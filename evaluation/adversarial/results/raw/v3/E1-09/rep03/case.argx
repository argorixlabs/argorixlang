module Eval.W09.PolicyUnknownRule

capability trace.write { level safe }

policy ForwardCompatibility {
    require argorix_future_rule_v99
    on violation { action review trace required }
}

type Ping { content: string }

agent Worker {
    receives Ping
    capabilities { trace.write }
    on Ping as ping { trace ping }
}

protocol Flow { User -> Worker: tell Ping }
