module passports.research_agent

passport ResearchAgentPassport {
    agent ResearchAgent
    agent_name "Eval Research Agent"

    global_id "argx:agent:01EVALRESEARCHAGENT"
    identity "did:argorix:eval-research-agent-v1"
    provider "Argorix"
    version "1.0.0"

    country "CL"
    jurisdiction "CL"
    data_residency ["CL", "EU"]

    model "frontier-compatible"
    risk_level "medium"
    data_scope ["internal"]

    intent "evaluation"
    intended_use ["policy-review"]
    prohibited_use ["external-execution", "credential-access"]

    attestations ["policy-check", "evidence-bundle"]
}
