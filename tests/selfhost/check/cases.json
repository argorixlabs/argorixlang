        "package_root": "package",
        "read_budget": 200,
        "write_budget": 2000,
        "build_dirs": ["dumps"],
        "expected_build": {
          "dumps/0.check": "ok\n",
          "dumps/1.check": "3:36: semantic[LiteralOutOfRangeOrConstantTrap]\n3:22: semantic[TypeMismatch]\n"
