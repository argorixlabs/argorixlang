        "package_root": "link_package",
        "read_budget": 2000,
        "write_budget": 2000,
        "build_dirs": ["dumps"],
        "expected_build": {
          "dumps/0.link": "ok\n",
          "dumps/1.link": "0:7:33: resolution[PrivateSymbol]\n0:7:53: resolution[PrivateSymbol]\n",
