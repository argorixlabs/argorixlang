core 0.1;
module demo.main;

import demo.helper;

pub fn argorix_main() -> u32 {
    let data: Buffer<u8> = Buffer::new();
    let size: u64 = helper.consume(data);
    let again: u64 = helper.consume(data);
    let wrong: u32 = helper.consume(data, 1u32);
    let also: bool = helper.LIMIT;
    helper.LIMIT(1u32) + size + again
}
