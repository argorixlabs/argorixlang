core 0.1;
module selfhost_agent.package_files;

// The Argorix module graph of agent-language packages (ESP-018.C), through
// the compiler-host boundary.
// `packages.txt` in the package root lists one directory per line, each
// holding an `argorix.toml`. Each package is resolved, merged and checked,
// and its canonical dump (spec/language/packages.md) written to
// `dumps/<n>.package` in the build root, where n counts from 0, and its IR
// dump (spec/language/ir.md) to `dumps/<n>.package-ir`. The result
// is the number of dumps written, or 1000000 plus the failure digest of the
// first read or write that failed.

import stdlib.compiler_host;
import stdlib.result;
import stdlib.bytes;
import compiler.agent_package;

pub fn argorix_main(package: PackageRead, build: BuildWrite) -> u64 {
    match compiler_host.read(package, "packages.txt".as_slice()) {
        BytesResult::Ok { value } => dump_each(package, build, value.as_slice()),
        BytesResult::Err { failure } => 1000000u64 + result.failure_digest(failure),
    }
}

fn dump_each(package: PackageRead, build: BuildWrite, list: Slice<u8>) -> u64 {
    let mut written: u64 = 0u64;
    let mut start: u64 = 0u64;
    let mut at: u64 = 0u64;
    while at <= list.length() {
        if at == list.length() || list[at] == 10u8 {
            if at > start {
                let outcome: u64 = dump_one(package, build, list.slice(start, at), written);
                if outcome != 0u64 {
                    return outcome;
                }
                written += 1u64;
            }
            start = at + 1u64;
        }
        at += 1u64;
    }
    written
}

// 0 when the dump was written.
fn dump_one(package: PackageRead, build: BuildWrite, directory: Slice<u8>, number: u64) -> u64 {
    let mut name: Buffer<u8> = bytes.append(Buffer::new(), "dumps/".as_slice());
    name = bytes.append_decimal(name, number);
    name = bytes.append(name, ".package".as_slice());
    let mut root: Buffer<u8> = bytes.append(Buffer::new(), directory);
    root.push(47u8);
    let printed: Buffer<u8> = agent_package.dump(package, root.as_slice());
    let written: u64 = result.checked_digest(compiler_host.write(build, name.as_slice(), printed.as_slice()));
    if written != 0u64 {
        return written;
    }
    name = bytes.append(name, "-ir".as_slice());
    let lowered: Buffer<u8> = agent_package.ir_dump(package, root.as_slice());
    result.checked_digest(compiler_host.write(build, name.as_slice(), lowered.as_slice()))
}
