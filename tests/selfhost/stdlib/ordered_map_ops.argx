core 0.1;
module selfhost_stdlib.ordered_map_ops;

// stdlib.ordered_map: keys inserted out of order come back in bytewise
// order, a duplicate is reported instead of overwriting, and a missing key
// is a result. All 6 checks pass gives 63.

import stdlib.ordered_map;
import stdlib.bytes;
import stdlib.result;

fn bit(passed: bool, index: u64) -> u64 {
    if passed { 1u64 << index } else { 0u64 }
}

fn added(inserted: Inserted) -> Map {
    match inserted {
        Inserted::Added { map } => map,
        Inserted::Duplicate { map, at: _ } => map,
    }
}

fn key_is(map_keys: Slice<u8>, starts: Slice<u64>, ends: Slice<u64>, entry: u64, expected: Slice<u8>) -> bool {
    bytes.equal(map_keys.slice(starts[entry], ends[entry]), expected)
}

fn value_or(lookup: U64Result, fallback: u64) -> u64 {
    match lookup {
        U64Result::Ok { value } => value,
        U64Result::Err { failure } => fallback + result.failure_digest(failure),
    }
}

pub fn argorix_main() -> u64 {
    let a: Array<u8, 1> = [97u8];
    let ab: Array<u8, 2> = [97u8, 98u8];
    let b: Array<u8, 1> = [98u8];
    let c: Array<u8, 1> = [99u8];
    let zz: Array<u8, 2> = [122u8, 122u8];
    let mut mask: u64 = 0u64;

    let mut m: Map = ordered_map.empty();
    m = added(ordered_map.insert(m, b.as_slice(), 2u64));
    m = added(ordered_map.insert(m, a.as_slice(), 1u64));
    m = added(ordered_map.insert(m, c.as_slice(), 3u64));
    // `b` is entry 1 of a, b, c: the duplicate names it and changes nothing.
    let duplicate_at: u64 = match ordered_map.insert(m, b.as_slice(), 9u64) {
        Inserted::Added { map } => {
            m = map;
            999u64
        },
        Inserted::Duplicate { map, at } => {
            m = map;
            at
        },
    };
    m = added(ordered_map.insert(m, ab.as_slice(), 4u64));

    mask += bit(m.starts.length() == 4u64, 0u64);
    let ordered: bool = key_is(m.keys.as_slice(), m.starts.as_slice(), m.ends.as_slice(), 0u64, a.as_slice())
        && key_is(m.keys.as_slice(), m.starts.as_slice(), m.ends.as_slice(), 1u64, ab.as_slice())
        && key_is(m.keys.as_slice(), m.starts.as_slice(), m.ends.as_slice(), 2u64, b.as_slice())
        && key_is(m.keys.as_slice(), m.starts.as_slice(), m.ends.as_slice(), 3u64, c.as_slice());
    mask += bit(ordered, 1u64);
    let values_in_order: bool = m.values[0u64] == 1u64 && m.values[1u64] == 4u64
        && m.values[2u64] == 2u64 && m.values[3u64] == 3u64;
    mask += bit(values_in_order, 2u64);
    let b_value: u64 = value_or(ordered_map.get(m.keys.as_slice(), m.starts.as_slice(), m.ends.as_slice(), m.values.as_slice(), b.as_slice()), 0u64);
    mask += bit(duplicate_at == 1u64 && b_value == 2u64, 3u64);
    let c_value: u64 = value_or(ordered_map.get(m.keys.as_slice(), m.starts.as_slice(), m.ends.as_slice(), m.values.as_slice(), c.as_slice()), 0u64);
    mask += bit(c_value == 3u64, 4u64);
    // A missing key would go after all four: OutOfRange at 4.
    let missing: u64 = value_or(ordered_map.get(m.keys.as_slice(), m.starts.as_slice(), m.ends.as_slice(), m.values.as_slice(), zz.as_slice()), 0u64);
    mask += bit(missing == 2000004u64, 5u64);
    mask
}
