core 0.1;
module selfhost_stdlib.trap_slice_reversed;

// A slice whose start is past its end is refused even when both are in range.

fn middle(value: Slice<u8>) -> u64 {
    value.slice(2u64, 1u64).length()
}

pub fn argorix_main() -> u64 {
    let abc: Array<u8, 3> = [97u8, 98u8, 99u8];
    middle(abc.as_slice())
}
