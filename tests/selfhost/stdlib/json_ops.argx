core 0.1;
module selfhost_stdlib.json_ops;

// stdlib.json: the writer's output validates, and the validator refuses
// duplicate keys, out-of-range integers, whitespace, bad escapes, raw control
// bytes, invalid UTF-8 and nesting past max_depth(). All 14 checks pass gives
// 16383.

import stdlib.json;
import stdlib.bytes;
import stdlib.result;

fn bit(passed: bool, index: u64) -> u64 {
    if passed { 1u64 << index } else { 0u64 }
}

fn digest(value: Slice<u8>) -> u64 {
    result.checked_digest(json.validate(value))
}

// `levels` opening brackets, then as many closing ones.
fn nested(levels: u64) -> Buffer<u8> {
    let mut out: Buffer<u8> = Buffer::new();
    let mut index: u64 = 0u64;
    while index < levels {
        out = json.begin_array(out);
        index += 1u64;
    }
    index = 0u64;
    while index < levels {
        out = json.end_array(out);
        index += 1u64;
    }
    out
}

pub fn argorix_main() -> u64 {
    let a: Array<u8, 1> = [97u8];
    let b: Array<u8, 1> = [98u8];
    let quoted: Array<u8, 3> = [120u8, 34u8, 121u8];
    let mut mask: u64 = 0u64;

    // {"a":18446744073709551615,"b":[true,false,null,"x\"y"]}
    let mut doc: Buffer<u8> = json.begin_object(Buffer::new());
    doc = json.unsigned(json.key(doc, true, a.as_slice()), 18446744073709551615u64);
    doc = json.begin_array(json.key(doc, false, b.as_slice()));
    doc = json.boolean(json.separator(doc, true), true);
    doc = json.boolean(json.separator(doc, false), false);
    doc = json.null(json.separator(doc, false));
    doc = json.string(json.separator(doc, false), quoted.as_slice());
    doc = json.end_object(json.end_array(doc));
    let expected: Array<u8, 55> = [123u8, 34u8, 97u8, 34u8, 58u8, 49u8, 56u8, 52u8, 52u8, 54u8,
        55u8, 52u8, 52u8, 48u8, 55u8, 51u8, 55u8, 48u8, 57u8, 53u8, 53u8, 49u8, 54u8, 49u8, 53u8,
        44u8, 34u8, 98u8, 34u8, 58u8, 91u8, 116u8, 114u8, 117u8, 101u8, 44u8, 102u8, 97u8, 108u8,
        115u8, 101u8, 44u8, 110u8, 117u8, 108u8, 108u8, 44u8, 34u8, 120u8, 92u8, 34u8, 121u8, 34u8,
        93u8, 125u8];
    mask += bit(bytes.equal(doc.as_slice(), expected.as_slice()), 0u64);
    mask += bit(digest(doc.as_slice()) == 0u64, 1u64);

    // {"a":1,"a":2}: the second key starts at 7.
    let duplicate: Array<u8, 13> = [123u8, 34u8, 97u8, 34u8, 58u8, 49u8, 44u8, 34u8, 97u8, 34u8,
        58u8, 50u8, 125u8];
    mask += bit(digest(duplicate.as_slice()) == 3000007u64, 2u64);
    let leading_zero: Array<u8, 2> = [48u8, 49u8];
    mask += bit(digest(leading_zero.as_slice()) == 5000001u64, 3u64);
    // u64::MAX + 1
    let too_big: Array<u8, 20> = [49u8, 56u8, 52u8, 52u8, 54u8, 55u8, 52u8, 52u8, 48u8, 55u8,
        51u8, 55u8, 48u8, 57u8, 53u8, 53u8, 49u8, 54u8, 49u8, 54u8];
    mask += bit(digest(too_big.as_slice()) == 2000000u64, 4u64);
    let spaced: Array<u8, 6> = [91u8, 49u8, 44u8, 32u8, 50u8, 93u8];
    mask += bit(digest(spaced.as_slice()) == 5000003u64, 5u64);
    let bad_escape: Array<u8, 4> = [34u8, 92u8, 120u8, 34u8];
    mask += bit(digest(bad_escape.as_slice()) == 5000002u64, 6u64);
    let raw_newline: Array<u8, 3> = [34u8, 10u8, 34u8];
    mask += bit(digest(raw_newline.as_slice()) == 5000001u64, 7u64);
    let not_utf8: Array<u8, 3> = [34u8, 255u8, 34u8];
    mask += bit(digest(not_utf8.as_slice()) == 1000001u64, 8u64);
    let fraction: Array<u8, 3> = [49u8, 46u8, 53u8];
    mask += bit(digest(fraction.as_slice()) == 5000001u64, 9u64);
    let empty: Array<u8, 0> = [];
    mask += bit(digest(empty.as_slice()) == 5000000u64, 10u64);

    let deepest: Buffer<u8> = nested(json.max_depth());
    mask += bit(digest(deepest.as_slice()) == 0u64, 11u64);
    // One level more is refused at the bracket that opens it.
    let too_deep: Buffer<u8> = nested(json.max_depth() + 1u64);
    mask += bit(digest(too_deep.as_slice()) == 6000064u64, 12u64);
    let unclosed: Array<u8, 2> = [91u8, 49u8];
    mask += bit(digest(unclosed.as_slice()) == 5000002u64, 13u64);
    mask
}
