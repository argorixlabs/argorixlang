core 0.1;
module selfhost_stage1.render_files;

// The diagnostics stage1 writes (`compiler.report`), over real packages,
// through the compiler-host boundary. `packages.txt` in the package root
// lists one package per line: its files' relative paths separated by spaces,
// the root first. Each package is read and its rendered diagnostics, named by
// those paths, written to `dumps/<n>.txt` in the build root, where n counts
// from 0; a package that links and checks gives an empty file. The result is
// the number of files written, or 1000000 plus the failure digest of the
// first read or write that failed.

import stdlib.compiler_host;
import stdlib.result;
import stdlib.bytes;
import compiler.report;

pub fn argorix_main(package: PackageRead, build: BuildWrite) -> u64 {
    match compiler_host.read(package, "packages.txt".as_slice()) {
        BytesResult::Ok { value } => render_each(package, build, value.as_slice()),
        BytesResult::Err { failure } => 1000000u64 + result.failure_digest(failure),
    }
}

fn render_each(package: PackageRead, build: BuildWrite, list: Slice<u8>) -> u64 {
    let mut written: u64 = 0u64;
    let mut start: u64 = 0u64;
    let mut at: u64 = 0u64;
    while at <= list.length() {
        if at == list.length() || list[at] == 10u8 {
            if at > start {
                let outcome: u64 = render_one(package, build, list.slice(start, at), written);
                if outcome != 0u64 {
                    return outcome;
                }
                written += 1u64;
            }
            start = at + 1u64;
        }
        at += 1u64;
    }
    written
}

// 0 when the file was written.
fn render_one(package: PackageRead, build: BuildWrite, line: Slice<u8>, number: u64) -> u64 {
    let mut sources: Buffer<u8> = Buffer::new();
    let mut ends: Buffer<u64> = Buffer::new();
    let mut paths: Buffer<u8> = Buffer::new();
    let mut path_ends: Buffer<u64> = Buffer::new();
    let mut start: u64 = 0u64;
    let mut at: u64 = 0u64;
    while at <= line.length() {
        if at == line.length() || line[at] == 32u8 {
            if at > start {
                paths = bytes.append(paths, line.slice(start, at));
                path_ends.push(paths.length());
                match compiler_host.read(package, line.slice(start, at)) {
                    BytesResult::Ok { value } => {
                        sources = bytes.append(sources, value.as_slice());
                        ends.push(sources.length());
                    },
                    BytesResult::Err { failure } => {
                        return 1000000u64 + result.failure_digest(failure);
                    },
                }
            }
            start = at + 1u64;
        }
        at += 1u64;
    }
    let mut name: Buffer<u8> = bytes.append(Buffer::new(), "dumps/".as_slice());
    name = bytes.append_decimal(name, number);
    name = bytes.append(name, ".txt".as_slice());
    let printed: Buffer<u8> = report.render(paths.as_slice(), path_ends.as_slice(), sources.as_slice(), ends.as_slice());
    result.checked_digest(compiler_host.write(build, name.as_slice(), printed.as_slice()))
}
