// What serde expects of a struct: `struct <Name>`.
pub fn append_struct_name(out: Buffer<u8>, s: u64) -> Buffer<u8> {
    if s == BS_PROGRAM { return bytes.append(out, "struct BytecodeProgram".as_slice()); }
    if s == BS_MODULE { return bytes.append(out, "struct BytecodeModule".as_slice()); }
    if s == BS_MODULE_IMPORT { return bytes.append(out, "struct BytecodeModuleImport".as_slice()); }
    if s == BS_PROVIDER_CONTRACT { return bytes.append(out, "struct BytecodeProviderContract".as_slice()); }
    if s == BS_FEATURE { return bytes.append(out, "struct BytecodeFeature".as_slice()); }
    if s == BS_SECRET { return bytes.append(out, "struct BytecodeSecret".as_slice()); }
    if s == BS_ADAPTER { return bytes.append(out, "struct BytecodeAdapter".as_slice()); }
    if s == BS_ADAPTER_PROFILE { return bytes.append(out, "struct BytecodeAdapterProfile".as_slice()); }
    if s == BS_CRYPTO { return bytes.append(out, "struct BytecodeCrypto".as_slice()); }
    if s == BS_CRYPTO_BOUNDARY { return bytes.append(out, "struct BytecodeCryptoBoundary".as_slice()); }
    if s == BS_DID_METHOD { return bytes.append(out, "struct BytecodeDidMethod".as_slice()); }
    if s == BS_A_TRUST_BOUNDARY { return bytes.append(out, "struct BytecodeATrustBoundary".as_slice()); }
    if s == BS_A_TRUST_IDENTITY { return bytes.append(out, "struct BytecodeATrustIdentity".as_slice()); }
    if s == BS_A_TRUST_CREDENTIAL_CONTRACT { return bytes.append(out, "struct BytecodeATrustCredentialContract".as_slice()); }
    if s == BS_A_TRUST_HANDSHAKE { return bytes.append(out, "struct BytecodeATrustHandshake".as_slice()); }
    if s == BS_TRUST_LEDGER { return bytes.append(out, "struct BytecodeTrustLedger".as_slice()); }
    if s == BS_TRUST_LEDGER_ENTRY { return bytes.append(out, "struct BytecodeTrustLedgerEntry".as_slice()); }
    if s == BS_MCP_BRIDGE_CONTRACT { return bytes.append(out, "struct BytecodeMcpBridgeContract".as_slice()); }
    if s == BS_A2_A_BRIDGE_CONTRACT { return bytes.append(out, "struct BytecodeA2ABridgeContract".as_slice()); }
    if s == BS_A_TRUST_EVIDENCE_MAP { return bytes.append(out, "struct BytecodeATrustEvidenceMap".as_slice()); }
    if s == BS_GOVERNANCE_PROFILE { return bytes.append(out, "struct BytecodeGovernanceProfile".as_slice()); }
    if s == BS_GOVERNANCE_CONTROL { return bytes.append(out, "struct BytecodeGovernanceControl".as_slice()); }
    if s == BS_REGULATORY_MAPPING { return bytes.append(out, "struct BytecodeRegulatoryMapping".as_slice()); }
    if s == BS_REGULATORY_OBLIGATION { return bytes.append(out, "struct BytecodeRegulatoryObligation".as_slice()); }
    if s == BS_THIRD_PARTY_VERIFIER { return bytes.append(out, "struct BytecodeThirdPartyVerifier".as_slice()); }
    if s == BS_PUBLIC_CONFORMANCE_REPORT { return bytes.append(out, "struct BytecodePublicConformanceReport".as_slice()); }
    if s == BS_PUBLIC_CONFORMANCE_CLAIM { return bytes.append(out, "struct BytecodePublicConformanceClaim".as_slice()); }
    if s == BS_RUNTIME_HARDENING_PROFILE { return bytes.append(out, "struct BytecodeRuntimeHardeningProfile".as_slice()); }
    if s == BS_THREAT_MODEL { return bytes.append(out, "struct BytecodeThreatModel".as_slice()); }
    if s == BS_THREAT_ASSET { return bytes.append(out, "struct BytecodeThreatAsset".as_slice()); }
    if s == BS_THREAT { return bytes.append(out, "struct BytecodeThreat".as_slice()); }
    if s == BS_THREAT_MITIGATION { return bytes.append(out, "struct BytecodeThreatMitigation".as_slice()); }
    if s == BS_SPEC_FREEZE { return bytes.append(out, "struct BytecodeSpecFreeze".as_slice()); }
    if s == BS_RELEASE_CANDIDATE { return bytes.append(out, "struct BytecodeReleaseCandidate".as_slice()); }
    if s == BS_COMPATIBILITY_MATRIX_ENTRY { return bytes.append(out, "struct BytecodeCompatibilityMatrixEntry".as_slice()); }
    if s == BS_RUNTIME_EXECUTION_PROFILE { return bytes.append(out, "struct BytecodeRuntimeExecutionProfile".as_slice()); }
    if s == BS_SANDBOXED_PROVIDER_ADAPTER { return bytes.append(out, "struct BytecodeSandboxedProviderAdapter".as_slice()); }
    if s == BS_PROVIDER_HARNESS { return bytes.append(out, "struct BytecodeProviderHarness".as_slice()); }
    if s == BS_ASSERTION { return bytes.append(out, "struct BytecodeAssertion".as_slice()); }
    if s == BS_POLICY { return bytes.append(out, "struct BytecodePolicy".as_slice()); }
    if s == BS_POLICY_RULE { return bytes.append(out, "struct BytecodePolicyRule".as_slice()); }
    if s == BS_POLICY_VIOLATION { return bytes.append(out, "struct BytecodePolicyViolation".as_slice()); }
    if s == BS_TYPE { return bytes.append(out, "struct BytecodeType".as_slice()); }
    if s == BS_TYPE_FIELD { return bytes.append(out, "struct BytecodeTypeField".as_slice()); }
    if s == BS_FAILURE { return bytes.append(out, "struct BytecodeFailure".as_slice()); }
    if s == BS_PASSPORT { return bytes.append(out, "struct BytecodePassport".as_slice()); }
    if s == BS_PASSPORT_ASN { return bytes.append(out, "struct BytecodePassportAsn".as_slice()); }
    if s == BS_MODEL { return bytes.append(out, "struct BytecodeModel".as_slice()); }
    if s == BS_TOOL { return bytes.append(out, "struct BytecodeTool".as_slice()); }
    if s == BS_AGENT { return bytes.append(out, "struct BytecodeAgent".as_slice()); }
    if s == BS_CAPABILITY { return bytes.append(out, "struct BytecodeCapability".as_slice()); }
    out
}

// The variant `op` names, or `OP_OTHER`.
pub fn variant(name: Slice<u8>) -> u64 {
    if bytes.equal(name, "DeclareProviderContract".as_slice()) { return OP_DECLARE_PROVIDER_CONTRACT; }
    if bytes.equal(name, "DeclareAgent".as_slice()) { return OP_DECLARE_AGENT; }
    if bytes.equal(name, "DeclareCapability".as_slice()) { return OP_DECLARE_CAPABILITY; }
    if bytes.equal(name, "DeclareProtocol".as_slice()) { return OP_DECLARE_PROTOCOL; }
    if bytes.equal(name, "DeclareAssertion".as_slice()) { return OP_DECLARE_ASSERTION; }
    if bytes.equal(name, "DeclareFailure".as_slice()) { return OP_DECLARE_FAILURE; }
    if bytes.equal(name, "VerifyAssertion".as_slice()) { return OP_VERIFY_ASSERTION; }
    if bytes.equal(name, "PolicyReport".as_slice()) { return OP_POLICY_REPORT; }
    if bytes.equal(name, "DeclareTool".as_slice()) { return OP_DECLARE_TOOL; }
    if bytes.equal(name, "AuthorizeTool".as_slice()) { return OP_AUTHORIZE_TOOL; }
    if bytes.equal(name, "DeclareModel".as_slice()) { return OP_DECLARE_MODEL; }
    if bytes.equal(name, "AuthorizeModel".as_slice()) { return OP_AUTHORIZE_MODEL; }
    if bytes.equal(name, "DeclareHandler".as_slice()) { return OP_DECLARE_HANDLER; }
    if bytes.equal(name, "EmitMessage".as_slice()) { return OP_EMIT_MESSAGE; }
    if bytes.equal(name, "TraceValue".as_slice()) { return OP_TRACE_VALUE; }
    if bytes.equal(name, "HandlerHalt".as_slice()) { return OP_HANDLER_HALT; }
    if bytes.equal(name, "InvokeIntrinsic".as_slice()) { return OP_INVOKE_INTRINSIC; }
    if bytes.equal(name, "CallTool".as_slice()) { return OP_CALL_TOOL; }
    if bytes.equal(name, "AskModel".as_slice()) { return OP_ASK_MODEL; }
    if bytes.equal(name, "EndHandler".as_slice()) { return OP_END_HANDLER; }
    if bytes.equal(name, "SendMessage".as_slice()) { return OP_SEND_MESSAGE; }
    if bytes.equal(name, "RequireCapability".as_slice()) { return OP_REQUIRE_CAPABILITY; }
    if bytes.equal(name, "RequireApproval".as_slice()) { return OP_REQUIRE_APPROVAL; }
    if bytes.equal(name, "Trace".as_slice()) { return OP_TRACE; }
    if bytes.equal(name, "Halt".as_slice()) { return OP_HALT; }
    if bytes.equal(name, "End".as_slice()) { return OP_END; }
    OP_OTHER
}

// The struct of a variant's fields, or `NONE` for a unit variant.
pub fn variant_struct(v: u64) -> u64 {
    if v == OP_DECLARE_PROVIDER_CONTRACT { return BS_OP_DECLARE_PROVIDER_CONTRACT; }
    if v == OP_DECLARE_AGENT { return BS_OP_DECLARE_AGENT; }
    if v == OP_DECLARE_CAPABILITY { return BS_OP_DECLARE_CAPABILITY; }
    if v == OP_DECLARE_PROTOCOL { return BS_OP_DECLARE_PROTOCOL; }
    if v == OP_DECLARE_ASSERTION { return BS_OP_DECLARE_ASSERTION; }
    if v == OP_DECLARE_FAILURE { return BS_OP_DECLARE_FAILURE; }
    if v == OP_VERIFY_ASSERTION { return BS_OP_VERIFY_ASSERTION; }
    if v == OP_DECLARE_TOOL { return BS_OP_DECLARE_TOOL; }
    if v == OP_AUTHORIZE_TOOL { return BS_OP_AUTHORIZE_TOOL; }
    if v == OP_DECLARE_MODEL { return BS_OP_DECLARE_MODEL; }
    if v == OP_AUTHORIZE_MODEL { return BS_OP_AUTHORIZE_MODEL; }
    if v == OP_DECLARE_HANDLER { return BS_OP_DECLARE_HANDLER; }
    if v == OP_EMIT_MESSAGE { return BS_OP_EMIT_MESSAGE; }
    if v == OP_TRACE_VALUE { return BS_OP_TRACE_VALUE; }
    if v == OP_HANDLER_HALT { return BS_OP_HANDLER_HALT; }
    if v == OP_INVOKE_INTRINSIC { return BS_OP_INVOKE_INTRINSIC; }
    if v == OP_CALL_TOOL { return BS_OP_CALL_TOOL; }
    if v == OP_ASK_MODEL { return BS_OP_ASK_MODEL; }
    if v == OP_SEND_MESSAGE { return BS_OP_SEND_MESSAGE; }
    if v == OP_REQUIRE_CAPABILITY { return BS_OP_REQUIRE_CAPABILITY; }
    if v == OP_REQUIRE_APPROVAL { return BS_OP_REQUIRE_APPROVAL; }
    if v == OP_TRACE { return BS_OP_TRACE; }
    if v == OP_HALT { return BS_OP_HALT; }
    NONE
}
