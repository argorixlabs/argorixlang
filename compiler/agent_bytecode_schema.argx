        if bytes.equal(key, "capability".as_slice()) { return 2u64; }
        if bytes.equal(key, "input".as_slice()) { return 3u64; }
        if bytes.equal(key, "output".as_slice()) { return 4u64; }
        return NONE;
    }
    if s == BS_TOOL {
        if bytes.equal(key, "name".as_slice()) { return 0u64; }
        if bytes.equal(key, "provider".as_slice()) { return 1u64; }
        if bytes.equal(key, "capability".as_slice()) { return 2u64; }
        if bytes.equal(key, "input".as_slice()) { return 3u64; }
        if bytes.equal(key, "output".as_slice()) { return 4u64; }
        return NONE;
    }
    if s == BS_AGENT {
        if bytes.equal(key, "name".as_slice()) { return 0u64; }
        if bytes.equal(key, "approval".as_slice()) { return 1u64; }
        return NONE;
    }
    if s == BS_CAPABILITY {
        if bytes.equal(key, "name".as_slice()) { return 0u64; }
        if bytes.equal(key, "level".as_slice()) { return 1u64; }
        if bytes.equal(key, "requires_approval".as_slice()) { return 2u64; }
        return NONE;
    }
    if s == BS_OP_DECLARE_PROVIDER_CONTRACT {
        if bytes.equal(key, "name".as_slice()) { return 0u64; }
        if bytes.equal(key, "kind".as_slice()) { return 1u64; }
        if bytes.equal(key, "enabled".as_slice()) { return 2u64; }
        if bytes.equal(key, "dry_run_only".as_slice()) { return 3u64; }
        if bytes.equal(key, "requires_feature_flag".as_slice()) { return 4u64; }
        if bytes.equal(key, "requires_explicit_approval".as_slice()) { return 5u64; }
        if bytes.equal(key, "allowed_targets".as_slice()) { return 6u64; }
        if bytes.equal(key, "allowed_capabilities".as_slice()) { return 7u64; }
        return NONE;
    }
    if s == BS_OP_DECLARE_AGENT {
        if bytes.equal(key, "name".as_slice()) { return 0u64; }
        if bytes.equal(key, "approval".as_slice()) { return 1u64; }
        return NONE;
    }
    if s == BS_OP_DECLARE_CAPABILITY {
        if bytes.equal(key, "name".as_slice()) { return 0u64; }
        if bytes.equal(key, "level".as_slice()) { return 1u64; }
        if bytes.equal(key, "requires_approval".as_slice()) { return 2u64; }
        return NONE;
    }
    if s == BS_OP_DECLARE_PROTOCOL {
        if bytes.equal(key, "name".as_slice()) { return 0u64; }
        return NONE;
    }
    if s == BS_OP_DECLARE_ASSERTION {
        if bytes.equal(key, "name".as_slice()) { return 0u64; }
        if bytes.equal(key, "argument".as_slice()) { return 1u64; }
        return NONE;
    }
    if s == BS_OP_DECLARE_FAILURE {
        if bytes.equal(key, "name".as_slice()) { return 0u64; }
        if bytes.equal(key, "action".as_slice()) { return 1u64; }
        if bytes.equal(key, "trace".as_slice()) { return 2u64; }
        return NONE;
    }
    if s == BS_OP_VERIFY_ASSERTION {
        if bytes.equal(key, "name".as_slice()) { return 0u64; }
        if bytes.equal(key, "argument".as_slice()) { return 1u64; }
        return NONE;
    }
    if s == BS_OP_DECLARE_TOOL {
        if bytes.equal(key, "name".as_slice()) { return 0u64; }
        if bytes.equal(key, "provider".as_slice()) { return 1u64; }
        if bytes.equal(key, "capability".as_slice()) { return 2u64; }
        if bytes.equal(key, "input".as_slice()) { return 3u64; }
        if bytes.equal(key, "output".as_slice()) { return 4u64; }
        return NONE;
    }
    if s == BS_OP_AUTHORIZE_TOOL {
        if bytes.equal(key, "agent".as_slice()) { return 0u64; }
        if bytes.equal(key, "tool".as_slice()) { return 1u64; }
        return NONE;
    }
    if s == BS_OP_DECLARE_MODEL {
        if bytes.equal(key, "name".as_slice()) { return 0u64; }
        if bytes.equal(key, "provider".as_slice()) { return 1u64; }
        if bytes.equal(key, "capability".as_slice()) { return 2u64; }
        if bytes.equal(key, "input".as_slice()) { return 3u64; }
        if bytes.equal(key, "output".as_slice()) { return 4u64; }
        return NONE;
    }
    if s == BS_OP_AUTHORIZE_MODEL {
        if bytes.equal(key, "agent".as_slice()) { return 0u64; }
        if bytes.equal(key, "model".as_slice()) { return 1u64; }
        return NONE;
    }
    if s == BS_OP_DECLARE_HANDLER {
        if bytes.equal(key, "agent".as_slice()) { return 0u64; }
        if bytes.equal(key, "message_type".as_slice()) { return 1u64; }
        if bytes.equal(key, "binding".as_slice()) { return 2u64; }
        return NONE;
    }
    if s == BS_OP_EMIT_MESSAGE {
        if bytes.equal(key, "agent".as_slice()) { return 0u64; }
        if bytes.equal(key, "message_type".as_slice()) { return 1u64; }
        if bytes.equal(key, "to".as_slice()) { return 2u64; }
        return NONE;
    }
    if s == BS_OP_TRACE_VALUE {
        if bytes.equal(key, "agent".as_slice()) { return 0u64; }
        if bytes.equal(key, "binding".as_slice()) { return 1u64; }
        return NONE;
    }
    if s == BS_OP_HANDLER_HALT {
        if bytes.equal(key, "agent".as_slice()) { return 0u64; }
        return NONE;
    }
    if s == BS_OP_INVOKE_INTRINSIC {
        if bytes.equal(key, "agent".as_slice()) { return 0u64; }
        if bytes.equal(key, "name".as_slice()) { return 1u64; }
        if bytes.equal(key, "argument".as_slice()) { return 2u64; }
        return NONE;
    }
    if s == BS_OP_CALL_TOOL {
        if bytes.equal(key, "agent".as_slice()) { return 0u64; }
        if bytes.equal(key, "tool".as_slice()) { return 1u64; }
        if bytes.equal(key, "binding".as_slice()) { return 2u64; }
        return NONE;
    }
    if s == BS_OP_ASK_MODEL {
        if bytes.equal(key, "agent".as_slice()) { return 0u64; }
        if bytes.equal(key, "model".as_slice()) { return 1u64; }
        if bytes.equal(key, "binding".as_slice()) { return 2u64; }
        return NONE;
    }
    if s == BS_OP_SEND_MESSAGE {
        if bytes.equal(key, "from".as_slice()) { return 0u64; }
        if bytes.equal(key, "to".as_slice()) { return 1u64; }
        if bytes.equal(key, "act".as_slice()) { return 2u64; }
        if bytes.equal(key, "message_type".as_slice()) { return 3u64; }
        return NONE;
    }
    if s == BS_OP_REQUIRE_CAPABILITY {
        if bytes.equal(key, "agent".as_slice()) { return 0u64; }
        if bytes.equal(key, "capability".as_slice()) { return 1u64; }
        return NONE;
    }
    if s == BS_OP_REQUIRE_APPROVAL {
        if bytes.equal(key, "agent".as_slice()) { return 0u64; }
        if bytes.equal(key, "capability".as_slice()) { return 1u64; }
        return NONE;
    }
    if s == BS_OP_TRACE {
        if bytes.equal(key, "message".as_slice()) { return 0u64; }
        return NONE;
    }
    if s == BS_OP_HALT {
        if bytes.equal(key, "reason".as_slice()) { return 0u64; }
        return NONE;
    }
    NONE
}

pub fn append_field_key(out: Buffer<u8>, s: u64, i: u64) -> Buffer<u8> {
    if s == BS_PROGRAM {
        if i == 0u64 { return bytes.append(out, "source_digest".as_slice()); }
        if i == 1u64 { return bytes.append(out, "bytecode_version".as_slice()); }
        if i == 2u64 { return bytes.append(out, "language".as_slice()); }
