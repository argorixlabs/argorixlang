        if i == 9u64 { return bytes.append(out, "secrets".as_slice()); }
        if i == 10u64 { return bytes.append(out, "adapters".as_slice()); }
        if i == 11u64 { return bytes.append(out, "adapter_profiles".as_slice()); }
        if i == 12u64 { return bytes.append(out, "cryptos".as_slice()); }
        if i == 13u64 { return bytes.append(out, "crypto_boundaries".as_slice()); }
        if i == 14u64 { return bytes.append(out, "did_methods".as_slice()); }
