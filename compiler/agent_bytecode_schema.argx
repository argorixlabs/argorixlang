// The field of `s` serde reads as `key`, or `NONE`.
pub fn field_index(s: u64, key: Slice<u8>) -> u64 {
    if s == BS_PROGRAM {
        if bytes.equal(key, "source_digest".as_slice()) { return 0u64; }
        if bytes.equal(key, "bytecode_version".as_slice()) { return 1u64; }
        if bytes.equal(key, "language".as_slice()) { return 2u64; }
        if bytes.equal(key, "module".as_slice()) { return 3u64; }
        if bytes.equal(key, "modules".as_slice()) { return 4u64; }
        if bytes.equal(key, "imports".as_slice()) { return 5u64; }
        if bytes.equal(key, "providers".as_slice()) { return 6u64; }
        if bytes.equal(key, "provider_harnesses".as_slice()) { return 7u64; }
        if bytes.equal(key, "features".as_slice()) { return 8u64; }
        if bytes.equal(key, "secrets".as_slice()) { return 9u64; }
        if bytes.equal(key, "adapters".as_slice()) { return 10u64; }
        if bytes.equal(key, "adapter_profiles".as_slice()) { return 11u64; }
        if bytes.equal(key, "cryptos".as_slice()) { return 12u64; }
        if bytes.equal(key, "crypto_boundaries".as_slice()) { return 13u64; }
        if bytes.equal(key, "did_methods".as_slice()) { return 14u64; }
        if bytes.equal(key, "atrust_boundaries".as_slice()) { return 15u64; }
        if bytes.equal(key, "atrust_identities".as_slice()) { return 16u64; }
        if bytes.equal(key, "atrust_credential_contracts".as_slice()) { return 17u64; }
        if bytes.equal(key, "atrust_handshakes".as_slice()) { return 18u64; }
        if bytes.equal(key, "trust_ledgers".as_slice()) { return 19u64; }
        if bytes.equal(key, "mcp_bridge_contracts".as_slice()) { return 20u64; }
        if bytes.equal(key, "a2a_bridge_contracts".as_slice()) { return 21u64; }
        if bytes.equal(key, "atrust_evidence_maps".as_slice()) { return 22u64; }
        if bytes.equal(key, "governance_profiles".as_slice()) { return 23u64; }
        if bytes.equal(key, "regulatory_mappings".as_slice()) { return 24u64; }
        if bytes.equal(key, "third_party_verifiers".as_slice()) { return 25u64; }
        if bytes.equal(key, "public_conformance_reports".as_slice()) { return 26u64; }
        if bytes.equal(key, "runtime_hardening_profiles".as_slice()) { return 27u64; }
