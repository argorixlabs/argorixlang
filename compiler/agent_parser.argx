    p = default_unknown(p, node, agent_schema.GOVERNANCE_PROFILE_DECL_ASSURANCE, agent_schema.GOVERNANCE_ASSURANCE, agent_schema.GOVERNANCE_ASSURANCE_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.GOVERNANCE_PROFILE_DECL_NETWORK, agent_schema.A_TRUST_NETWORK_BOUNDARY, agent_schema.A_TRUST_NETWORK_BOUNDARY_UNKNOWN, fallback);
