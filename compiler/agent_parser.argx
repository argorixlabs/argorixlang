        if p.failed { return p; }
    }
    let fallback: u64 = name_span(p.slots.as_slice(), p.nodes.as_slice(), node);
    p = default_string(p, node, agent_schema.REGULATORY_MAPPING_DECL_GOVERNANCE_PROFILE, fallback);
    p = default_string(p, node, agent_schema.REGULATORY_MAPPING_DECL_EVIDENCE_MAP, fallback);
    p = default_string(p, node, agent_schema.REGULATORY_MAPPING_DECL_JURISDICTION, fallback);
    p = default_string(p, node, agent_schema.REGULATORY_MAPPING_DECL_FRAMEWORK, fallback);
    p = default_array(p, node, agent_schema.REGULATORY_MAPPING_DECL_OBLIGATIONS);
    p = default_unknown(p, node, agent_schema.REGULATORY_MAPPING_DECL_COVERAGE, agent_schema.REGULATORY_COVERAGE, agent_schema.REGULATORY_COVERAGE_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.REGULATORY_MAPPING_DECL_ASSESSMENT, agent_schema.REGULATORY_ASSESSMENT, agent_schema.REGULATORY_ASSESSMENT_UNKNOWN, fallback);
    p = default_string(p, node, agent_schema.REGULATORY_MAPPING_DECL_LEGAL_CLAIMS, fallback);
    p = default_string(p, node, agent_schema.REGULATORY_MAPPING_DECL_CERTIFICATION, fallback);
    p = default_unknown(p, node, agent_schema.REGULATORY_MAPPING_DECL_NETWORK, agent_schema.A_TRUST_NETWORK_BOUNDARY, agent_schema.A_TRUST_NETWORK_BOUNDARY_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.REGULATORY_MAPPING_DECL_EXTERNAL_EXECUTION, agent_schema.A_TRUST_EXECUTION, agent_schema.A_TRUST_EXECUTION_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.REGULATORY_MAPPING_DECL_SECRET_MATERIAL, agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.REGULATORY_MAPPING_DECL_KEY_MATERIAL, agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.REGULATORY_MAPPING_DECL_EXECUTION, agent_schema.A_TRUST_EXECUTION, agent_schema.A_TRUST_EXECUTION_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.REGULATORY_MAPPING_DECL_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS_UNKNOWN, fallback);
    p = default_array(p, node, agent_schema.REGULATORY_MAPPING_DECL_PURPOSE);
    block_end(t, p, node)
}

// `parse_third_party_verifier`.
fn parse_third_party_verifier(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "third_party_verifier".as_slice(), "third_party_verifier name".as_slice(), agent_schema.THIRD_PARTY_VERIFIER_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated third_party_verifier declaration".as_slice());
        if p.failed { return p; }
        if peek_is(s, t, p.current, "verifier_type".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.THIRD_PARTY_VERIFIER_DECL_VERIFIER_TYPE, "third_party_verifier".as_slice(), "third_party_verifier verifier_type".as_slice(), agent_schema.THIRD_PARTY_VERIFIER_TYPE, agent_words.T_PARSE_THIRD_PARTY_VERIFIER_TYPE__THIRD_PARTY_VERIFIER_TYPE, agent_schema.THIRD_PARTY_VERIFIER_TYPE_UNKNOWN);
        } else if peek_is(s, t, p.current, "independence".as_slice()) {
