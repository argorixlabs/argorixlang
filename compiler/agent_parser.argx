    p = default_string(p, node, agent_schema.SPEC_FREEZE_DECL_LEGAL_CLAIMS, fallback);
    p = default_string(p, node, agent_schema.SPEC_FREEZE_DECL_CERTIFICATION, fallback);
    block_end(t, p, node)
