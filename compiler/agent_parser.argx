// `parse_public_conformance_claims`.
fn parse_public_conformance_claims(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = expect_symbol(t, parser, agent_lexer.LEFT_BRACKET, "`[`".as_slice());
    if p.failed { return p; }
    p = agent_ast.array(p);
    let values: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACKET {
        p = ensure_not_eof(t, p, "unterminated public_conformance_report claims array".as_slice());
        if p.failed { return p; }
        p = parse_public_conformance_claim(s, t, p);
        if p.failed { return p; }
        let value: u64 = p.result;
        p = agent_ast.push(p, values, value);
        if peek_kind(t, p.current) == agent_lexer.COMMA {
            p = advance(t, p);
        }
    }
    p = advance(t, p);
    p.result = values;
    p
}

// A key whose value `parse_public_conformance_claims` reads.
fn field_parse_public_conformance_claims(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree, node: u64, field: u64, block: Slice<u8>) -> Tree {
    let mut p: Tree = field_start(s, t, parser, node, field, block);
    if p.failed { return p; }
    p = parse_public_conformance_claims(s, t, p);
    if p.failed { return p; }
    agent_ast.set_last(p, node, field)
}

// `parse_public_conformance_claim`.
fn parse_public_conformance_claim(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let open: u64 = parser.current;
    let mut p: Tree = expect_symbol(t, parser, agent_lexer.LEFT_BRACE, "`{`".as_slice());
    if p.failed { return p; }
    p = agent_ast.object(p, agent_schema.PUBLIC_CONFORMANCE_CLAIM_DECL);
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
