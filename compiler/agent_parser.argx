        } else if peek_is(s, t, p.current, "key_material".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.REGULATORY_MAPPING_DECL_KEY_MATERIAL, "regulatory_mapping".as_slice(), "regulatory_mapping key_material".as_slice(), agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_words.T_PARSE_BRIDGE_MATERIAL__A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN);
