fn parse_release_candidate(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "release_candidate".as_slice(), "release_candidate name".as_slice(), agent_schema.RELEASE_CANDIDATE_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated release_candidate declaration".as_slice());
        if p.failed { return p; }
        if peek_is(s, t, p.current, "compatibility_matrix".as_slice()) {
            p = field_object_list(s, t, p, node, agent_schema.RELEASE_CANDIDATE_DECL_COMPATIBILITY_MATRIX, "release_candidate".as_slice(), "compatibility matrix entry".as_slice(), agent_schema.COMPATIBILITY_MATRIX_ENTRY_DECL, "+version -bytecode -evidence -conformance".as_slice());
        } else if peek_is(s, t, p.current, "notes".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.RELEASE_CANDIDATE_DECL_NOTES, "release_candidate".as_slice(), "release_candidate notes".as_slice());
        } else if peek_is(s, t, p.current, "required_artifacts".as_slice()) {
