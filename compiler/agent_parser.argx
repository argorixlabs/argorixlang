        } else if peek_is(s, t, p.current, "verification".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_VERIFICATION, "atrust_credential_contract".as_slice(), "atrust_credential_contract verification".as_slice(), agent_schema.A_TRUST_CREDENTIAL_VERIFICATION, agent_words.T_PARSE_ATRUST_CREDENTIAL_CONTRACT__A_TRUST_CREDENTIAL_VERIFICATION, agent_schema.A_TRUST_CREDENTIAL_VERIFICATION_UNKNOWN);
        } else if peek_is(s, t, p.current, "presentation".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_PRESENTATION, "atrust_credential_contract".as_slice(), "atrust_credential_contract presentation".as_slice(), agent_schema.A_TRUST_CREDENTIAL_PRESENTATION, agent_words.T_PARSE_ATRUST_CREDENTIAL_CONTRACT__A_TRUST_CREDENTIAL_PRESENTATION, agent_schema.A_TRUST_CREDENTIAL_PRESENTATION_UNKNOWN);
        } else if peek_is(s, t, p.current, "resolution".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_RESOLUTION, "atrust_credential_contract".as_slice(), "atrust_credential_contract resolution".as_slice(), agent_schema.A_TRUST_RESOLUTION_MODE, agent_words.T_PARSE_ATRUST_CREDENTIAL_CONTRACT__A_TRUST_RESOLUTION_MODE, agent_schema.A_TRUST_RESOLUTION_MODE_UNKNOWN);
        } else if peek_is(s, t, p.current, "key_material".as_slice()) {
