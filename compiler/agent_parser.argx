        } else if peek_is(s, t, p.current, "handshake".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.A2_A_BRIDGE_CONTRACT_DECL_HANDSHAKE, "a2a_bridge_contract".as_slice(), "a2a_bridge_contract handshake reference".as_slice());
        } else if peek_is(s, t, p.current, "trust_ledger".as_slice()) {
