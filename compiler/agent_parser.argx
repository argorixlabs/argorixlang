        } else if peek_is(s, t, p.current, "secret_material".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_SECRET_MATERIAL, "atrust_credential_contract".as_slice(), "atrust_credential_contract secret_material".as_slice(), agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_words.T_PARSE_ATRUST_CREDENTIAL_CONTRACT__A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN);
        } else if peek_is(s, t, p.current, "execution".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_EXECUTION, "atrust_credential_contract".as_slice(), "atrust_credential_contract execution".as_slice(), agent_schema.A_TRUST_EXECUTION, agent_words.T_PARSE_ATRUST_CREDENTIAL_CONTRACT__A_TRUST_EXECUTION, agent_schema.A_TRUST_EXECUTION_UNKNOWN);
        } else if peek_is(s, t, p.current, "evidence".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_EVIDENCE, "atrust_credential_contract".as_slice(), "atrust_credential_contract evidence".as_slice(), agent_schema.A_TRUST_EVIDENCE_REQUIREMENT, agent_words.T_PARSE_ATRUST_CREDENTIAL_CONTRACT__A_TRUST_EVIDENCE_REQUIREMENT, agent_schema.A_TRUST_EVIDENCE_REQUIREMENT_UNKNOWN);
        } else if peek_is(s, t, p.current, "security_claims".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_SECURITY_CLAIMS, "atrust_credential_contract".as_slice(), "atrust_credential_contract security_claims".as_slice(), agent_schema.A_TRUST_SECURITY_CLAIMS, agent_words.T_PARSE_ATRUST_CREDENTIAL_CONTRACT__A_TRUST_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS_UNKNOWN);
        } else if peek_is(s, t, p.current, "claims".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_CLAIMS, "atrust_credential_contract".as_slice(), "atrust_credential_contract claims".as_slice());
        } else if peek_is(s, t, p.current, "purpose".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_PURPOSE, "atrust_credential_contract".as_slice(), "atrust_credential_contract purpose".as_slice());
        } else if peek_is(s, t, p.current, "notes".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_NOTES, "atrust_credential_contract".as_slice(), "atrust_credential_contract notes".as_slice());
        } else {
            return block_unexpected(s, t, p, "atrust_credential_contract".as_slice(), "an".as_slice());
        }
        if p.failed { return p; }
    }
    let fallback: u64 = name_span(p.slots.as_slice(), p.nodes.as_slice(), node);
    p = default_string(p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_SUBJECT, fallback);
    p = default_string(p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_IDENTITY, fallback);
    p = default_string(p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_BOUNDARY, fallback);
    p = default_string(p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_METHOD, fallback);
    p = default_string(p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_ISSUER_DID, fallback);
    p = default_string(p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_HOLDER_DID, fallback);
    p = default_string(p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_CREDENTIAL_TYPE, fallback);
    p = default_string(p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_SCHEMA, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_STATUS, agent_schema.A_TRUST_CREDENTIAL_STATUS, agent_schema.A_TRUST_CREDENTIAL_STATUS_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_VERIFICATION, agent_schema.A_TRUST_CREDENTIAL_VERIFICATION, agent_schema.A_TRUST_CREDENTIAL_VERIFICATION_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_PRESENTATION, agent_schema.A_TRUST_CREDENTIAL_PRESENTATION, agent_schema.A_TRUST_CREDENTIAL_PRESENTATION_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_RESOLUTION, agent_schema.A_TRUST_RESOLUTION_MODE, agent_schema.A_TRUST_RESOLUTION_MODE_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_KEY_MATERIAL, agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_SECRET_MATERIAL, agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_EXECUTION, agent_schema.A_TRUST_EXECUTION, agent_schema.A_TRUST_EXECUTION_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_EVIDENCE, agent_schema.A_TRUST_EVIDENCE_REQUIREMENT, agent_schema.A_TRUST_EVIDENCE_REQUIREMENT_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS_UNKNOWN, fallback);
    p = default_array(p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_CLAIMS);
    p = default_array(p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_PURPOSE);
    block_end(t, p, node)
}

// `parse_atrust_handshake`.
fn parse_atrust_handshake(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "atrust_handshake".as_slice(), "atrust handshake name".as_slice(), agent_schema.A_TRUST_HANDSHAKE_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated atrust_handshake declaration".as_slice());
        if p.failed { return p; }
        if peek_is(s, t, p.current, "initiator".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_INITIATOR, "atrust_handshake".as_slice(), "atrust_handshake initiator agent".as_slice());
        } else if peek_is(s, t, p.current, "responder".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_RESPONDER, "atrust_handshake".as_slice(), "atrust_handshake responder agent".as_slice());
        } else if peek_is(s, t, p.current, "initiator_identity".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_INITIATOR_IDENTITY, "atrust_handshake".as_slice(), "atrust_handshake initiator_identity reference".as_slice());
        } else if peek_is(s, t, p.current, "responder_identity".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_RESPONDER_IDENTITY, "atrust_handshake".as_slice(), "atrust_handshake responder_identity reference".as_slice());
        } else if peek_is(s, t, p.current, "credential_contracts".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_CREDENTIAL_CONTRACTS, "atrust_handshake".as_slice(), "atrust_handshake credential_contracts".as_slice());
        } else if peek_is(s, t, p.current, "boundary".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_BOUNDARY, "atrust_handshake".as_slice(), "atrust_handshake atrust_boundary reference".as_slice());
        } else if peek_is(s, t, p.current, "method".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_METHOD, "atrust_handshake".as_slice(), "atrust_handshake did_method reference".as_slice());
        } else if peek_is(s, t, p.current, "mode".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_MODE, "atrust_handshake".as_slice(), "atrust_handshake mode".as_slice(), agent_schema.A_TRUST_HANDSHAKE_DRY_RUN_MODE, agent_words.T_PARSE_ATRUST_HANDSHAKE__A_TRUST_HANDSHAKE_DRY_RUN_MODE, agent_schema.A_TRUST_HANDSHAKE_DRY_RUN_MODE_UNKNOWN);
        } else if peek_is(s, t, p.current, "direction".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_DIRECTION, "atrust_handshake".as_slice(), "atrust_handshake direction".as_slice(), agent_schema.A_TRUST_HANDSHAKE_DIRECTION, agent_words.T_PARSE_ATRUST_HANDSHAKE__A_TRUST_HANDSHAKE_DIRECTION, agent_schema.A_TRUST_HANDSHAKE_DIRECTION_UNKNOWN);
        } else if peek_is(s, t, p.current, "challenge".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_CHALLENGE, "atrust_handshake".as_slice(), "atrust_handshake challenge".as_slice(), agent_schema.A_TRUST_HANDSHAKE_CHALLENGE, agent_words.T_PARSE_ATRUST_HANDSHAKE__A_TRUST_HANDSHAKE_CHALLENGE, agent_schema.A_TRUST_HANDSHAKE_CHALLENGE_UNKNOWN);
        } else if peek_is(s, t, p.current, "response".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_RESPONSE, "atrust_handshake".as_slice(), "atrust_handshake response".as_slice(), agent_schema.A_TRUST_HANDSHAKE_RESPONSE, agent_words.T_PARSE_ATRUST_HANDSHAKE__A_TRUST_HANDSHAKE_RESPONSE, agent_schema.A_TRUST_HANDSHAKE_RESPONSE_UNKNOWN);
        } else if peek_is(s, t, p.current, "transcript".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_TRANSCRIPT, "atrust_handshake".as_slice(), "atrust_handshake transcript".as_slice(), agent_schema.A_TRUST_HANDSHAKE_TRANSCRIPT, agent_words.T_PARSE_ATRUST_HANDSHAKE__A_TRUST_HANDSHAKE_TRANSCRIPT, agent_schema.A_TRUST_HANDSHAKE_TRANSCRIPT_UNKNOWN);
        } else if peek_is(s, t, p.current, "verification".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_VERIFICATION, "atrust_handshake".as_slice(), "atrust_handshake verification".as_slice(), agent_schema.A_TRUST_HANDSHAKE_VERIFICATION, agent_words.T_PARSE_ATRUST_HANDSHAKE__A_TRUST_HANDSHAKE_VERIFICATION, agent_schema.A_TRUST_HANDSHAKE_VERIFICATION_UNKNOWN);
        } else if peek_is(s, t, p.current, "resolution".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_RESOLUTION, "atrust_handshake".as_slice(), "atrust_handshake resolution".as_slice(), agent_schema.A_TRUST_RESOLUTION_MODE, agent_words.T_PARSE_ATRUST_HANDSHAKE__A_TRUST_RESOLUTION_MODE, agent_schema.A_TRUST_RESOLUTION_MODE_UNKNOWN);
        } else if peek_is(s, t, p.current, "network".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_NETWORK, "atrust_handshake".as_slice(), "atrust_handshake network".as_slice(), agent_schema.A_TRUST_NETWORK_BOUNDARY, agent_words.T_PARSE_ATRUST_HANDSHAKE__A_TRUST_NETWORK_BOUNDARY, agent_schema.A_TRUST_NETWORK_BOUNDARY_UNKNOWN);
        } else if peek_is(s, t, p.current, "key_material".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_KEY_MATERIAL, "atrust_handshake".as_slice(), "atrust_handshake key_material".as_slice(), agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_words.T_PARSE_ATRUST_HANDSHAKE__A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN);
        } else if peek_is(s, t, p.current, "secret_material".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_SECRET_MATERIAL, "atrust_handshake".as_slice(), "atrust_handshake secret_material".as_slice(), agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_words.T_PARSE_ATRUST_HANDSHAKE__A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN);
        } else if peek_is(s, t, p.current, "execution".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_EXECUTION, "atrust_handshake".as_slice(), "atrust_handshake execution".as_slice(), agent_schema.A_TRUST_EXECUTION, agent_words.T_PARSE_ATRUST_HANDSHAKE__A_TRUST_EXECUTION, agent_schema.A_TRUST_EXECUTION_UNKNOWN);
        } else if peek_is(s, t, p.current, "evidence".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_EVIDENCE, "atrust_handshake".as_slice(), "atrust_handshake evidence".as_slice(), agent_schema.A_TRUST_EVIDENCE_REQUIREMENT, agent_words.T_PARSE_ATRUST_HANDSHAKE__A_TRUST_EVIDENCE_REQUIREMENT, agent_schema.A_TRUST_EVIDENCE_REQUIREMENT_UNKNOWN);
        } else if peek_is(s, t, p.current, "security_claims".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_SECURITY_CLAIMS, "atrust_handshake".as_slice(), "atrust_handshake security_claims".as_slice(), agent_schema.A_TRUST_SECURITY_CLAIMS, agent_words.T_PARSE_ATRUST_HANDSHAKE__A_TRUST_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS_UNKNOWN);
        } else if peek_is(s, t, p.current, "purpose".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_PURPOSE, "atrust_handshake".as_slice(), "atrust_handshake purpose".as_slice());
        } else if peek_is(s, t, p.current, "notes".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_NOTES, "atrust_handshake".as_slice(), "atrust_handshake notes".as_slice());
        } else {
            return block_unexpected(s, t, p, "atrust_handshake".as_slice(), "an".as_slice());
        }
        if p.failed { return p; }
    }
    let fallback: u64 = name_span(p.slots.as_slice(), p.nodes.as_slice(), node);
    p = default_string(p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_INITIATOR, fallback);
    p = default_string(p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_RESPONDER, fallback);
    p = default_string(p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_INITIATOR_IDENTITY, fallback);
    p = default_string(p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_RESPONDER_IDENTITY, fallback);
    p = default_array(p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_CREDENTIAL_CONTRACTS);
    p = default_string(p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_BOUNDARY, fallback);
    p = default_string(p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_METHOD, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_MODE, agent_schema.A_TRUST_HANDSHAKE_DRY_RUN_MODE, agent_schema.A_TRUST_HANDSHAKE_DRY_RUN_MODE_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_DIRECTION, agent_schema.A_TRUST_HANDSHAKE_DIRECTION, agent_schema.A_TRUST_HANDSHAKE_DIRECTION_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_CHALLENGE, agent_schema.A_TRUST_HANDSHAKE_CHALLENGE, agent_schema.A_TRUST_HANDSHAKE_CHALLENGE_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_RESPONSE, agent_schema.A_TRUST_HANDSHAKE_RESPONSE, agent_schema.A_TRUST_HANDSHAKE_RESPONSE_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_TRANSCRIPT, agent_schema.A_TRUST_HANDSHAKE_TRANSCRIPT, agent_schema.A_TRUST_HANDSHAKE_TRANSCRIPT_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_VERIFICATION, agent_schema.A_TRUST_HANDSHAKE_VERIFICATION, agent_schema.A_TRUST_HANDSHAKE_VERIFICATION_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_RESOLUTION, agent_schema.A_TRUST_RESOLUTION_MODE, agent_schema.A_TRUST_RESOLUTION_MODE_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_NETWORK, agent_schema.A_TRUST_NETWORK_BOUNDARY, agent_schema.A_TRUST_NETWORK_BOUNDARY_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_KEY_MATERIAL, agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_SECRET_MATERIAL, agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_EXECUTION, agent_schema.A_TRUST_EXECUTION, agent_schema.A_TRUST_EXECUTION_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_EVIDENCE, agent_schema.A_TRUST_EVIDENCE_REQUIREMENT, agent_schema.A_TRUST_EVIDENCE_REQUIREMENT_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS_UNKNOWN, fallback);
    p = default_array(p, node, agent_schema.A_TRUST_HANDSHAKE_DECL_PURPOSE);
    block_end(t, p, node)
}

// `parse_trust_ledger`.
fn parse_trust_ledger(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "trust_ledger".as_slice(), "trust ledger name".as_slice(), agent_schema.TRUST_LEDGER_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated trust_ledger declaration".as_slice());
        if p.failed { return p; }
        if peek_is(s, t, p.current, "scope".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.TRUST_LEDGER_DECL_SCOPE, "trust_ledger".as_slice(), "trust_ledger scope".as_slice(), agent_schema.TRUST_LEDGER_SCOPE, agent_words.T_PARSE_TRUST_LEDGER__TRUST_LEDGER_SCOPE, agent_schema.TRUST_LEDGER_SCOPE_UNKNOWN);
        } else if peek_is(s, t, p.current, "mode".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.TRUST_LEDGER_DECL_MODE, "trust_ledger".as_slice(), "trust_ledger mode".as_slice(), agent_schema.TRUST_LEDGER_MODE, agent_words.T_PARSE_TRUST_LEDGER__TRUST_LEDGER_MODE, agent_schema.TRUST_LEDGER_MODE_UNKNOWN);
        } else if peek_is(s, t, p.current, "hash_algorithm".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.TRUST_LEDGER_DECL_HASH_ALGORITHM, "trust_ledger".as_slice(), "trust_ledger hash_algorithm reference".as_slice());
        } else if peek_is(s, t, p.current, "chain_policy".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.TRUST_LEDGER_DECL_CHAIN_POLICY, "trust_ledger".as_slice(), "trust_ledger chain_policy".as_slice(), agent_schema.TRUST_LEDGER_CHAIN_POLICY, agent_words.T_PARSE_TRUST_LEDGER__TRUST_LEDGER_CHAIN_POLICY, agent_schema.TRUST_LEDGER_CHAIN_POLICY_UNKNOWN);
        } else if peek_is(s, t, p.current, "entries".as_slice()) {
            p = field_parse_trust_ledger_entries(s, t, p, node, agent_schema.TRUST_LEDGER_DECL_ENTRIES, "trust_ledger".as_slice());
        } else if peek_is(s, t, p.current, "chain_root".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.TRUST_LEDGER_DECL_CHAIN_ROOT, "trust_ledger".as_slice(), "trust_ledger chain_root".as_slice());
        } else if peek_is(s, t, p.current, "network".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.TRUST_LEDGER_DECL_NETWORK, "trust_ledger".as_slice(), "trust_ledger network".as_slice(), agent_schema.A_TRUST_NETWORK_BOUNDARY, agent_words.T_PARSE_TRUST_LEDGER__A_TRUST_NETWORK_BOUNDARY, agent_schema.A_TRUST_NETWORK_BOUNDARY_UNKNOWN);
        } else if peek_is(s, t, p.current, "key_material".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.TRUST_LEDGER_DECL_KEY_MATERIAL, "trust_ledger".as_slice(), "trust_ledger key_material".as_slice(), agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_words.T_PARSE_TRUST_LEDGER__A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN);
        } else if peek_is(s, t, p.current, "secret_material".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.TRUST_LEDGER_DECL_SECRET_MATERIAL, "trust_ledger".as_slice(), "trust_ledger secret_material".as_slice(), agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_words.T_PARSE_TRUST_LEDGER__A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN);
        } else if peek_is(s, t, p.current, "execution".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.TRUST_LEDGER_DECL_EXECUTION, "trust_ledger".as_slice(), "trust_ledger execution".as_slice(), agent_schema.A_TRUST_EXECUTION, agent_words.T_PARSE_TRUST_LEDGER__A_TRUST_EXECUTION, agent_schema.A_TRUST_EXECUTION_UNKNOWN);
        } else if peek_is(s, t, p.current, "evidence".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.TRUST_LEDGER_DECL_EVIDENCE, "trust_ledger".as_slice(), "trust_ledger evidence".as_slice(), agent_schema.A_TRUST_EVIDENCE_REQUIREMENT, agent_words.T_PARSE_TRUST_LEDGER__A_TRUST_EVIDENCE_REQUIREMENT, agent_schema.A_TRUST_EVIDENCE_REQUIREMENT_UNKNOWN);
        } else if peek_is(s, t, p.current, "security_claims".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.TRUST_LEDGER_DECL_SECURITY_CLAIMS, "trust_ledger".as_slice(), "trust_ledger security_claims".as_slice(), agent_schema.A_TRUST_SECURITY_CLAIMS, agent_words.T_PARSE_TRUST_LEDGER__A_TRUST_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS_UNKNOWN);
        } else if peek_is(s, t, p.current, "purpose".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.TRUST_LEDGER_DECL_PURPOSE, "trust_ledger".as_slice(), "trust_ledger purpose".as_slice());
        } else if peek_is(s, t, p.current, "notes".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.TRUST_LEDGER_DECL_NOTES, "trust_ledger".as_slice(), "trust_ledger notes".as_slice());
        } else {
            return block_unexpected(s, t, p, "trust_ledger".as_slice(), "a".as_slice());
        }
        if p.failed { return p; }
    }
    let fallback: u64 = name_span(p.slots.as_slice(), p.nodes.as_slice(), node);
    p = default_unknown(p, node, agent_schema.TRUST_LEDGER_DECL_SCOPE, agent_schema.TRUST_LEDGER_SCOPE, agent_schema.TRUST_LEDGER_SCOPE_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.TRUST_LEDGER_DECL_MODE, agent_schema.TRUST_LEDGER_MODE, agent_schema.TRUST_LEDGER_MODE_UNKNOWN, fallback);
    p = default_string(p, node, agent_schema.TRUST_LEDGER_DECL_HASH_ALGORITHM, fallback);
    p = default_unknown(p, node, agent_schema.TRUST_LEDGER_DECL_CHAIN_POLICY, agent_schema.TRUST_LEDGER_CHAIN_POLICY, agent_schema.TRUST_LEDGER_CHAIN_POLICY_UNKNOWN, fallback);
    p = default_array(p, node, agent_schema.TRUST_LEDGER_DECL_ENTRIES);
    p = default_string(p, node, agent_schema.TRUST_LEDGER_DECL_CHAIN_ROOT, fallback);
    p = default_unknown(p, node, agent_schema.TRUST_LEDGER_DECL_NETWORK, agent_schema.A_TRUST_NETWORK_BOUNDARY, agent_schema.A_TRUST_NETWORK_BOUNDARY_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.TRUST_LEDGER_DECL_KEY_MATERIAL, agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.TRUST_LEDGER_DECL_SECRET_MATERIAL, agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.TRUST_LEDGER_DECL_EXECUTION, agent_schema.A_TRUST_EXECUTION, agent_schema.A_TRUST_EXECUTION_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.TRUST_LEDGER_DECL_EVIDENCE, agent_schema.A_TRUST_EVIDENCE_REQUIREMENT, agent_schema.A_TRUST_EVIDENCE_REQUIREMENT_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.TRUST_LEDGER_DECL_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS_UNKNOWN, fallback);
    p = default_array(p, node, agent_schema.TRUST_LEDGER_DECL_PURPOSE);
    block_end(t, p, node)
}

// `parse_trust_ledger_entries`.
fn parse_trust_ledger_entries(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = expect_symbol(t, parser, agent_lexer.LEFT_BRACKET, "`[`".as_slice());
    if p.failed { return p; }
    p = agent_ast.array(p);
    let values: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACKET {
        p = ensure_not_eof(t, p, "unterminated trust_ledger entries array".as_slice());
        if p.failed { return p; }
        p = parse_trust_ledger_entry(s, t, p);
        if p.failed { return p; }
        let value: u64 = p.result;
        p = agent_ast.push(p, values, value);
        if peek_kind(t, p.current) == agent_lexer.COMMA {
            p = advance(t, p);
        }
    }
    p = advance(t, p);
    p.result = values;
    p
}

// A key whose value `parse_trust_ledger_entries` reads.
fn field_parse_trust_ledger_entries(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree, node: u64, field: u64, block: Slice<u8>) -> Tree {
    let mut p: Tree = field_start(s, t, parser, node, field, block);
    if p.failed { return p; }
    p = parse_trust_ledger_entries(s, t, p);
    if p.failed { return p; }
    agent_ast.set_last(p, node, field)
}

// `parse_trust_ledger_entry`.
fn parse_trust_ledger_entry(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let open: u64 = parser.current;
    let mut p: Tree = expect_symbol(t, parser, agent_lexer.LEFT_BRACE, "`{`".as_slice());
    if p.failed { return p; }
    p = agent_ast.object(p, agent_schema.TRUST_LEDGER_ENTRY_DECL);
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated trust_ledger entry".as_slice());
        if p.failed { return p; }
        if peek_is(s, t, p.current, "id".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.TRUST_LEDGER_ENTRY_DECL_ID, "trust_ledger entry".as_slice(), "trust_ledger entry id".as_slice());
        } else if peek_is(s, t, p.current, "kind".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.TRUST_LEDGER_ENTRY_DECL_KIND, "trust_ledger entry".as_slice(), "trust_ledger entry kind".as_slice(), agent_schema.TRUST_LEDGER_ENTRY_KIND, agent_words.T_PARSE_TRUST_LEDGER_ENTRY__TRUST_LEDGER_ENTRY_KIND, agent_schema.TRUST_LEDGER_ENTRY_KIND_UNKNOWN);
        } else if peek_is(s, t, p.current, "subject".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.TRUST_LEDGER_ENTRY_DECL_SUBJECT, "trust_ledger entry".as_slice(), "trust_ledger entry subject".as_slice());
        } else if peek_is(s, t, p.current, "previous_hash".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.TRUST_LEDGER_ENTRY_DECL_PREVIOUS_HASH, "trust_ledger entry".as_slice(), "trust_ledger entry previous_hash".as_slice());
        } else if peek_is(s, t, p.current, "entry_hash".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.TRUST_LEDGER_ENTRY_DECL_ENTRY_HASH, "trust_ledger entry".as_slice(), "trust_ledger entry entry_hash".as_slice());
        } else if peek_is(s, t, p.current, "evidence_ref".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.TRUST_LEDGER_ENTRY_DECL_EVIDENCE_REF, "trust_ledger entry".as_slice(), "trust_ledger entry evidence_ref".as_slice());
        } else {
            return block_unexpected(s, t, p, "trust_ledger entry".as_slice(), "a".as_slice());
        }
        if p.failed { return p; }
    }
    p = span_of(t, p, open);
    let fallback: u64 = p.result;
    p = default_string(p, node, agent_schema.TRUST_LEDGER_ENTRY_DECL_ID, fallback);
    p = default_unknown(p, node, agent_schema.TRUST_LEDGER_ENTRY_DECL_KIND, agent_schema.TRUST_LEDGER_ENTRY_KIND, agent_schema.TRUST_LEDGER_ENTRY_KIND_UNKNOWN, fallback);
    p = default_string(p, node, agent_schema.TRUST_LEDGER_ENTRY_DECL_SUBJECT, fallback);
    p = default_string(p, node, agent_schema.TRUST_LEDGER_ENTRY_DECL_PREVIOUS_HASH, fallback);
    p = default_string(p, node, agent_schema.TRUST_LEDGER_ENTRY_DECL_ENTRY_HASH, fallback);
    p = default_string(p, node, agent_schema.TRUST_LEDGER_ENTRY_DECL_EVIDENCE_REF, fallback);
    block_end(t, p, node)
}

// `parse_mcp_bridge_contract`.
fn parse_mcp_bridge_contract(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract name".as_slice(), agent_schema.MCP_BRIDGE_CONTRACT_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated mcp_bridge_contract declaration".as_slice());
        if p.failed { return p; }
        if peek_is(s, t, p.current, "agent".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_AGENT, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract agent reference".as_slice());
        } else if peek_is(s, t, p.current, "passport".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_PASSPORT, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract passport reference".as_slice());
        } else if peek_is(s, t, p.current, "identity".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_IDENTITY, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract identity reference".as_slice());
        } else if peek_is(s, t, p.current, "boundary".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_BOUNDARY, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract boundary reference".as_slice());
        } else if peek_is(s, t, p.current, "transport".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_TRANSPORT, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract transport".as_slice(), agent_schema.BRIDGE_TRANSPORT, agent_words.T_PARSE_MCP_BRIDGE_CONTRACT__BRIDGE_TRANSPORT, agent_schema.BRIDGE_TRANSPORT_UNKNOWN);
        } else if peek_is(s, t, p.current, "protocol".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_PROTOCOL, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract protocol".as_slice(), agent_schema.MCP_PROTOCOL, agent_words.T_PARSE_MCP_BRIDGE_CONTRACT__MCP_PROTOCOL, agent_schema.MCP_PROTOCOL_UNKNOWN);
        } else if peek_is(s, t, p.current, "direction".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_DIRECTION, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract direction".as_slice(), agent_schema.BRIDGE_DIRECTION, agent_words.T_PARSE_BRIDGE_DIRECTION__BRIDGE_DIRECTION, agent_schema.BRIDGE_DIRECTION_UNKNOWN);
        } else if peek_is(s, t, p.current, "tools".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_TOOLS, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract tools".as_slice());
        } else if peek_is(s, t, p.current, "resources".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_RESOURCES, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract resources".as_slice());
        } else if peek_is(s, t, p.current, "prompts".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_PROMPTS, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract prompts".as_slice());
        } else if peek_is(s, t, p.current, "network".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_NETWORK, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract network".as_slice(), agent_schema.A_TRUST_NETWORK_BOUNDARY, agent_words.T_PARSE_MCP_BRIDGE_CONTRACT__A_TRUST_NETWORK_BOUNDARY, agent_schema.A_TRUST_NETWORK_BOUNDARY_UNKNOWN);
        } else if peek_is(s, t, p.current, "external_execution".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_EXTERNAL_EXECUTION, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract external_execution".as_slice(), agent_schema.A_TRUST_EXECUTION, agent_words.T_PARSE_BRIDGE_EXECUTION__A_TRUST_EXECUTION, agent_schema.A_TRUST_EXECUTION_UNKNOWN);
        } else if peek_is(s, t, p.current, "tool_execution".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_TOOL_EXECUTION, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract tool_execution".as_slice(), agent_schema.A_TRUST_EXECUTION, agent_words.T_PARSE_BRIDGE_EXECUTION__A_TRUST_EXECUTION, agent_schema.A_TRUST_EXECUTION_UNKNOWN);
        } else if peek_is(s, t, p.current, "secret_material".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_SECRET_MATERIAL, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract secret_material".as_slice(), agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_words.T_PARSE_BRIDGE_MATERIAL__A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN);
        } else if peek_is(s, t, p.current, "key_material".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_KEY_MATERIAL, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract key_material".as_slice(), agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_words.T_PARSE_BRIDGE_MATERIAL__A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN);
        } else if peek_is(s, t, p.current, "authentication".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_AUTHENTICATION, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract authentication".as_slice(), agent_schema.BRIDGE_AUTHENTICATION, agent_words.T_PARSE_BRIDGE_AUTHENTICATION__BRIDGE_AUTHENTICATION, agent_schema.BRIDGE_AUTHENTICATION_UNKNOWN);
        } else if peek_is(s, t, p.current, "authorization".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_AUTHORIZATION, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract authorization".as_slice(), agent_schema.BRIDGE_AUTHORIZATION, agent_words.T_PARSE_BRIDGE_AUTHORIZATION__BRIDGE_AUTHORIZATION, agent_schema.BRIDGE_AUTHORIZATION_UNKNOWN);
        } else if peek_is(s, t, p.current, "evidence".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_EVIDENCE, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract evidence".as_slice(), agent_schema.A_TRUST_EVIDENCE_REQUIREMENT, agent_words.T_PARSE_MCP_BRIDGE_CONTRACT__A_TRUST_EVIDENCE_REQUIREMENT, agent_schema.A_TRUST_EVIDENCE_REQUIREMENT_UNKNOWN);
        } else if peek_is(s, t, p.current, "security_claims".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_SECURITY_CLAIMS, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract security_claims".as_slice(), agent_schema.A_TRUST_SECURITY_CLAIMS, agent_words.T_PARSE_MCP_BRIDGE_CONTRACT__A_TRUST_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS_UNKNOWN);
        } else if peek_is(s, t, p.current, "purpose".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_PURPOSE, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract purpose".as_slice());
        } else if peek_is(s, t, p.current, "notes".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_NOTES, "mcp_bridge_contract".as_slice(), "mcp_bridge_contract notes".as_slice());
        } else {
            return block_unexpected(s, t, p, "mcp_bridge_contract".as_slice(), "an".as_slice());
        }
        if p.failed { return p; }
    }
    let fallback: u64 = name_span(p.slots.as_slice(), p.nodes.as_slice(), node);
    p = default_string(p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_AGENT, fallback);
    p = default_string(p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_PASSPORT, fallback);
    p = default_string(p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_IDENTITY, fallback);
    p = default_string(p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_BOUNDARY, fallback);
    p = default_unknown(p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_TRANSPORT, agent_schema.BRIDGE_TRANSPORT, agent_schema.BRIDGE_TRANSPORT_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_PROTOCOL, agent_schema.MCP_PROTOCOL, agent_schema.MCP_PROTOCOL_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_DIRECTION, agent_schema.BRIDGE_DIRECTION, agent_schema.BRIDGE_DIRECTION_UNKNOWN, fallback);
    p = default_array(p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_TOOLS);
    p = default_array(p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_RESOURCES);
    p = default_array(p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_PROMPTS);
    p = default_unknown(p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_NETWORK, agent_schema.A_TRUST_NETWORK_BOUNDARY, agent_schema.A_TRUST_NETWORK_BOUNDARY_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_EXTERNAL_EXECUTION, agent_schema.A_TRUST_EXECUTION, agent_schema.A_TRUST_EXECUTION_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_TOOL_EXECUTION, agent_schema.A_TRUST_EXECUTION, agent_schema.A_TRUST_EXECUTION_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_SECRET_MATERIAL, agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_KEY_MATERIAL, agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_AUTHENTICATION, agent_schema.BRIDGE_AUTHENTICATION, agent_schema.BRIDGE_AUTHENTICATION_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_AUTHORIZATION, agent_schema.BRIDGE_AUTHORIZATION, agent_schema.BRIDGE_AUTHORIZATION_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_EVIDENCE, agent_schema.A_TRUST_EVIDENCE_REQUIREMENT, agent_schema.A_TRUST_EVIDENCE_REQUIREMENT_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS_UNKNOWN, fallback);
    p = default_array(p, node, agent_schema.MCP_BRIDGE_CONTRACT_DECL_PURPOSE);
    block_end(t, p, node)
}

// `parse_a2a_bridge_contract`.
fn parse_a2a_bridge_contract(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "a2a_bridge_contract".as_slice(), "a2a_bridge_contract name".as_slice(), agent_schema.A2_A_BRIDGE_CONTRACT_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated a2a_bridge_contract declaration".as_slice());
        if p.failed { return p; }
        if peek_is(s, t, p.current, "initiator".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.A2_A_BRIDGE_CONTRACT_DECL_INITIATOR, "a2a_bridge_contract".as_slice(), "a2a_bridge_contract initiator reference".as_slice());
