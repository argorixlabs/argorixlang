    p = default_unknown(p, node, agent_schema.GOVERNANCE_PROFILE_DECL_EXECUTION, agent_schema.A_TRUST_EXECUTION, agent_schema.A_TRUST_EXECUTION_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.GOVERNANCE_PROFILE_DECL_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS_UNKNOWN, fallback);
    p = default_array(p, node, agent_schema.GOVERNANCE_PROFILE_DECL_PURPOSE);
    block_end(t, p, node)
}

// `parse_governance_controls`.
fn parse_governance_controls(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = expect_symbol(t, parser, agent_lexer.LEFT_BRACKET, "`[`".as_slice());
    if p.failed { return p; }
    p = agent_ast.array(p);
    let values: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACKET {
        p = ensure_not_eof(t, p, "unterminated governance_profile controls array".as_slice());
        if p.failed { return p; }
        p = parse_governance_control(s, t, p);
        if p.failed { return p; }
        let value: u64 = p.result;
        p = agent_ast.push(p, values, value);
        if peek_kind(t, p.current) == agent_lexer.COMMA {
            p = advance(t, p);
        }
    }
    p = advance(t, p);
    p.result = values;
    p
}

// A key whose value `parse_governance_controls` reads.
fn field_parse_governance_controls(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree, node: u64, field: u64, block: Slice<u8>) -> Tree {
    let mut p: Tree = field_start(s, t, parser, node, field, block);
    if p.failed { return p; }
    p = parse_governance_controls(s, t, p);
    if p.failed { return p; }
    agent_ast.set_last(p, node, field)
}

// `parse_governance_control`.
fn parse_governance_control(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let open: u64 = parser.current;
    let mut p: Tree = expect_symbol(t, parser, agent_lexer.LEFT_BRACE, "`{`".as_slice());
    if p.failed { return p; }
    p = agent_ast.object(p, agent_schema.GOVERNANCE_CONTROL_DECL);
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated governance control".as_slice());
        if p.failed { return p; }
        if peek_is(s, t, p.current, "id".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.GOVERNANCE_CONTROL_DECL_ID, "governance control".as_slice(), "governance control id".as_slice());
        } else if peek_is(s, t, p.current, "category".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.GOVERNANCE_CONTROL_DECL_CATEGORY, "governance control".as_slice(), "governance control category".as_slice(), agent_schema.GOVERNANCE_CONTROL_CATEGORY, agent_words.T_PARSE_GOVERNANCE_CONTROL_CATEGORY__GOVERNANCE_CONTROL_CATEGORY, agent_schema.GOVERNANCE_CONTROL_CATEGORY_UNKNOWN);
        } else if peek_is(s, t, p.current, "requirement".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.GOVERNANCE_CONTROL_DECL_REQUIREMENT, "governance control".as_slice(), "governance control requirement".as_slice());
        } else if peek_is(s, t, p.current, "evidence_ref".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.GOVERNANCE_CONTROL_DECL_EVIDENCE_REF, "governance control".as_slice(), "governance control evidence_ref".as_slice());
        } else if peek_is(s, t, p.current, "status".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.GOVERNANCE_CONTROL_DECL_STATUS, "governance control".as_slice(), "governance control status".as_slice(), agent_schema.GOVERNANCE_CONTROL_STATUS, agent_words.T_PARSE_GOVERNANCE_CONTROL_STATUS__GOVERNANCE_CONTROL_STATUS, agent_schema.GOVERNANCE_CONTROL_STATUS_UNKNOWN);
        } else {
            return block_unexpected(s, t, p, "governance control".as_slice(), "".as_slice());
        }
        if p.failed { return p; }
    }
    p = span_of(t, p, open);
    let fallback: u64 = p.result;
    p = default_string(p, node, agent_schema.GOVERNANCE_CONTROL_DECL_ID, fallback);
    p = default_unknown(p, node, agent_schema.GOVERNANCE_CONTROL_DECL_CATEGORY, agent_schema.GOVERNANCE_CONTROL_CATEGORY, agent_schema.GOVERNANCE_CONTROL_CATEGORY_UNKNOWN, fallback);
    p = default_string(p, node, agent_schema.GOVERNANCE_CONTROL_DECL_REQUIREMENT, fallback);
    p = default_string(p, node, agent_schema.GOVERNANCE_CONTROL_DECL_EVIDENCE_REF, fallback);
    p = default_unknown(p, node, agent_schema.GOVERNANCE_CONTROL_DECL_STATUS, agent_schema.GOVERNANCE_CONTROL_STATUS, agent_schema.GOVERNANCE_CONTROL_STATUS_UNKNOWN, fallback);
    block_end(t, p, node)
}

// `parse_regulatory_mapping`.
fn parse_regulatory_mapping(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "regulatory_mapping".as_slice(), "regulatory_mapping name".as_slice(), agent_schema.REGULATORY_MAPPING_DECL);
