// `parse_governance_profile`.
fn parse_governance_profile(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "governance_profile".as_slice(), "governance_profile name".as_slice(), agent_schema.GOVERNANCE_PROFILE_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated governance_profile declaration".as_slice());
        if p.failed { return p; }
        if peek_is(s, t, p.current, "scope".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.GOVERNANCE_PROFILE_DECL_SCOPE, "governance_profile".as_slice(), "governance_profile scope".as_slice(), agent_schema.GOVERNANCE_SCOPE, agent_words.T_PARSE_GOVERNANCE_SCOPE__GOVERNANCE_SCOPE, agent_schema.GOVERNANCE_SCOPE_UNKNOWN);
        } else if peek_is(s, t, p.current, "level".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.GOVERNANCE_PROFILE_DECL_LEVEL, "governance_profile".as_slice(), "governance_profile level".as_slice(), agent_schema.GOVERNANCE_LEVEL, agent_words.T_PARSE_GOVERNANCE_LEVEL__GOVERNANCE_LEVEL, agent_schema.GOVERNANCE_LEVEL_UNKNOWN);
        } else if peek_is(s, t, p.current, "domain".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.GOVERNANCE_PROFILE_DECL_DOMAIN, "governance_profile".as_slice(), "governance_profile domain".as_slice(), agent_schema.GOVERNANCE_DOMAIN, agent_words.T_PARSE_GOVERNANCE_DOMAIN__GOVERNANCE_DOMAIN, agent_schema.GOVERNANCE_DOMAIN_UNKNOWN);
        } else if peek_is(s, t, p.current, "owner".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.GOVERNANCE_PROFILE_DECL_OWNER, "governance_profile".as_slice(), "governance_profile owner".as_slice());
        } else if peek_is(s, t, p.current, "jurisdiction".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.GOVERNANCE_PROFILE_DECL_JURISDICTION, "governance_profile".as_slice(), "governance_profile jurisdiction".as_slice());
        } else if peek_is(s, t, p.current, "framework".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.GOVERNANCE_PROFILE_DECL_FRAMEWORK, "governance_profile".as_slice(), "governance_profile framework".as_slice());
        } else if peek_is(s, t, p.current, "evidence_map".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.GOVERNANCE_PROFILE_DECL_EVIDENCE_MAP, "governance_profile".as_slice(), "governance_profile evidence_map".as_slice());
        } else if peek_is(s, t, p.current, "trust_ledger".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.GOVERNANCE_PROFILE_DECL_TRUST_LEDGER, "governance_profile".as_slice(), "governance_profile trust_ledger".as_slice());
        } else if peek_is(s, t, p.current, "policies".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.GOVERNANCE_PROFILE_DECL_POLICIES, "governance_profile".as_slice(), "governance_profile policy".as_slice());
        } else if peek_is(s, t, p.current, "controls".as_slice()) {
            p = field_parse_governance_controls(s, t, p, node, agent_schema.GOVERNANCE_PROFILE_DECL_CONTROLS, "governance_profile".as_slice());
        } else if peek_is(s, t, p.current, "risk_level".as_slice()) {
