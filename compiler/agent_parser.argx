        } else if peek_is(s, t, p.current, "evidence_ref".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.PUBLIC_CONFORMANCE_CLAIM_DECL_EVIDENCE_REF, "public conformance claim".as_slice(), "public conformance claim evidence_ref".as_slice());
        } else if peek_is(s, t, p.current, "status".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.PUBLIC_CONFORMANCE_CLAIM_DECL_STATUS, "public conformance claim".as_slice(), "public conformance claim status".as_slice(), agent_schema.PUBLIC_CONFORMANCE_CLAIM_STATUS, agent_words.T_PARSE_PUBLIC_CONFORMANCE_CLAIM_STATUS__PUBLIC_CONFORMANCE_CLAIM_STATUS, agent_schema.PUBLIC_CONFORMANCE_CLAIM_STATUS_UNKNOWN);
        } else {
