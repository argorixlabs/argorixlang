    p = default_array(p, node, agent_schema.RELEASE_CANDIDATE_DECL_KNOWN_LIMITATIONS);
    p = default_array(p, node, agent_schema.RELEASE_CANDIDATE_DECL_PURPOSE);
    p = default_string(p, node, agent_schema.RELEASE_CANDIDATE_DECL_VERSION, fallback);
    p = default_string(p, node, agent_schema.RELEASE_CANDIDATE_DECL_BASE_VERSION, fallback);
    p = default_string(p, node, agent_schema.RELEASE_CANDIDATE_DECL_SPEC_FREEZE, fallback);
    p = default_string(p, node, agent_schema.RELEASE_CANDIDATE_DECL_READINESS, fallback);
    p = default_string(p, node, agent_schema.RELEASE_CANDIDATE_DECL_RUNTIME_STATUS, fallback);
    p = default_string(p, node, agent_schema.RELEASE_CANDIDATE_DECL_NETWORK, fallback);
    p = default_string(p, node, agent_schema.RELEASE_CANDIDATE_DECL_EXTERNAL_EXECUTION, fallback);
    p = default_string(p, node, agent_schema.RELEASE_CANDIDATE_DECL_PROVIDER_EXECUTION, fallback);
    p = default_string(p, node, agent_schema.RELEASE_CANDIDATE_DECL_SECRET_MATERIAL, fallback);
    p = default_string(p, node, agent_schema.RELEASE_CANDIDATE_DECL_KEY_MATERIAL, fallback);
    p = default_string(p, node, agent_schema.RELEASE_CANDIDATE_DECL_ENV_ACCESS, fallback);
    p = default_string(p, node, agent_schema.RELEASE_CANDIDATE_DECL_FILESYSTEM_ACCESS, fallback);
    p = default_string(p, node, agent_schema.RELEASE_CANDIDATE_DECL_TOOL_EXECUTION, fallback);
    p = default_string(p, node, agent_schema.RELEASE_CANDIDATE_DECL_AGENT_EXECUTION, fallback);
    p = default_string(p, node, agent_schema.RELEASE_CANDIDATE_DECL_SECURITY_CLAIMS, fallback);
    p = default_string(p, node, agent_schema.RELEASE_CANDIDATE_DECL_LEGAL_CLAIMS, fallback);
    p = default_string(p, node, agent_schema.RELEASE_CANDIDATE_DECL_CERTIFICATION, fallback);
    block_end(t, p, node)
}

fn parse_runtime_execution_profile(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "runtime_execution_profile".as_slice(), "runtime_execution_profile name".as_slice(), agent_schema.RUNTIME_EXECUTION_PROFILE_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated runtime_execution_profile declaration".as_slice());
        if p.failed { return p; }
        if peek_is(s, t, p.current, "fail_closed".as_slice()) {
            p = field_bool(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_FAIL_CLOSED, "runtime_execution_profile".as_slice(), "runtime_execution_profile fail_closed value".as_slice());
        } else if peek_is(s, t, p.current, "notes".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_NOTES, "runtime_execution_profile".as_slice(), "runtime_execution_profile notes".as_slice());
        } else if peek_is(s, t, p.current, "agents".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_AGENTS, "runtime_execution_profile".as_slice(), "runtime_execution_profile array value".as_slice(), LATE_ARRAY);
        } else if peek_is(s, t, p.current, "allowed_actions".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_ALLOWED_ACTIONS, "runtime_execution_profile".as_slice(), "runtime_execution_profile array value".as_slice(), LATE_ARRAY);
        } else if peek_is(s, t, p.current, "denied_actions".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_DENIED_ACTIONS, "runtime_execution_profile".as_slice(), "runtime_execution_profile array value".as_slice(), LATE_ARRAY);
        } else if peek_is(s, t, p.current, "purpose".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_PURPOSE, "runtime_execution_profile".as_slice(), "runtime_execution_profile array value".as_slice(), LATE_ARRAY);
        } else if peek_is(s, t, p.current, "mode".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_MODE, "runtime_execution_profile".as_slice(), "runtime_execution_profile field value".as_slice(), LATE_IDENT);
        } else if peek_is(s, t, p.current, "provider".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_PROVIDER, "runtime_execution_profile".as_slice(), "runtime_execution_profile field value".as_slice(), LATE_IDENT);
        } else if peek_is(s, t, p.current, "hardening".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_HARDENING, "runtime_execution_profile".as_slice(), "runtime_execution_profile field value".as_slice(), LATE_IDENT);
        } else if peek_is(s, t, p.current, "threat_model".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_THREAT_MODEL, "runtime_execution_profile".as_slice(), "runtime_execution_profile field value".as_slice(), LATE_IDENT);
        } else if peek_is(s, t, p.current, "evidence_map".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_EVIDENCE_MAP, "runtime_execution_profile".as_slice(), "runtime_execution_profile field value".as_slice(), LATE_IDENT);
        } else if peek_is(s, t, p.current, "governance_profile".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_GOVERNANCE_PROFILE, "runtime_execution_profile".as_slice(), "runtime_execution_profile field value".as_slice(), LATE_IDENT);
        } else if peek_is(s, t, p.current, "network".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_NETWORK, "runtime_execution_profile".as_slice(), "runtime_execution_profile field value".as_slice(), LATE_IDENT);
        } else if peek_is(s, t, p.current, "external_execution".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_EXTERNAL_EXECUTION, "runtime_execution_profile".as_slice(), "runtime_execution_profile field value".as_slice(), LATE_IDENT);
        } else if peek_is(s, t, p.current, "tool_execution".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_TOOL_EXECUTION, "runtime_execution_profile".as_slice(), "runtime_execution_profile field value".as_slice(), LATE_IDENT);
        } else if peek_is(s, t, p.current, "agent_execution".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_AGENT_EXECUTION, "runtime_execution_profile".as_slice(), "runtime_execution_profile field value".as_slice(), LATE_IDENT);
        } else if peek_is(s, t, p.current, "secrets".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_SECRETS, "runtime_execution_profile".as_slice(), "runtime_execution_profile field value".as_slice(), LATE_IDENT);
        } else if peek_is(s, t, p.current, "key_material".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_KEY_MATERIAL, "runtime_execution_profile".as_slice(), "runtime_execution_profile field value".as_slice(), LATE_IDENT);
        } else if peek_is(s, t, p.current, "audit".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_AUDIT, "runtime_execution_profile".as_slice(), "runtime_execution_profile field value".as_slice(), LATE_IDENT);
        } else if peek_is(s, t, p.current, "evidence".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_EVIDENCE, "runtime_execution_profile".as_slice(), "runtime_execution_profile field value".as_slice(), LATE_IDENT);
        } else if peek_is(s, t, p.current, "security_report".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_SECURITY_REPORT, "runtime_execution_profile".as_slice(), "runtime_execution_profile field value".as_slice(), LATE_IDENT);
        } else if peek_is(s, t, p.current, "security_claims".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_SECURITY_CLAIMS, "runtime_execution_profile".as_slice(), "runtime_execution_profile field value".as_slice(), LATE_IDENT);
        } else {
            return block_unexpected(s, t, p, "runtime_execution_profile".as_slice(), "".as_slice());
        }
        if p.failed { return p; }
    }
    let fallback: u64 = name_span(p.slots.as_slice(), p.nodes.as_slice(), node);
    p = default_false(p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_FAIL_CLOSED, fallback);
    p = default_array(p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_AGENTS);
    p = default_array(p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_ALLOWED_ACTIONS);
    p = default_array(p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_DENIED_ACTIONS);
    p = default_array(p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_PURPOSE);
    p = default_string(p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_MODE, fallback);
    p = default_string(p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_PROVIDER, fallback);
    p = default_string(p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_HARDENING, fallback);
    p = default_string(p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_THREAT_MODEL, fallback);
    p = default_string(p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_EVIDENCE_MAP, fallback);
    p = default_string(p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_GOVERNANCE_PROFILE, fallback);
    p = default_string(p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_NETWORK, fallback);
    p = default_string(p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_EXTERNAL_EXECUTION, fallback);
    p = default_string(p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_TOOL_EXECUTION, fallback);
    p = default_string(p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_AGENT_EXECUTION, fallback);
    p = default_string(p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_SECRETS, fallback);
    p = default_string(p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_KEY_MATERIAL, fallback);
    p = default_string(p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_AUDIT, fallback);
    p = default_string(p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_EVIDENCE, fallback);
    p = default_string(p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_SECURITY_REPORT, fallback);
    p = default_string(p, node, agent_schema.RUNTIME_EXECUTION_PROFILE_DECL_SECURITY_CLAIMS, fallback);
    block_end(t, p, node)
}

