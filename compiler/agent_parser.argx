    p = default_unknown(p, node, agent_schema.PUBLIC_CONFORMANCE_CLAIM_DECL_STATUS, agent_schema.PUBLIC_CONFORMANCE_CLAIM_STATUS, agent_schema.PUBLIC_CONFORMANCE_CLAIM_STATUS_UNKNOWN, fallback);
    block_end(t, p, node)
}

// `parse_regulatory_obligations`.
fn parse_regulatory_obligations(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = expect_symbol(t, parser, agent_lexer.LEFT_BRACKET, "`[`".as_slice());
    if p.failed { return p; }
    p = agent_ast.array(p);
    let values: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACKET {
        p = ensure_not_eof(t, p, "unterminated regulatory_mapping obligations array".as_slice());
        if p.failed { return p; }
        p = parse_regulatory_obligation(s, t, p);
        if p.failed { return p; }
        let value: u64 = p.result;
        p = agent_ast.push(p, values, value);
        if peek_kind(t, p.current) == agent_lexer.COMMA {
            p = advance(t, p);
        }
    }
    p = advance(t, p);
    p.result = values;
    p
}

// A key whose value `parse_regulatory_obligations` reads.
fn field_parse_regulatory_obligations(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree, node: u64, field: u64, block: Slice<u8>) -> Tree {
    let mut p: Tree = field_start(s, t, parser, node, field, block);
    if p.failed { return p; }
    p = parse_regulatory_obligations(s, t, p);
    if p.failed { return p; }
    agent_ast.set_last(p, node, field)
}

// `parse_regulatory_obligation`.
