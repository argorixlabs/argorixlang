        } else {
            return block_unexpected(s, t, p, "spec_freeze".as_slice(), "".as_slice());
        }
        if p.failed { return p; }
    }
    let fallback: u64 = name_span(p.slots.as_slice(), p.nodes.as_slice(), node);
    p = default_array(p, node, agent_schema.SPEC_FREEZE_DECL_FROZEN_FEATURES);
    p = default_array(p, node, agent_schema.SPEC_FREEZE_DECL_COMPATIBLE_VERSIONS);
    p = default_array(p, node, agent_schema.SPEC_FREEZE_DECL_REQUIRED_SUITES);
    p = default_array(p, node, agent_schema.SPEC_FREEZE_DECL_PURPOSE);
    p = default_string(p, node, agent_schema.SPEC_FREEZE_DECL_VERSION, fallback);
    p = default_string(p, node, agent_schema.SPEC_FREEZE_DECL_TARGET, fallback);
    p = default_string(p, node, agent_schema.SPEC_FREEZE_DECL_FREEZE_SCOPE, fallback);
    p = default_string(p, node, agent_schema.SPEC_FREEZE_DECL_COMPATIBILITY, fallback);
    p = default_string(p, node, agent_schema.SPEC_FREEZE_DECL_STABILITY, fallback);
    p = default_string(p, node, agent_schema.SPEC_FREEZE_DECL_EVIDENCE_BUNDLE, fallback);
    p = default_string(p, node, agent_schema.SPEC_FREEZE_DECL_SECURITY_REPORT, fallback);
    p = default_string(p, node, agent_schema.SPEC_FREEZE_DECL_CONFORMANCE, fallback);
    p = default_string(p, node, agent_schema.SPEC_FREEZE_DECL_BACKWARD_COMPATIBILITY, fallback);
    p = default_string(p, node, agent_schema.SPEC_FREEZE_DECL_RUNTIME_STATUS, fallback);
    p = default_string(p, node, agent_schema.SPEC_FREEZE_DECL_NETWORK, fallback);
    p = default_string(p, node, agent_schema.SPEC_FREEZE_DECL_EXTERNAL_EXECUTION, fallback);
    p = default_string(p, node, agent_schema.SPEC_FREEZE_DECL_PROVIDER_EXECUTION, fallback);
    p = default_string(p, node, agent_schema.SPEC_FREEZE_DECL_SECRET_MATERIAL, fallback);
    p = default_string(p, node, agent_schema.SPEC_FREEZE_DECL_KEY_MATERIAL, fallback);
    p = default_string(p, node, agent_schema.SPEC_FREEZE_DECL_ENV_ACCESS, fallback);
