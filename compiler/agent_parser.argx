    p = default_unknown(p, node, agent_schema.A_TRUST_EVIDENCE_MAP_DECL_TRACE, agent_schema.A_TRUST_EVIDENCE_REQUIREMENT, agent_schema.A_TRUST_EVIDENCE_REQUIREMENT_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_EVIDENCE_MAP_DECL_NETWORK, agent_schema.A_TRUST_NETWORK_BOUNDARY, agent_schema.A_TRUST_NETWORK_BOUNDARY_UNKNOWN, fallback);
