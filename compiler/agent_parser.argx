// ------------------------------------------------------------------ providers

fn parse_provider(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "provider".as_slice(), "provider name".as_slice(), agent_schema.PROVIDER_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    p = expect_keyword(s, t, p, "kind".as_slice());
    if p.failed { return p; }
    p = expect_identifier(s, t, p, "provider kind".as_slice());
    if p.failed { return p; }
    let kind_token: u64 = p.current - 1u64;
    let kind: u64 = agent_words.words_parse_provider__provider_kind_decl(s.slice(text_start(t, kind_token), text_end(t, kind_token)));
    if kind == agent_words.NO_VARIANT {
        let mut message: Buffer<u8> = bytes.append(Buffer::new(), "invalid provider kind `".as_slice());
        message = bytes.append(message, s.slice(text_start(t, kind_token), text_end(t, kind_token)));
        message = bytes.append(message, "`; expected `simulated` or `external`".as_slice());
        return fail_at(t, p, message, kind_token);
    }
    p = agent_ast.variant(p, agent_schema.PROVIDER_KIND_DECL, kind, 0u64);
    p = spanned_last(t, p, kind_token);
    p = agent_ast.set_last(p, node, agent_schema.PROVIDER_DECL_KIND);
    p = expect_keyword(s, t, p, "enabled".as_slice());
    if p.failed { return p; }
    p = expect_bool(s, t, p, "provider enabled value".as_slice());
    if p.failed { return p; }
    p = agent_ast.set_last(p, node, agent_schema.PROVIDER_DECL_ENABLED);
    p = expect_keyword(s, t, p, "dry_run_only".as_slice());
    if p.failed { return p; }
    p = expect_bool(s, t, p, "provider dry_run_only value".as_slice());
    if p.failed { return p; }
    p = agent_ast.set_last(p, node, agent_schema.PROVIDER_DECL_DRY_RUN_ONLY);
    let mut feature_flag: bool = false;
    let mut approval: bool = false;
    p = match_keyword(s, t, p, "requires".as_slice());
    while p.matched {
        p = expect_identifier(s, t, p, "provider requirement".as_slice());
        if p.failed { return p; }
        let at: u64 = p.current - 1u64;
        let word: Slice<u8> = s.slice(text_start(t, at), text_end(t, at));
        if bytes.equal(word, "feature_flag".as_slice()) && !feature_flag {
            if approval {
                return fail_at(t, p, bytes.copy("`requires feature_flag` must appear before `requires approval`".as_slice()), at);
            }
            feature_flag = true;
        } else if bytes.equal(word, "approval".as_slice()) && !approval {
            approval = true;
        } else if bytes.equal(word, "feature_flag".as_slice()) || bytes.equal(word, "approval".as_slice()) {
            let mut message: Buffer<u8> = bytes.append(Buffer::new(), "duplicate provider requirement `".as_slice());
            message = bytes.append(message, word);
            message.push(96u8);
            return fail_at(t, p, message, at);
        } else {
            let mut message: Buffer<u8> = bytes.append(Buffer::new(), "invalid provider requirement `".as_slice());
            message = bytes.append(message, word);
            message = bytes.append(message, "`; expected `feature_flag` or `approval`".as_slice());
            return fail_at(t, p, message, at);
        }
        p = match_keyword(s, t, p, "requires".as_slice());
    }
    p = agent_ast.boolean(p, feature_flag);
    p = agent_ast.set_last(p, node, agent_schema.PROVIDER_DECL_REQUIRES_FEATURE_FLAG);
    p = agent_ast.boolean(p, approval);
    p = agent_ast.set_last(p, node, agent_schema.PROVIDER_DECL_REQUIRES_EXPLICIT_APPROVAL);
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        let at: u64 = p.current;
        if peek_is(s, t, at, "allowed_targets".as_slice()) {
            if !unset(p.slots.as_slice(), p.nodes.as_slice(), node, agent_schema.PROVIDER_DECL_ALLOWED_TARGETS) {
                return fail_at(t, p, bytes.copy("duplicate `allowed_targets` block".as_slice()), at);
            }
            p = advance(t, p);
            p = parse_identifier_block(s, t, p, "allowed target".as_slice());
            if p.failed { return p; }
            p = agent_ast.set_last(p, node, agent_schema.PROVIDER_DECL_ALLOWED_TARGETS);
        } else if peek_is(s, t, at, "allowed_capabilities".as_slice()) {
            if !unset(p.slots.as_slice(), p.nodes.as_slice(), node, agent_schema.PROVIDER_DECL_ALLOWED_CAPABILITIES) {
                return fail_at(t, p, bytes.copy("duplicate `allowed_capabilities` block".as_slice()), at);
            }
            p = advance(t, p);
            p = parse_identifier_block(s, t, p, "allowed capability".as_slice());
            if p.failed { return p; }
            p = agent_ast.set_last(p, node, agent_schema.PROVIDER_DECL_ALLOWED_CAPABILITIES);
        } else if peek_kind(t, at) == agent_lexer.IDENT {
            let mut message: Buffer<u8> = bytes.append(Buffer::new(), "unexpected provider item `".as_slice());
            message = bytes.append(message, s.slice(text_start(t, at), text_end(t, at)));
            message.push(96u8);
            return fail_at(t, p, message, at);
        } else {
            return fail_at(t, p, bytes.copy("expected provider allowlist block".as_slice()), at);
        }
    }
    p = default_array(p, node, agent_schema.PROVIDER_DECL_ALLOWED_TARGETS);
    p = default_array(p, node, agent_schema.PROVIDER_DECL_ALLOWED_CAPABILITIES);
    block_end(t, p, node)
}


// ------------------------------------------------------------------ features and secrets

fn parse_feature(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "feature".as_slice(), "feature name".as_slice(), agent_schema.FEATURE_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    let mut requires_approval: bool = false;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated feature declaration".as_slice());
        if p.failed { return p; }
        if peek_is(s, t, p.current, "provider".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.FEATURE_DECL_PROVIDER, "feature".as_slice(), "feature provider reference".as_slice());
        } else if peek_is(s, t, p.current, "status".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.FEATURE_DECL_STATUS, "feature".as_slice(), "feature status".as_slice(), agent_schema.FEATURE_STATUS, agent_words.T_PARSE_FEATURE__FEATURE_STATUS, agent_schema.FEATURE_STATUS_UNKNOWN);
        } else if peek_is(s, t, p.current, "default".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.FEATURE_DECL_DEFAULT, "feature".as_slice(), "feature default".as_slice(), agent_schema.FEATURE_DEFAULT, agent_words.T_PARSE_FEATURE__FEATURE_DEFAULT, agent_schema.FEATURE_DEFAULT_UNKNOWN);
        } else if peek_is(s, t, p.current, "requires".as_slice()) {
            let at: u64 = p.current;
            p = advance(t, p);
            p = expect_keyword(s, t, p, "approval".as_slice());
            if p.failed { return p; }
            if requires_approval {
                return fail_at(t, p, bytes.copy("duplicate feature field `requires approval`".as_slice()), at);
            }
            requires_approval = true;
        } else if peek_is(s, t, p.current, "purpose".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.FEATURE_DECL_PURPOSE, "feature".as_slice(), "feature purpose value".as_slice());
        } else {
            return block_unexpected(s, t, p, "feature".as_slice(), "a".as_slice());
        }
        if p.failed { return p; }
    }
    let fallback: u64 = name_span(p.slots.as_slice(), p.nodes.as_slice(), node);
    p = default_unknown(p, node, agent_schema.FEATURE_DECL_STATUS, agent_schema.FEATURE_STATUS, agent_schema.FEATURE_STATUS_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.FEATURE_DECL_DEFAULT, agent_schema.FEATURE_DEFAULT, agent_schema.FEATURE_DEFAULT_UNKNOWN, fallback);
    p = agent_ast.boolean(p, requires_approval);
    p = agent_ast.set_last(p, node, agent_schema.FEATURE_DECL_REQUIRES_APPROVAL);
    block_end(t, p, node)
}

// The keys a secret declaration must never hold: secret material.
fn forbidden_secret_key(word: Slice<u8>) -> bool {
    bytes.equal(word, "value".as_slice()) || bytes.equal(word, "secret_value".as_slice()) || bytes.equal(word, "token".as_slice()) || bytes.equal(word, "api_key_value".as_slice()) || bytes.equal(word, "raw".as_slice()) || bytes.equal(word, "plaintext".as_slice())
}

fn parse_secret(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "secret".as_slice(), "secret name".as_slice(), agent_schema.SECRET_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated secret declaration".as_slice());
        if p.failed { return p; }
        let at: u64 = p.current;
        if peek_is(s, t, at, "handle".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.SECRET_DECL_HANDLE, "secret".as_slice(), "secret handle value".as_slice());
        } else if peek_is(s, t, at, "provider".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.SECRET_DECL_PROVIDER, "secret".as_slice(), "secret provider reference".as_slice());
        } else if peek_is(s, t, at, "required_by".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.SECRET_DECL_REQUIRED_BY, "secret".as_slice(), "secret required_by reference".as_slice());
        } else if peek_is(s, t, at, "scope".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.SECRET_DECL_SCOPE, "secret".as_slice(), "secret scope".as_slice(), agent_schema.SECRET_SCOPE, agent_words.T_PARSE_SECRET__SECRET_SCOPE, agent_schema.SECRET_SCOPE_UNKNOWN);
        } else if peek_is(s, t, at, "access".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.SECRET_DECL_ACCESS, "secret".as_slice(), "secret access".as_slice(), agent_schema.SECRET_ACCESS, agent_words.T_PARSE_SECRET__SECRET_ACCESS, agent_schema.SECRET_ACCESS_UNKNOWN);
        } else if peek_is(s, t, at, "source".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.SECRET_DECL_SOURCE, "secret".as_slice(), "secret source".as_slice(), agent_schema.SECRET_SOURCE, agent_words.T_PARSE_SECRET__SECRET_SOURCE, agent_schema.SECRET_SOURCE_UNKNOWN);
        } else if peek_kind(t, at) == agent_lexer.IDENT && forbidden_secret_key(s.slice(text_start(t, at), text_end(t, at))) {
            let mut message: Buffer<u8> = bytes.append(Buffer::new(), "secret declarations must not contain secret material; field `".as_slice());
            message = bytes.append(message, s.slice(text_start(t, at), text_end(t, at)));
            message = bytes.append(message, "` is forbidden".as_slice());
            return fail_at(t, p, message, at);
        } else {
            return block_unexpected(s, t, p, "secret".as_slice(), "a".as_slice());
        }
        if p.failed { return p; }
    }
    let fallback: u64 = name_span(p.slots.as_slice(), p.nodes.as_slice(), node);
    p = default_string(p, node, agent_schema.SECRET_DECL_HANDLE, fallback);
    p = default_unknown(p, node, agent_schema.SECRET_DECL_SCOPE, agent_schema.SECRET_SCOPE, agent_schema.SECRET_SCOPE_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.SECRET_DECL_ACCESS, agent_schema.SECRET_ACCESS, agent_schema.SECRET_ACCESS_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.SECRET_DECL_SOURCE, agent_schema.SECRET_SOURCE, agent_schema.SECRET_SOURCE_UNKNOWN, fallback);
    block_end(t, p, node)
}


// ------------------------------------------------------------------ crypto boundaries

// `Spanned::new("<text>".to_owned(), span)`.
fn default_text(parser: Tree, node: u64, field: u64, text: Slice<u8>, span_node: u64) -> Tree {
    let mut p: Tree = parser;
    if !unset(p.slots.as_slice(), p.nodes.as_slice(), node, field) {
        return p;
    }
    p = agent_ast.string(p, text);
    let value: u64 = p.result;
    p = agent_ast.spanned(p, value, span_node);
    agent_ast.set_last(p, node, field)
}

fn parse_crypto_boundary(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "crypto_boundary".as_slice(), "crypto boundary name".as_slice(), agent_schema.CRYPTO_BOUNDARY_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated crypto_boundary declaration".as_slice());
        if p.failed { return p; }
        let at: u64 = p.current;
        if peek_is(s, t, at, "allowed_hashes".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.CRYPTO_BOUNDARY_DECL_ALLOWED_HASHES, "crypto_boundary".as_slice(), "crypto_boundary allowed_hashes".as_slice());
        } else if peek_is(s, t, at, "allowed_signatures".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.CRYPTO_BOUNDARY_DECL_ALLOWED_SIGNATURES, "crypto_boundary".as_slice(), "crypto_boundary allowed_signatures".as_slice());
        } else if peek_is(s, t, at, "allowed_kems".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.CRYPTO_BOUNDARY_DECL_ALLOWED_KEMS, "crypto_boundary".as_slice(), "crypto_boundary allowed_kems".as_slice());
        } else if peek_is(s, t, at, "allowed_aeads".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.CRYPTO_BOUNDARY_DECL_ALLOWED_AEADS, "crypto_boundary".as_slice(), "crypto_boundary allowed_aeads".as_slice());
        } else if peek_is(s, t, at, "legacy_allowed".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.CRYPTO_BOUNDARY_DECL_LEGACY_ALLOWED, "crypto_boundary".as_slice(), "crypto_boundary legacy_allowed".as_slice());
        } else if peek_is(s, t, at, "denied".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.CRYPTO_BOUNDARY_DECL_DENIED, "crypto_boundary".as_slice(), "crypto_boundary denied".as_slice());
        } else if peek_is(s, t, at, "purpose".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.CRYPTO_BOUNDARY_DECL_PURPOSE, "crypto_boundary".as_slice(), "crypto_boundary purpose".as_slice());
        } else if peek_is(s, t, at, "min_hash_bits".as_slice()) {
            p = field_integer(s, t, p, node, agent_schema.CRYPTO_BOUNDARY_DECL_MIN_HASH_BITS, "crypto_boundary".as_slice(), "crypto_boundary min_hash_bits".as_slice());
        } else if peek_is(s, t, at, "post_quantum_ready".as_slice()) {
            p = field_bool(s, t, p, node, agent_schema.CRYPTO_BOUNDARY_DECL_POST_QUANTUM_READY, "crypto_boundary".as_slice(), "crypto_boundary post_quantum_ready".as_slice());
        } else if peek_is(s, t, at, "hybrid_allowed".as_slice()) {
            p = field_bool(s, t, p, node, agent_schema.CRYPTO_BOUNDARY_DECL_HYBRID_ALLOWED, "crypto_boundary".as_slice(), "crypto_boundary hybrid_allowed".as_slice());
        } else if peek_is(s, t, at, "key_material".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.CRYPTO_BOUNDARY_DECL_KEY_MATERIAL, "crypto_boundary".as_slice(), "crypto_boundary key_material".as_slice());
        } else if peek_is(s, t, at, "secret_material".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.CRYPTO_BOUNDARY_DECL_SECRET_MATERIAL, "crypto_boundary".as_slice(), "crypto_boundary secret_material".as_slice());
        } else if peek_is(s, t, at, "execution".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.CRYPTO_BOUNDARY_DECL_EXECUTION, "crypto_boundary".as_slice(), "crypto_boundary execution".as_slice());
        } else {
            return block_unexpected(s, t, p, "crypto_boundary".as_slice(), "a".as_slice());
        }
        if p.failed { return p; }
    }
    p = default_array(p, node, agent_schema.CRYPTO_BOUNDARY_DECL_ALLOWED_HASHES);
    p = default_array(p, node, agent_schema.CRYPTO_BOUNDARY_DECL_ALLOWED_SIGNATURES);
    p = default_array(p, node, agent_schema.CRYPTO_BOUNDARY_DECL_ALLOWED_KEMS);
    p = default_array(p, node, agent_schema.CRYPTO_BOUNDARY_DECL_ALLOWED_AEADS);
    p = default_array(p, node, agent_schema.CRYPTO_BOUNDARY_DECL_LEGACY_ALLOWED);
    p = default_array(p, node, agent_schema.CRYPTO_BOUNDARY_DECL_DENIED);
    p = default_array(p, node, agent_schema.CRYPTO_BOUNDARY_DECL_PURPOSE);
    let fallback: u64 = name_span(p.slots.as_slice(), p.nodes.as_slice(), node);
    p = default_text(p, node, agent_schema.CRYPTO_BOUNDARY_DECL_KEY_MATERIAL, "denied".as_slice(), fallback);
    p = default_text(p, node, agent_schema.CRYPTO_BOUNDARY_DECL_SECRET_MATERIAL, "denied".as_slice(), fallback);
    p = default_text(p, node, agent_schema.CRYPTO_BOUNDARY_DECL_EXECUTION, "disabled".as_slice(), fallback);
    block_end(t, p, node)
}


// ------------------------------------------------------------------ passports

fn parse_passport(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "passport".as_slice(), "passport name".as_slice(), agent_schema.PASSPORT_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated passport declaration".as_slice());
        if p.failed { return p; }
        let at: u64 = p.current;
        if peek_is(s, t, at, "agent".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.PASSPORT_DECL_AGENT, "passport".as_slice(), "passport agent reference".as_slice());
        } else if peek_is(s, t, at, "agent_name".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.PASSPORT_DECL_AGENT_NAME, "passport".as_slice(), "passport agent_name value".as_slice());
        } else if peek_is(s, t, at, "global_id".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.PASSPORT_DECL_GLOBAL_ID, "passport".as_slice(), "passport global_id value".as_slice());
        } else if peek_is(s, t, at, "identity".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.PASSPORT_DECL_IDENTITY, "passport".as_slice(), "passport identity value".as_slice());
        } else if peek_is(s, t, at, "provider".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.PASSPORT_DECL_PROVIDER, "passport".as_slice(), "passport provider value".as_slice());
        } else if peek_is(s, t, at, "version".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.PASSPORT_DECL_VERSION, "passport".as_slice(), "passport version value".as_slice());
        } else if peek_is(s, t, at, "ans_name".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.PASSPORT_DECL_ANS_NAME, "passport".as_slice(), "passport ans_name value".as_slice());
        } else if peek_is(s, t, at, "country".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.PASSPORT_DECL_COUNTRY, "passport".as_slice(), "passport country value".as_slice());
        } else if peek_is(s, t, at, "jurisdiction".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.PASSPORT_DECL_JURISDICTION, "passport".as_slice(), "passport jurisdiction value".as_slice());
        } else if peek_is(s, t, at, "data_residency".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.PASSPORT_DECL_DATA_RESIDENCY, "passport".as_slice(), "data residency entry".as_slice());
        } else if peek_is(s, t, at, "model".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.PASSPORT_DECL_MODEL, "passport".as_slice(), "passport model value".as_slice());
        } else if peek_is(s, t, at, "risk_level".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.PASSPORT_DECL_RISK_LEVEL, "passport".as_slice(), "passport risk_level value".as_slice());
        } else if peek_is(s, t, at, "data_scope".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.PASSPORT_DECL_DATA_SCOPE, "passport".as_slice(), "data scope entry".as_slice());
        } else if peek_is(s, t, at, "intent".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.PASSPORT_DECL_INTENT, "passport".as_slice(), "passport intent value".as_slice());
        } else if peek_is(s, t, at, "intended_use".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.PASSPORT_DECL_INTENDED_USE, "passport".as_slice(), "intended use entry".as_slice());
        } else if peek_is(s, t, at, "prohibited_use".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.PASSPORT_DECL_PROHIBITED_USE, "passport".as_slice(), "prohibited use entry".as_slice());
        } else if peek_is(s, t, at, "attestations".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.PASSPORT_DECL_ATTESTATIONS, "passport".as_slice(), "attestation entry".as_slice());
        } else if peek_is(s, t, at, "asn".as_slice()) {
            if !unset(p.slots.as_slice(), p.nodes.as_slice(), node, agent_schema.PASSPORT_DECL_ASN) {
                return fail_at(t, p, bytes.copy("duplicate `asn` block in passport".as_slice()), at);
            }
            p = parse_passport_asn(s, t, p);
            if p.failed { return p; }
            p = agent_ast.set_last(p, node, agent_schema.PASSPORT_DECL_ASN);
        } else {
            return block_unexpected(s, t, p, "passport".as_slice(), "a".as_slice());
        }
        if p.failed { return p; }
    }
    let fallback: u64 = name_span(p.slots.as_slice(), p.nodes.as_slice(), node);
    p = default_string(p, node, agent_schema.PASSPORT_DECL_AGENT, fallback);
    p = default_string(p, node, agent_schema.PASSPORT_DECL_AGENT_NAME, fallback);
    p = default_string(p, node, agent_schema.PASSPORT_DECL_GLOBAL_ID, fallback);
    p = default_string(p, node, agent_schema.PASSPORT_DECL_IDENTITY, fallback);
    p = default_string(p, node, agent_schema.PASSPORT_DECL_PROVIDER, fallback);
    p = default_string(p, node, agent_schema.PASSPORT_DECL_VERSION, fallback);
    p = default_string(p, node, agent_schema.PASSPORT_DECL_COUNTRY, fallback);
    p = default_string(p, node, agent_schema.PASSPORT_DECL_JURISDICTION, fallback);
    p = default_array(p, node, agent_schema.PASSPORT_DECL_DATA_RESIDENCY);
    p = default_string(p, node, agent_schema.PASSPORT_DECL_RISK_LEVEL, fallback);
    p = default_array(p, node, agent_schema.PASSPORT_DECL_DATA_SCOPE);
    p = default_string(p, node, agent_schema.PASSPORT_DECL_INTENT, fallback);
    p = default_array(p, node, agent_schema.PASSPORT_DECL_INTENDED_USE);
    p = default_array(p, node, agent_schema.PASSPORT_DECL_PROHIBITED_USE);
    p = default_array(p, node, agent_schema.PASSPORT_DECL_ATTESTATIONS);
    block_end(t, p, node)
}

// `asn { ... }`: its keys are refused as passport fields; a key left out is
// an empty string spanned by the closing `}`.
fn parse_passport_asn(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = expect_keyword(s, t, parser, "asn".as_slice());
    if p.failed { return p; }
    p = expect_symbol(t, p, agent_lexer.LEFT_BRACE, "`{`".as_slice());
    if p.failed { return p; }
    p = agent_ast.object(p, agent_schema.PASSPORT_ASN_DECL);
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated asn block".as_slice());
        if p.failed { return p; }
        let at: u64 = p.current;
        if peek_is(s, t, at, "registry".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.PASSPORT_ASN_DECL_REGISTRY, "passport".as_slice(), "asn registry value".as_slice());
        } else if peek_is(s, t, at, "number".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.PASSPORT_ASN_DECL_NUMBER, "passport".as_slice(), "asn number value".as_slice());
        } else if peek_is(s, t, at, "holder".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.PASSPORT_ASN_DECL_HOLDER, "passport".as_slice(), "asn holder value".as_slice());
        } else if peek_is(s, t, at, "country".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.PASSPORT_ASN_DECL_COUNTRY, "passport".as_slice(), "asn country value".as_slice());
        } else {
            return block_unexpected(s, t, p, "asn".as_slice(), "an".as_slice());
        }
        if p.failed { return p; }
    }
    let close: u64 = p.current;
    p = span_of(t, p, close);
    let fallback: u64 = p.result;
    p = default_string(p, node, agent_schema.PASSPORT_ASN_DECL_REGISTRY, fallback);
    p = default_string(p, node, agent_schema.PASSPORT_ASN_DECL_NUMBER, fallback);
    p = default_string(p, node, agent_schema.PASSPORT_ASN_DECL_HOLDER, fallback);
    p = default_string(p, node, agent_schema.PASSPORT_ASN_DECL_COUNTRY, fallback);
    block_end(t, p, node)
}

// ------------------------------------------------------------------ generated keyed blocks

// GENERATED by crates/argorixc/tests/agent_blocks.rs from the keyed-block
// declarations of crates/argorix_parser/src/parser.rs; regenerate with
// ARGORIX_BLESS=1, do not edit.

// `parse_harness`.
fn parse_harness(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "harness".as_slice(), "harness name".as_slice(), agent_schema.PROVIDER_HARNESS_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated harness declaration".as_slice());
        if p.failed { return p; }
        if peek_is(s, t, p.current, "provider".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.PROVIDER_HARNESS_DECL_PROVIDER, "harness".as_slice(), "harness provider reference".as_slice());
        } else if peek_is(s, t, p.current, "feature".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.PROVIDER_HARNESS_DECL_FEATURE, "harness".as_slice(), "harness feature reference".as_slice());
        } else if peek_is(s, t, p.current, "secret".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.PROVIDER_HARNESS_DECL_SECRET, "harness".as_slice(), "harness secret reference".as_slice());
        } else if peek_is(s, t, p.current, "mode".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.PROVIDER_HARNESS_DECL_MODE, "harness".as_slice(), "harness mode".as_slice(), agent_schema.HARNESS_MODE, agent_words.T_PARSE_HARNESS__HARNESS_MODE, agent_schema.HARNESS_MODE_UNKNOWN);
        } else if peek_is(s, t, p.current, "network".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.PROVIDER_HARNESS_DECL_NETWORK, "harness".as_slice(), "harness network mode".as_slice(), agent_schema.HARNESS_NETWORK, agent_words.T_PARSE_HARNESS__HARNESS_NETWORK, agent_schema.HARNESS_NETWORK_UNKNOWN);
        } else if peek_is(s, t, p.current, "secrets".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.PROVIDER_HARNESS_DECL_SECRETS, "harness".as_slice(), "harness secrets mode".as_slice(), agent_schema.HARNESS_SECRETS, agent_words.T_PARSE_HARNESS__HARNESS_SECRETS, agent_schema.HARNESS_SECRETS_UNKNOWN);
        } else if peek_is(s, t, p.current, "filesystem".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.PROVIDER_HARNESS_DECL_FILESYSTEM, "harness".as_slice(), "harness filesystem mode".as_slice(), agent_schema.HARNESS_FILESYSTEM, agent_words.T_PARSE_HARNESS__HARNESS_FILESYSTEM, agent_schema.HARNESS_FILESYSTEM_UNKNOWN);
        } else if peek_is(s, t, p.current, "max_steps".as_slice()) {
            p = field_integer(s, t, p, node, agent_schema.PROVIDER_HARNESS_DECL_MAX_STEPS, "harness".as_slice(), "harness max_steps integer".as_slice());
        } else if peek_is(s, t, p.current, "timeout_ms".as_slice()) {
            p = field_integer(s, t, p, node, agent_schema.PROVIDER_HARNESS_DECL_TIMEOUT_MS, "harness".as_slice(), "harness timeout_ms integer".as_slice());
        } else if peek_is(s, t, p.current, "input_contract".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.PROVIDER_HARNESS_DECL_INPUT_CONTRACT, "harness".as_slice(), "harness input contract".as_slice());
        } else if peek_is(s, t, p.current, "output_contract".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.PROVIDER_HARNESS_DECL_OUTPUT_CONTRACT, "harness".as_slice(), "harness output contract".as_slice());
        } else if peek_is(s, t, p.current, "attestations".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.PROVIDER_HARNESS_DECL_ATTESTATIONS, "harness".as_slice(), "harness attestation".as_slice());
        } else {
            return block_unexpected(s, t, p, "harness".as_slice(), "a".as_slice());
        }
        if p.failed { return p; }
    }
    let fallback: u64 = name_span(p.slots.as_slice(), p.nodes.as_slice(), node);
    p = default_string(p, node, agent_schema.PROVIDER_HARNESS_DECL_PROVIDER, fallback);
    p = default_unknown(p, node, agent_schema.PROVIDER_HARNESS_DECL_MODE, agent_schema.HARNESS_MODE, agent_schema.HARNESS_MODE_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.PROVIDER_HARNESS_DECL_NETWORK, agent_schema.HARNESS_NETWORK, agent_schema.HARNESS_NETWORK_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.PROVIDER_HARNESS_DECL_SECRETS, agent_schema.HARNESS_SECRETS, agent_schema.HARNESS_SECRETS_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.PROVIDER_HARNESS_DECL_FILESYSTEM, agent_schema.HARNESS_FILESYSTEM, agent_schema.HARNESS_FILESYSTEM_UNKNOWN, fallback);
    p = default_array(p, node, agent_schema.PROVIDER_HARNESS_DECL_ATTESTATIONS);
    block_end(t, p, node)
}

// `parse_adapter`.
fn parse_adapter(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "adapter".as_slice(), "adapter name".as_slice(), agent_schema.ADAPTER_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated adapter declaration".as_slice());
        if p.failed { return p; }
        if peek_is(s, t, p.current, "provider".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.ADAPTER_DECL_PROVIDER, "adapter".as_slice(), "adapter provider reference".as_slice());
        } else if peek_is(s, t, p.current, "feature".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.ADAPTER_DECL_FEATURE, "adapter".as_slice(), "adapter feature reference".as_slice());
        } else if peek_is(s, t, p.current, "secret".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.ADAPTER_DECL_SECRET, "adapter".as_slice(), "adapter secret reference".as_slice());
        } else if peek_is(s, t, p.current, "harness".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.ADAPTER_DECL_HARNESS, "adapter".as_slice(), "adapter harness reference".as_slice());
        } else if peek_is(s, t, p.current, "kind".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.ADAPTER_DECL_KIND, "adapter".as_slice(), "adapter kind".as_slice(), agent_schema.ADAPTER_KIND, agent_words.T_PARSE_ADAPTER__ADAPTER_KIND, agent_schema.ADAPTER_KIND_UNKNOWN);
        } else if peek_is(s, t, p.current, "vendor".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.ADAPTER_DECL_VENDOR, "adapter".as_slice(), "adapter vendor".as_slice());
        } else if peek_is(s, t, p.current, "mode".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.ADAPTER_DECL_MODE, "adapter".as_slice(), "adapter mode".as_slice(), agent_schema.ADAPTER_MODE, agent_words.T_PARSE_ADAPTER__ADAPTER_MODE, agent_schema.ADAPTER_MODE_UNKNOWN);
        } else if peek_is(s, t, p.current, "execution".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.ADAPTER_DECL_EXECUTION, "adapter".as_slice(), "adapter execution".as_slice(), agent_schema.ADAPTER_EXECUTION, agent_words.T_PARSE_ADAPTER__ADAPTER_EXECUTION, agent_schema.ADAPTER_EXECUTION_UNKNOWN);
        } else if peek_is(s, t, p.current, "network".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.ADAPTER_DECL_NETWORK, "adapter".as_slice(), "adapter network".as_slice(), agent_schema.ADAPTER_NETWORK, agent_words.T_PARSE_ADAPTER__ADAPTER_NETWORK, agent_schema.ADAPTER_NETWORK_UNKNOWN);
        } else if peek_is(s, t, p.current, "secrets".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.ADAPTER_DECL_SECRETS, "adapter".as_slice(), "adapter secrets".as_slice(), agent_schema.ADAPTER_SECRETS, agent_words.T_PARSE_ADAPTER__ADAPTER_SECRETS, agent_schema.ADAPTER_SECRETS_UNKNOWN);
        } else if peek_is(s, t, p.current, "filesystem".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.ADAPTER_DECL_FILESYSTEM, "adapter".as_slice(), "adapter filesystem".as_slice(), agent_schema.ADAPTER_FILESYSTEM, agent_words.T_PARSE_ADAPTER__ADAPTER_FILESYSTEM, agent_schema.ADAPTER_FILESYSTEM_UNKNOWN);
        } else if peek_is(s, t, p.current, "input_contract".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.ADAPTER_DECL_INPUT_CONTRACT, "adapter".as_slice(), "adapter input contract".as_slice());
        } else if peek_is(s, t, p.current, "output_contract".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.ADAPTER_DECL_OUTPUT_CONTRACT, "adapter".as_slice(), "adapter output contract".as_slice());
        } else if peek_is(s, t, p.current, "conformance".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.ADAPTER_DECL_CONFORMANCE, "adapter".as_slice(), "adapter conformance item".as_slice());
        } else {
            return block_unexpected(s, t, p, "adapter".as_slice(), "an".as_slice());
        }
        if p.failed { return p; }
    }
    let fallback: u64 = name_span(p.slots.as_slice(), p.nodes.as_slice(), node);
    p = default_string(p, node, agent_schema.ADAPTER_DECL_PROVIDER, fallback);
    p = default_unknown(p, node, agent_schema.ADAPTER_DECL_MODE, agent_schema.ADAPTER_MODE, agent_schema.ADAPTER_MODE_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.ADAPTER_DECL_EXECUTION, agent_schema.ADAPTER_EXECUTION, agent_schema.ADAPTER_EXECUTION_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.ADAPTER_DECL_NETWORK, agent_schema.ADAPTER_NETWORK, agent_schema.ADAPTER_NETWORK_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.ADAPTER_DECL_SECRETS, agent_schema.ADAPTER_SECRETS, agent_schema.ADAPTER_SECRETS_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.ADAPTER_DECL_FILESYSTEM, agent_schema.ADAPTER_FILESYSTEM, agent_schema.ADAPTER_FILESYSTEM_UNKNOWN, fallback);
    p = default_array(p, node, agent_schema.ADAPTER_DECL_CONFORMANCE);
    block_end(t, p, node)
}

// `parse_adapter_profile`.
fn parse_adapter_profile(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "adapter_profile".as_slice(), "adapter profile name".as_slice(), agent_schema.ADAPTER_PROFILE_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated adapter_profile declaration".as_slice());
        if p.failed { return p; }
        if peek_is(s, t, p.current, "adapter".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.ADAPTER_PROFILE_DECL_ADAPTER, "adapter_profile".as_slice(), "adapter reference".as_slice());
        } else if peek_is(s, t, p.current, "provider".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.ADAPTER_PROFILE_DECL_PROVIDER, "adapter_profile".as_slice(), "provider reference".as_slice());
        } else if peek_is(s, t, p.current, "vendor".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.ADAPTER_PROFILE_DECL_VENDOR, "adapter_profile".as_slice(), "vendor name".as_slice());
        } else if peek_is(s, t, p.current, "family".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.ADAPTER_PROFILE_DECL_FAMILY, "adapter_profile".as_slice(), "profile family".as_slice(), agent_schema.ADAPTER_PROFILE_FAMILY, agent_words.T_PARSE_ADAPTER_PROFILE__ADAPTER_PROFILE_FAMILY, agent_schema.ADAPTER_PROFILE_FAMILY_UNKNOWN);
        } else if peek_is(s, t, p.current, "api_style".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.ADAPTER_PROFILE_DECL_API_STYLE, "adapter_profile".as_slice(), "profile api_style".as_slice(), agent_schema.ADAPTER_PROFILE_API_STYLE, agent_words.T_PARSE_ADAPTER_PROFILE__ADAPTER_PROFILE_API_STYLE, agent_schema.ADAPTER_PROFILE_API_STYLE_UNKNOWN);
        } else if peek_is(s, t, p.current, "auth".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.ADAPTER_PROFILE_DECL_AUTH, "adapter_profile".as_slice(), "profile auth".as_slice(), agent_schema.ADAPTER_PROFILE_AUTH, agent_words.T_PARSE_ADAPTER_PROFILE__ADAPTER_PROFILE_AUTH, agent_schema.ADAPTER_PROFILE_AUTH_UNKNOWN);
        } else if peek_is(s, t, p.current, "execution".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.ADAPTER_PROFILE_DECL_EXECUTION, "adapter_profile".as_slice(), "profile execution".as_slice(), agent_schema.ADAPTER_PROFILE_EXECUTION, agent_words.T_PARSE_ADAPTER_PROFILE__ADAPTER_PROFILE_EXECUTION, agent_schema.ADAPTER_PROFILE_EXECUTION_UNKNOWN);
        } else if peek_is(s, t, p.current, "network".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.ADAPTER_PROFILE_DECL_NETWORK, "adapter_profile".as_slice(), "profile network".as_slice(), agent_schema.ADAPTER_PROFILE_NETWORK, agent_words.T_PARSE_ADAPTER_PROFILE__ADAPTER_PROFILE_NETWORK, agent_schema.ADAPTER_PROFILE_NETWORK_UNKNOWN);
        } else if peek_is(s, t, p.current, "secrets".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.ADAPTER_PROFILE_DECL_SECRETS, "adapter_profile".as_slice(), "profile secrets".as_slice(), agent_schema.ADAPTER_PROFILE_SECRETS, agent_words.T_PARSE_ADAPTER_PROFILE__ADAPTER_PROFILE_SECRETS, agent_schema.ADAPTER_PROFILE_SECRETS_UNKNOWN);
        } else if peek_is(s, t, p.current, "request_contract".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.ADAPTER_PROFILE_DECL_REQUEST_CONTRACT, "adapter_profile".as_slice(), "request contract type".as_slice());
        } else if peek_is(s, t, p.current, "response_contract".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.ADAPTER_PROFILE_DECL_RESPONSE_CONTRACT, "adapter_profile".as_slice(), "response contract type".as_slice());
        } else if peek_is(s, t, p.current, "capabilities".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.ADAPTER_PROFILE_DECL_CAPABILITIES, "adapter_profile".as_slice(), "profile capability".as_slice());
        } else if peek_is(s, t, p.current, "required_conformance".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.ADAPTER_PROFILE_DECL_REQUIRED_CONFORMANCE, "adapter_profile".as_slice(), "profile required conformance item".as_slice());
        } else {
            return block_unexpected(s, t, p, "adapter_profile".as_slice(), "an".as_slice());
        }
        if p.failed { return p; }
    }
    let fallback: u64 = name_span(p.slots.as_slice(), p.nodes.as_slice(), node);
    p = default_string(p, node, agent_schema.ADAPTER_PROFILE_DECL_ADAPTER, fallback);
    p = default_string(p, node, agent_schema.ADAPTER_PROFILE_DECL_PROVIDER, fallback);
    p = default_string(p, node, agent_schema.ADAPTER_PROFILE_DECL_VENDOR, fallback);
    p = default_unknown(p, node, agent_schema.ADAPTER_PROFILE_DECL_FAMILY, agent_schema.ADAPTER_PROFILE_FAMILY, agent_schema.ADAPTER_PROFILE_FAMILY_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.ADAPTER_PROFILE_DECL_API_STYLE, agent_schema.ADAPTER_PROFILE_API_STYLE, agent_schema.ADAPTER_PROFILE_API_STYLE_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.ADAPTER_PROFILE_DECL_AUTH, agent_schema.ADAPTER_PROFILE_AUTH, agent_schema.ADAPTER_PROFILE_AUTH_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.ADAPTER_PROFILE_DECL_EXECUTION, agent_schema.ADAPTER_PROFILE_EXECUTION, agent_schema.ADAPTER_PROFILE_EXECUTION_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.ADAPTER_PROFILE_DECL_NETWORK, agent_schema.ADAPTER_PROFILE_NETWORK, agent_schema.ADAPTER_PROFILE_NETWORK_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.ADAPTER_PROFILE_DECL_SECRETS, agent_schema.ADAPTER_PROFILE_SECRETS, agent_schema.ADAPTER_PROFILE_SECRETS_UNKNOWN, fallback);
    p = default_array(p, node, agent_schema.ADAPTER_PROFILE_DECL_CAPABILITIES);
    p = default_array(p, node, agent_schema.ADAPTER_PROFILE_DECL_REQUIRED_CONFORMANCE);
    block_end(t, p, node)
}

// `parse_crypto`.
fn parse_crypto(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "crypto".as_slice(), "crypto primitive name".as_slice(), agent_schema.CRYPTO_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated crypto declaration".as_slice());
        if p.failed { return p; }
        if peek_is(s, t, p.current, "kind".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.CRYPTO_DECL_KIND, "crypto".as_slice(), "crypto kind".as_slice(), agent_schema.CRYPTO_KIND, agent_words.T_PARSE_CRYPTO__CRYPTO_KIND, agent_schema.CRYPTO_KIND_UNKNOWN);
        } else if peek_is(s, t, p.current, "status".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.CRYPTO_DECL_STATUS, "crypto".as_slice(), "crypto status".as_slice(), agent_schema.CRYPTO_STATUS, agent_words.T_PARSE_CRYPTO__CRYPTO_STATUS, agent_schema.CRYPTO_STATUS_UNKNOWN);
        } else if peek_is(s, t, p.current, "strength".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.CRYPTO_DECL_STRENGTH, "crypto".as_slice(), "crypto strength".as_slice(), agent_schema.CRYPTO_STRENGTH, agent_words.T_PARSE_CRYPTO__CRYPTO_STRENGTH, agent_schema.CRYPTO_STRENGTH_UNKNOWN_VALUE);
        } else if peek_is(s, t, p.current, "purpose".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.CRYPTO_DECL_PURPOSE, "crypto".as_slice(), "crypto purpose".as_slice());
        } else if peek_is(s, t, p.current, "output_bits".as_slice()) {
            p = field_integer(s, t, p, node, agent_schema.CRYPTO_DECL_OUTPUT_BITS, "crypto".as_slice(), "crypto output_bits".as_slice());
        } else if peek_is(s, t, p.current, "min_key_bits".as_slice()) {
            p = field_integer(s, t, p, node, agent_schema.CRYPTO_DECL_MIN_KEY_BITS, "crypto".as_slice(), "crypto min_key_bits".as_slice());
        } else if peek_is(s, t, p.current, "security_level".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.CRYPTO_DECL_SECURITY_LEVEL, "crypto".as_slice(), "crypto security_level".as_slice());
        } else if peek_is(s, t, p.current, "notes".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.CRYPTO_DECL_NOTES, "crypto".as_slice(), "crypto notes".as_slice());
        } else {
            return block_unexpected(s, t, p, "crypto".as_slice(), "a".as_slice());
        }
        if p.failed { return p; }
    }
    let fallback: u64 = name_span(p.slots.as_slice(), p.nodes.as_slice(), node);
    p = default_unknown(p, node, agent_schema.CRYPTO_DECL_KIND, agent_schema.CRYPTO_KIND, agent_schema.CRYPTO_KIND_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.CRYPTO_DECL_STATUS, agent_schema.CRYPTO_STATUS, agent_schema.CRYPTO_STATUS_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.CRYPTO_DECL_STRENGTH, agent_schema.CRYPTO_STRENGTH, agent_schema.CRYPTO_STRENGTH_UNKNOWN_VALUE, fallback);
    p = default_array(p, node, agent_schema.CRYPTO_DECL_PURPOSE);
    block_end(t, p, node)
}

// `parse_did_method`.
fn parse_did_method(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "did_method".as_slice(), "did method name".as_slice(), agent_schema.DID_METHOD_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated did_method declaration".as_slice());
        if p.failed { return p; }
        if peek_is(s, t, p.current, "status".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.DID_METHOD_DECL_STATUS, "did_method".as_slice(), "did_method status".as_slice(), agent_schema.DID_METHOD_STATUS, agent_words.T_PARSE_DID_METHOD__DID_METHOD_STATUS, agent_schema.DID_METHOD_STATUS_UNKNOWN);
        } else if peek_is(s, t, p.current, "resolution".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.DID_METHOD_DECL_RESOLUTION, "did_method".as_slice(), "did_method resolution".as_slice(), agent_schema.DID_RESOLUTION_MODE, agent_words.T_PARSE_DID_METHOD__DID_RESOLUTION_MODE, agent_schema.DID_RESOLUTION_MODE_UNKNOWN);
        } else if peek_is(s, t, p.current, "ledger".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.DID_METHOD_DECL_LEDGER, "did_method".as_slice(), "did_method ledger".as_slice(), agent_schema.DID_LEDGER_MODE, agent_words.T_PARSE_DID_METHOD__DID_LEDGER_MODE, agent_schema.DID_LEDGER_MODE_UNKNOWN);
        } else if peek_is(s, t, p.current, "crypto_boundary".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.DID_METHOD_DECL_CRYPTO_BOUNDARY, "did_method".as_slice(), "did_method crypto_boundary reference".as_slice());
        } else if peek_is(s, t, p.current, "governance".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.DID_METHOD_DECL_GOVERNANCE, "did_method".as_slice(), "did_method governance".as_slice());
        } else if peek_is(s, t, p.current, "purpose".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.DID_METHOD_DECL_PURPOSE, "did_method".as_slice(), "did_method purpose".as_slice());
        } else if peek_is(s, t, p.current, "notes".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.DID_METHOD_DECL_NOTES, "did_method".as_slice(), "did_method notes".as_slice());
        } else {
            return block_unexpected(s, t, p, "did_method".as_slice(), "a".as_slice());
        }
        if p.failed { return p; }
    }
    let fallback: u64 = name_span(p.slots.as_slice(), p.nodes.as_slice(), node);
    p = default_unknown(p, node, agent_schema.DID_METHOD_DECL_STATUS, agent_schema.DID_METHOD_STATUS, agent_schema.DID_METHOD_STATUS_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.DID_METHOD_DECL_RESOLUTION, agent_schema.DID_RESOLUTION_MODE, agent_schema.DID_RESOLUTION_MODE_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.DID_METHOD_DECL_LEDGER, agent_schema.DID_LEDGER_MODE, agent_schema.DID_LEDGER_MODE_UNKNOWN, fallback);
    p = default_string(p, node, agent_schema.DID_METHOD_DECL_CRYPTO_BOUNDARY, fallback);
    p = default_array(p, node, agent_schema.DID_METHOD_DECL_PURPOSE);
    block_end(t, p, node)
}

// `parse_atrust_boundary`.
fn parse_atrust_boundary(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "atrust_boundary".as_slice(), "atrust boundary name".as_slice(), agent_schema.A_TRUST_BOUNDARY_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated atrust_boundary declaration".as_slice());
        if p.failed { return p; }
        if peek_is(s, t, p.current, "crypto_boundary".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.A_TRUST_BOUNDARY_DECL_CRYPTO_BOUNDARY, "atrust_boundary".as_slice(), "atrust_boundary crypto_boundary reference".as_slice());
        } else if peek_is(s, t, p.current, "did_methods".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.A_TRUST_BOUNDARY_DECL_DID_METHODS, "atrust_boundary".as_slice(), "atrust_boundary did_methods".as_slice());
        } else if peek_is(s, t, p.current, "identity_format".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_BOUNDARY_DECL_IDENTITY_FORMAT, "atrust_boundary".as_slice(), "atrust_boundary identity_format".as_slice(), agent_schema.A_TRUST_IDENTITY_FORMAT, agent_words.T_PARSE_ATRUST_BOUNDARY__A_TRUST_IDENTITY_FORMAT, agent_schema.A_TRUST_IDENTITY_FORMAT_UNKNOWN);
        } else if peek_is(s, t, p.current, "credential_mode".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_BOUNDARY_DECL_CREDENTIAL_MODE, "atrust_boundary".as_slice(), "atrust_boundary credential_mode".as_slice(), agent_schema.A_TRUST_CREDENTIAL_MODE, agent_words.T_PARSE_ATRUST_BOUNDARY__A_TRUST_CREDENTIAL_MODE, agent_schema.A_TRUST_CREDENTIAL_MODE_UNKNOWN);
        } else if peek_is(s, t, p.current, "handshake".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_BOUNDARY_DECL_HANDSHAKE, "atrust_boundary".as_slice(), "atrust_boundary handshake".as_slice(), agent_schema.A_TRUST_HANDSHAKE_MODE, agent_words.T_PARSE_ATRUST_BOUNDARY__A_TRUST_HANDSHAKE_MODE, agent_schema.A_TRUST_HANDSHAKE_MODE_UNKNOWN);
        } else if peek_is(s, t, p.current, "resolution".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_BOUNDARY_DECL_RESOLUTION, "atrust_boundary".as_slice(), "atrust_boundary resolution".as_slice(), agent_schema.A_TRUST_RESOLUTION_MODE, agent_words.T_PARSE_ATRUST_BOUNDARY__A_TRUST_RESOLUTION_MODE, agent_schema.A_TRUST_RESOLUTION_MODE_UNKNOWN);
        } else if peek_is(s, t, p.current, "key_material".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_BOUNDARY_DECL_KEY_MATERIAL, "atrust_boundary".as_slice(), "atrust_boundary key_material".as_slice(), agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_words.T_PARSE_ATRUST_BOUNDARY__A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN);
        } else if peek_is(s, t, p.current, "secret_material".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_BOUNDARY_DECL_SECRET_MATERIAL, "atrust_boundary".as_slice(), "atrust_boundary secret_material".as_slice(), agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_words.T_PARSE_ATRUST_BOUNDARY__A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN);
        } else if peek_is(s, t, p.current, "execution".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_BOUNDARY_DECL_EXECUTION, "atrust_boundary".as_slice(), "atrust_boundary execution".as_slice(), agent_schema.A_TRUST_EXECUTION, agent_words.T_PARSE_ATRUST_BOUNDARY__A_TRUST_EXECUTION, agent_schema.A_TRUST_EXECUTION_UNKNOWN);
        } else if peek_is(s, t, p.current, "post_quantum_ready".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_BOUNDARY_DECL_POST_QUANTUM_READY, "atrust_boundary".as_slice(), "atrust_boundary post_quantum_ready".as_slice(), agent_schema.A_TRUST_POST_QUANTUM_REQUIREMENT, agent_words.T_PARSE_ATRUST_BOUNDARY__A_TRUST_POST_QUANTUM_REQUIREMENT, agent_schema.A_TRUST_POST_QUANTUM_REQUIREMENT_UNKNOWN);
        } else if peek_is(s, t, p.current, "security_claims".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_BOUNDARY_DECL_SECURITY_CLAIMS, "atrust_boundary".as_slice(), "atrust_boundary security_claims".as_slice(), agent_schema.A_TRUST_SECURITY_CLAIMS, agent_words.T_PARSE_ATRUST_BOUNDARY__A_TRUST_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS_UNKNOWN);
        } else if peek_is(s, t, p.current, "purpose".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.A_TRUST_BOUNDARY_DECL_PURPOSE, "atrust_boundary".as_slice(), "atrust_boundary purpose".as_slice());
        } else if peek_is(s, t, p.current, "notes".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.A_TRUST_BOUNDARY_DECL_NOTES, "atrust_boundary".as_slice(), "atrust_boundary notes".as_slice());
        } else {
            return block_unexpected(s, t, p, "atrust_boundary".as_slice(), "an".as_slice());
        }
        if p.failed { return p; }
    }
    let fallback: u64 = name_span(p.slots.as_slice(), p.nodes.as_slice(), node);
    p = default_string(p, node, agent_schema.A_TRUST_BOUNDARY_DECL_CRYPTO_BOUNDARY, fallback);
    p = default_array(p, node, agent_schema.A_TRUST_BOUNDARY_DECL_DID_METHODS);
    p = default_unknown(p, node, agent_schema.A_TRUST_BOUNDARY_DECL_IDENTITY_FORMAT, agent_schema.A_TRUST_IDENTITY_FORMAT, agent_schema.A_TRUST_IDENTITY_FORMAT_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_BOUNDARY_DECL_CREDENTIAL_MODE, agent_schema.A_TRUST_CREDENTIAL_MODE, agent_schema.A_TRUST_CREDENTIAL_MODE_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_BOUNDARY_DECL_HANDSHAKE, agent_schema.A_TRUST_HANDSHAKE_MODE, agent_schema.A_TRUST_HANDSHAKE_MODE_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_BOUNDARY_DECL_RESOLUTION, agent_schema.A_TRUST_RESOLUTION_MODE, agent_schema.A_TRUST_RESOLUTION_MODE_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_BOUNDARY_DECL_KEY_MATERIAL, agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_BOUNDARY_DECL_SECRET_MATERIAL, agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_BOUNDARY_DECL_EXECUTION, agent_schema.A_TRUST_EXECUTION, agent_schema.A_TRUST_EXECUTION_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_BOUNDARY_DECL_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS_UNKNOWN, fallback);
    p = default_array(p, node, agent_schema.A_TRUST_BOUNDARY_DECL_PURPOSE);
    block_end(t, p, node)
}

// `parse_atrust_identity`.
fn parse_atrust_identity(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "atrust_identity".as_slice(), "atrust identity name".as_slice(), agent_schema.A_TRUST_IDENTITY_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated atrust_identity declaration".as_slice());
        if p.failed { return p; }
        if peek_is(s, t, p.current, "subject".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.A_TRUST_IDENTITY_DECL_SUBJECT, "atrust_identity".as_slice(), "atrust_identity subject agent".as_slice());
        } else if peek_is(s, t, p.current, "did".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.A_TRUST_IDENTITY_DECL_DID, "atrust_identity".as_slice(), "atrust_identity did".as_slice());
        } else if peek_is(s, t, p.current, "method".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.A_TRUST_IDENTITY_DECL_METHOD, "atrust_identity".as_slice(), "atrust_identity did_method reference".as_slice());
        } else if peek_is(s, t, p.current, "boundary".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.A_TRUST_IDENTITY_DECL_BOUNDARY, "atrust_identity".as_slice(), "atrust_identity atrust_boundary reference".as_slice());
        } else if peek_is(s, t, p.current, "status".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_IDENTITY_DECL_STATUS, "atrust_identity".as_slice(), "atrust_identity status".as_slice(), agent_schema.A_TRUST_IDENTITY_STATUS, agent_words.T_PARSE_ATRUST_IDENTITY__A_TRUST_IDENTITY_STATUS, agent_schema.A_TRUST_IDENTITY_STATUS_UNKNOWN);
        } else if peek_is(s, t, p.current, "validation".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_IDENTITY_DECL_VALIDATION, "atrust_identity".as_slice(), "atrust_identity validation".as_slice(), agent_schema.A_TRUST_IDENTITY_VALIDATION, agent_words.T_PARSE_ATRUST_IDENTITY__A_TRUST_IDENTITY_VALIDATION, agent_schema.A_TRUST_IDENTITY_VALIDATION_UNKNOWN);
        } else if peek_is(s, t, p.current, "resolution".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_IDENTITY_DECL_RESOLUTION, "atrust_identity".as_slice(), "atrust_identity resolution".as_slice(), agent_schema.A_TRUST_RESOLUTION_MODE, agent_words.T_PARSE_ATRUST_IDENTITY__A_TRUST_RESOLUTION_MODE, agent_schema.A_TRUST_RESOLUTION_MODE_UNKNOWN);
        } else if peek_is(s, t, p.current, "key_material".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_IDENTITY_DECL_KEY_MATERIAL, "atrust_identity".as_slice(), "atrust_identity key_material".as_slice(), agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_words.T_PARSE_ATRUST_IDENTITY__A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN);
        } else if peek_is(s, t, p.current, "secret_material".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_IDENTITY_DECL_SECRET_MATERIAL, "atrust_identity".as_slice(), "atrust_identity secret_material".as_slice(), agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_words.T_PARSE_ATRUST_IDENTITY__A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN);
        } else if peek_is(s, t, p.current, "execution".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_IDENTITY_DECL_EXECUTION, "atrust_identity".as_slice(), "atrust_identity execution".as_slice(), agent_schema.A_TRUST_EXECUTION, agent_words.T_PARSE_ATRUST_IDENTITY__A_TRUST_EXECUTION, agent_schema.A_TRUST_EXECUTION_UNKNOWN);
        } else if peek_is(s, t, p.current, "evidence".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_IDENTITY_DECL_EVIDENCE, "atrust_identity".as_slice(), "atrust_identity evidence".as_slice(), agent_schema.A_TRUST_EVIDENCE_REQUIREMENT, agent_words.T_PARSE_ATRUST_IDENTITY__A_TRUST_EVIDENCE_REQUIREMENT, agent_schema.A_TRUST_EVIDENCE_REQUIREMENT_UNKNOWN);
        } else if peek_is(s, t, p.current, "security_claims".as_slice()) {
            p = field_enum(s, t, p, node, agent_schema.A_TRUST_IDENTITY_DECL_SECURITY_CLAIMS, "atrust_identity".as_slice(), "atrust_identity security_claims".as_slice(), agent_schema.A_TRUST_SECURITY_CLAIMS, agent_words.T_PARSE_ATRUST_IDENTITY__A_TRUST_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS_UNKNOWN);
        } else if peek_is(s, t, p.current, "purpose".as_slice()) {
            p = field_string_array(s, t, p, node, agent_schema.A_TRUST_IDENTITY_DECL_PURPOSE, "atrust_identity".as_slice(), "atrust_identity purpose".as_slice());
        } else if peek_is(s, t, p.current, "notes".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.A_TRUST_IDENTITY_DECL_NOTES, "atrust_identity".as_slice(), "atrust_identity notes".as_slice());
        } else {
            return block_unexpected(s, t, p, "atrust_identity".as_slice(), "an".as_slice());
        }
        if p.failed { return p; }
    }
    let fallback: u64 = name_span(p.slots.as_slice(), p.nodes.as_slice(), node);
    p = default_string(p, node, agent_schema.A_TRUST_IDENTITY_DECL_SUBJECT, fallback);
    p = default_string(p, node, agent_schema.A_TRUST_IDENTITY_DECL_DID, fallback);
    p = default_string(p, node, agent_schema.A_TRUST_IDENTITY_DECL_METHOD, fallback);
    p = default_string(p, node, agent_schema.A_TRUST_IDENTITY_DECL_BOUNDARY, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_IDENTITY_DECL_STATUS, agent_schema.A_TRUST_IDENTITY_STATUS, agent_schema.A_TRUST_IDENTITY_STATUS_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_IDENTITY_DECL_VALIDATION, agent_schema.A_TRUST_IDENTITY_VALIDATION, agent_schema.A_TRUST_IDENTITY_VALIDATION_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_IDENTITY_DECL_RESOLUTION, agent_schema.A_TRUST_RESOLUTION_MODE, agent_schema.A_TRUST_RESOLUTION_MODE_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_IDENTITY_DECL_KEY_MATERIAL, agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_IDENTITY_DECL_SECRET_MATERIAL, agent_schema.A_TRUST_MATERIAL_BOUNDARY, agent_schema.A_TRUST_MATERIAL_BOUNDARY_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_IDENTITY_DECL_EXECUTION, agent_schema.A_TRUST_EXECUTION, agent_schema.A_TRUST_EXECUTION_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_IDENTITY_DECL_EVIDENCE, agent_schema.A_TRUST_EVIDENCE_REQUIREMENT, agent_schema.A_TRUST_EVIDENCE_REQUIREMENT_UNKNOWN, fallback);
    p = default_unknown(p, node, agent_schema.A_TRUST_IDENTITY_DECL_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS, agent_schema.A_TRUST_SECURITY_CLAIMS_UNKNOWN, fallback);
    p = default_array(p, node, agent_schema.A_TRUST_IDENTITY_DECL_PURPOSE);
    block_end(t, p, node)
}

// `parse_atrust_credential_contract`.
fn parse_atrust_credential_contract(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "atrust_credential_contract".as_slice(), "atrust credential contract name".as_slice(), agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated atrust_credential_contract declaration".as_slice());
        if p.failed { return p; }
        if peek_is(s, t, p.current, "subject".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_SUBJECT, "atrust_credential_contract".as_slice(), "atrust_credential_contract subject agent".as_slice());
        } else if peek_is(s, t, p.current, "identity".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_IDENTITY, "atrust_credential_contract".as_slice(), "atrust_credential_contract identity reference".as_slice());
        } else if peek_is(s, t, p.current, "boundary".as_slice()) {
            p = field_ident(s, t, p, node, agent_schema.A_TRUST_CREDENTIAL_CONTRACT_DECL_BOUNDARY, "atrust_credential_contract".as_slice(), "atrust_credential_contract atrust_boundary reference".as_slice());
        } else if peek_is(s, t, p.current, "method".as_slice()) {
