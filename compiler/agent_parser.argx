        } else if peek_is(s, t, p.current, "security_claims".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.THREAT_MODEL_DECL_SECURITY_CLAIMS, "threat_model".as_slice(), "threat_model field value".as_slice(), LATE_IDENT);
        } else {
            return block_unexpected(s, t, p, "threat_model".as_slice(), "".as_slice());
        }
        if p.failed { return p; }
    }
    let fallback: u64 = name_span(p.slots.as_slice(), p.nodes.as_slice(), node);
    p = default_array(p, node, agent_schema.THREAT_MODEL_DECL_ASSETS);
    p = default_array(p, node, agent_schema.THREAT_MODEL_DECL_THREATS);
    p = default_array(p, node, agent_schema.THREAT_MODEL_DECL_MITIGATIONS);
    p = default_array(p, node, agent_schema.THREAT_MODEL_DECL_PURPOSE);
    p = default_string(p, node, agent_schema.THREAT_MODEL_DECL_HARDENING_PROFILE, fallback);
    p = default_string(p, node, agent_schema.THREAT_MODEL_DECL_EVIDENCE_MAP, fallback);
    p = default_string(p, node, agent_schema.THREAT_MODEL_DECL_GOVERNANCE_PROFILE, fallback);
    p = default_string(p, node, agent_schema.THREAT_MODEL_DECL_PUBLIC_CONFORMANCE_REPORT, fallback);
    p = default_string(p, node, agent_schema.THREAT_MODEL_DECL_METHODOLOGY, fallback);
    p = default_string(p, node, agent_schema.THREAT_MODEL_DECL_SCOPE, fallback);
    p = default_string(p, node, agent_schema.THREAT_MODEL_DECL_REVIEW_STATUS, fallback);
    p = default_string(p, node, agent_schema.THREAT_MODEL_DECL_RESIDUAL_RISK, fallback);
    p = default_string(p, node, agent_schema.THREAT_MODEL_DECL_RISK_ACCEPTANCE, fallback);
    p = default_string(p, node, agent_schema.THREAT_MODEL_DECL_NETWORK, fallback);
    p = default_string(p, node, agent_schema.THREAT_MODEL_DECL_EXTERNAL_EXECUTION, fallback);
    p = default_string(p, node, agent_schema.THREAT_MODEL_DECL_TOOL_EXECUTION, fallback);
    p = default_string(p, node, agent_schema.THREAT_MODEL_DECL_AGENT_EXECUTION, fallback);
    p = default_string(p, node, agent_schema.THREAT_MODEL_DECL_SECRET_MATERIAL, fallback);
    p = default_string(p, node, agent_schema.THREAT_MODEL_DECL_KEY_MATERIAL, fallback);
    p = default_string(p, node, agent_schema.THREAT_MODEL_DECL_EXECUTION, fallback);
    p = default_string(p, node, agent_schema.THREAT_MODEL_DECL_SECURITY_CLAIMS, fallback);
    block_end(t, p, node)
}

fn parse_spec_freeze(s: Slice<u8>, t: Slice<AgentToken>, parser: Tree) -> Tree {
    let mut p: Tree = block_start(s, t, parser, "spec_freeze".as_slice(), "spec_freeze name".as_slice(), agent_schema.SPEC_FREEZE_DECL);
    if p.failed { return p; }
    let node: u64 = p.result;
    while peek_kind(t, p.current) != agent_lexer.RIGHT_BRACE {
        p = ensure_not_eof(t, p, "unterminated spec_freeze declaration".as_slice());
        if p.failed { return p; }
        if peek_is(s, t, p.current, "notes".as_slice()) {
            p = field_string(s, t, p, node, agent_schema.SPEC_FREEZE_DECL_NOTES, "spec_freeze".as_slice(), "spec_freeze notes".as_slice());
        } else if peek_is(s, t, p.current, "frozen_features".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.SPEC_FREEZE_DECL_FROZEN_FEATURES, "spec_freeze".as_slice(), "spec_freeze array value".as_slice(), LATE_ARRAY);
