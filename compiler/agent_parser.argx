        } else if peek_is(s, t, p.current, "agent_execution".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.SPEC_FREEZE_DECL_AGENT_EXECUTION, "spec_freeze".as_slice(), "spec_freeze field value".as_slice(), LATE_IDENT);
        } else if peek_is(s, t, p.current, "security_claims".as_slice()) {
            p = field_late(s, t, p, node, agent_schema.SPEC_FREEZE_DECL_SECURITY_CLAIMS, "spec_freeze".as_slice(), "spec_freeze field value".as_slice(), LATE_IDENT);
        } else if peek_is(s, t, p.current, "legal_claims".as_slice()) {
