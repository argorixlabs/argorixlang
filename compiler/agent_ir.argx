    y = key(y, "version".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.PASSPORT_DECL_VERSION));
    y = optional_value_skip(y, sl, n, st, "ans_name".as_slice(), get(sl, n, node, agent_schema.PASSPORT_DECL_ANS_NAME));
    y = key(y, "country".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.PASSPORT_DECL_COUNTRY));
    y = key(y, "jurisdiction".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.PASSPORT_DECL_JURISDICTION));
    y = values(y, sl, n, st, "data_residency".as_slice(), get(sl, n, node, agent_schema.PASSPORT_DECL_DATA_RESIDENCY));
    y = optional_skip(y, sl, n, st, "asn".as_slice(), get(sl, n, node, agent_schema.PASSPORT_DECL_ASN), IR_PASSPORT_ASN);
    y = optional_value_skip(y, sl, n, st, "model".as_slice(), get(sl, n, node, agent_schema.PASSPORT_DECL_MODEL));
    y = key(y, "risk_level".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.PASSPORT_DECL_RISK_LEVEL));
    y = values(y, sl, n, st, "data_scope".as_slice(), get(sl, n, node, agent_schema.PASSPORT_DECL_DATA_SCOPE));
    y = key(y, "intent".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.PASSPORT_DECL_INTENT));
    y = values(y, sl, n, st, "intended_use".as_slice(), get(sl, n, node, agent_schema.PASSPORT_DECL_INTENDED_USE));
    y = values(y, sl, n, st, "prohibited_use".as_slice(), get(sl, n, node, agent_schema.PASSPORT_DECL_PROHIBITED_USE));
    y = values(y, sl, n, st, "attestations".as_slice(), get(sl, n, node, agent_schema.PASSPORT_DECL_ATTESTATIONS));
    close(y, 125u8)
}

