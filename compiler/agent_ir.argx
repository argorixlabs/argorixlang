    y = optional_value_null(y, sl, n, st, "argument".as_slice(), get(sl, n, node, agent_schema.ASSERTION_DECL_ARGUMENT));
    close(y, 125u8)
}

fn emit_policy(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, node: u64) -> Pretty {
