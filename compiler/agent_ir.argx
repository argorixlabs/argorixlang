fn emit_agent(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, node: u64) -> Pretty {
    let mut y: Pretty = open(state, 123u8);
    y = key(y, "name".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.AGENT_DECL_NAME));
    y = special_agent_approval(y, sl, n, st, "approval".as_slice(), node);
    y = list(y, sl, n, st, "receives".as_slice(), get(sl, n, node, agent_schema.AGENT_DECL_RECEIVES), IR_RECEIVE);
    y = list(y, sl, n, st, "sends".as_slice(), get(sl, n, node, agent_schema.AGENT_DECL_SENDS), IR_SEND);
    y = values(y, sl, n, st, "capabilities".as_slice(), get(sl, n, node, agent_schema.AGENT_DECL_CAPABILITIES));
    y = values(y, sl, n, st, "tools".as_slice(), get(sl, n, node, agent_schema.AGENT_DECL_TOOLS));
    y = values(y, sl, n, st, "models".as_slice(), get(sl, n, node, agent_schema.AGENT_DECL_MODELS));
    y = list(y, sl, n, st, "handlers".as_slice(), get(sl, n, node, agent_schema.AGENT_DECL_HANDLERS), IR_HANDLER);
    close(y, 125u8)
}

