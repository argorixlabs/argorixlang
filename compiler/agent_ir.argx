    y = value(y, sl, n, st, get(sl, n, node, agent_schema.PROTOCOL_DECL_NAME));
    y = list(y, sl, n, st, "steps".as_slice(), get(sl, n, node, agent_schema.PROTOCOL_DECL_STEPS), IR_PROTOCOL_STEP);
    close(y, 125u8)
}

