core 0.1;
module compiler.agent_ir;

// The IR of the agent language, in Argorix (ESP-018.D). It ports
// `IrProgram::from(&Program)` of crates/argorix_ir/src/ir.rs over the tree of
// compiler.agent_parser, and writes it as serde_json's pretty JSON: the dump
// of spec/language/ir.md. The emitters of the IR types are generated from
// ir.rs (crates/argorixc/tests/agent_ir_table.rs); the fields of no regular
// shape are the `special_*` functions below.

import stdlib.bytes;
import compiler.agent_ast;
import compiler.agent_schema;
import compiler.agent_parser;
import compiler.agent_check;

// The output and serde_json's pretty layout: `depth` levels of two spaces,
// and `first` while the innermost object or array has no member yet.
// `modules` and `imports` are a package's, one `name path` or `from to`
// line each; empty for one file.
struct Pretty { out: Buffer<u8>, depth: u64, first: bool, modules: Buffer<u8>, imports: Buffer<u8>, }

// The dump: the checker's when the program does not parse or check,
// otherwise the IR and a line feed.
pub fn dump(source: Slice<u8>) -> Buffer<u8> {
    let checked: Buffer<u8> = agent_check.dump(source);
    if !bytes.equal(checked.as_slice(), "ok\n".as_slice()) {
        return checked;
    }
    let parsed: Tree = agent_parser.parse(source);
    program_ir(parsed.slots.as_slice(), parsed.nodes.as_slice(), parsed.strings.as_slice(), parsed.result, "".as_slice(), "".as_slice())
}

// The IR of a checked `program` and a line feed, with a package's modules
// and imports (`name path` and `from to` lines; empty for one file).
pub fn program_ir(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64, modules: Slice<u8>, imports: Slice<u8>) -> Buffer<u8> {
    let start: Pretty = Pretty { out: Buffer::new(), depth: 0u64, first: true, modules: bytes.copy(modules), imports: bytes.copy(imports) };
    let y: Pretty = emit_program(start, sl, n, st, program);
    let mut out: Buffer<u8> = bytes.copy(y.out.as_slice());
    out.push(10u8);
    out
}

// ------------------------------------------------------------------ the layout

fn open(state: Pretty, byte: u8) -> Pretty {
    let mut y: Pretty = state;
    y.out.push(byte);
    y.depth += 1u64;
    y.first = true;
    y
}

fn close(state: Pretty, byte: u8) -> Pretty {
    let mut y: Pretty = state;
    y.depth -= 1u64;
    if !y.first {
        y = newline(y);
    }
    y.out.push(byte);
    y.first = false;
    y
}

fn newline(state: Pretty) -> Pretty {
    let mut y: Pretty = state;
    y.out.push(10u8);
    let mut index: u64 = 0u64;
    while index < y.depth {
        y.out.push(32u8);
        y.out.push(32u8);
        index += 1u64;
    }
    y
}

// Where the next member of the innermost object or array starts.
fn member(state: Pretty) -> Pretty {
    let mut y: Pretty = state;
    if !y.first {
        y.out.push(44u8);
    }
    y.first = false;
    newline(y)
}

fn key(state: Pretty, name: Slice<u8>) -> Pretty {
    let mut y: Pretty = text(member(state), name);
    y.out.push(58u8);
    y.out.push(32u8);
    y
}

// `value` as a JSON string, escaped as serde_json escapes it.
fn text(state: Pretty, value: Slice<u8>) -> Pretty {
    let mut y: Pretty = state;
    y.out.push(34u8);
    let mut at: u64 = 0u64;
    while at < value.length() {
        let byte: u8 = value[at];
        if byte == 34u8 || byte == 92u8 {
            y.out.push(92u8);
            y.out.push(byte);
        } else if byte == 8u8 {
            y.out.push(92u8);
            y.out.push(98u8);
        } else if byte == 9u8 {
            y.out.push(92u8);
            y.out.push(116u8);
        } else if byte == 10u8 {
            y.out.push(92u8);
            y.out.push(110u8);
        } else if byte == 12u8 {
            y.out.push(92u8);
            y.out.push(102u8);
        } else if byte == 13u8 {
            y.out.push(92u8);
            y.out.push(114u8);
        } else if byte < 32u8 {
            y.out.push(92u8);
            y.out.push(117u8);
            y.out.push(48u8);
            y.out.push(48u8);
            y.out.push(hex(byte / 16u8));
            y.out.push(hex(byte % 16u8));
        } else {
            y.out.push(byte);
        }
        at += 1u64;
    }
    y.out.push(34u8);
    y
}

fn hex(digit: u8) -> u8 {
    if digit < 10u8 {
        return 48u8 + digit;
    }
    87u8 + digit
}

fn word(state: Pretty, value: Slice<u8>) -> Pretty {
    let mut y: Pretty = state;
    let mut index: u64 = 0u64;
    while index < value.length() {
        y.out.push(value[index]);
        index += 1u64;
    }
    y
}

// ------------------------------------------------------------------ values of the tree

fn get(sl: Slice<u64>, n: Slice<AgentNode>, node: u64, field: u64) -> u64 {
    agent_ast.get(sl, n, node, field)
}

// A string, integer, boolean, null or enum of the tree, as JSON.
fn scalar(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, node: u64) -> Pretty {
    let found: AgentNode = n[node];
    if found.kind == agent_ast.N_STRING {
        return text(state, st.slice(found.a, found.b));
    }
    if found.kind == agent_ast.N_INTEGER {
        let digits: Buffer<u8> = bytes.append_decimal(Buffer::new(), found.a);
        return word(state, digits.as_slice());
    }
    if found.kind == agent_ast.N_BOOL {
        if found.a == 1u64 {
            return word(state, "true".as_slice());
        }
        return word(state, "false".as_slice());
    }
    if found.kind == agent_ast.N_VARIANT {
        return variant_name(state, n, st, node);
    }
    word(state, "null".as_slice())
}

// An enum's `source_name()`: the word itself for `Unknown`.
fn variant_name(state: Pretty, n: Slice<AgentNode>, st: Slice<u8>, node: u64) -> Pretty {
    let found: AgentNode = n[node];
    if found.b != 0u64 && n[found.b].kind == agent_ast.N_STRING {
        return text(state, st.slice(n[found.b].a, n[found.b].b));
    }
    let named: Buffer<u8> = agent_schema.append_source_name(Buffer::new(), found.schema, found.a);
    text(state, named.as_slice())
}

// The value of a `Spanned`.
fn value(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, spanned: u64) -> Pretty {
    scalar(state, sl, n, st, get(sl, n, spanned, agent_schema.SPANNED_VALUE))
}

// The source name of a `Spanned` enum.
fn name(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, spanned: u64) -> Pretty {
    variant_name(state, n, st, get(sl, n, spanned, agent_schema.SPANNED_VALUE))
}

fn optional_value_skip(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, field: Slice<u8>, spanned: u64) -> Pretty {
    if spanned == 0u64 {
        return state;
    }
    value(key(state, field), sl, n, st, spanned)
}

fn optional_value_null(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, field: Slice<u8>, spanned: u64) -> Pretty {
    let y: Pretty = key(state, field);
    if spanned == 0u64 {
        return word(y, "null".as_slice());
    }
    value(y, sl, n, st, spanned)
}

fn optional_name_skip(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, field: Slice<u8>, spanned: u64) -> Pretty {
    if spanned == 0u64 {
        return state;
    }
    name(key(state, field), sl, n, st, spanned)
}

fn optional_name_null(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, field: Slice<u8>, spanned: u64) -> Pretty {
    let y: Pretty = key(state, field);
    if spanned == 0u64 {
        return word(y, "null".as_slice());
    }
    name(y, sl, n, st, spanned)
}

// A list of `Spanned` values.
fn values(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, field: Slice<u8>, array: u64) -> Pretty {
    let mut y: Pretty = open(key(state, field), 91u8);
    let mut link: u64 = n[array].a;
    while link != 0u64 {
        let item: u64 = link - 1u64;
        link = n[item].next;
        y = value(member(y), sl, n, st, item);
    }
    close(y, 93u8)
}

fn values_skip(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, field: Slice<u8>, array: u64) -> Pretty {
    if n[array].a == 0u64 {
        return state;
    }
    values(state, sl, n, st, field, array)
}

// A list of IR type `s`, one per element of `array`.
fn list(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, field: Slice<u8>, array: u64, s: u64) -> Pretty {
    let mut y: Pretty = open(key(state, field), 91u8);
    let mut link: u64 = n[array].a;
    while link != 0u64 {
        let item: u64 = link - 1u64;
        link = n[item].next;
        y = emit(member(y), sl, n, st, s, item);
    }
    close(y, 93u8)
}

fn list_skip(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, field: Slice<u8>, array: u64, s: u64) -> Pretty {
    if n[array].a == 0u64 {
        return state;
    }
    list(state, sl, n, st, field, array, s)
}

fn optional_skip(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, field: Slice<u8>, node: u64, s: u64) -> Pretty {
    if node == 0u64 {
        return state;
    }
    emit(key(state, field), sl, n, st, s, node)
}

fn optional_null(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, field: Slice<u8>, node: u64, s: u64) -> Pretty {
    let y: Pretty = key(state, field);
    if node == 0u64 {
        return word(y, "null".as_slice());
    }
    emit(y, sl, n, st, s, node)
}

// ------------------------------------------------------------------ the fields written by hand

// A package's modules and imports, which `package_ir` fills; both are left
// out when empty, as for one file.
fn special_program_modules(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, field: Slice<u8>, node: u64) -> Pretty {
    let lines: Buffer<u8> = bytes.copy(state.modules.as_slice());
    pairs(state, field, lines.as_slice(), "name".as_slice(), "path".as_slice())
}

fn special_program_imports(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, field: Slice<u8>, node: u64) -> Pretty {
    let lines: Buffer<u8> = bytes.copy(state.imports.as_slice());
    pairs(state, field, lines.as_slice(), "from".as_slice(), "to".as_slice())
}

// A list of objects `{left: .., right: ..}`, one per `left right` line.
fn pairs(state: Pretty, field: Slice<u8>, lines: Slice<u8>, left: Slice<u8>, right: Slice<u8>) -> Pretty {
    if lines.length() == 0u64 {
        return state;
    }
    let mut y: Pretty = open(key(state, field), 91u8);
    let mut start: u64 = 0u64;
    let mut at: u64 = 0u64;
    while at < lines.length() {
        if lines[at] == 10u8 {
            let mut space: u64 = start;
            while lines[space] != 32u8 {
                space += 1u64;
            }
            y = open(member(y), 123u8);
            y = text(key(y, left), lines.slice(start, space));
            y = text(key(y, right), lines.slice(space + 1u64, at));
            y = close(y, 125u8);
            start = at + 1u64;
        }
        at += 1u64;
    }
    close(y, 93u8)
}

// `declaration.effect()`: `require` or `deny`.
fn special_policy_rule_effect(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, field: Slice<u8>, node: u64) -> Pretty {
    let y: Pretty = key(state, field);
    if n[node].a == agent_schema.POLICY_RULE_DECL_REQUIRE {
        return text(y, "require".as_slice());
    }
    text(y, "deny".as_slice())
}

// `declaration.rule().value.source_name()`.
fn special_policy_rule_rule(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, field: Slice<u8>, node: u64) -> Pretty {
    let rule: u64 = get(sl, n, n[node].b, 0u64);
    name(key(state, field), sl, n, st, rule)
}

// `resolved_provider`: the tool's provider, or `simulated`.
fn special_tool_provider(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, field: Slice<u8>, node: u64) -> Pretty {
    let y: Pretty = key(state, field);
    let provider: u64 = get(sl, n, node, agent_schema.TOOL_DECL_PROVIDER);
    if provider == 0u64 {
        return text(y, "simulated".as_slice());
    }
    value(y, sl, n, st, provider)
}

// `effective_approval()`: the agent's approval, or `denied`.
fn special_agent_approval(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, field: Slice<u8>, node: u64) -> Pretty {
    let y: Pretty = key(state, field);
    let approval: u64 = get(sl, n, node, agent_schema.AGENT_DECL_APPROVAL);
    if approval == 0u64 {
        return text(y, "denied".as_slice());
    }
    name(y, sl, n, st, approval)
}

// Each instruction as an object tagged by `op`, its fields in order.
fn special_handler_instructions(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, field: Slice<u8>, node: u64) -> Pretty {
    let mut y: Pretty = open(key(state, field), 91u8);
    let mut link: u64 = n[get(sl, n, node, agent_schema.HANDLER_DECL_INSTRUCTIONS)].a;
    while link != 0u64 {
        let instruction: u64 = link - 1u64;
        link = n[instruction].next;
        y = open(member(y), 123u8);
        let which: u64 = n[instruction].a;
        let fields: u64 = n[instruction].b;
        if which == agent_schema.HANDLER_INSTRUCTION_EMIT {
            y = text(key(y, "op".as_slice()), "emit".as_slice());
            y = value(key(y, "message_type".as_slice()), sl, n, st, get(sl, n, fields, agent_schema.HANDLER_INSTRUCTION__EMIT_MESSAGE_TYPE));
            y = value(key(y, "to".as_slice()), sl, n, st, get(sl, n, fields, agent_schema.HANDLER_INSTRUCTION__EMIT_TO));
        } else if which == agent_schema.HANDLER_INSTRUCTION_TRACE {
            y = text(key(y, "op".as_slice()), "trace".as_slice());
            y = value(key(y, "binding".as_slice()), sl, n, st, get(sl, n, fields, agent_schema.HANDLER_INSTRUCTION__TRACE_BINDING));
        } else if which == agent_schema.HANDLER_INSTRUCTION_HALT {
            y = text(key(y, "op".as_slice()), "halt".as_slice());
        } else if which == agent_schema.HANDLER_INSTRUCTION_INTRINSIC_CALL {
            y = text(key(y, "op".as_slice()), "intrinsic".as_slice());
            y = value(key(y, "name".as_slice()), sl, n, st, get(sl, n, fields, agent_schema.HANDLER_INSTRUCTION__INTRINSIC_CALL_NAME));
            y = value(key(y, "argument".as_slice()), sl, n, st, get(sl, n, fields, agent_schema.HANDLER_INSTRUCTION__INTRINSIC_CALL_ARGUMENT));
        } else if which == agent_schema.HANDLER_INSTRUCTION_CALL_TOOL {
            y = text(key(y, "op".as_slice()), "call".as_slice());
            y = value(key(y, "tool".as_slice()), sl, n, st, get(sl, n, fields, agent_schema.HANDLER_INSTRUCTION__CALL_TOOL_TOOL));
            y = value(key(y, "binding".as_slice()), sl, n, st, get(sl, n, fields, agent_schema.HANDLER_INSTRUCTION__CALL_TOOL_BINDING));
        } else {
            y = text(key(y, "op".as_slice()), "ask".as_slice());
            y = value(key(y, "model".as_slice()), sl, n, st, get(sl, n, fields, agent_schema.HANDLER_INSTRUCTION__ASK_MODEL_MODEL));
            y = value(key(y, "binding".as_slice()), sl, n, st, get(sl, n, fields, agent_schema.HANDLER_INSTRUCTION__ASK_MODEL_BINDING));
        }
        y = close(y, 125u8);
    }
    close(y, 93u8)
}

// ------------------------------------------------------------------ generated IR emitters
// GENERATED by crates/argorixc/tests/agent_ir_table.rs from the IR types and
// `IrProgram::from` of crates/argorix_ir/src/ir.rs. Do not edit by hand;
// ARGORIX_BLESS=1 regenerates it.

pub const IR_PROGRAM: u64 = 0u64;
pub const IR_PROVIDER_CONTRACT: u64 = 1u64;
pub const IR_PROVIDER_HARNESS: u64 = 2u64;
pub const IR_FEATURE: u64 = 3u64;
pub const IR_SECRET: u64 = 4u64;
pub const IR_ADAPTER: u64 = 5u64;
pub const IR_ADAPTER_PROFILE: u64 = 6u64;
pub const IR_CRYPTO: u64 = 7u64;
pub const IR_CRYPTO_BOUNDARY: u64 = 8u64;
pub const IR_DID_METHOD: u64 = 9u64;
pub const IR_A_TRUST_BOUNDARY: u64 = 10u64;
pub const IR_A_TRUST_IDENTITY: u64 = 11u64;
pub const IR_A_TRUST_CREDENTIAL_CONTRACT: u64 = 12u64;
pub const IR_A_TRUST_HANDSHAKE: u64 = 13u64;
pub const IR_TRUST_LEDGER: u64 = 14u64;
pub const IR_TRUST_LEDGER_ENTRY: u64 = 15u64;
pub const IR_MCP_BRIDGE_CONTRACT: u64 = 16u64;
pub const IR_A2_A_BRIDGE_CONTRACT: u64 = 17u64;
pub const IR_A_TRUST_EVIDENCE_MAP: u64 = 18u64;
pub const IR_GOVERNANCE_PROFILE: u64 = 19u64;
pub const IR_GOVERNANCE_CONTROL: u64 = 20u64;
pub const IR_REGULATORY_MAPPING: u64 = 21u64;
pub const IR_REGULATORY_OBLIGATION: u64 = 22u64;
pub const IR_THIRD_PARTY_VERIFIER: u64 = 23u64;
pub const IR_PUBLIC_CONFORMANCE_REPORT: u64 = 24u64;
pub const IR_PUBLIC_CONFORMANCE_CLAIM: u64 = 25u64;
pub const IR_RUNTIME_HARDENING_PROFILE: u64 = 26u64;
pub const IR_THREAT_MODEL: u64 = 27u64;
pub const IR_THREAT_ASSET: u64 = 28u64;
pub const IR_THREAT: u64 = 29u64;
pub const IR_THREAT_MITIGATION: u64 = 30u64;
pub const IR_SPEC_FREEZE: u64 = 31u64;
pub const IR_RELEASE_CANDIDATE: u64 = 32u64;
pub const IR_COMPATIBILITY_MATRIX_ENTRY: u64 = 33u64;
pub const IR_RUNTIME_EXECUTION_PROFILE: u64 = 34u64;
pub const IR_SANDBOXED_PROVIDER_ADAPTER: u64 = 35u64;
pub const IR_ASSERTION: u64 = 36u64;
pub const IR_POLICY: u64 = 37u64;
pub const IR_POLICY_RULE: u64 = 38u64;
pub const IR_POLICY_VIOLATION: u64 = 39u64;
pub const IR_FAILURE: u64 = 40u64;
pub const IR_CAPABILITY: u64 = 41u64;
pub const IR_ENUM: u64 = 42u64;
pub const IR_TYPE: u64 = 43u64;
pub const IR_FIELD: u64 = 44u64;
pub const IR_TOOL: u64 = 45u64;
pub const IR_MODEL: u64 = 46u64;
pub const IR_AGENT: u64 = 47u64;
pub const IR_RECEIVE: u64 = 48u64;
pub const IR_SEND: u64 = 49u64;
pub const IR_HANDLER: u64 = 50u64;
pub const IR_PROTOCOL: u64 = 51u64;
pub const IR_PROTOCOL_STEP: u64 = 52u64;
pub const IR_PASSPORT: u64 = 53u64;
pub const IR_PASSPORT_ASN: u64 = 54u64;

// The emitter of IR type `s` over the tree node `node`.
fn emit(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, s: u64, node: u64) -> Pretty {
    if s == IR_PROGRAM {
        return emit_program(state, sl, n, st, node);
    }
    if s == IR_PROVIDER_CONTRACT {
        return emit_provider_contract(state, sl, n, st, node);
    }
    if s == IR_PROVIDER_HARNESS {
        return emit_provider_harness(state, sl, n, st, node);
    }
    if s == IR_FEATURE {
        return emit_feature(state, sl, n, st, node);
    }
    if s == IR_SECRET {
        return emit_secret(state, sl, n, st, node);
    }
    if s == IR_ADAPTER {
        return emit_adapter(state, sl, n, st, node);
    }
    if s == IR_ADAPTER_PROFILE {
        return emit_adapter_profile(state, sl, n, st, node);
    }
    if s == IR_CRYPTO {
        return emit_crypto(state, sl, n, st, node);
    }
    if s == IR_CRYPTO_BOUNDARY {
        return emit_crypto_boundary(state, sl, n, st, node);
    }
    if s == IR_DID_METHOD {
        return emit_did_method(state, sl, n, st, node);
    }
    if s == IR_A_TRUST_BOUNDARY {
        return emit_a_trust_boundary(state, sl, n, st, node);
    }
    if s == IR_A_TRUST_IDENTITY {
        return emit_a_trust_identity(state, sl, n, st, node);
    }
    if s == IR_A_TRUST_CREDENTIAL_CONTRACT {
        return emit_a_trust_credential_contract(state, sl, n, st, node);
    }
    if s == IR_A_TRUST_HANDSHAKE {
        return emit_a_trust_handshake(state, sl, n, st, node);
    }
    if s == IR_TRUST_LEDGER {
        return emit_trust_ledger(state, sl, n, st, node);
    }
    if s == IR_TRUST_LEDGER_ENTRY {
        return emit_trust_ledger_entry(state, sl, n, st, node);
    }
    if s == IR_MCP_BRIDGE_CONTRACT {
        return emit_mcp_bridge_contract(state, sl, n, st, node);
    }
    if s == IR_A2_A_BRIDGE_CONTRACT {
        return emit_a2_a_bridge_contract(state, sl, n, st, node);
    }
    if s == IR_A_TRUST_EVIDENCE_MAP {
        return emit_a_trust_evidence_map(state, sl, n, st, node);
    }
    if s == IR_GOVERNANCE_PROFILE {
        return emit_governance_profile(state, sl, n, st, node);
    }
    if s == IR_GOVERNANCE_CONTROL {
        return emit_governance_control(state, sl, n, st, node);
    }
    if s == IR_REGULATORY_MAPPING {
        return emit_regulatory_mapping(state, sl, n, st, node);
    }
    if s == IR_REGULATORY_OBLIGATION {
        return emit_regulatory_obligation(state, sl, n, st, node);
    }
    if s == IR_THIRD_PARTY_VERIFIER {
        return emit_third_party_verifier(state, sl, n, st, node);
    }
    if s == IR_PUBLIC_CONFORMANCE_REPORT {
        return emit_public_conformance_report(state, sl, n, st, node);
    }
    if s == IR_PUBLIC_CONFORMANCE_CLAIM {
        return emit_public_conformance_claim(state, sl, n, st, node);
    }
    if s == IR_RUNTIME_HARDENING_PROFILE {
        return emit_runtime_hardening_profile(state, sl, n, st, node);
    }
    if s == IR_THREAT_MODEL {
        return emit_threat_model(state, sl, n, st, node);
    }
    if s == IR_THREAT_ASSET {
        return emit_threat_asset(state, sl, n, st, node);
    }
    if s == IR_THREAT {
        return emit_threat(state, sl, n, st, node);
    }
    if s == IR_THREAT_MITIGATION {
        return emit_threat_mitigation(state, sl, n, st, node);
    }
    if s == IR_SPEC_FREEZE {
        return emit_spec_freeze(state, sl, n, st, node);
    }
    if s == IR_RELEASE_CANDIDATE {
        return emit_release_candidate(state, sl, n, st, node);
    }
    if s == IR_COMPATIBILITY_MATRIX_ENTRY {
        return emit_compatibility_matrix_entry(state, sl, n, st, node);
    }
    if s == IR_RUNTIME_EXECUTION_PROFILE {
        return emit_runtime_execution_profile(state, sl, n, st, node);
    }
    if s == IR_SANDBOXED_PROVIDER_ADAPTER {
        return emit_sandboxed_provider_adapter(state, sl, n, st, node);
    }
    if s == IR_ASSERTION {
        return emit_assertion(state, sl, n, st, node);
    }
    if s == IR_POLICY {
        return emit_policy(state, sl, n, st, node);
    }
    if s == IR_POLICY_RULE {
        return emit_policy_rule(state, sl, n, st, node);
    }
    if s == IR_POLICY_VIOLATION {
        return emit_policy_violation(state, sl, n, st, node);
    }
    if s == IR_FAILURE {
        return emit_failure(state, sl, n, st, node);
    }
    if s == IR_CAPABILITY {
        return emit_capability(state, sl, n, st, node);
    }
    if s == IR_ENUM {
        return emit_enum(state, sl, n, st, node);
    }
    if s == IR_TYPE {
        return emit_type(state, sl, n, st, node);
    }
    if s == IR_FIELD {
        return emit_field(state, sl, n, st, node);
    }
    if s == IR_TOOL {
        return emit_tool(state, sl, n, st, node);
    }
    if s == IR_MODEL {
        return emit_model(state, sl, n, st, node);
    }
    if s == IR_AGENT {
        return emit_agent(state, sl, n, st, node);
    }
    if s == IR_RECEIVE {
        return emit_receive(state, sl, n, st, node);
    }
    if s == IR_SEND {
        return emit_send(state, sl, n, st, node);
    }
    if s == IR_HANDLER {
        return emit_handler(state, sl, n, st, node);
    }
    if s == IR_PROTOCOL {
        return emit_protocol(state, sl, n, st, node);
    }
    if s == IR_PROTOCOL_STEP {
        return emit_protocol_step(state, sl, n, st, node);
    }
    if s == IR_PASSPORT {
        return emit_passport(state, sl, n, st, node);
    }
    if s == IR_PASSPORT_ASN {
        return emit_passport_asn(state, sl, n, st, node);
    }
    state
}

fn emit_program(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, node: u64) -> Pretty {
    let mut y: Pretty = open(state, 123u8);
    y = key(y, "ir_version".as_slice());
    y = text(y, "1.0".as_slice());
    y = key(y, "language".as_slice());
    y = text(y, "Argorix Lang".as_slice());
    y = key(y, "module".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.PROGRAM_MODULE));
    y = special_program_modules(y, sl, n, st, "modules".as_slice(), node);
    y = special_program_imports(y, sl, n, st, "imports".as_slice(), node);
    y = list(y, sl, n, st, "providers".as_slice(), get(sl, n, node, agent_schema.PROGRAM_PROVIDERS), IR_PROVIDER_CONTRACT);
    y = list(y, sl, n, st, "provider_harnesses".as_slice(), get(sl, n, node, agent_schema.PROGRAM_HARNESSES), IR_PROVIDER_HARNESS);
    y = list_skip(y, sl, n, st, "features".as_slice(), get(sl, n, node, agent_schema.PROGRAM_FEATURES), IR_FEATURE);
    y = list_skip(y, sl, n, st, "secrets".as_slice(), get(sl, n, node, agent_schema.PROGRAM_SECRETS), IR_SECRET);
    y = list_skip(y, sl, n, st, "adapters".as_slice(), get(sl, n, node, agent_schema.PROGRAM_ADAPTERS), IR_ADAPTER);
    y = list_skip(y, sl, n, st, "adapter_profiles".as_slice(), get(sl, n, node, agent_schema.PROGRAM_ADAPTER_PROFILES), IR_ADAPTER_PROFILE);
    y = list_skip(y, sl, n, st, "cryptos".as_slice(), get(sl, n, node, agent_schema.PROGRAM_CRYPTOS), IR_CRYPTO);
    y = list_skip(y, sl, n, st, "crypto_boundaries".as_slice(), get(sl, n, node, agent_schema.PROGRAM_CRYPTO_BOUNDARIES), IR_CRYPTO_BOUNDARY);
    y = list_skip(y, sl, n, st, "did_methods".as_slice(), get(sl, n, node, agent_schema.PROGRAM_DID_METHODS), IR_DID_METHOD);
    y = list_skip(y, sl, n, st, "atrust_boundaries".as_slice(), get(sl, n, node, agent_schema.PROGRAM_ATRUST_BOUNDARIES), IR_A_TRUST_BOUNDARY);
    y = list_skip(y, sl, n, st, "atrust_identities".as_slice(), get(sl, n, node, agent_schema.PROGRAM_ATRUST_IDENTITIES), IR_A_TRUST_IDENTITY);
    y = list_skip(y, sl, n, st, "atrust_credential_contracts".as_slice(), get(sl, n, node, agent_schema.PROGRAM_ATRUST_CREDENTIAL_CONTRACTS), IR_A_TRUST_CREDENTIAL_CONTRACT);
    y = list_skip(y, sl, n, st, "atrust_handshakes".as_slice(), get(sl, n, node, agent_schema.PROGRAM_ATRUST_HANDSHAKES), IR_A_TRUST_HANDSHAKE);
    y = list_skip(y, sl, n, st, "trust_ledgers".as_slice(), get(sl, n, node, agent_schema.PROGRAM_TRUST_LEDGERS), IR_TRUST_LEDGER);
    y = list_skip(y, sl, n, st, "mcp_bridge_contracts".as_slice(), get(sl, n, node, agent_schema.PROGRAM_MCP_BRIDGE_CONTRACTS), IR_MCP_BRIDGE_CONTRACT);
    y = list_skip(y, sl, n, st, "a2a_bridge_contracts".as_slice(), get(sl, n, node, agent_schema.PROGRAM_A2A_BRIDGE_CONTRACTS), IR_A2_A_BRIDGE_CONTRACT);
    y = list_skip(y, sl, n, st, "atrust_evidence_maps".as_slice(), get(sl, n, node, agent_schema.PROGRAM_ATRUST_EVIDENCE_MAPS), IR_A_TRUST_EVIDENCE_MAP);
    y = list_skip(y, sl, n, st, "governance_profiles".as_slice(), get(sl, n, node, agent_schema.PROGRAM_GOVERNANCE_PROFILES), IR_GOVERNANCE_PROFILE);
    y = list_skip(y, sl, n, st, "regulatory_mappings".as_slice(), get(sl, n, node, agent_schema.PROGRAM_REGULATORY_MAPPINGS), IR_REGULATORY_MAPPING);
    y = list_skip(y, sl, n, st, "third_party_verifiers".as_slice(), get(sl, n, node, agent_schema.PROGRAM_THIRD_PARTY_VERIFIERS), IR_THIRD_PARTY_VERIFIER);
    y = list_skip(y, sl, n, st, "public_conformance_reports".as_slice(), get(sl, n, node, agent_schema.PROGRAM_PUBLIC_CONFORMANCE_REPORTS), IR_PUBLIC_CONFORMANCE_REPORT);
    y = list_skip(y, sl, n, st, "runtime_hardening_profiles".as_slice(), get(sl, n, node, agent_schema.PROGRAM_RUNTIME_HARDENING_PROFILES), IR_RUNTIME_HARDENING_PROFILE);
    y = list_skip(y, sl, n, st, "threat_models".as_slice(), get(sl, n, node, agent_schema.PROGRAM_THREAT_MODELS), IR_THREAT_MODEL);
    y = list_skip(y, sl, n, st, "spec_freezes".as_slice(), get(sl, n, node, agent_schema.PROGRAM_SPEC_FREEZES), IR_SPEC_FREEZE);
    y = list_skip(y, sl, n, st, "release_candidates".as_slice(), get(sl, n, node, agent_schema.PROGRAM_RELEASE_CANDIDATES), IR_RELEASE_CANDIDATE);
    y = list_skip(y, sl, n, st, "runtime_execution_profiles".as_slice(), get(sl, n, node, agent_schema.PROGRAM_RUNTIME_EXECUTION_PROFILES), IR_RUNTIME_EXECUTION_PROFILE);
    y = list_skip(y, sl, n, st, "sandboxed_provider_adapters".as_slice(), get(sl, n, node, agent_schema.PROGRAM_SANDBOXED_PROVIDER_ADAPTERS), IR_SANDBOXED_PROVIDER_ADAPTER);
    y = list(y, sl, n, st, "assertions".as_slice(), get(sl, n, node, agent_schema.PROGRAM_ASSERTIONS), IR_ASSERTION);
    y = list(y, sl, n, st, "policies".as_slice(), get(sl, n, node, agent_schema.PROGRAM_POLICIES), IR_POLICY);
    y = list(y, sl, n, st, "failures".as_slice(), get(sl, n, node, agent_schema.PROGRAM_FAILURES), IR_FAILURE);
    y = list(y, sl, n, st, "capabilities".as_slice(), get(sl, n, node, agent_schema.PROGRAM_CAPABILITIES), IR_CAPABILITY);
    y = list(y, sl, n, st, "enums".as_slice(), get(sl, n, node, agent_schema.PROGRAM_ENUMS), IR_ENUM);
    y = list(y, sl, n, st, "types".as_slice(), get(sl, n, node, agent_schema.PROGRAM_TYPES), IR_TYPE);
    y = list(y, sl, n, st, "tools".as_slice(), get(sl, n, node, agent_schema.PROGRAM_TOOLS), IR_TOOL);
    y = list(y, sl, n, st, "models".as_slice(), get(sl, n, node, agent_schema.PROGRAM_MODELS), IR_MODEL);
    y = list(y, sl, n, st, "agents".as_slice(), get(sl, n, node, agent_schema.PROGRAM_AGENTS), IR_AGENT);
    y = list(y, sl, n, st, "protocols".as_slice(), get(sl, n, node, agent_schema.PROGRAM_PROTOCOLS), IR_PROTOCOL);
    y = list_skip(y, sl, n, st, "passports".as_slice(), get(sl, n, node, agent_schema.PROGRAM_PASSPORTS), IR_PASSPORT);
    close(y, 125u8)
}

fn emit_provider_contract(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, node: u64) -> Pretty {
    let mut y: Pretty = open(state, 123u8);
    y = key(y, "name".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.PROVIDER_DECL_NAME));
    y = key(y, "kind".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.PROVIDER_DECL_KIND));
    y = key(y, "enabled".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.PROVIDER_DECL_ENABLED));
    y = key(y, "dry_run_only".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.PROVIDER_DECL_DRY_RUN_ONLY));
    y = key(y, "requires_feature_flag".as_slice());
    y = scalar(y, sl, n, st, get(sl, n, node, agent_schema.PROVIDER_DECL_REQUIRES_FEATURE_FLAG));
    y = key(y, "requires_explicit_approval".as_slice());
    y = scalar(y, sl, n, st, get(sl, n, node, agent_schema.PROVIDER_DECL_REQUIRES_EXPLICIT_APPROVAL));
    y = values(y, sl, n, st, "allowed_targets".as_slice(), get(sl, n, node, agent_schema.PROVIDER_DECL_ALLOWED_TARGETS));
    y = values(y, sl, n, st, "allowed_capabilities".as_slice(), get(sl, n, node, agent_schema.PROVIDER_DECL_ALLOWED_CAPABILITIES));
    close(y, 125u8)
}

fn emit_provider_harness(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, node: u64) -> Pretty {
    let mut y: Pretty = open(state, 123u8);
    y = key(y, "name".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.PROVIDER_HARNESS_DECL_NAME));
    y = key(y, "provider".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.PROVIDER_HARNESS_DECL_PROVIDER));
    y = optional_value_skip(y, sl, n, st, "feature".as_slice(), get(sl, n, node, agent_schema.PROVIDER_HARNESS_DECL_FEATURE));
    y = optional_value_skip(y, sl, n, st, "secret".as_slice(), get(sl, n, node, agent_schema.PROVIDER_HARNESS_DECL_SECRET));
    y = key(y, "mode".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.PROVIDER_HARNESS_DECL_MODE));
    y = key(y, "network".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.PROVIDER_HARNESS_DECL_NETWORK));
    y = key(y, "secrets".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.PROVIDER_HARNESS_DECL_SECRETS));
    y = key(y, "filesystem".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.PROVIDER_HARNESS_DECL_FILESYSTEM));
    y = optional_value_null(y, sl, n, st, "max_steps".as_slice(), get(sl, n, node, agent_schema.PROVIDER_HARNESS_DECL_MAX_STEPS));
    y = optional_value_null(y, sl, n, st, "timeout_ms".as_slice(), get(sl, n, node, agent_schema.PROVIDER_HARNESS_DECL_TIMEOUT_MS));
    y = optional_value_null(y, sl, n, st, "input_contract".as_slice(), get(sl, n, node, agent_schema.PROVIDER_HARNESS_DECL_INPUT_CONTRACT));
    y = optional_value_null(y, sl, n, st, "output_contract".as_slice(), get(sl, n, node, agent_schema.PROVIDER_HARNESS_DECL_OUTPUT_CONTRACT));
    y = values(y, sl, n, st, "attestations".as_slice(), get(sl, n, node, agent_schema.PROVIDER_HARNESS_DECL_ATTESTATIONS));
    close(y, 125u8)
}

fn emit_feature(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, node: u64) -> Pretty {
    let mut y: Pretty = open(state, 123u8);
    y = key(y, "name".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.FEATURE_DECL_NAME));
    y = optional_value_skip(y, sl, n, st, "provider".as_slice(), get(sl, n, node, agent_schema.FEATURE_DECL_PROVIDER));
    y = key(y, "status".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.FEATURE_DECL_STATUS));
    y = key(y, "default".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.FEATURE_DECL_DEFAULT));
    y = key(y, "requires_approval".as_slice());
    y = scalar(y, sl, n, st, get(sl, n, node, agent_schema.FEATURE_DECL_REQUIRES_APPROVAL));
    y = optional_value_skip(y, sl, n, st, "purpose".as_slice(), get(sl, n, node, agent_schema.FEATURE_DECL_PURPOSE));
    close(y, 125u8)
}

fn emit_secret(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, node: u64) -> Pretty {
    let mut y: Pretty = open(state, 123u8);
    y = key(y, "name".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.SECRET_DECL_NAME));
    y = key(y, "handle".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.SECRET_DECL_HANDLE));
    y = optional_value_skip(y, sl, n, st, "provider".as_slice(), get(sl, n, node, agent_schema.SECRET_DECL_PROVIDER));
    y = optional_value_skip(y, sl, n, st, "required_by".as_slice(), get(sl, n, node, agent_schema.SECRET_DECL_REQUIRED_BY));
    y = key(y, "scope".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.SECRET_DECL_SCOPE));
    y = key(y, "access".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.SECRET_DECL_ACCESS));
    y = key(y, "source".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.SECRET_DECL_SOURCE));
    close(y, 125u8)
}

fn emit_adapter(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, node: u64) -> Pretty {
    let mut y: Pretty = open(state, 123u8);
    y = key(y, "name".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.ADAPTER_DECL_NAME));
    y = key(y, "provider".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.ADAPTER_DECL_PROVIDER));
    y = optional_value_skip(y, sl, n, st, "feature".as_slice(), get(sl, n, node, agent_schema.ADAPTER_DECL_FEATURE));
    y = optional_value_skip(y, sl, n, st, "secret".as_slice(), get(sl, n, node, agent_schema.ADAPTER_DECL_SECRET));
    y = optional_value_skip(y, sl, n, st, "harness".as_slice(), get(sl, n, node, agent_schema.ADAPTER_DECL_HARNESS));
    y = optional_name_skip(y, sl, n, st, "kind".as_slice(), get(sl, n, node, agent_schema.ADAPTER_DECL_KIND));
    y = optional_value_skip(y, sl, n, st, "vendor".as_slice(), get(sl, n, node, agent_schema.ADAPTER_DECL_VENDOR));
    y = key(y, "mode".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.ADAPTER_DECL_MODE));
    y = key(y, "execution".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.ADAPTER_DECL_EXECUTION));
    y = key(y, "network".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.ADAPTER_DECL_NETWORK));
    y = key(y, "secrets".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.ADAPTER_DECL_SECRETS));
    y = key(y, "filesystem".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.ADAPTER_DECL_FILESYSTEM));
    y = optional_value_skip(y, sl, n, st, "input_contract".as_slice(), get(sl, n, node, agent_schema.ADAPTER_DECL_INPUT_CONTRACT));
    y = optional_value_skip(y, sl, n, st, "output_contract".as_slice(), get(sl, n, node, agent_schema.ADAPTER_DECL_OUTPUT_CONTRACT));
    y = values(y, sl, n, st, "conformance".as_slice(), get(sl, n, node, agent_schema.ADAPTER_DECL_CONFORMANCE));
    close(y, 125u8)
}

fn emit_adapter_profile(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, node: u64) -> Pretty {
    let mut y: Pretty = open(state, 123u8);
    y = key(y, "name".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.ADAPTER_PROFILE_DECL_NAME));
    y = key(y, "adapter".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.ADAPTER_PROFILE_DECL_ADAPTER));
    y = key(y, "provider".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.ADAPTER_PROFILE_DECL_PROVIDER));
    y = key(y, "vendor".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.ADAPTER_PROFILE_DECL_VENDOR));
    y = key(y, "family".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.ADAPTER_PROFILE_DECL_FAMILY));
    y = key(y, "api_style".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.ADAPTER_PROFILE_DECL_API_STYLE));
    y = key(y, "auth".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.ADAPTER_PROFILE_DECL_AUTH));
    y = key(y, "execution".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.ADAPTER_PROFILE_DECL_EXECUTION));
    y = key(y, "network".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.ADAPTER_PROFILE_DECL_NETWORK));
    y = key(y, "secrets".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.ADAPTER_PROFILE_DECL_SECRETS));
    y = optional_value_skip(y, sl, n, st, "request_contract".as_slice(), get(sl, n, node, agent_schema.ADAPTER_PROFILE_DECL_REQUEST_CONTRACT));
    y = optional_value_skip(y, sl, n, st, "response_contract".as_slice(), get(sl, n, node, agent_schema.ADAPTER_PROFILE_DECL_RESPONSE_CONTRACT));
    y = values(y, sl, n, st, "capabilities".as_slice(), get(sl, n, node, agent_schema.ADAPTER_PROFILE_DECL_CAPABILITIES));
    y = values(y, sl, n, st, "required_conformance".as_slice(), get(sl, n, node, agent_schema.ADAPTER_PROFILE_DECL_REQUIRED_CONFORMANCE));
    close(y, 125u8)
}

fn emit_crypto(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, node: u64) -> Pretty {
    let mut y: Pretty = open(state, 123u8);
    y = key(y, "name".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.CRYPTO_DECL_NAME));
    y = key(y, "kind".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.CRYPTO_DECL_KIND));
    y = key(y, "status".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.CRYPTO_DECL_STATUS));
    y = key(y, "strength".as_slice());
    y = name(y, sl, n, st, get(sl, n, node, agent_schema.CRYPTO_DECL_STRENGTH));
    y = values(y, sl, n, st, "purpose".as_slice(), get(sl, n, node, agent_schema.CRYPTO_DECL_PURPOSE));
    y = optional_value_skip(y, sl, n, st, "output_bits".as_slice(), get(sl, n, node, agent_schema.CRYPTO_DECL_OUTPUT_BITS));
    y = optional_value_skip(y, sl, n, st, "min_key_bits".as_slice(), get(sl, n, node, agent_schema.CRYPTO_DECL_MIN_KEY_BITS));
    y = optional_value_skip(y, sl, n, st, "security_level".as_slice(), get(sl, n, node, agent_schema.CRYPTO_DECL_SECURITY_LEVEL));
    y = optional_value_skip(y, sl, n, st, "notes".as_slice(), get(sl, n, node, agent_schema.CRYPTO_DECL_NOTES));
    close(y, 125u8)
}

fn emit_crypto_boundary(state: Pretty, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, node: u64) -> Pretty {
    let mut y: Pretty = open(state, 123u8);
    y = key(y, "name".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.CRYPTO_BOUNDARY_DECL_NAME));
    y = values(y, sl, n, st, "allowed_hashes".as_slice(), get(sl, n, node, agent_schema.CRYPTO_BOUNDARY_DECL_ALLOWED_HASHES));
    y = values(y, sl, n, st, "allowed_signatures".as_slice(), get(sl, n, node, agent_schema.CRYPTO_BOUNDARY_DECL_ALLOWED_SIGNATURES));
    y = values(y, sl, n, st, "allowed_kems".as_slice(), get(sl, n, node, agent_schema.CRYPTO_BOUNDARY_DECL_ALLOWED_KEMS));
    y = values(y, sl, n, st, "allowed_aeads".as_slice(), get(sl, n, node, agent_schema.CRYPTO_BOUNDARY_DECL_ALLOWED_AEADS));
    y = values(y, sl, n, st, "legacy_allowed".as_slice(), get(sl, n, node, agent_schema.CRYPTO_BOUNDARY_DECL_LEGACY_ALLOWED));
    y = values(y, sl, n, st, "denied".as_slice(), get(sl, n, node, agent_schema.CRYPTO_BOUNDARY_DECL_DENIED));
    y = values(y, sl, n, st, "purpose".as_slice(), get(sl, n, node, agent_schema.CRYPTO_BOUNDARY_DECL_PURPOSE));
    y = optional_value_skip(y, sl, n, st, "min_hash_bits".as_slice(), get(sl, n, node, agent_schema.CRYPTO_BOUNDARY_DECL_MIN_HASH_BITS));
    y = optional_value_skip(y, sl, n, st, "post_quantum_ready".as_slice(), get(sl, n, node, agent_schema.CRYPTO_BOUNDARY_DECL_POST_QUANTUM_READY));
    y = optional_value_skip(y, sl, n, st, "hybrid_allowed".as_slice(), get(sl, n, node, agent_schema.CRYPTO_BOUNDARY_DECL_HYBRID_ALLOWED));
    y = key(y, "key_material".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.CRYPTO_BOUNDARY_DECL_KEY_MATERIAL));
    y = key(y, "secret_material".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.CRYPTO_BOUNDARY_DECL_SECRET_MATERIAL));
    y = key(y, "execution".as_slice());
    y = value(y, sl, n, st, get(sl, n, node, agent_schema.CRYPTO_BOUNDARY_DECL_EXECUTION));
    close(y, 125u8)
}

