// `"<name>"`: the name of field `index` of struct `s`, quoted.
pub fn append_field(out: Buffer<u8>, s: u64, index: u64) -> Buffer<u8> {
    if s == 0u64 {
        if index == 0u64 { return bytes.append(out, "\"start\"".as_slice()); }
        if index == 1u64 { return bytes.append(out, "\"end\"".as_slice()); }
        if index == 2u64 { return bytes.append(out, "\"line\"".as_slice()); }
        if index == 3u64 { return bytes.append(out, "\"column\"".as_slice()); }
    }
    if s == 1u64 {
        if index == 0u64 { return bytes.append(out, "\"value\"".as_slice()); }
        if index == 1u64 { return bytes.append(out, "\"span\"".as_slice()); }
    }
    if s == 2u64 {
        if index == 0u64 { return bytes.append(out, "\"module\"".as_slice()); }
        if index == 1u64 { return bytes.append(out, "\"imports\"".as_slice()); }
        if index == 2u64 { return bytes.append(out, "\"providers\"".as_slice()); }
        if index == 3u64 { return bytes.append(out, "\"harnesses\"".as_slice()); }
        if index == 4u64 { return bytes.append(out, "\"features\"".as_slice()); }
        if index == 5u64 { return bytes.append(out, "\"secrets\"".as_slice()); }
        if index == 6u64 { return bytes.append(out, "\"adapters\"".as_slice()); }
        if index == 7u64 { return bytes.append(out, "\"adapter_profiles\"".as_slice()); }
        if index == 8u64 { return bytes.append(out, "\"cryptos\"".as_slice()); }
        if index == 9u64 { return bytes.append(out, "\"crypto_boundaries\"".as_slice()); }
        if index == 10u64 { return bytes.append(out, "\"did_methods\"".as_slice()); }
        if index == 11u64 { return bytes.append(out, "\"atrust_boundaries\"".as_slice()); }
        if index == 12u64 { return bytes.append(out, "\"atrust_identities\"".as_slice()); }
        if index == 13u64 { return bytes.append(out, "\"atrust_credential_contracts\"".as_slice()); }
        if index == 14u64 { return bytes.append(out, "\"atrust_handshakes\"".as_slice()); }
        if index == 15u64 { return bytes.append(out, "\"trust_ledgers\"".as_slice()); }
        if index == 16u64 { return bytes.append(out, "\"mcp_bridge_contracts\"".as_slice()); }
        if index == 17u64 { return bytes.append(out, "\"a2a_bridge_contracts\"".as_slice()); }
        if index == 18u64 { return bytes.append(out, "\"atrust_evidence_maps\"".as_slice()); }
        if index == 19u64 { return bytes.append(out, "\"governance_profiles\"".as_slice()); }
        if index == 20u64 { return bytes.append(out, "\"regulatory_mappings\"".as_slice()); }
        if index == 21u64 { return bytes.append(out, "\"third_party_verifiers\"".as_slice()); }
        if index == 22u64 { return bytes.append(out, "\"public_conformance_reports\"".as_slice()); }
        if index == 23u64 { return bytes.append(out, "\"runtime_hardening_profiles\"".as_slice()); }
        if index == 24u64 { return bytes.append(out, "\"threat_models\"".as_slice()); }
        if index == 25u64 { return bytes.append(out, "\"spec_freezes\"".as_slice()); }
        if index == 26u64 { return bytes.append(out, "\"release_candidates\"".as_slice()); }
        if index == 27u64 { return bytes.append(out, "\"runtime_execution_profiles\"".as_slice()); }
