fn validate_release_candidates(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let items: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__RELEASE_CANDIDATES);
    let freezes: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__SPEC_FREEZES);
    let mut link: u64 = n[items].a;
    while link != 0u64 {
        let candidate: u64 = link - 1u64;
        link = n[candidate].next;
        let name: u64 = fld(n, sl, candidate, agent_bytecode_schema.BS_RELEASE_CANDIDATE__NAME);
        if seen_before(n, sl, st, items, agent_bytecode_schema.BS_RELEASE_CANDIDATE__NAME, candidate, name) { o = named(o, n, st, "duplicate release_candidate ".as_slice(), name, "".as_slice()); }
        let version: u64 = fld(n, sl, candidate, agent_bytecode_schema.BS_RELEASE_CANDIDATE__VERSION);
        let matrix: u64 = fld(n, sl, candidate, agent_bytecode_schema.BS_RELEASE_CANDIDATE__COMPATIBILITY_MATRIX);
        let notes: u64 = fld(n, sl, candidate, agent_bytecode_schema.BS_RELEASE_CANDIDATE__NOTES);
        let valid: bool = !bare_empty(n, name) && bytes.starts_with(st.slice(n[version].a, n[version].b), "1.0.0-rc".as_slice()) && text_is(n, st, fld(n, sl, candidate, agent_bytecode_schema.BS_RELEASE_CANDIDATE__BASE_VERSION), "0.36".as_slice()) && list_has(n, sl, st, freezes, agent_bytecode_schema.BS_SPEC_FREEZE__NAME, fld(n, sl, candidate, agent_bytecode_schema.BS_RELEASE_CANDIDATE__SPEC_FREEZE)) && one_of(n, st, fld(n, sl, candidate, agent_bytecode_schema.BS_RELEASE_CANDIDATE__READINESS), "draft rc pending_review".as_slice()) && valid_strings(n, fld(n, sl, candidate, agent_bytecode_schema.BS_RELEASE_CANDIDATE__REQUIRED_ARTIFACTS)) && valid_strings(n, fld(n, sl, candidate, agent_bytecode_schema.BS_RELEASE_CANDIDATE__REQUIRED_CHECKS)) && valid_strings(n, fld(n, sl, candidate, agent_bytecode_schema.BS_RELEASE_CANDIDATE__KNOWN_LIMITATIONS)) && valid_strings(n, fld(n, sl, candidate, agent_bytecode_schema.BS_RELEASE_CANDIDATE__PURPOSE)) && matrix_has_version(n, sl, st, matrix, "0.34".as_slice()) && matrix_has_version(n, sl, st, matrix, "0.35".as_slice()) && matrix_has_version(n, sl, st, matrix, "0.36".as_slice()) && valid_matrix(n, sl, st, matrix) && closed_release_boundaries(n, sl, st, candidate, agent_bytecode_schema.BS_RELEASE_CANDIDATE__RUNTIME_STATUS, agent_bytecode_schema.BS_RELEASE_CANDIDATE__NETWORK, agent_bytecode_schema.BS_RELEASE_CANDIDATE__EXTERNAL_EXECUTION, agent_bytecode_schema.BS_RELEASE_CANDIDATE__PROVIDER_EXECUTION, agent_bytecode_schema.BS_RELEASE_CANDIDATE__SECRET_MATERIAL, agent_bytecode_schema.BS_RELEASE_CANDIDATE__KEY_MATERIAL, agent_bytecode_schema.BS_RELEASE_CANDIDATE__ENV_ACCESS, agent_bytecode_schema.BS_RELEASE_CANDIDATE__FILESYSTEM_ACCESS, agent_bytecode_schema.BS_RELEASE_CANDIDATE__TOOL_EXECUTION, agent_bytecode_schema.BS_RELEASE_CANDIDATE__AGENT_EXECUTION, agent_bytecode_schema.BS_RELEASE_CANDIDATE__SECURITY_CLAIMS, agent_bytecode_schema.BS_RELEASE_CANDIDATE__LEGAL_CLAIMS, agent_bytecode_schema.BS_RELEASE_CANDIDATE__CERTIFICATION) && (n[notes].kind != V_STRING || !bare_empty(n, notes));
        if !valid { o = invalid(o, n, st, "release_candidate".as_slice(), name, "invalid RC metadata or an enabled runtime/claim boundary".as_slice(), NONE); }
    }
    o
