fn lists_disjoint(n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, allowed: u64, denied: u64) -> bool {
    let mut link: u64 = n[allowed].a;
    while link != 0u64 {
        let item: u64 = link - 1u64;
        link = n[item].next;
        if list_has(n, sl, st, denied, NONE, item) { return false; }
    }
    true
}

fn runtime_agents_known(n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, wanted: u64, agents: u64) -> bool {
    let mut link: u64 = n[wanted].a;
    while link != 0u64 {
        let item: u64 = link - 1u64;
        link = n[item].next;
        if !list_has(n, sl, st, agents, agent_bytecode_schema.BS_AGENT__NAME, item) { return false; }
    }
    true
}

fn declared_reference(n: Slice<Value>, st: Slice<u8>, node: u64, first: Slice<u8>, second: Slice<u8>) -> bool {
    let value: Slice<u8> = st.slice(n[node].a, n[node].b);
    let mut colon: u64 = 0u64;
    while colon < value.length() && value[colon] != 58u8 { colon += 1u64; }
    if colon == value.length() || colon + 1u64 == value.length() { return false; }
    let prefix: Slice<u8> = value.slice(0u64, colon);
    if !bytes.equal(prefix, first) && !bytes.equal(prefix, second) { return false; }
    let mut at: u64 = colon + 1u64;
    while at < value.length() {
        let ch: u8 = value[at];
        if !(ch == 95u8 || (ch >= 48u8 && ch <= 57u8) || (ch >= 65u8 && ch <= 90u8) || (ch >= 97u8 && ch <= 122u8)) { return false; }
        at += 1u64;
    }
    true
}

fn validate_runtime_execution_profiles(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let items: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__RUNTIME_EXECUTION_PROFILES);
    let agents: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__AGENTS);
    let providers: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__PROVIDERS);
    let hardening: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__RUNTIME_HARDENING_PROFILES);
    let threats: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__THREAT_MODELS);
    let maps: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__ATRUST_EVIDENCE_MAPS);
    let governance: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__GOVERNANCE_PROFILES);
    let mut link: u64 = n[items].a;
    while link != 0u64 {
        let profile: u64 = link - 1u64;
        link = n[profile].next;
        let name: u64 = fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__NAME);
        if seen_before(n, sl, st, items, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__NAME, profile, name) { o = named(o, n, st, "duplicate runtime_execution_profile ".as_slice(), name, "".as_slice()); }
        let provider: u64 = fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__PROVIDER);
        let governance_name: u64 = fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__GOVERNANCE_PROFILE);
        let governance_item: u64 = find_last(n, sl, st, governance, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__NAME, governance_name);
        let allowed: u64 = fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__ALLOWED_ACTIONS);
        let denied: u64 = fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__DENIED_ACTIONS);
        let notes: u64 = fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__NOTES);
        let valid: bool = !bare_empty(n, name) && one_of(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__MODE), "dry_run simulated sandboxed_external".as_slice()) && runtime_agents_known(n, sl, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__AGENTS), agents) && (text_is(n, st, provider, "simulated".as_slice()) || list_has(n, sl, st, providers, agent_bytecode_schema.BS_PROVIDER_CONTRACT__NAME, provider)) && list_has(n, sl, st, hardening, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__NAME, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__HARDENING)) && list_has(n, sl, st, threats, agent_bytecode_schema.BS_THREAT_MODEL__NAME, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__THREAT_MODEL)) && list_has(n, sl, st, maps, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__NAME, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__EVIDENCE_MAP)) && governance_item != NONE && same_text(n, st, fld(n, sl, governance_item, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__EVIDENCE_MAP), fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__EVIDENCE_MAP)) && valid_strings(n, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__AGENTS)) && valid_strings(n, allowed) && valid_strings(n, denied) && valid_strings(n, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__PURPOSE)) && lists_disjoint(n, sl, st, allowed, denied) && one_of(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__NETWORK), "denied declared_only".as_slice()) && one_of(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__EXTERNAL_EXECUTION), "disabled sandboxed".as_slice()) && text_is(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__TOOL_EXECUTION), "disabled".as_slice()) && text_is(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__AGENT_EXECUTION), "disabled".as_slice()) && one_of(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__SECRETS), "denied env_reference_only".as_slice()) && text_is(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__KEY_MATERIAL), "denied".as_slice()) && text_is(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__AUDIT), "required".as_slice()) && text_is(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__EVIDENCE), "required".as_slice()) && text_is(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__SECURITY_REPORT), "required".as_slice()) && n[fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__FAIL_CLOSED)].a != 0u64 && text_is(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__SECURITY_CLAIMS), "none".as_slice()) && (n[notes].kind != V_STRING || !bare_empty(n, notes));
        if !valid { o = invalid(o, n, st, "runtime_execution_profile".as_slice(), name, "invalid binding, action boundary, or fail-closed requirement".as_slice(), NONE); }
    }
    o
}

fn validate_sandboxed_provider_adapters(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let items: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__SANDBOXED_PROVIDER_ADAPTERS);
    let providers: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__PROVIDERS);
    let runtimes: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__RUNTIME_EXECUTION_PROFILES);
    let mut link: u64 = n[items].a;
    while link != 0u64 {
        let adapter: u64 = link - 1u64;
        link = n[adapter].next;
        let name: u64 = fld(n, sl, adapter, agent_bytecode_schema.BS_SANDBOXED_PROVIDER_ADAPTER__NAME);
        if seen_before(n, sl, st, items, agent_bytecode_schema.BS_SANDBOXED_PROVIDER_ADAPTER__NAME, adapter, name) { o = named(o, n, st, "duplicate sandboxed_provider_adapter ".as_slice(), name, "".as_slice()); }
        let provider: u64 = fld(n, sl, adapter, agent_bytecode_schema.BS_SANDBOXED_PROVIDER_ADAPTER__PROVIDER);
        let runtime: u64 = find_last(n, sl, st, runtimes, agent_bytecode_schema.BS_RUNTIME_EXECUTION_PROFILE__NAME, fld(n, sl, adapter, agent_bytecode_schema.BS_SANDBOXED_PROVIDER_ADAPTER__RUNTIME));
        let allowed: u64 = fld(n, sl, adapter, agent_bytecode_schema.BS_SANDBOXED_PROVIDER_ADAPTER__ALLOWED_OPERATIONS);
        let denied: u64 = fld(n, sl, adapter, agent_bytecode_schema.BS_SANDBOXED_PROVIDER_ADAPTER__DENIED_OPERATIONS);
        let endpoint_value: u64 = fld(n, sl, adapter, agent_bytecode_schema.BS_SANDBOXED_PROVIDER_ADAPTER__ENDPOINT_VALUE);
