.BS_SPEC_FREEZE__FILESYSTEM_ACCESS, agent_bytecode_schema.BS_SPEC_FREEZE__TOOL_EXECUTION, agent_bytecode_schema.BS_SPEC_FREEZE__AGENT_EXECUTION, agent_bytecode_schema.BS_SPEC_FREEZE__SECURITY_CLAIMS, agent_bytecode_schema.BS_SPEC_FREEZE__LEGAL_CLAIMS, agent_bytecode_schema.BS_SPEC_FREEZE__CERTIFICATION) && (n[notes].kind != V_STRING || !bare_empty(n, notes));
        if !valid { o = invalid(o, n, st, "spec_freeze".as_slice(), name, "invalid freeze metadata or an enabled runtime/claim boundary".as_slice(), NONE); }
    }
