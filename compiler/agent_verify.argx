fn valid_strings(n: Slice<Value>, list: u64) -> bool {
    !is_empty(n, list) && !any_empty(n, list)
}

fn has_word(n: Slice<Value>, st: Slice<u8>, list: u64, word: Slice<u8>) -> bool {
    let mut link: u64 = n[list].a;
    while link != 0u64 {
        let item: u64 = link - 1u64;
        link = n[item].next;
        if text_is(n, st, item, word) { return true; }
    }
    false
}

fn closed_release_boundaries(n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, item: u64, runtime: u64, network: u64, external: u64, provider: u64, secret: u64, key: u64, env: u64, filesystem: u64, tool: u64, agent: u64, claims: u64, legal: u64, certification: u64) -> bool {
    text_is(n, st, fld(n, sl, item, runtime), "disabled".as_slice()) && text_is(n, st, fld(n, sl, item, network), "denied".as_slice()) && text_is(n, st, fld(n, sl, item, external), "disabled".as_slice()) && text_is(n, st, fld(n, sl, item, provider), "disabled".as_slice()) && text_is(n, st, fld(n, sl, item, secret), "denied".as_slice()) && text_is(n, st, fld(n, sl, item, key), "denied".as_slice()) && text_is(n, st, fld(n, sl, item, env), "denied".as_slice()) && text_is(n, st, fld(n, sl, item, filesystem), "denied".as_slice()) && text_is(n, st, fld(n, sl, item, tool), "disabled".as_slice()) && text_is(n, st, fld(n, sl, item, agent), "disabled".as_slice()) && text_is(n, st, fld(n, sl, item, claims), "none".as_slice()) && text_is(n, st, fld(n, sl, item, legal), "none".as_slice()) && text_is(n, st, fld(n, sl, item, certification), "none".as_slice())
}

fn validate_spec_freezes(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let items: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__SPEC_FREEZES);
    let mut link: u64 = n[items].a;
