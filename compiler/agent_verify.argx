core 0.1;
module compiler.agent_verify;

// The bytecode verifier's decisions on serialized bytecode, in Argorix
// (ESP-018.D.3). A `.argbc.json` file is read as stage0's
// `serde_json::from_str::<BytecodeProgram>` reads it, with the same errors at
// the same positions, into a tree of values; the verifier then decides on the
// tree (spec/language/verify.md).
//
// The reader ports serde_json 1.0.151 (de.rs, read.rs, error.rs) and serde's
// derived and internally tagged deserialization, over the tables of
// compiler.agent_bytecode_schema. Unreproduced forms still dump
// `unsupported`: noncanonical float diagnostics, numbers past u64 or out
// of f64's range, structs written as arrays, and Unicode Debug formatting
// outside printable Latin-1. The differential rejects `unsupported` in the
// maintained corpus.

import stdlib.bytes;
import stdlib.text;
import stdlib.result;
import compiler.agent_bytecode_schema;
import compiler.agent_check;

// A value of the tree. Objects keep their fields in slots
// (`a` the first, `b` the struct); arrays and maps link their elements
// through `next` (`a` the first + 1, `b` the last + 1); a map's elements are
// entries (`a` the key string, `b` the value); strings are `a..b` of
// `strings`; a variant has its index in `a` and its fields' object in `b`.
struct Value { kind: u64, a: u64, b: u64, next: u64, }

pub const V_NULL: u64 = 0u64;
pub const V_OBJECT: u64 = 1u64;
pub const V_ARRAY: u64 = 2u64;
pub const V_STRING: u64 = 3u64;
pub const V_BOOL: u64 = 4u64;
pub const V_U64: u64 = 5u64;
pub const V_I64: u64 = 6u64;
pub const V_F64: u64 = 7u64;
pub const V_VARIANT: u64 = 8u64;
pub const V_MAP: u64 = 9u64;
pub const V_ENTRY: u64 = 10u64;

// The reader: where it is in the input, how deep it may still go, the first
// error (its message, and its line and column, 0 until serde_json fixes the
// position of a custom error), and the tree.
struct Reader {
    index: u64,
    depth: u64,
    failed: bool,
    message: Buffer<u8>,
    line: u64,
    column: u64,
    unsupported: bool,
    nodes: Buffer<Value>,
    slots: Buffer<u64>,
    strings: Buffer<u8>,
    result: u64,
}

const NONE: u64 = 1000000000u64;

// ------------------------------------------------------------------ positions and errors

// serde_json's `position_of_index`: the line, from 1, and the bytes since the
// line began.
fn at_index(s: Slice<u8>, reader: Reader, i: u64) -> Reader {
    let mut r: Reader = reader;
    let mut line: u64 = 1u64;
    let mut start: u64 = 0u64;
    let mut at: u64 = 0u64;
    while at < i {
        if s[at] == 10u8 {
            line += 1u64;
            start = at + 1u64;
        }
        at += 1u64;
    }
    r.line = line;
    r.column = i - start;
    r
}

fn set_message(reader: Reader, message: Slice<u8>) -> Reader {
    let mut r: Reader = reader;
    r.failed = true;
    let mut index: u64 = 0u64;
    while index < message.length() {
        r.message.push(message[index]);
        index += 1u64;
    }
    r
}

// `error`: at the current index.
fn error(s: Slice<u8>, reader: Reader, message: Slice<u8>) -> Reader {
    let i: u64 = reader.index;
    at_index(s, set_message(reader, message), i)
}

// `peek_error`: one past the current index, at most the end.
fn peek_error(s: Slice<u8>, reader: Reader, message: Slice<u8>) -> Reader {
    let mut i: u64 = reader.index + 1u64;
    if i > s.length() {
        i = s.length();
    }
    at_index(s, set_message(reader, message), i)
}

// A custom error of serde: no position until `fix_position`.
fn custom(reader: Reader, message: Slice<u8>) -> Reader {
    let mut r: Reader = set_message(reader, message);
    r.line = 0u64;
    r
}

// `fix_position`: a custom error takes the current index.
fn fix_position(s: Slice<u8>, reader: Reader) -> Reader {
    if !reader.failed || reader.line != 0u64 {
        return reader;
    }
    let i: u64 = reader.index;
    at_index(s, reader, i)
}

fn unsupported(reader: Reader) -> Reader {
    let mut r: Reader = reader;
    r.unsupported = true;
    r.failed = true;
    r
}

// ------------------------------------------------------------------ the tree

fn add(reader: Reader, kind: u64, a: u64, b: u64) -> Reader {
    let mut r: Reader = reader;
    r.result = r.nodes.length();
    r.nodes.push(Value { kind: kind, a: a, b: b, next: 0u64 });
    r
}

// `value` appended to array or map `node`.
fn push(reader: Reader, node: u64, value: u64) -> Reader {
    let mut r: Reader = reader;
    let last: u64 = r.nodes[node].b;
    if last == 0u64 {
        r.nodes[node].a = value + 1u64;
    } else {
        r.nodes[last - 1u64].next = value + 1u64;
    }
    r.nodes[node].b = value + 1u64;
    r
}

fn string_node(reader: Reader, text_bytes: Slice<u8>) -> Reader {
    let mut r: Reader = reader;
    let start: u64 = r.strings.length();
    let mut index: u64 = 0u64;
    while index < text_bytes.length() {
        r.strings.push(text_bytes[index]);
        index += 1u64;
    }
    let end: u64 = r.strings.length();
    add(r, V_STRING, start, end)
}

// ------------------------------------------------------------------ bytes

fn peek_is(s: Slice<u8>, index: u64, byte: u8) -> bool {
    index < s.length() && s[index] == byte
}

// `parse_whitespace`: past spaces, line feeds, tabs and carriage returns.
fn whitespace(s: Slice<u8>, reader: Reader) -> Reader {
    let mut r: Reader = reader;
    while r.index < s.length() && (s[r.index] == 32u8 || s[r.index] == 10u8 || s[r.index] == 9u8 || s[r.index] == 13u8) {
        r.index += 1u64;
    }
    r
}

// `parse_ident`: the rest of `null`, `true` or `false`.
fn ident(s: Slice<u8>, reader: Reader, rest: Slice<u8>) -> Reader {
    let mut r: Reader = reader;
    let mut index: u64 = 0u64;
    while index < rest.length() {
        if r.index >= s.length() {
            return error(s, r, "EOF while parsing a value".as_slice());
        }
        let next: u8 = s[r.index];
        r.index += 1u64;
        if next != rest[index] {
            return error(s, r, "expected ident".as_slice());
        }
        index += 1u64;
    }
    r
}

// ------------------------------------------------------------------ strings

// `decode_hex_escape`: four hex digits after `\u`, or NONE on an error.
fn hex_escape(s: Slice<u8>, reader: Reader) -> Reader {
    let mut r: Reader = reader;
    if s.length() - r.index < 4u64 {
        r.index = s.length();
        return error(s, r, "EOF while parsing a string".as_slice());
    }
    let mut value: u64 = 0u64;
    let mut index: u64 = 0u64;
    let mut valid: bool = true;
    while index < 4u64 {
        let c: u8 = s[r.index + index];
        let mut digit: u64 = 16u64;
        if c >= 48u8 && c <= 57u8 {
            digit = widen(c) - 48u64;
        } else if c >= 65u8 && c <= 70u8 {
            digit = widen(c) - 55u64;
        } else if c >= 97u8 && c <= 102u8 {
            digit = widen(c) - 87u64;
        }
        if digit == 16u64 {
            valid = false;
        }
        value = value * 16u64 + digit;
        index += 1u64;
    }
    r.index += 4u64;
    if !valid {
        return error(s, r, "invalid escape".as_slice());
    }
    r.result = value;
    r
}

fn widen(byte: u8) -> u64 {
    let mut value: u64 = 0u64;
    let mut bit: u8 = 128u8;
    let mut weight: u64 = 128u64;
    while weight > 0u64 {
        if byte & bit != 0u8 {
            value += weight;
        }
        bit = bit / 2u8;
        weight = weight / 2u64;
    }
    value
}

// The UTF-8 bytes of code point `n`.
fn push_code_point(out: Buffer<u8>, n: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    if n < 128u64 {
        o.push(narrow(n));
    } else if n < 2048u64 {
        o.push(narrow(192u64 + n / 64u64));
        o.push(narrow(128u64 + n % 64u64));
    } else if n < 65536u64 {
        o.push(narrow(224u64 + n / 4096u64));
        o.push(narrow(128u64 + (n / 64u64) % 64u64));
        o.push(narrow(128u64 + n % 64u64));
    } else {
        o.push(narrow(240u64 + n / 262144u64));
        o.push(narrow(128u64 + (n / 4096u64) % 64u64));
        o.push(narrow(128u64 + (n / 64u64) % 64u64));
        o.push(narrow(128u64 + n % 64u64));
    }
    o
}

fn narrow(value: u64) -> u8 {
    let mut byte: u8 = 0u8;
    let mut weight: u64 = 128u64;
    let mut bit: u8 = 128u8;
    while weight > 0u64 {
        if value % (weight * 2u64) >= weight {
            byte = byte + bit;
        }
        weight = weight / 2u64;
        bit = bit / 2u8;
    }
    byte
}

// `parse_str` after the opening quote: the string's node, or an error.
fn parse_string(s: Slice<u8>, reader: Reader) -> Reader {
    let mut r: Reader = reader;
    let mut decoded: Buffer<u8> = Buffer::new();
    loop {
        while r.index < s.length() && s[r.index] != 34u8 && s[r.index] != 92u8 && s[r.index] >= 32u8 {
            decoded.push(s[r.index]);
            r.index += 1u64;
        }
        if r.index == s.length() {
            return error(s, r, "EOF while parsing a string".as_slice());
        }
        let byte: u8 = s[r.index];
        if byte == 34u8 {
            r.index += 1u64;
            return string_node(r, decoded.as_slice());
        }
        if byte != 92u8 {
            r.index += 1u64;
            return error(s, r, "control character (\\u0000-\\u001F) found while parsing a string".as_slice());
        }
        r.index += 1u64;
        if r.index == s.length() {
            return error(s, r, "EOF while parsing a string".as_slice());
        }
        let escape: u8 = s[r.index];
        r.index += 1u64;
        if escape == 34u8 || escape == 92u8 || escape == 47u8 {
            decoded.push(escape);
        } else if escape == 98u8 {
            decoded.push(8u8);
        } else if escape == 102u8 {
            decoded.push(12u8);
        } else if escape == 110u8 {
            decoded.push(10u8);
        } else if escape == 114u8 {
            decoded.push(13u8);
        } else if escape == 116u8 {
            decoded.push(9u8);
        } else if escape == 117u8 {
            r = hex_escape(s, r);
            if r.failed {
                return r;
            }
            let n: u64 = r.result;
            if n >= 56320u64 && n <= 57343u64 {
                return error(s, r, "lone leading surrogate in hex escape".as_slice());
            }
            if n < 55296u64 || n > 56319u64 {
                decoded = push_code_point(decoded, n);
            } else {
                if r.index == s.length() {
                    return error(s, r, "EOF while parsing a string".as_slice());
                }
                let backslash: u8 = s[r.index];
                r.index += 1u64;
                if backslash != 92u8 {
                    return error(s, r, "unexpected end of hex escape".as_slice());
                }
                if r.index == s.length() {
                    return error(s, r, "EOF while parsing a string".as_slice());
                }
                let u: u8 = s[r.index];
                r.index += 1u64;
                if u != 117u8 {
                    return error(s, r, "unexpected end of hex escape".as_slice());
                }
                r = hex_escape(s, r);
                if r.failed {
                    return r;
                }
                let n2: u64 = r.result;
                if n2 < 56320u64 || n2 > 57343u64 {
                    return error(s, r, "lone leading surrogate in hex escape".as_slice());
                }
                decoded = push_code_point(decoded, (n - 55296u64) * 1024u64 + (n2 - 56320u64) + 65536u64);
            }
        } else {
            return error(s, r, "invalid escape".as_slice());
        }
    }
    r
}

// `ignore_str` after the opening quote.
fn ignore_string(s: Slice<u8>, reader: Reader) -> Reader {
    let mut r: Reader = reader;
    loop {
        while r.index < s.length() && s[r.index] != 34u8 && s[r.index] != 92u8 && s[r.index] >= 32u8 {
            r.index += 1u64;
        }
        if r.index == s.length() {
            return error(s, r, "EOF while parsing a string".as_slice());
        }
        let byte: u8 = s[r.index];
        if byte == 34u8 {
            r.index += 1u64;
            return r;
        }
        if byte != 92u8 {
            return error(s, r, "control character (\\u0000-\\u001F) found while parsing a string".as_slice());
        }
        r.index += 1u64;
        if r.index == s.length() {
            return error(s, r, "EOF while parsing a string".as_slice());
        }
        let escape: u8 = s[r.index];
        r.index += 1u64;
        if escape == 117u8 {
            r = hex_escape(s, r);
            if r.failed {
                return r;
            }
        } else if !(escape == 34u8 || escape == 92u8 || escape == 47u8 || escape == 98u8 || escape == 102u8 || escape == 110u8 || escape == 114u8 || escape == 116u8) {
            return error(s, r, "invalid escape".as_slice());
        }
    }
    r
}

// ------------------------------------------------------------------ numbers

// `parse_integer` after an optional `-`: a U64, I64 or F64 node. A number
// that could be out of f64's range remains `unsupported`.
fn parse_integer(s: Slice<u8>, reader: Reader, positive: bool) -> Reader {
    let mut r: Reader = reader;
    let start: u64 = if positive { r.index } else { r.index - 1u64 };
    if r.index >= s.length() {
        return error(s, r, "EOF while parsing a value".as_slice());
    }
    let first: u8 = s[r.index];
    r.index += 1u64;
    let mut significand: u64 = 0u64;
    let mut digits: u64 = 1u64;
    let mut long: bool = false;
    if first == 48u8 {
        if r.index < s.length() && s[r.index] >= 48u8 && s[r.index] <= 57u8 {
            return peek_error(s, r, "invalid number".as_slice());
        }
    } else if first >= 49u8 && first <= 57u8 {
        significand = widen(first) - 48u64;
        while r.index < s.length() && s[r.index] >= 48u8 && s[r.index] <= 57u8 {
            let digit: u64 = widen(s[r.index]) - 48u64;
            // Past u64, `parse_long_integer` reads the rest as a float.
            if significand > 1844674407370955161u64 || (significand == 1844674407370955161u64 && digit > 5u64) {
                long = true;
            } else {
                significand = significand * 10u64 + digit;
            }
            r.index += 1u64;
            digits += 1u64;
        }
    } else {
        return error(s, r, "invalid number".as_slice());
    }
    parse_number(s, r, positive, significand, digits, long, start)
}

fn parse_number(s: Slice<u8>, reader: Reader, positive: bool, significand: u64, digits: u64, long: bool, start: u64) -> Reader {
    let mut r: Reader = reader;
    let mut exponent: u64 = 0u64;
    let mut negative_exponent: bool = false;
    let mut float: bool = long;
    if peek_is(s, r.index, 46u8) {
        float = true;
        r.index += 1u64;
        let mut after: u64 = 0u64;
        while r.index < s.length() && s[r.index] >= 48u8 && s[r.index] <= 57u8 {
            r.index += 1u64;
            after += 1u64;
        }
        if after == 0u64 {
            if r.index < s.length() {
                return peek_error(s, r, "invalid number".as_slice());
            }
            return peek_error(s, r, "EOF while parsing a value".as_slice());
        }
    }
    if peek_is(s, r.index, 101u8) || peek_is(s, r.index, 69u8) {
        float = true;
        r.index += 1u64;
        if peek_is(s, r.index, 43u8) {
            r.index += 1u64;
        } else if peek_is(s, r.index, 45u8) {
            r.index += 1u64;
            negative_exponent = true;
        }
        if r.index >= s.length() {
            return error(s, r, "EOF while parsing a value".as_slice());
        }
        let next: u8 = s[r.index];
        r.index += 1u64;
        if next < 48u8 || next > 57u8 {
            return error(s, r, "invalid number".as_slice());
        }
        exponent = widen(next) - 48u64;
        while r.index < s.length() && s[r.index] >= 48u8 && s[r.index] <= 57u8 {
            if exponent > 100000u64 {
                return unsupported(r);
            }
            exponent = exponent * 10u64 + widen(s[r.index]) - 48u64;
            r.index += 1u64;
        }
    }
    if float {
        // Only a large positive exponent can overflow f64.
        if significand != 0u64 && !negative_exponent && digits + exponent >= 300u64 {
            return unsupported(r);
        }
        return float_node(s, r, start);
    }
    if positive {
        return add(r, V_U64, significand, 0u64);
    }
    if significand == 0u64 || significand > 9223372036854775808u64 {
        // `-0` and what underflows i64 become floats.
        return float_node(s, r, start);
    }
    add(r, V_I64, significand, 0u64)
}

// Preserve the lexeme for the subset where serde_json's shortest float
// spelling is identical to the input. Other float diagnostics remain
// unsupported rather than risking a different error message.
fn float_node(s: Slice<u8>, reader: Reader, start: u64) -> Reader {
    let mut r: Reader = reader;
    let first: u64 = r.strings.length();
    let mut at: u64 = start;
    while at < r.index {
        r.strings.push(s[at]);
        at += 1u64;
    }
    let end: u64 = r.strings.length();
    add(r, V_F64, first, end)
}

fn canonical_simple_float(raw: Slice<u8>) -> bool {
    let mut dot: u64 = 0u64;
    while dot < raw.length() && raw[dot] != 46u8 {
        if raw[dot] == 101u8 || raw[dot] == 69u8 { return false; }
        dot += 1u64;
    }
    if dot == raw.length() || dot + 1u64 == raw.length() || raw[raw.length() - 1u64] == 48u8 || raw.length() > 16u64 { return false; }
    let mut at: u64 = dot + 1u64;
    while at < raw.length() {
        if raw[at] < 48u8 || raw[at] > 57u8 { return false; }
        at += 1u64;
    }
    true
}

// `Unexpected` of a number node, as serde_json writes it.
fn append_number(out: Buffer<u8>, value: Value) -> Buffer<u8> {
    let mut o: Buffer<u8> = bytes.append(out, "integer `".as_slice());
    if value.kind == V_I64 {
        o.push(45u8);
    }
    o = bytes.append_decimal(o, value.a);
    o.push(96u8);
    o
}

// ------------------------------------------------------------------ serde's messages

// A string as Rust's `{:?}` writes it for the supported printable range.
fn append_debug(out: Buffer<u8>, value: Slice<u8>) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    o.push(34u8);
    let mut index: u64 = 0u64;
    while index < value.length() {
        let c: u8 = value[index];
        if c == 9u8 {
            o = bytes.append(o, "\\t".as_slice());
        } else if c == 10u8 {
            o = bytes.append(o, "\\n".as_slice());
        } else if c == 13u8 {
            o = bytes.append(o, "\\r".as_slice());
        } else if c == 0u8 {
            o = bytes.append(o, "\\0".as_slice());
        } else if c == 34u8 || c == 92u8 {
            o.push(92u8);
            o.push(c);
        } else if c < 32u8 || c == 127u8 {
            o = bytes.append(o, "\\u{".as_slice());
            let code: u64 = widen(c);
            if code >= 16u64 {
                o.push(hex_digit(code / 16u64));
            }
            o.push(hex_digit(code % 16u64));
            o.push(125u8);
        } else {
            o.push(c);
        }
        index += 1u64;
    }
    o.push(34u8);
    o
}

fn hex_digit(value: u64) -> u8 {
    if value < 10u64 {
        return narrow(48u64 + value);
    }
    narrow(87u64 + value)
}

// Printable Latin-1 characters have the same quoted spelling in Rust's
// Debug formatter and in UTF-8. Keep other non-ASCII characters undecided.
fn debug_safe(value: Slice<u8>) -> bool {
    let mut at: u64 = 0u64;
    while at < value.length() {
        let c: u8 = value[at];
        if c < 128u8 { at += 1u64; }
        else if at + 1u64 < value.length() && c == 194u8 && value[at + 1u64] >= 161u8 && value[at + 1u64] <= 191u8 && value[at + 1u64] != 173u8 { at += 2u64; }
        else if at + 1u64 < value.length() && c == 195u8 && value[at + 1u64] >= 128u8 && value[at + 1u64] <= 191u8 { at += 2u64; }
        else { return false; }
    }
    true
}

// "invalid type: <what node is>, expected <expected>", a custom error; a
// other float and Unicode Debug forms remain `unsupported`.
fn invalid_type(reader: Reader, node: u64, expected: Slice<u8>) -> Reader {
    let found: Value = reader.nodes[node];
    let mut message: Buffer<u8> = bytes.append(Buffer::new(), "invalid type: ".as_slice());
    if found.kind == V_NULL {
        message = bytes.append(message, "null".as_slice());
    } else if found.kind == V_BOOL {
        if found.a == 1u64 {
            message = bytes.append(message, "boolean `true`".as_slice());
        } else {
            message = bytes.append(message, "boolean `false`".as_slice());
        }
    } else if found.kind == V_U64 || found.kind == V_I64 {
        message = append_number(message, found);
    } else if found.kind == V_STRING {
        let text_bytes: Buffer<u8> = copy_range(reader.strings.as_slice(), found.a, found.b);
        if !debug_safe(text_bytes.as_slice()) {
            return unsupported(reader);
        }
        message = bytes.append(message, "string ".as_slice());
        message = append_debug(message, text_bytes.as_slice());
    } else if found.kind == V_F64 {
        let raw: Buffer<u8> = copy_range(reader.strings.as_slice(), found.a, found.b);
        if !canonical_simple_float(raw.as_slice()) { return unsupported(reader); }
        message = bytes.append(message, "floating point `".as_slice());
        message = bytes.append(message, raw.as_slice());
        message.push(96u8);
    } else if found.kind == V_ARRAY {
        message = bytes.append(message, "sequence".as_slice());
    } else if found.kind == V_MAP {
        message = bytes.append(message, "map".as_slice());
    } else {
        return unsupported(reader);
    }
    message = bytes.append(message, ", expected ".as_slice());
    message = bytes.append(message, expected);
    custom(reader, message.as_slice())
}

// `peek_invalid_type`: read the value that is not of the expected type, then
// the custom error, positioned where the value ends.
fn peek_invalid_type(s: Slice<u8>, reader: Reader, expected: Slice<u8>) -> Reader {
    let mut r: Reader = reader;
    let mut peek: u8 = 0u8;
    if r.index < s.length() {
        peek = s[r.index];
    }
    if peek == 110u8 {
        r.index += 1u64;
        r = ident(s, r, "ull".as_slice());
        if r.failed {
            return r;
        }
        r = add(r, V_NULL, 0u64, 0u64);
    } else if peek == 116u8 {
        r.index += 1u64;
        r = ident(s, r, "rue".as_slice());
        if r.failed {
            return r;
        }
        r = add(r, V_BOOL, 1u64, 0u64);
    } else if peek == 102u8 {
        r.index += 1u64;
        r = ident(s, r, "alse".as_slice());
        if r.failed {
            return r;
        }
        r = add(r, V_BOOL, 0u64, 0u64);
    } else if peek == 45u8 {
        r.index += 1u64;
        r = parse_integer(s, r, false);
        if r.failed {
            return r;
        }
    } else if peek >= 48u8 && peek <= 57u8 {
        r = parse_integer(s, r, true);
        if r.failed {
            return r;
        }
    } else if peek == 34u8 {
        r.index += 1u64;
        r = parse_string(s, r);
        if r.failed {
            return r;
        }
    } else if peek == 91u8 {
        r = add(r, V_ARRAY, 0u64, 0u64);
    } else if peek == 123u8 {
        r = add(r, V_MAP, 0u64, 0u64);
    } else {
        return peek_error(s, r, "expected value".as_slice());
    }
    let node: u64 = r.result;
    r = invalid_type(r, node, expected);
    fix_position(s, r)
}

fn missing_field(reader: Reader, s: u64, i: u64) -> Reader {
    let mut message: Buffer<u8> = bytes.append(Buffer::new(), "missing field `".as_slice());
    message = agent_bytecode_schema.append_field_key(message, s, i);
    message.push(96u8);
    custom(reader, message.as_slice())
}

fn duplicate_field(reader: Reader, key: Slice<u8>) -> Reader {
    let mut message: Buffer<u8> = bytes.append(Buffer::new(), "duplicate field `".as_slice());
    message = bytes.append(message, key);
    message.push(96u8);
    custom(reader, message.as_slice())
}

// ------------------------------------------------------------------ structure

// `end_seq`, when no error came before it; otherwise only its movement.
fn end_seq(s: Slice<u8>, reader: Reader) -> Reader {
    let mut r: Reader = whitespace(s, reader);
    let failed: bool = r.failed;
    if r.index >= s.length() {
        if failed {
            return r;
        }
        return peek_error(s, r, "EOF while parsing a list".as_slice());
    }
    let byte: u8 = s[r.index];
    if byte == 93u8 {
        r.index += 1u64;
        return r;
    }
    if byte == 44u8 {
        r.index += 1u64;
        r = whitespace(s, r);
        if failed {
            return r;
        }
        if peek_is(s, r.index, 93u8) {
            return peek_error(s, r, "trailing comma".as_slice());
        }
        return peek_error(s, r, "trailing characters".as_slice());
    }
    if failed {
        return r;
    }
    peek_error(s, r, "trailing characters".as_slice())
}

// `end_map`, likewise.
fn end_map(s: Slice<u8>, reader: Reader) -> Reader {
    let mut r: Reader = whitespace(s, reader);
    if r.index < s.length() && s[r.index] == 125u8 {
        r.index += 1u64;
        return r;
    }
    if r.failed {
        return r;
    }
    if r.index >= s.length() {
        return peek_error(s, r, "EOF while parsing an object".as_slice());
    }
    if s[r.index] == 44u8 {
        return peek_error(s, r, "trailing comma".as_slice());
    }
    peek_error(s, r, "trailing characters".as_slice())
}

// `has_next_element`: whether the list goes on; `result` is 1 if it does.
fn next_element(s: Slice<u8>, reader: Reader, first: bool) -> Reader {
    let mut r: Reader = whitespace(s, reader);
    r.result = 0u64;
    if r.index >= s.length() {
        return peek_error(s, r, "EOF while parsing a list".as_slice());
    }
    let byte: u8 = s[r.index];
    if byte == 93u8 {
        return r;
    }
    if first {
        r.result = 1u64;
        return r;
    }
    if byte != 44u8 {
        return peek_error(s, r, "expected `,` or `]`".as_slice());
    }
    r.index += 1u64;
    r = whitespace(s, r);
    if r.index >= s.length() {
        return peek_error(s, r, "EOF while parsing a value".as_slice());
    }
    if s[r.index] == 93u8 {
        return peek_error(s, r, "trailing comma".as_slice());
    }
    r.result = 1u64;
    r
}

// `has_next_key` and the key after it: `result` is the key's string node, or
// NONE at the end of the object.
fn next_key(s: Slice<u8>, reader: Reader, first: bool) -> Reader {
    let mut r: Reader = whitespace(s, reader);
    r.result = NONE;
    if r.index >= s.length() {
        return peek_error(s, r, "EOF while parsing an object".as_slice());
    }
    let byte: u8 = s[r.index];
    if byte == 125u8 {
        return r;
    }
    if first {
        if byte != 34u8 {
            return peek_error(s, r, "key must be a string".as_slice());
        }
    } else {
        if byte != 44u8 {
            return peek_error(s, r, "expected `,` or `}`".as_slice());
        }
        r.index += 1u64;
        r = whitespace(s, r);
        if r.index >= s.length() {
            return peek_error(s, r, "EOF while parsing a value".as_slice());
        }
        if s[r.index] == 125u8 {
            return peek_error(s, r, "trailing comma".as_slice());
        }
        if s[r.index] != 34u8 {
            return peek_error(s, r, "key must be a string".as_slice());
        }
    }
    r.index += 1u64;
    parse_string(s, r)
}

// `parse_object_colon`.
fn colon(s: Slice<u8>, reader: Reader) -> Reader {
    let mut r: Reader = whitespace(s, reader);
    if r.index >= s.length() {
        return peek_error(s, r, "EOF while parsing an object".as_slice());
    }
    if s[r.index] != 58u8 {
        return peek_error(s, r, "expected `:`".as_slice());
    }
    r.index += 1u64;
    r
}

// `check_recursion` on entering a list or an object.
fn deeper(s: Slice<u8>, reader: Reader) -> Reader {
    let mut r: Reader = reader;
    r.depth -= 1u64;
    if r.depth == 0u64 {
        return peek_error(s, r, "recursion limit exceeded".as_slice());
    }
    r
}

// `ignore_value`: a value skipped, as serde_json skips an unknown field's.
fn ignore_value(s: Slice<u8>, reader: Reader) -> Reader {
    let mut r: Reader = reader;
    let mut frames: Buffer<u8> = Buffer::new();
    let mut enclosing: u8 = 0u8;
    loop {
        r = whitespace(s, r);
        if r.index >= s.length() {
            return peek_error(s, r, "EOF while parsing a value".as_slice());
        }
        let peek: u8 = s[r.index];
        let mut frame: u8 = 0u8;
        if peek == 110u8 {
            r.index += 1u64;
            r = ident(s, r, "ull".as_slice());
        } else if peek == 116u8 {
            r.index += 1u64;
            r = ident(s, r, "rue".as_slice());
        } else if peek == 102u8 {
            r.index += 1u64;
            r = ident(s, r, "alse".as_slice());
        } else if peek == 45u8 {
            r.index += 1u64;
            r = ignore_integer(s, r);
        } else if peek >= 48u8 && peek <= 57u8 {
            r = ignore_integer(s, r);
        } else if peek == 34u8 {
            r.index += 1u64;
            r = ignore_string(s, r);
        } else if peek == 91u8 || peek == 123u8 {
            if enclosing != 0u8 {
                frames.push(enclosing);
                enclosing = 0u8;
            }
            r.index += 1u64;
            frame = peek;
        } else {
            return peek_error(s, r, "expected value".as_slice());
        }
        if r.failed {
            return r;
        }
        let mut accept_comma: bool = false;
        if frame == 0u8 {
            if enclosing != 0u8 {
                frame = enclosing;
                enclosing = 0u8;
                accept_comma = true;
            } else if frames.length() > 0u64 {
                frame = frames[frames.length() - 1u64];
                frames = pop(frames);
                accept_comma = true;
            } else {
                return r;
            }
        }
        loop {
            r = whitespace(s, r);
            if r.index >= s.length() {
                if frame == 91u8 {
                    return peek_error(s, r, "EOF while parsing a list".as_slice());
                }
                return peek_error(s, r, "EOF while parsing an object".as_slice());
            }
            let next: u8 = s[r.index];
            if next == 44u8 && accept_comma {
                r.index += 1u64;
                break;
            }
            let closes: bool = (next == 93u8 && frame == 91u8) || (next == 125u8 && frame == 123u8);
            if !closes {
                if accept_comma {
                    if frame == 91u8 {
                        return peek_error(s, r, "expected `,` or `]`".as_slice());
                    }
                    return peek_error(s, r, "expected `,` or `}`".as_slice());
                }
                break;
            }
            r.index += 1u64;
            if frames.length() == 0u64 {
                return r;
            }
            frame = frames[frames.length() - 1u64];
            frames = pop(frames);
            accept_comma = true;
        }
        if frame == 123u8 {
            r = whitespace(s, r);
            if r.index >= s.length() {
                return peek_error(s, r, "EOF while parsing an object".as_slice());
            }
            if s[r.index] != 34u8 {
                return peek_error(s, r, "key must be a string".as_slice());
            }
            r.index += 1u64;
            r = ignore_string(s, r);
            if r.failed {
                return r;
            }
            r = whitespace(s, r);
            if r.index >= s.length() {
                return peek_error(s, r, "EOF while parsing an object".as_slice());
            }
            if s[r.index] != 58u8 {
                return peek_error(s, r, "expected `:`".as_slice());
            }
            r.index += 1u64;
        }
        enclosing = frame;
    }
    r
}

// The buffer without its last byte.
fn pop(frames: Buffer<u8>) -> Buffer<u8> {
    let mut out: Buffer<u8> = Buffer::new();
    let mut index: u64 = 0u64;
    while index + 1u64 < frames.length() {
        out.push(frames[index]);
        index += 1u64;
    }
    out
}

// `ignore_integer` and its decimal and exponent.
fn ignore_integer(s: Slice<u8>, reader: Reader) -> Reader {
    let mut r: Reader = reader;
    let mut first: u8 = 0u8;
    if r.index < s.length() {
        first = s[r.index];
        r.index += 1u64;
    }
    if first == 48u8 {
        if r.index < s.length() && s[r.index] >= 48u8 && s[r.index] <= 57u8 {
            return peek_error(s, r, "invalid number".as_slice());
        }
    } else if first >= 49u8 && first <= 57u8 {
        while r.index < s.length() && s[r.index] >= 48u8 && s[r.index] <= 57u8 {
            r.index += 1u64;
        }
    } else {
        return error(s, r, "invalid number".as_slice());
    }
    if peek_is(s, r.index, 46u8) {
        r.index += 1u64;
        let mut digit: bool = false;
        while r.index < s.length() && s[r.index] >= 48u8 && s[r.index] <= 57u8 {
            r.index += 1u64;
            digit = true;
        }
        if !digit {
            return peek_error(s, r, "invalid number".as_slice());
        }
    }
    if peek_is(s, r.index, 101u8) || peek_is(s, r.index, 69u8) {
        r.index += 1u64;
        if peek_is(s, r.index, 43u8) || peek_is(s, r.index, 45u8) {
            r.index += 1u64;
        }
        let mut next: u8 = 0u8;
        if r.index < s.length() {
            next = s[r.index];
            r.index += 1u64;
        }
        if next < 48u8 || next > 57u8 {
            return error(s, r, "invalid number".as_slice());
        }
        while r.index < s.length() && s[r.index] >= 48u8 && s[r.index] <= 57u8 {
            r.index += 1u64;
        }
    }
    r
}

// ------------------------------------------------------------------ typed values

// The value of type `ty` (agent_bytecode_schema's `kind + 16 * struct`).
const T_STRUCT: u64 = 10u64;
const T_INSTRUCTION: u64 = 11u64;
const T_U64: u64 = 12u64;

fn deserialize(s: Slice<u8>, reader: Reader, ty: u64) -> Reader {
    let kind: u64 = ty % 16u64;
    let inner: u64 = ty / 16u64;
    if kind == agent_bytecode_schema.T_STRING {
        return de_str(s, reader, "a string".as_slice());
    }
    if kind == agent_bytecode_schema.T_BOOL {
        return de_bool(s, reader);
    }
    if kind == T_U64 {
        return de_u64(s, reader);
    }
    if kind == agent_bytecode_schema.T_STRINGS {
        return de_seq(s, reader, agent_bytecode_schema.T_STRING);
    }
    if kind == agent_bytecode_schema.T_LIST {
        return de_seq(s, reader, T_STRUCT + 16u64 * inner);
    }
    if kind == agent_bytecode_schema.T_INSTRUCTIONS {
        return de_seq(s, reader, T_INSTRUCTION);
    }
    if kind == T_STRUCT {
        return de_struct(s, reader, inner);
    }
    if kind == T_INSTRUCTION {
        return de_instruction(s, reader);
    }
    // An option: `null`, or the value.
    let mut r: Reader = whitespace(s, reader);
    if peek_is(s, r.index, 110u8) {
        r.index += 1u64;
        r = ident(s, r, "ull".as_slice());
        if r.failed {
            return r;
        }
        return add(r, V_NULL, 0u64, 0u64);
    }
    if kind == agent_bytecode_schema.T_OPTION_STRING {
        return de_str(s, r, "a string".as_slice());
    }
    if kind == agent_bytecode_schema.T_OPTION_BOOL {
        return de_bool(s, r);
    }
    if kind == agent_bytecode_schema.T_OPTION_U64 {
        return de_u64(s, r);
    }
    de_struct(s, r, inner)
}

fn de_str(s: Slice<u8>, reader: Reader, expected: Slice<u8>) -> Reader {
    let mut r: Reader = whitespace(s, reader);
    if r.index >= s.length() {
        return peek_error(s, r, "EOF while parsing a value".as_slice());
    }
    if s[r.index] == 34u8 {
        r.index += 1u64;
        return parse_string(s, r);
    }
    peek_invalid_type(s, r, expected)
}

fn de_bool(s: Slice<u8>, reader: Reader) -> Reader {
    let mut r: Reader = whitespace(s, reader);
    if r.index >= s.length() {
        return peek_error(s, r, "EOF while parsing a value".as_slice());
    }
    if s[r.index] == 116u8 {
        r.index += 1u64;
        r = ident(s, r, "rue".as_slice());
        if r.failed {
            return r;
        }
        return add(r, V_BOOL, 1u64, 0u64);
    }
    if s[r.index] == 102u8 {
        r.index += 1u64;
        r = ident(s, r, "alse".as_slice());
        if r.failed {
            return r;
        }
        return add(r, V_BOOL, 0u64, 0u64);
    }
    peek_invalid_type(s, r, "a boolean".as_slice())
}

// `deserialize_number` with serde's u64 visitor.
fn de_u64(s: Slice<u8>, reader: Reader) -> Reader {
    let mut r: Reader = whitespace(s, reader);
    if r.index >= s.length() {
        return peek_error(s, r, "EOF while parsing a value".as_slice());
    }
    let peek: u8 = s[r.index];
    if peek == 45u8 {
        r.index += 1u64;
        r = parse_integer(s, r, false);
    } else if peek >= 48u8 && peek <= 57u8 {
        r = parse_integer(s, r, true);
    } else {
        return peek_invalid_type(s, r, "u64".as_slice());
    }
    if r.failed {
        return r;
    }
    let found: Value = r.nodes[r.result];
    if found.kind == V_U64 {
        return r;
    }
    if found.kind == V_F64 {
        return unsupported(r);
    }
    let mut message: Buffer<u8> = bytes.append(Buffer::new(), "invalid value: ".as_slice());
    message = append_number(message, found);
    message = bytes.append(message, ", expected u64".as_slice());
    fix_position(s, custom(r, message.as_slice()))
}

// `deserialize_seq` with Vec's visitor: elements of type `element`.
fn de_seq(s: Slice<u8>, reader: Reader, element: u64) -> Reader {
    let mut r: Reader = whitespace(s, reader);
    if r.index >= s.length() {
        return peek_error(s, r, "EOF while parsing a value".as_slice());
    }
    if s[r.index] != 91u8 {
        return peek_invalid_type(s, r, "a sequence".as_slice());
    }
    r = deeper(s, r);
    if r.failed {
        return r;
    }
    r.index += 1u64;
    r = add(r, V_ARRAY, 0u64, 0u64);
    let array: u64 = r.result;
    let mut first: bool = true;
    loop {
        r = next_element(s, r, first);
        if r.failed || r.result == 0u64 {
            break;
        }
        first = false;
        r = deserialize(s, r, element);
        if r.failed {
            break;
        }
        let item: u64 = r.result;
        r = push(r, array, item);
    }
    r.depth += 1u64;
    r = end_seq(s, r);
    r.result = array;
    fix_position(s, r)
}

// `deserialize_struct` with the derived visitor of struct `st`.
fn de_struct(s: Slice<u8>, reader: Reader, st: u64) -> Reader {
    let mut r: Reader = whitespace(s, reader);
    if r.index >= s.length() {
        return peek_error(s, r, "EOF while parsing a value".as_slice());
    }
    if s[r.index] == 91u8 {
        return unsupported(r);
    }
    if s[r.index] != 123u8 {
        let expected: Buffer<u8> = agent_bytecode_schema.append_struct_name(Buffer::new(), st);
        return peek_invalid_type(s, r, expected.as_slice());
    }
    r = deeper(s, r);
    if r.failed {
        return r;
    }
    r.index += 1u64;
    r = visit_struct(s, r, st);
    let object: u64 = r.result;
    r.depth += 1u64;
    r = end_map(s, r);
    r.result = object;
    fix_position(s, r)
}

// The derived `visit_map`: each field once, unknown fields skipped, then the
// missing ones in declaration order.
fn visit_struct(s: Slice<u8>, reader: Reader, st: u64) -> Reader {
    let mut r: Reader = reader;
    let count: u64 = agent_bytecode_schema.field_count(st);
    let slot: u64 = r.slots.length();
    let mut index: u64 = 0u64;
    while index < count {
        r.slots.push(NONE);
        index += 1u64;
    }
    r = add(r, V_OBJECT, slot, st);
    let object: u64 = r.result;
    let mut first: bool = true;
    loop {
        r = next_key(s, r, first);
        if r.failed || r.result == NONE {
            break;
        }
        first = false;
        let key: Value = r.nodes[r.result];
        let key_bytes: Buffer<u8> = copy_range(r.strings.as_slice(), key.a, key.b);
        let field: u64 = agent_bytecode_schema.field_index(st, key_bytes.as_slice());
        if field != NONE && r.slots[slot + field] != NONE {
            r = duplicate_field(r, key_bytes.as_slice());
            break;
        }
        r = colon(s, r);
        if r.failed {
            break;
        }
        if field == NONE {
            r = ignore_value(s, r);
        } else {
            r = deserialize(s, r, agent_bytecode_schema.field_type(st, field));
            if !r.failed {
                r.slots[slot + field] = r.result;
            }
        }
        if r.failed {
            break;
        }
    }
    if !r.failed {
        r = fill_missing(r, slot, st);
    }
    r.result = object;
    r
}

// Missing fields: an error for a required one, else its default.
fn fill_missing(reader: Reader, slot: u64, st: u64) -> Reader {
    let mut r: Reader = reader;
    let count: u64 = agent_bytecode_schema.field_count(st);
    let mut index: u64 = 0u64;
    while index < count {
        if r.slots[slot + index] == NONE {
            let default: u64 = agent_bytecode_schema.field_default(st, index);
            if default == agent_bytecode_schema.REQUIRED {
                return missing_field(r, st, index);
            }
            let kind: u64 = agent_bytecode_schema.field_type(st, index) % 16u64;
            if default == agent_bytecode_schema.DEFAULT_PROVIDER {
                r = string_node(r, "simulated".as_slice());
            } else if kind == agent_bytecode_schema.T_STRING {
                r = string_node(r, "".as_slice());
            } else if kind == agent_bytecode_schema.T_BOOL {
                r = add(r, V_BOOL, 0u64, 0u64);
            } else if kind == agent_bytecode_schema.T_STRINGS || kind == agent_bytecode_schema.T_LIST || kind == agent_bytecode_schema.T_INSTRUCTIONS {
                r = add(r, V_ARRAY, 0u64, 0u64);
            } else {
                r = add(r, V_NULL, 0u64, 0u64);
            }
            let node: u64 = r.result;
            r.slots[slot + index] = node;
        }
        index += 1u64;
    }
    r
}

// ------------------------------------------------------------------ instructions

// An internally tagged `Instruction`: serde_json's `deserialize_any` with
// serde's `TaggedContentVisitor`, then the variant from the buffered content.
fn de_instruction(s: Slice<u8>, reader: Reader) -> Reader {
    let mut r: Reader = whitespace(s, reader);
    if r.index >= s.length() {
        return peek_error(s, r, "EOF while parsing a value".as_slice());
    }
    let peek: u8 = s[r.index];
    if peek == 91u8 {
        return unsupported(r);
    }
    if peek != 123u8 {
        r = de_any(s, r);
        if r.failed {
            return r;
        }
        let node: u64 = r.result;
        r = invalid_type(r, node, "internally tagged enum Instruction".as_slice());
        return fix_position(s, r);
    }
    r = deeper(s, r);
    if r.failed {
        return r;
    }
    r.index += 1u64;
    r = add(r, V_MAP, 0u64, 0u64);
    let map: u64 = r.result;
    let mut tag: u64 = NONE;
    let mut first: bool = true;
    loop {
        r = next_key(s, r, first);
        if r.failed || r.result == NONE {
            break;
        }
        first = false;
        let key_node: u64 = r.result;
        let key: Value = r.nodes[key_node];
        let is_tag: bool = range_is(r.strings.as_slice(), key.a, key.b, "op".as_slice());
        if is_tag && tag != NONE {
            r = duplicate_field(r, "op".as_slice());
            break;
        }
        r = colon(s, r);
        if r.failed {
            break;
        }
        if is_tag {
            r = de_str(s, r, "variant identifier".as_slice());
            if r.failed {
                break;
            }
            let name: Value = r.nodes[r.result];
            let name_bytes: Buffer<u8> = copy_range(r.strings.as_slice(), name.a, name.b);
            tag = agent_bytecode_schema.variant(name_bytes.as_slice());
        } else {
            r = de_any(s, r);
            if r.failed {
                break;
            }
            let value: u64 = r.result;
            r = add(r, V_ENTRY, key_node, value);
            let entry: u64 = r.result;
            r = push(r, map, entry);
        }
    }
    if !r.failed && tag == NONE {
        r = custom(r, "missing field `op`".as_slice());
    }
    r.depth += 1u64;
    r = end_map(s, r);
    r = fix_position(s, r);
    if r.failed {
        return r;
    }
    decode_variant(r, tag, map)
}

// `deserialize_any` with serde's `ContentVisitor`: any value, kept as it is.
fn de_any(s: Slice<u8>, reader: Reader) -> Reader {
    let mut r: Reader = whitespace(s, reader);
    if r.index >= s.length() {
        return peek_error(s, r, "EOF while parsing a value".as_slice());
    }
    let peek: u8 = s[r.index];
    if peek == 110u8 {
        r.index += 1u64;
        r = ident(s, r, "ull".as_slice());
        if r.failed {
            return r;
        }
        return add(r, V_NULL, 0u64, 0u64);
    }
    if peek == 116u8 || peek == 102u8 {
        return de_bool(s, r);
    }
    if peek == 45u8 {
        r.index += 1u64;
        return parse_integer(s, r, false);
    }
    if peek >= 48u8 && peek <= 57u8 {
        return parse_integer(s, r, true);
    }
    if peek == 34u8 {
        r.index += 1u64;
        return parse_string(s, r);
    }
    if peek == 91u8 {
        r = deeper(s, r);
        if r.failed {
            return r;
        }
        r.index += 1u64;
        r = add(r, V_ARRAY, 0u64, 0u64);
        let array: u64 = r.result;
        let mut first: bool = true;
        loop {
            r = next_element(s, r, first);
            if r.failed || r.result == 0u64 {
                break;
            }
            first = false;
            r = de_any(s, r);
            if r.failed {
                break;
            }
            let item: u64 = r.result;
            r = push(r, array, item);
        }
        r.depth += 1u64;
        r = end_seq(s, r);
        r.result = array;
        return fix_position(s, r);
    }
    if peek == 123u8 {
        r = deeper(s, r);
        if r.failed {
            return r;
        }
        r.index += 1u64;
        r = add(r, V_MAP, 0u64, 0u64);
        let map: u64 = r.result;
        let mut first: bool = true;
        loop {
            r = next_key(s, r, first);
            if r.failed || r.result == NONE {
                break;
            }
            first = false;
            let key: u64 = r.result;
            r = colon(s, r);
            if r.failed {
                break;
            }
            r = de_any(s, r);
            if r.failed {
                break;
            }
            let value: u64 = r.result;
            r = add(r, V_ENTRY, key, value);
            let entry: u64 = r.result;
            r = push(r, map, entry);
        }
        r.depth += 1u64;
        r = end_map(s, r);
        r.result = map;
        return fix_position(s, r);
    }
    peek_error(s, r, "expected value".as_slice())
}

// The variant `tag` from its buffered fields: serde's derived visitor over
// a `ContentDeserializer`. Its errors have no position yet.
fn decode_variant(reader: Reader, tag: u64, map: u64) -> Reader {
    let mut r: Reader = reader;
    let st: u64 = agent_bytecode_schema.variant_struct(tag);
    if st == NONE {
        return add(r, V_VARIANT, tag, 0u64);
    }
    let count: u64 = agent_bytecode_schema.field_count(st);
    let slot: u64 = r.slots.length();
    let mut index: u64 = 0u64;
    while index < count {
        r.slots.push(NONE);
        index += 1u64;
    }
    r = add(r, V_OBJECT, slot, st);
    let object: u64 = r.result;
    let mut link: u64 = r.nodes[map].a;
    while link != 0u64 {
        let entry: Value = r.nodes[link - 1u64];
        link = entry.next;
        let key: Value = r.nodes[entry.a];
        let key_bytes: Buffer<u8> = copy_range(r.strings.as_slice(), key.a, key.b);
        let field: u64 = agent_bytecode_schema.field_index(st, key_bytes.as_slice());
        if field != NONE {
            if r.slots[slot + field] != NONE {
                return duplicate_field(r, key_bytes.as_slice());
            }
            r = content_value(r, agent_bytecode_schema.field_type(st, field), entry.b);
            if r.failed {
                return r;
            }
            r.slots[slot + field] = entry.b;
        }
    }
    r = fill_missing(r, slot, st);
    if r.failed {
        return r;
    }
    add(r, V_VARIANT, tag, object)
}

// Whether buffered `node` has type `ty`, else serde's error.
fn content_value(reader: Reader, ty: u64, node: u64) -> Reader {
    let kind: u64 = ty % 16u64;
    let found: Value = reader.nodes[node];
    if kind == agent_bytecode_schema.T_OPTION_STRING && found.kind == V_NULL {
        return reader;
    }
    if kind == agent_bytecode_schema.T_STRING || kind == agent_bytecode_schema.T_OPTION_STRING {
        if found.kind == V_STRING {
            return reader;
        }
        return invalid_type(reader, node, "a string".as_slice());
    }
    if kind == agent_bytecode_schema.T_BOOL {
        if found.kind == V_BOOL {
            return reader;
        }
        return invalid_type(reader, node, "a boolean".as_slice());
    }
    if found.kind != V_ARRAY {
        return invalid_type(reader, node, "a sequence".as_slice());
    }
    let mut r: Reader = reader;
    let mut link: u64 = found.a;
    while link != 0u64 {
        let item: u64 = link - 1u64;
        link = r.nodes[item].next;
        r = content_value(r, agent_bytecode_schema.T_STRING, item);
        if r.failed {
            return r;
        }
    }
    r
}

// ------------------------------------------------------------------ the dump

// The dump of spec/language/verify.md for the bytes of a `.argbc.json` file.
pub fn dump(source: Slice<u8>) -> Buffer<u8> {
    if !text.is_valid(source) {
        return bytes.copy("invalid bytecode: not UTF-8\n".as_slice());
    }
    let mut r: Reader = Reader {
        index: 0u64,
        depth: 128u64,
        failed: false,
        message: Buffer::new(),
        line: 0u64,
        column: 0u64,
        unsupported: false,
        nodes: Buffer::new(),
        slots: Buffer::new(),
        strings: Buffer::new(),
        result: 0u64,
    };
    r = de_struct(source, r, agent_bytecode_schema.BS_PROGRAM);
    let program: u64 = r.result;
    if !r.failed {
        r = whitespace(source, r);
        if r.index < source.length() {
            r = peek_error(source, r, "trailing characters".as_slice());
        }
    }
    if r.unsupported {
        return bytes.copy("unsupported\n".as_slice());
    }
    if r.failed {
        let mut out: Buffer<u8> = bytes.append(Buffer::new(), "invalid bytecode JSON: ".as_slice());
        out = bytes.append(out, r.message.as_slice());
        if r.line != 0u64 {
            out = bytes.append(out, " at line ".as_slice());
            out = bytes.append_decimal(out, r.line);
            out = bytes.append(out, " column ".as_slice());
            out = bytes.append_decimal(out, r.column);
        }
        out.push(10u8);
        return out;
    }
    decide(r.nodes.as_slice(), r.slots.as_slice(), r.strings.as_slice(), program)
}

// `ok`, or the verifier's errors; `unsupported` for metadata whose checks
// are not ported yet.
fn decide(n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, program: u64) -> Buffer<u8> {
    if unported(n, sl, program) {
        return bytes.copy("unsupported\n".as_slice());
    }
    let out: Buffer<u8> = verify(n, sl, st, program);
    if out.length() == 0u64 {
        return bytes.copy("ok\n".as_slice());
    }
    out
}

// Bytes `a..b` of `strings`, copied.
fn copy_range(strings: Slice<u8>, a: u64, b: u64) -> Buffer<u8> {
    bytes.copy(strings.slice(a, b))
}

// Whether bytes `a..b` of `strings` are `word`.
fn range_is(strings: Slice<u8>, a: u64, b: u64, word: Slice<u8>) -> bool {
    bytes.equal(strings.slice(a, b), word)
}

// ------------------------------------------------------------------ the verifier

// The tree as the verifier reads it: `n` the values, `sl` the slots, `st`
// the strings.

fn fld(n: Slice<Value>, sl: Slice<u64>, object: u64, field: u64) -> u64 {
    sl[n[object].a + field]
}

fn text_is(n: Slice<Value>, st: Slice<u8>, node: u64, word: Slice<u8>) -> bool {
    bytes.equal(st.slice(n[node].a, n[node].b), word)
}

fn same_text(n: Slice<Value>, st: Slice<u8>, left: u64, right: u64) -> bool {
    bytes.equal(st.slice(n[left].a, n[left].b), st.slice(n[right].a, n[right].b))
}

// `trim().is_empty()`, Unicode white space as Rust trims it.
fn blank(n: Slice<Value>, st: Slice<u8>, node: u64) -> bool {
    agent_check.trim_start(st, n[node].a, n[node].b) == n[node].b
}

fn is_empty(n: Slice<Value>, list: u64) -> bool {
    n[list].a == 0u64
}

// Whether list `list` has an element whose text (field `field` of it, or
// the element itself when `field` is NONE) equals node `wanted`.
fn list_has(n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, list: u64, field: u64, wanted: u64) -> bool {
    let mut link: u64 = n[list].a;
    while link != 0u64 {
        let item: u64 = link - 1u64;
        link = n[item].next;
        let mut value: u64 = item;
        if field != NONE {
            value = fld(n, sl, item, field);
        }
        if same_text(n, st, value, wanted) {
            return true;
        }
    }
    false
}

// Whether list `list` has, before element `before`, one whose text equals
// that of node `wanted`: a `HashSet::insert` that fails.
fn seen_before(n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, list: u64, field: u64, before: u64, wanted: u64) -> bool {
    let mut link: u64 = n[list].a;
    while link != 0u64 && link - 1u64 != before {
        let item: u64 = link - 1u64;
        link = n[item].next;
        let mut value: u64 = item;
        if field != NONE {
            value = fld(n, sl, item, field);
        }
        if same_text(n, st, value, wanted) {
            return true;
        }
    }
    false
}

fn put(out: Buffer<u8>, value: Slice<u8>) -> Buffer<u8> {
    bytes.append(out, value)
}

fn put_text(out: Buffer<u8>, n: Slice<Value>, st: Slice<u8>, node: u64) -> Buffer<u8> {
    bytes.append(out, st.slice(n[node].a, n[node].b))
}

fn line(out: Buffer<u8>, value: Slice<u8>) -> Buffer<u8> {
    let mut o: Buffer<u8> = bytes.append(out, value);
    o.push(10u8);
    o
}

// "<head>`<text>`<tail>" and a line feed.
fn named(out: Buffer<u8>, n: Slice<Value>, st: Slice<u8>, head: Slice<u8>, node: u64, tail: Slice<u8>) -> Buffer<u8> {
    let mut o: Buffer<u8> = bytes.append(out, head);
    o.push(96u8);
    o = put_text(o, n, st, node);
    o.push(96u8);
    o = bytes.append(o, tail);
    o.push(10u8);
    o
}

// "invalid <kind> `<name>`: <reason><text>`" when `node` is not NONE,
// else "...: <reason>".
fn invalid(out: Buffer<u8>, n: Slice<Value>, st: Slice<u8>, kind: Slice<u8>, name: u64, reason: Slice<u8>, node: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = bytes.append(out, "invalid ".as_slice());
    o = bytes.append(o, kind);
    o = bytes.append(o, " `".as_slice());
    o = put_text(o, n, st, name);
    o = bytes.append(o, "`: ".as_slice());
    o = bytes.append(o, reason);
    if node != NONE {
        o = put_text(o, n, st, node);
        o.push(96u8);
    }
    o.push(10u8);
    o
}

// The versions `verify_bytecode` supports, in order; NONE for another.
fn version_rank(n: Slice<Value>, st: Slice<u8>, version: u64) -> u64 {
    let v: Slice<u8> = st.slice(n[version].a, n[version].b);
    if bytes.equal(v, "0.3".as_slice()) { return 3u64; }
    if bytes.equal(v, "0.5".as_slice()) { return 5u64; }
    let mut minor: u64 = 6u64;
    while minor <= 36u64 {
        let mut word: Buffer<u8> = bytes.append(Buffer::new(), "0.".as_slice());
        word = bytes.append_decimal(word, minor);
        if bytes.equal(v, word.as_slice()) {
            return minor;
        }
        minor += 1u64;
    }
    if bytes.equal(v, "1.0".as_slice()) { return 100u64; }
    NONE
}

// Whether the version is at least 0.<minor> (1.0 for 100).
fn at_least(rank: u64, minor: u64) -> bool {
    rank != NONE && rank >= minor
}

pub fn verify(n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64) -> Buffer<u8> {
    let mut out: Buffer<u8> = Buffer::new();
    let version: u64 = fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__BYTECODE_VERSION);
    let rank: u64 = version_rank(n, st, version);
    if blank(n, st, version) {
        out = line(out, "bytecode_version is required".as_slice());
    } else if rank == NONE {
        out = named(out, n, st, "unsupported bytecode version ".as_slice(), version, "".as_slice());
    }
    let agents: u64 = fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__AGENTS);
    if is_empty(n, agents) {
        out = line(out, "bytecode must declare at least one agent".as_slice());
    }
    let providers: u64 = fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__PROVIDERS);
    if !at_least(rank, 11u64) && !is_empty(n, providers) {
        out = line(out, "provider contracts require bytecode version 0.11 through 0.15".as_slice());
    }
    let modules: u64 = fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__MODULES);
    let imports: u64 = fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__IMPORTS);
    if (!is_empty(n, modules) || !is_empty(n, imports)) && !at_least(rank, 16u64) {
        out = line(out, "module metadata requires bytecode version 0.16".as_slice());
    }
    let mut link: u64 = n[imports].a;
    while link != 0u64 {
        let import: u64 = link - 1u64;
        link = n[import].next;
        let from: u64 = fld(n, sl, import, agent_bytecode_schema.BS_MODULE_IMPORT__FROM);
        let to: u64 = fld(n, sl, import, agent_bytecode_schema.BS_MODULE_IMPORT__TO);
        if !list_has(n, sl, st, modules, agent_bytecode_schema.BS_MODULE__NAME, from) {
            out = named(out, n, st, "module import edge references unknown module ".as_slice(), from, "".as_slice());
        }
        if !list_has(n, sl, st, modules, agent_bytecode_schema.BS_MODULE__NAME, to) {
            out = named(out, n, st, "module import edge references unknown module ".as_slice(), to, "".as_slice());
        }
    }
    let policies: u64 = fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__POLICIES);
    if !is_empty(n, policies) && !at_least(rank, 17u64) {
        out = line(out, "policy metadata requires bytecode version 0.17".as_slice());
    }
    out = validate_policies(out, n, sl, st, policies);
    out = validate_message_contracts(out, n, sl, st, p, rank);
    out = metadata(out, n, sl, st, p, rank);
    verify_rest(out, n, sl, st, p, rank)
}

fn validate_policies(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, policies: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let mut link: u64 = n[policies].a;
    while link != 0u64 {
        let policy: u64 = link - 1u64;
        link = n[policy].next;
        let name: u64 = fld(n, sl, policy, agent_bytecode_schema.BS_POLICY__NAME);
        if blank(n, st, name) {
            o = invalid(o, n, st, "policy".as_slice(), name, "name must not be empty".as_slice(), NONE);
        } else if seen_named(n, sl, st, policies, agent_bytecode_schema.BS_POLICY__NAME, policy, name) {
            o = named(o, n, st, "duplicate policy ".as_slice(), name, "".as_slice());
        }
        let mut required: Buffer<u64> = Buffer::new();
        let mut denied: Buffer<u64> = Buffer::new();
        let mut rule_link: u64 = n[fld(n, sl, policy, agent_bytecode_schema.BS_POLICY__RULES)].a;
        while rule_link != 0u64 {
            let rule: u64 = rule_link - 1u64;
            rule_link = n[rule].next;
            let effect: u64 = fld(n, sl, rule, agent_bytecode_schema.BS_POLICY_RULE__EFFECT);
            let word: u64 = fld(n, sl, rule, agent_bytecode_schema.BS_POLICY_RULE__RULE);
            let require: bool = text_is(n, st, effect, "require".as_slice());
            if !require && !text_is(n, st, effect, "deny".as_slice()) {
                o = invalid(o, n, st, "policy".as_slice(), name, "unknown effect `".as_slice(), effect);
            } else if !agent_bytecode_schema.known_rule(st.slice(n[word].a, n[word].b)) {
                o = invalid(o, n, st, "policy".as_slice(), name, "unknown rule `".as_slice(), word);
            } else {
                let mut current_has: bool = in_nodes(n, st, required.as_slice(), word);
                let mut opposite_has: bool = in_nodes(n, st, denied.as_slice(), word);
                if require {
                    required.push(word);
                } else {
                    current_has = in_nodes(n, st, denied.as_slice(), word);
                    opposite_has = in_nodes(n, st, required.as_slice(), word);
                    denied.push(word);
                }
                if current_has {
                    let mut reason: Buffer<u8> = bytes.append(Buffer::new(), "duplicate ".as_slice());
                    reason = put_text(reason, n, st, effect);
                    reason = bytes.append(reason, " rule `".as_slice());
                    o = invalid(o, n, st, "policy".as_slice(), name, reason.as_slice(), word);
                }
                if opposite_has {
                    o = invalid(o, n, st, "policy".as_slice(), name, "contradictory rule `".as_slice(), word);
                }
            }
        }
        let violation: u64 = fld(n, sl, policy, agent_bytecode_schema.BS_POLICY__ON_VIOLATION);
        if n[violation].kind == V_OBJECT {
            let action: u64 = fld(n, sl, violation, agent_bytecode_schema.BS_POLICY_VIOLATION__ACTION);
            if !(text_is(n, st, action, "block".as_slice()) || text_is(n, st, action, "review".as_slice()) || text_is(n, st, action, "warn".as_slice())) {
                o = invalid(o, n, st, "policy".as_slice(), name, "unknown action `".as_slice(), action);
            }
        }
    }
    o
}

// A `HashSet` of names that only takes the non-blank ones: whether an
// earlier element with a non-blank name has this one.
fn seen_named(n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, list: u64, field: u64, before: u64, name: u64) -> bool {
    let mut link: u64 = n[list].a;
    while link != 0u64 && link - 1u64 != before {
        let item: u64 = link - 1u64;
        link = n[item].next;
        let other: u64 = fld(n, sl, item, field);
        if !blank(n, st, other) && same_text(n, st, other, name) {
            return true;
        }
    }
    false
}

fn in_nodes(n: Slice<Value>, st: Slice<u8>, nodes: Slice<u64>, wanted: u64) -> bool {
    let mut index: u64 = 0u64;
    while index < nodes.length() {
        if same_text(n, st, nodes[index], wanted) {
            return true;
        }
        index += 1u64;
    }
    false
}

// Whether `name` is a declared type or enum.
fn declared_type(n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64, name: u64) -> bool {
    list_has(n, sl, st, fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__TYPES), agent_bytecode_schema.BS_TYPE__NAME, name) || list_has(n, sl, st, fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__ENUMS), NONE, name)
}

fn validate_message_contracts(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64, rank: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let types: u64 = fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__TYPES);
    let enums: u64 = fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__ENUMS);
    if (!is_empty(n, types) || !is_empty(n, enums)) && !at_least(rank, 18u64) {
        o = line(o, "message contracts require bytecode version 0.18".as_slice());
    }
    let mut link: u64 = n[types].a;
    while link != 0u64 {
        let contract: u64 = link - 1u64;
        link = n[contract].next;
        let name: u64 = fld(n, sl, contract, agent_bytecode_schema.BS_TYPE__NAME);
        if seen_before(n, sl, st, types, agent_bytecode_schema.BS_TYPE__NAME, contract, name) {
            o = invalid(o, n, st, "message contract".as_slice(), name, "duplicate type name".as_slice(), NONE);
        }
        let fields: u64 = fld(n, sl, contract, agent_bytecode_schema.BS_TYPE__FIELDS);
        let mut field_link: u64 = n[fields].a;
        while field_link != 0u64 {
            let field: u64 = field_link - 1u64;
            field_link = n[field].next;
            let field_name: u64 = fld(n, sl, field, agent_bytecode_schema.BS_TYPE_FIELD__NAME);
            if seen_before(n, sl, st, fields, agent_bytecode_schema.BS_TYPE_FIELD__NAME, field, field_name) {
                o = invalid(o, n, st, "message contract".as_slice(), name, "duplicate field `".as_slice(), field_name);
            }
            let field_type: u64 = fld(n, sl, field, agent_bytecode_schema.BS_TYPE_FIELD__FIELD_TYPE);
            let primitive: bool = text_is(n, st, field_type, "string".as_slice()) || text_is(n, st, field_type, "bool".as_slice()) || text_is(n, st, field_type, "int".as_slice()) || text_is(n, st, field_type, "float".as_slice());
            if !primitive && !declared_type(n, sl, st, p, field_type) {
                o = invalid(o, n, st, "message contract".as_slice(), name, "unknown field type `".as_slice(), field_type);
            }
        }
    }
    o
}

// `invalid_contract_reason`.
fn contract_reason(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, contract: u64) -> Buffer<u8> {
    let name: u64 = fld(n, sl, contract, agent_bytecode_schema.BS_PROVIDER_CONTRACT__NAME);
    let kind: u64 = fld(n, sl, contract, agent_bytecode_schema.BS_PROVIDER_CONTRACT__KIND);
    let flag: bool = n[fld(n, sl, contract, agent_bytecode_schema.BS_PROVIDER_CONTRACT__ENABLED)].a == 1u64;
    let dry: bool = n[fld(n, sl, contract, agent_bytecode_schema.BS_PROVIDER_CONTRACT__DRY_RUN_ONLY)].a == 1u64;
    let feature: bool = n[fld(n, sl, contract, agent_bytecode_schema.BS_PROVIDER_CONTRACT__REQUIRES_FEATURE_FLAG)].a == 1u64;
    let approval: bool = n[fld(n, sl, contract, agent_bytecode_schema.BS_PROVIDER_CONTRACT__REQUIRES_EXPLICIT_APPROVAL)].a == 1u64;
    if blank(n, st, name) {
        return invalid(out, n, st, "provider contract".as_slice(), name, "name must not be empty".as_slice(), NONE);
    }
    if text_is(n, st, name, "simulated".as_slice()) {
        return invalid(out, n, st, "provider contract".as_slice(), name, "`simulated` is reserved for the executable provider".as_slice(), NONE);
    }
    if !text_is(n, st, kind, "external".as_slice()) {
        return invalid(out, n, st, "provider contract".as_slice(), name, "kind must be external".as_slice(), NONE);
    }
    if flag {
        return invalid(out, n, st, "provider contract".as_slice(), name, "external contracts must be disabled".as_slice(), NONE);
    }
    if !dry {
        return invalid(out, n, st, "provider contract".as_slice(), name, "external contracts must be dry-run-only".as_slice(), NONE);
    }
    if !feature {
        return invalid(out, n, st, "provider contract".as_slice(), name, "external contracts require a feature flag".as_slice(), NONE);
    }
    if !approval {
        return invalid(out, n, st, "provider contract".as_slice(), name, "external contracts require explicit approval".as_slice(), NONE);
    }
    out
}

// The main body after the metadata validators: providers, tools, models,
// allowlists, and the instructions.
fn verify_rest(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64, rank: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let providers: u64 = fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__PROVIDERS);
    let capabilities: u64 = fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__CAPABILITIES);
    let tools: u64 = fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__TOOLS);
    let models: u64 = fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__MODELS);
    let agents: u64 = fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__AGENTS);
    let mut link: u64 = n[providers].a;
    while link != 0u64 {
        let contract: u64 = link - 1u64;
        link = n[contract].next;
        let name: u64 = fld(n, sl, contract, agent_bytecode_schema.BS_PROVIDER_CONTRACT__NAME);
        if seen_before(n, sl, st, providers, agent_bytecode_schema.BS_PROVIDER_CONTRACT__NAME, contract, name) {
            o = named(o, n, st, "duplicate provider contract ".as_slice(), name, "".as_slice());
        }
        o = contract_reason(o, n, sl, st, contract);
    }
    let typed: bool = at_least(rank, 18u64);
    link = n[tools].a;
    while link != 0u64 {
        let tool: u64 = link - 1u64;
        link = n[tool].next;
        let name: u64 = fld(n, sl, tool, agent_bytecode_schema.BS_TOOL__NAME);
        let provider: u64 = fld(n, sl, tool, agent_bytecode_schema.BS_TOOL__PROVIDER);
        let capability: u64 = fld(n, sl, tool, agent_bytecode_schema.BS_TOOL__CAPABILITY);
        if !text_is(n, st, provider, "simulated".as_slice()) {
            o = named(o, n, st, "unsupported tool provider ".as_slice(), provider, "".as_slice());
        }
        if !list_has(n, sl, st, capabilities, agent_bytecode_schema.BS_CAPABILITY__NAME, capability) {
            o = put(o, "bytecode tool `".as_slice());
            o = put_text(o, n, st, name);
            o = named(o, n, st, "` references unknown capability ".as_slice(), capability, "".as_slice());
        }
        if typed {
            o = payload_type(o, n, sl, st, p, "bytecode tool `".as_slice(), name, "input".as_slice(), fld(n, sl, tool, agent_bytecode_schema.BS_TOOL__INPUT));
            o = payload_type(o, n, sl, st, p, "bytecode tool `".as_slice(), name, "output".as_slice(), fld(n, sl, tool, agent_bytecode_schema.BS_TOOL__OUTPUT));
        }
    }
    link = n[models].a;
    while link != 0u64 {
        let model: u64 = link - 1u64;
        link = n[model].next;
        let name: u64 = fld(n, sl, model, agent_bytecode_schema.BS_MODEL__NAME);
        let provider: u64 = fld(n, sl, model, agent_bytecode_schema.BS_MODEL__PROVIDER);
        let capability: u64 = fld(n, sl, model, agent_bytecode_schema.BS_MODEL__CAPABILITY);
        if !text_is(n, st, provider, "simulated".as_slice()) {
            o = named(o, n, st, "unsupported model provider ".as_slice(), provider, "".as_slice());
        }
        if !list_has(n, sl, st, capabilities, agent_bytecode_schema.BS_CAPABILITY__NAME, capability) {
            o = named(o, n, st, "bytecode model ".as_slice(), name, " is not declared or has invalid capability".as_slice());
        }
        if typed {
            o = payload_type(o, n, sl, st, p, "bytecode model `".as_slice(), name, "input".as_slice(), fld(n, sl, model, agent_bytecode_schema.BS_MODEL__INPUT));
            o = payload_type(o, n, sl, st, p, "bytecode model `".as_slice(), name, "output".as_slice(), fld(n, sl, model, agent_bytecode_schema.BS_MODEL__OUTPUT));
        }
    }
    o = allowlists(o, n, sl, st, p, rank);
    if !contracts_declared(n, sl, st, p) {
        o = line(o, "provider contract declarations do not match the top-level providers collection".as_slice());
    }
    let instructions: u64 = fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__INSTRUCTIONS);
    let mut protocol_or_message: bool = false;
    let mut last: u64 = NONE;
    link = n[instructions].a;
    while link != 0u64 {
        let instruction: u64 = link - 1u64;
        link = n[instruction].next;
        last = instruction;
        let op: u64 = n[instruction].a;
        let fields: u64 = n[instruction].b;
        if op == agent_bytecode_schema.OP_DECLARE_PROTOCOL {
            protocol_or_message = true;
        } else if op == agent_bytecode_schema.OP_DECLARE_HANDLER {
            protocol_or_message = true;
            o = known_agent(o, n, sl, st, agents, fld(n, sl, fields, agent_bytecode_schema.BS_OP_DECLARE_HANDLER__AGENT), "handler instruction references unknown agent ".as_slice());
        } else if op == agent_bytecode_schema.OP_SEND_MESSAGE {
            protocol_or_message = true;
            let from: u64 = fld(n, sl, fields, agent_bytecode_schema.BS_OP_SEND_MESSAGE__FROM);
            let to: u64 = fld(n, sl, fields, agent_bytecode_schema.BS_OP_SEND_MESSAGE__TO);
            if blank(n, st, from) {
                o = line(o, "SendMessage field `from` must not be empty".as_slice());
            }
            if blank(n, st, to) {
                o = line(o, "SendMessage field `to` must not be empty".as_slice());
            }
            if blank(n, st, fld(n, sl, fields, agent_bytecode_schema.BS_OP_SEND_MESSAGE__ACT)) {
                o = line(o, "SendMessage field `act` must not be empty".as_slice());
            }
            if blank(n, st, fld(n, sl, fields, agent_bytecode_schema.BS_OP_SEND_MESSAGE__MESSAGE_TYPE)) {
                o = line(o, "SendMessage field `message_type` must not be empty".as_slice());
            }
            if !list_has(n, sl, st, agents, agent_bytecode_schema.BS_AGENT__NAME, from) && !external_entity(n, st, from) {
                o = named(o, n, st, "unknown sender ".as_slice(), from, " in SendMessage instruction".as_slice());
            }
            if !list_has(n, sl, st, agents, agent_bytecode_schema.BS_AGENT__NAME, to) && !external_entity(n, st, to) {
                o = named(o, n, st, "unknown receiver ".as_slice(), to, " in SendMessage instruction".as_slice());
            }
        } else if op == agent_bytecode_schema.OP_REQUIRE_APPROVAL {
            o = known_agent(o, n, sl, st, agents, fld(n, sl, fields, agent_bytecode_schema.BS_OP_REQUIRE_APPROVAL__AGENT), "RequireApproval references unknown agent ".as_slice());
        } else if op == agent_bytecode_schema.OP_REQUIRE_CAPABILITY {
            o = known_agent(o, n, sl, st, agents, fld(n, sl, fields, agent_bytecode_schema.BS_OP_REQUIRE_CAPABILITY__AGENT), "RequireCapability references unknown agent ".as_slice());
        } else if op == agent_bytecode_schema.OP_AUTHORIZE_TOOL || op == agent_bytecode_schema.OP_CALL_TOOL {
            let mut agent_field: u64 = agent_bytecode_schema.BS_OP_AUTHORIZE_TOOL__AGENT;
            let mut tool_field: u64 = agent_bytecode_schema.BS_OP_AUTHORIZE_TOOL__TOOL;
            if op == agent_bytecode_schema.OP_CALL_TOOL {
                agent_field = agent_bytecode_schema.BS_OP_CALL_TOOL__AGENT;
                tool_field = agent_bytecode_schema.BS_OP_CALL_TOOL__TOOL;
            }
            o = known_agent(o, n, sl, st, agents, fld(n, sl, fields, agent_field), "handler instruction references unknown agent ".as_slice());
            let tool: u64 = fld(n, sl, fields, tool_field);
            if !list_has(n, sl, st, tools, agent_bytecode_schema.BS_TOOL__NAME, tool) {
                o = named(o, n, st, "bytecode tool ".as_slice(), tool, " is not declared".as_slice());
            }
        } else if op == agent_bytecode_schema.OP_AUTHORIZE_MODEL || op == agent_bytecode_schema.OP_ASK_MODEL {
            let mut agent_field: u64 = agent_bytecode_schema.BS_OP_AUTHORIZE_MODEL__AGENT;
            let mut model_field: u64 = agent_bytecode_schema.BS_OP_AUTHORIZE_MODEL__MODEL;
            if op == agent_bytecode_schema.OP_ASK_MODEL {
                agent_field = agent_bytecode_schema.BS_OP_ASK_MODEL__AGENT;
                model_field = agent_bytecode_schema.BS_OP_ASK_MODEL__MODEL;
            }
            o = known_agent(o, n, sl, st, agents, fld(n, sl, fields, agent_field), "handler instruction references unknown agent ".as_slice());
            let model: u64 = fld(n, sl, fields, model_field);
            if !list_has(n, sl, st, models, agent_bytecode_schema.BS_MODEL__NAME, model) {
                o = named(o, n, st, "bytecode model ".as_slice(), model, " is not declared or has invalid capability".as_slice());
            }
        } else if op == agent_bytecode_schema.OP_EMIT_MESSAGE {
            o = known_agent(o, n, sl, st, agents, fld(n, sl, fields, agent_bytecode_schema.BS_OP_EMIT_MESSAGE__AGENT), "handler instruction references unknown agent ".as_slice());
        } else if op == agent_bytecode_schema.OP_TRACE_VALUE {
            o = known_agent(o, n, sl, st, agents, fld(n, sl, fields, agent_bytecode_schema.BS_OP_TRACE_VALUE__AGENT), "handler instruction references unknown agent ".as_slice());
        } else if op == agent_bytecode_schema.OP_HANDLER_HALT {
            o = known_agent(o, n, sl, st, agents, fld(n, sl, fields, agent_bytecode_schema.BS_OP_HANDLER_HALT__AGENT), "handler instruction references unknown agent ".as_slice());
        } else if op == agent_bytecode_schema.OP_INVOKE_INTRINSIC {
            o = known_agent(o, n, sl, st, agents, fld(n, sl, fields, agent_bytecode_schema.BS_OP_INVOKE_INTRINSIC__AGENT), "handler instruction references unknown agent ".as_slice());
        } else if op == agent_bytecode_schema.OP_UNKNOWN {
            o = line(o, "bytecode contains an unknown instruction".as_slice());
        }
    }
    if !protocol_or_message {
        o = line(o, "bytecode must declare at least one protocol, handler, or SendMessage instruction".as_slice());
    }
    if last == NONE || n[last].a != agent_bytecode_schema.OP_END {
        o = line(o, "bytecode must terminate with an End instruction".as_slice());
    }
    o
}

fn external_entity(n: Slice<Value>, st: Slice<u8>, node: u64) -> bool {
    text_is(n, st, node, "User".as_slice()) || text_is(n, st, node, "System".as_slice()) || text_is(n, st, node, "Runtime".as_slice()) || text_is(n, st, node, "Memory".as_slice()) || text_is(n, st, node, "Tool".as_slice())
}

fn known_agent(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, agents: u64, agent: u64, head: Slice<u8>) -> Buffer<u8> {
    if list_has(n, sl, st, agents, agent_bytecode_schema.BS_AGENT__NAME, agent) {
        return out;
    }
    named(out, n, st, head, agent, "".as_slice())
}

// "<head><name>` declares unknown <slot> type `<type>`" unless declared.
fn payload_type(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64, head: Slice<u8>, name: u64, slot: Slice<u8>, type_name: u64) -> Buffer<u8> {
    if declared_type(n, sl, st, p, type_name) {
        return out;
    }
    let mut o: Buffer<u8> = put(out, head);
    o = put_text(o, n, st, name);
    o = put(o, "` declares unknown ".as_slice());
    o = put(o, slot);
    o = named(o, n, st, " type ".as_slice(), type_name, "".as_slice());
    o
}

// `validate_contract_allowlists`.
fn allowlists(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64, rank: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let capabilities: u64 = fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__CAPABILITIES);
    let tools: u64 = fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__TOOLS);
    let models: u64 = fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__MODELS);
    let mut link: u64 = n[fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__PROVIDERS)].a;
    while link != 0u64 {
        let contract: u64 = link - 1u64;
        link = n[contract].next;
        let name: u64 = fld(n, sl, contract, agent_bytecode_schema.BS_PROVIDER_CONTRACT__NAME);
        let targets: u64 = fld(n, sl, contract, agent_bytecode_schema.BS_PROVIDER_CONTRACT__ALLOWED_TARGETS);
        let allowed: u64 = fld(n, sl, contract, agent_bytecode_schema.BS_PROVIDER_CONTRACT__ALLOWED_CAPABILITIES);
        if rank == 11u64 && (!is_empty(n, targets) || !is_empty(n, allowed)) {
            o = invalid(o, n, st, "provider contract".as_slice(), name, "Bytecode 0.11 provider allowlists must be empty".as_slice(), NONE);
        } else if rank != NONE && rank >= 12u64 && rank <= 21u64 {
            let mut target_link: u64 = n[targets].a;
            while target_link != 0u64 {
                let target: u64 = target_link - 1u64;
                target_link = n[target].next;
                if seen_before(n, sl, st, targets, NONE, target, target) {
                    o = invalid(o, n, st, "provider contract".as_slice(), name, "duplicate allowed target `".as_slice(), target);
                } else {
                    let tool: u64 = find_named(n, sl, st, tools, agent_bytecode_schema.BS_TOOL__NAME, target);
                    let model: u64 = find_named(n, sl, st, models, agent_bytecode_schema.BS_MODEL__NAME, target);
                    let mut required: u64 = NONE;
                    if tool == NONE && model == NONE {
                        o = invalid(o, n, st, "provider contract".as_slice(), name, "unknown allowlist target `".as_slice(), target);
                    } else if tool != NONE && model != NONE {
                        o = invalid(o, n, st, "provider contract".as_slice(), name, "ambiguous allowlist target `".as_slice(), target);
                    } else if tool != NONE {
                        required = fld(n, sl, tool, agent_bytecode_schema.BS_TOOL__CAPABILITY);
                    } else {
                        required = fld(n, sl, model, agent_bytecode_schema.BS_MODEL__CAPABILITY);
                    }
                    if required != NONE && !is_empty(n, allowed) && !list_has(n, sl, st, allowed, NONE, required) {
                        let mut reason: Buffer<u8> = bytes.append(Buffer::new(), "allowlist target `".as_slice());
                        reason = put_text(reason, n, st, target);
                        reason = put(reason, "` requires capability `".as_slice());
                        o = invalid(o, n, st, "provider contract".as_slice(), name, reason.as_slice(), required);
                    }
                }
            }
            let mut capability_link: u64 = n[allowed].a;
            while capability_link != 0u64 {
                let capability: u64 = capability_link - 1u64;
                capability_link = n[capability].next;
                if seen_before(n, sl, st, allowed, NONE, capability, capability) {
                    o = invalid(o, n, st, "provider contract".as_slice(), name, "duplicate allowed capability `".as_slice(), capability);
                }
                if !list_has(n, sl, st, capabilities, agent_bytecode_schema.BS_CAPABILITY__NAME, capability) {
                    o = invalid(o, n, st, "provider contract".as_slice(), name, "unknown allowlist capability `".as_slice(), capability);
                }
            }
        }
    }
    o
}

fn find_named(n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, list: u64, field: u64, name: u64) -> u64 {
    let mut link: u64 = n[list].a;
    while link != 0u64 {
        let item: u64 = link - 1u64;
        link = n[item].next;
        if same_text(n, st, fld(n, sl, item, field), name) {
            return item;
        }
    }
    NONE
}

// Whether the `DeclareProviderContract` instructions are the providers, in
// order and field by field.
fn contracts_declared(n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64) -> bool {
    let mut provider_link: u64 = n[fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__PROVIDERS)].a;
    let mut link: u64 = n[fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__INSTRUCTIONS)].a;
    while link != 0u64 {
        let instruction: u64 = link - 1u64;
        link = n[instruction].next;
        if n[instruction].a == agent_bytecode_schema.OP_DECLARE_PROVIDER_CONTRACT {
            if provider_link == 0u64 {
                return false;
            }
            let provider: u64 = provider_link - 1u64;
            provider_link = n[provider].next;
            let declared: u64 = n[instruction].b;
            let mut field: u64 = 0u64;
            while field < 8u64 {
                if !same_value(n, sl, st, fld(n, sl, declared, field), fld(n, sl, provider, field)) {
                    return false;
                }
                field += 1u64;
            }
        }
    }
    provider_link == 0u64
}

// Equal strings, booleans or lists of strings.
fn same_value(n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, left: u64, right: u64) -> bool {
    if n[left].kind == V_STRING {
        return same_text(n, st, left, right);
    }
    if n[left].kind == V_BOOL {
        return n[left].a == n[right].a;
    }
    let mut a: u64 = n[left].a;
    let mut b: u64 = n[right].a;
    while a != 0u64 && b != 0u64 {
        if !same_text(n, st, a - 1u64, b - 1u64) {
            return false;
        }
        a = n[a - 1u64].next;
        b = n[b - 1u64].next;
    }
    a == 0u64 && b == 0u64
}

// Whether the program has metadata whose validators are not ported yet.
fn unported(n: Slice<Value>, sl: Slice<u64>, p: u64) -> bool {
    let mut field: u64 = 0u64;
    while field < agent_bytecode_schema.field_count(agent_bytecode_schema.BS_PROGRAM) {
        let ported: bool = field == agent_bytecode_schema.BS_PROGRAM__SOURCE_DIGEST || field == agent_bytecode_schema.BS_PROGRAM__BYTECODE_VERSION || field == agent_bytecode_schema.BS_PROGRAM__LANGUAGE || field == agent_bytecode_schema.BS_PROGRAM__MODULE || field == agent_bytecode_schema.BS_PROGRAM__MODULES || field == agent_bytecode_schema.BS_PROGRAM__IMPORTS || field == agent_bytecode_schema.BS_PROGRAM__PROVIDERS || field == agent_bytecode_schema.BS_PROGRAM__ASSERTIONS || field == agent_bytecode_schema.BS_PROGRAM__POLICIES || field == agent_bytecode_schema.BS_PROGRAM__TYPES || field == agent_bytecode_schema.BS_PROGRAM__ENUMS || field == agent_bytecode_schema.BS_PROGRAM__FAILURES || field == agent_bytecode_schema.BS_PROGRAM__AGENTS || field == agent_bytecode_schema.BS_PROGRAM__CAPABILITIES || field == agent_bytecode_schema.BS_PROGRAM__TOOLS || field == agent_bytecode_schema.BS_PROGRAM__MODELS || field == agent_bytecode_schema.BS_PROGRAM__INSTRUCTIONS || field == agent_bytecode_schema.BS_PROGRAM__PASSPORTS || field == agent_bytecode_schema.BS_PROGRAM__PROVIDER_HARNESSES || field == agent_bytecode_schema.BS_PROGRAM__FEATURES || field == agent_bytecode_schema.BS_PROGRAM__SECRETS || field == agent_bytecode_schema.BS_PROGRAM__ADAPTERS || field == agent_bytecode_schema.BS_PROGRAM__ADAPTER_PROFILES || field == agent_bytecode_schema.BS_PROGRAM__CRYPTOS || field == agent_bytecode_schema.BS_PROGRAM__CRYPTO_BOUNDARIES || field == agent_bytecode_schema.BS_PROGRAM__ATRUST_HANDSHAKES || field == agent_bytecode_schema.BS_PROGRAM__DID_METHODS || field == agent_bytecode_schema.BS_PROGRAM__ATRUST_BOUNDARIES || field == agent_bytecode_schema.BS_PROGRAM__ATRUST_IDENTITIES || field == agent_bytecode_schema.BS_PROGRAM__ATRUST_CREDENTIAL_CONTRACTS || field == agent_bytecode_schema.BS_PROGRAM__TRUST_LEDGERS || field == agent_bytecode_schema.BS_PROGRAM__MCP_BRIDGE_CONTRACTS || field == agent_bytecode_schema.BS_PROGRAM__A2A_BRIDGE_CONTRACTS || field == agent_bytecode_schema.BS_PROGRAM__ATRUST_EVIDENCE_MAPS || field == agent_bytecode_schema.BS_PROGRAM__GOVERNANCE_PROFILES || field == agent_bytecode_schema.BS_PROGRAM__REGULATORY_MAPPINGS || field == agent_bytecode_schema.BS_PROGRAM__THIRD_PARTY_VERIFIERS || field == agent_bytecode_schema.BS_PROGRAM__PUBLIC_CONFORMANCE_REPORTS || field == agent_bytecode_schema.BS_PROGRAM__RUNTIME_HARDENING_PROFILES || field == agent_bytecode_schema.BS_PROGRAM__THREAT_MODELS || field == agent_bytecode_schema.BS_PROGRAM__SPEC_FREEZES || field == agent_bytecode_schema.BS_PROGRAM__RELEASE_CANDIDATES || field == agent_bytecode_schema.BS_PROGRAM__RUNTIME_EXECUTION_PROFILES || field == agent_bytecode_schema.BS_PROGRAM__SANDBOXED_PROVIDER_ADAPTERS;
        let value: u64 = fld(n, sl, p, field);
        if !ported && n[value].kind == V_ARRAY && n[value].a != 0u64 {
            return true;
        }
        field += 1u64;
    }
    false
}

// ------------------------------------------------------------------ the metadata validators

fn list_of(n: Slice<Value>, sl: Slice<u64>, p: u64, field: u64) -> u64 {
    fld(n, sl, p, field)
}

// "<head>" when list `field` of the program is not empty and the version is
// below 0.<minor>.
fn gate(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, p: u64, rank: u64, field: u64, minor: u64, head: Slice<u8>) -> Buffer<u8> {
    if is_empty(n, list_of(n, sl, p, field)) || at_least(rank, minor) {
        return out;
    }
    line(out, head)
}

// "unsupported bytecode version `<v>`", the gate some lists use.
fn gate_version(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64, rank: u64, empty: bool, minor: u64) -> Buffer<u8> {
    if empty || at_least(rank, minor) {
        return out;
    }
    named(out, n, st, "unsupported bytecode version ".as_slice(), fld(n, sl, p, agent_bytecode_schema.BS_PROGRAM__BYTECODE_VERSION), "".as_slice())
}

// The validators and gates between the message contracts and the provider
// contracts, in `verify_bytecode`'s order.
fn metadata(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64, rank: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = validate_passports(out, n, sl, st, p, rank);
    o = validate_harnesses(o, n, sl, st, p, rank);
    o = validate_features(o, n, sl, st, p, rank);
    o = validate_secrets(o, n, sl, st, p, rank);
    o = gate(o, n, sl, p, rank, agent_bytecode_schema.BS_PROGRAM__ADAPTERS, 22u64, "adapter framework metadata requires bytecode version 0.22".as_slice());
    o = gate(o, n, sl, p, rank, agent_bytecode_schema.BS_PROGRAM__ADAPTER_PROFILES, 23u64, "adapter profile metadata requires bytecode version 0.23".as_slice());
    o = gate(o, n, sl, p, rank, agent_bytecode_schema.BS_PROGRAM__CRYPTOS, 24u64, "crypto primitive metadata requires bytecode version 0.24".as_slice());
    o = gate(o, n, sl, p, rank, agent_bytecode_schema.BS_PROGRAM__CRYPTO_BOUNDARIES, 25u64, "crypto boundary metadata requires bytecode version 0.25".as_slice());
    o = gate_version(o, n, sl, st, p, rank, is_empty(n, list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__ATRUST_CREDENTIAL_CONTRACTS)), 28u64);
    o = gate_version(o, n, sl, st, p, rank, is_empty(n, list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__ATRUST_HANDSHAKES)), 29u64);
    o = validate_atrust_handshakes(o, n, sl, st, p);
    o = gate_version(o, n, sl, st, p, rank, is_empty(n, list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__TRUST_LEDGERS)), 30u64);
    o = validate_trust_ledgers(o, n, sl, st, p);
    o = gate_version(o, n, sl, st, p, rank, is_empty(n, list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__MCP_BRIDGE_CONTRACTS)) && is_empty(n, list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__A2A_BRIDGE_CONTRACTS)), 31u64);
    o = validate_mcp_bridges(o, n, sl, st, p);
    o = validate_a2a_bridges(o, n, sl, st, p);
    o = gate(o, n, sl, p, rank, agent_bytecode_schema.BS_PROGRAM__ATRUST_EVIDENCE_MAPS, 32u64, "atrust_evidence_maps require bytecode_version 0.32".as_slice());
    o = validate_evidence_maps(o, n, sl, st, p);
    o = gate_pair(o, n, sl, p, rank, agent_bytecode_schema.BS_PROGRAM__GOVERNANCE_PROFILES, agent_bytecode_schema.BS_PROGRAM__REGULATORY_MAPPINGS, 33u64, "governance_profiles and regulatory_mappings require bytecode_version 0.33".as_slice());
    o = validate_governance(o, n, sl, st, p);
    o = validate_regulatory(o, n, sl, st, p);
    o = gate_pair(o, n, sl, p, rank, agent_bytecode_schema.BS_PROGRAM__THIRD_PARTY_VERIFIERS, agent_bytecode_schema.BS_PROGRAM__PUBLIC_CONFORMANCE_REPORTS, 34u64, "third_party_verifiers and public_conformance_reports require bytecode_version 0.34".as_slice());
    o = validate_third_party_verifiers(o, n, sl, st, p);
    o = validate_public_conformance_reports(o, n, sl, st, p);
    o = gate_pair(o, n, sl, p, rank, agent_bytecode_schema.BS_PROGRAM__RUNTIME_HARDENING_PROFILES, agent_bytecode_schema.BS_PROGRAM__THREAT_MODELS, 35u64, "runtime_hardening_profiles and threat_models require bytecode_version 0.35".as_slice());
    o = validate_runtime_hardening_profiles(o, n, sl, st, p);
    o = validate_threat_models(o, n, sl, st, p);
    o = gate_pair(o, n, sl, p, rank, agent_bytecode_schema.BS_PROGRAM__SPEC_FREEZES, agent_bytecode_schema.BS_PROGRAM__RELEASE_CANDIDATES, 36u64, "spec_freezes and release_candidates require bytecode_version 0.36".as_slice());
    o = validate_spec_freezes(o, n, sl, st, p);
    o = validate_release_candidates(o, n, sl, st, p);
    o = gate_pair(o, n, sl, p, rank, agent_bytecode_schema.BS_PROGRAM__RUNTIME_EXECUTION_PROFILES, agent_bytecode_schema.BS_PROGRAM__SANDBOXED_PROVIDER_ADAPTERS, 100u64, "runtime MVP metadata requires bytecode version 1.0".as_slice());
    o = validate_runtime_execution_profiles(o, n, sl, st, p);
    o = validate_sandboxed_provider_adapters(o, n, sl, st, p);
    o = validate_adapters(o, n, sl, st, p);
    o = validate_adapter_profiles(o, n, sl, st, p);
    o = validate_cryptos(o, n, sl, st, p);
    validate_crypto_boundaries(o, n, sl, st, p)
}

fn gate_pair(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, p: u64, rank: u64, first: u64, second: u64, minor: u64, head: Slice<u8>) -> Buffer<u8> {
    if (is_empty(n, list_of(n, sl, p, first)) && is_empty(n, list_of(n, sl, p, second))) || at_least(rank, minor) {
        return out;
    }
    line(out, head)
}

fn one_of(n: Slice<Value>, st: Slice<u8>, node: u64, words: Slice<u8>) -> bool {
    let value: Slice<u8> = st.slice(n[node].a, n[node].b);
    let mut start: u64 = 0u64;
    let mut at: u64 = 0u64;
    while at <= words.length() {
        if at == words.length() || words[at] == 32u8 {
            if bytes.equal(words.slice(start, at), value) {
                return true;
            }
            start = at + 1u64;
        }
        at += 1u64;
    }
    false
}

fn validate_passports(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64, rank: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = gate(out, n, sl, p, rank, agent_bytecode_schema.BS_PROGRAM__PASSPORTS, 19u64, "agent passports require bytecode version 0.19".as_slice());
    let passports: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__PASSPORTS);
    let agents: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__AGENTS);
    let mut link: u64 = n[passports].a;
    while link != 0u64 {
        let passport: u64 = link - 1u64;
        link = n[passport].next;
        let name: u64 = fld(n, sl, passport, agent_bytecode_schema.BS_PASSPORT__NAME);
        if seen_before(n, sl, st, passports, agent_bytecode_schema.BS_PASSPORT__NAME, passport, name) {
            o = invalid(o, n, st, "passport".as_slice(), name, "duplicate passport name".as_slice(), NONE);
        }
        o = passport_field(o, n, sl, st, passport, name, agent_bytecode_schema.BS_PASSPORT__AGENT, "missing required field `agent`".as_slice());
        o = passport_field(o, n, sl, st, passport, name, agent_bytecode_schema.BS_PASSPORT__AGENT_NAME, "missing required field `agent_name`".as_slice());
        o = passport_field(o, n, sl, st, passport, name, agent_bytecode_schema.BS_PASSPORT__GLOBAL_ID, "missing required field `global_id`".as_slice());
        o = passport_field(o, n, sl, st, passport, name, agent_bytecode_schema.BS_PASSPORT__IDENTITY, "missing required field `identity`".as_slice());
        o = passport_field(o, n, sl, st, passport, name, agent_bytecode_schema.BS_PASSPORT__PROVIDER, "missing required field `provider`".as_slice());
        o = passport_field(o, n, sl, st, passport, name, agent_bytecode_schema.BS_PASSPORT__VERSION, "missing required field `version`".as_slice());
        o = passport_field(o, n, sl, st, passport, name, agent_bytecode_schema.BS_PASSPORT__COUNTRY, "missing required field `country`".as_slice());
        o = passport_field(o, n, sl, st, passport, name, agent_bytecode_schema.BS_PASSPORT__JURISDICTION, "missing required field `jurisdiction`".as_slice());
        o = passport_field(o, n, sl, st, passport, name, agent_bytecode_schema.BS_PASSPORT__INTENT, "missing required field `intent`".as_slice());
        o = passport_field(o, n, sl, st, passport, name, agent_bytecode_schema.BS_PASSPORT__RISK_LEVEL, "missing required field `risk_level`".as_slice());
        if is_empty(n, fld(n, sl, passport, agent_bytecode_schema.BS_PASSPORT__DATA_RESIDENCY)) {
            o = invalid(o, n, st, "passport".as_slice(), name, "data_residency must not be empty".as_slice(), NONE);
        }
        let agent: u64 = fld(n, sl, passport, agent_bytecode_schema.BS_PASSPORT__AGENT);
        if !blank(n, st, agent) {
            if !list_has(n, sl, st, agents, agent_bytecode_schema.BS_AGENT__NAME, agent) {
                o = invalid(o, n, st, "passport".as_slice(), name, "unknown agent `".as_slice(), agent);
            } else if earlier_passport_agent(n, sl, st, passports, agents, passport, agent) {
                let mut reason: Buffer<u8> = bytes.append(Buffer::new(), "agent `".as_slice());
                reason = put_text(reason, n, st, agent);
                reason = put(reason, "` already has a passport".as_slice());
                o = invalid(o, n, st, "passport".as_slice(), name, reason.as_slice(), NONE);
            }
        }
        let risk: u64 = fld(n, sl, passport, agent_bytecode_schema.BS_PASSPORT__RISK_LEVEL);
        if !blank(n, st, risk) && !one_of(n, st, risk, "low medium high critical".as_slice()) {
            o = invalid(o, n, st, "passport".as_slice(), name, "invalid risk_level `".as_slice(), risk);
        }
        let asn: u64 = fld(n, sl, passport, agent_bytecode_schema.BS_PASSPORT__ASN);
        if n[asn].kind == V_OBJECT {
            let registry: u64 = fld(n, sl, asn, agent_bytecode_schema.BS_PASSPORT_ASN__REGISTRY);
            if !one_of(n, st, registry, "LACNIC ARIN RIPE APNIC AFRINIC UNKNOWN".as_slice()) {
                o = invalid(o, n, st, "passport".as_slice(), name, "invalid asn registry `".as_slice(), registry);
            }
        }
    }
    o
}

fn passport_field(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, passport: u64, name: u64, field: u64, reason: Slice<u8>) -> Buffer<u8> {
    if !blank(n, st, fld(n, sl, passport, field)) {
        return out;
    }
    invalid(out, n, st, "passport".as_slice(), name, reason, NONE)
}

// Whether an earlier passport's agent, non-blank and declared, is `agent`:
// `passport_agents` only takes those.
fn earlier_passport_agent(n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, passports: u64, agents: u64, before: u64, agent: u64) -> bool {
    let mut link: u64 = n[passports].a;
    while link != 0u64 && link - 1u64 != before {
        let item: u64 = link - 1u64;
        link = n[item].next;
        let other: u64 = fld(n, sl, item, agent_bytecode_schema.BS_PASSPORT__AGENT);
        if !blank(n, st, other) && list_has(n, sl, st, agents, agent_bytecode_schema.BS_AGENT__NAME, other) && same_text(n, st, other, agent) {
            return true;
        }
    }
    false
}

// A u64 option that is `Some(0)`.
fn some_zero(n: Slice<Value>, node: u64) -> bool {
    n[node].kind == V_U64 && n[node].a == 0u64
}

fn validate_harnesses(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64, rank: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = gate(out, n, sl, p, rank, agent_bytecode_schema.BS_PROGRAM__PROVIDER_HARNESSES, 20u64, "provider harness metadata requires bytecode version 0.20 or later".as_slice());
    let harnesses: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__PROVIDER_HARNESSES);
    let providers: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__PROVIDERS);
    let features: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__FEATURES);
    let secrets: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__SECRETS);
    let types: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__TYPES);
    let mut link: u64 = n[harnesses].a;
    while link != 0u64 {
        let harness: u64 = link - 1u64;
        link = n[harness].next;
        let name: u64 = fld(n, sl, harness, agent_bytecode_schema.BS_PROVIDER_HARNESS__NAME);
        if seen_before(n, sl, st, harnesses, agent_bytecode_schema.BS_PROVIDER_HARNESS__NAME, harness, name) {
            o = named(o, n, st, "duplicate provider harness ".as_slice(), name, "".as_slice());
        }
        if blank(n, st, name) {
            o = invalid(o, n, st, "provider harness".as_slice(), name, "name must not be empty".as_slice(), NONE);
        }
        let provider: u64 = fld(n, sl, harness, agent_bytecode_schema.BS_PROVIDER_HARNESS__PROVIDER);
        if blank(n, st, provider) {
            o = invalid(o, n, st, "provider harness".as_slice(), name, "provider must not be empty".as_slice(), NONE);
        } else if !list_has(n, sl, st, providers, agent_bytecode_schema.BS_PROVIDER_CONTRACT__NAME, provider) {
            o = invalid(o, n, st, "provider harness".as_slice(), name, "unknown provider `".as_slice(), provider);
        }
        let feature: u64 = fld(n, sl, harness, agent_bytecode_schema.BS_PROVIDER_HARNESS__FEATURE);
        if n[feature].kind == V_STRING && !is_empty(n, features) && !list_has(n, sl, st, features, agent_bytecode_schema.BS_FEATURE__NAME, feature) {
            o = invalid(o, n, st, "provider harness".as_slice(), name, "unknown feature `".as_slice(), feature);
        }
        let secret: u64 = fld(n, sl, harness, agent_bytecode_schema.BS_PROVIDER_HARNESS__SECRET);
        if n[secret].kind == V_STRING && !is_empty(n, secrets) && !list_has(n, sl, st, secrets, agent_bytecode_schema.BS_SECRET__NAME, secret) {
            o = invalid(o, n, st, "provider harness".as_slice(), name, "unknown secret `".as_slice(), secret);
        }
        let mode: u64 = fld(n, sl, harness, agent_bytecode_schema.BS_PROVIDER_HARNESS__MODE);
        if !one_of(n, st, mode, "dry_run simulated".as_slice()) {
            o = invalid(o, n, st, "provider harness".as_slice(), name, "invalid mode `".as_slice(), mode);
        }
        if !text_is(n, st, fld(n, sl, harness, agent_bytecode_schema.BS_PROVIDER_HARNESS__NETWORK), "denied".as_slice()) {
            o = invalid(o, n, st, "provider harness".as_slice(), name, "network must be denied".as_slice(), NONE);
        }
        if !text_is(n, st, fld(n, sl, harness, agent_bytecode_schema.BS_PROVIDER_HARNESS__SECRETS), "denied".as_slice()) {
            o = invalid(o, n, st, "provider harness".as_slice(), name, "secrets must be denied".as_slice(), NONE);
        }
        let filesystem: u64 = fld(n, sl, harness, agent_bytecode_schema.BS_PROVIDER_HARNESS__FILESYSTEM);
        if !one_of(n, st, filesystem, "none read_only".as_slice()) {
            o = invalid(o, n, st, "provider harness".as_slice(), name, "invalid filesystem `".as_slice(), filesystem);
        }
        if some_zero(n, fld(n, sl, harness, agent_bytecode_schema.BS_PROVIDER_HARNESS__MAX_STEPS)) {
            o = invalid(o, n, st, "provider harness".as_slice(), name, "max_steps must be positive".as_slice(), NONE);
        }
        if some_zero(n, fld(n, sl, harness, agent_bytecode_schema.BS_PROVIDER_HARNESS__TIMEOUT_MS)) {
            o = invalid(o, n, st, "provider harness".as_slice(), name, "timeout_ms must be positive".as_slice(), NONE);
        }
        let input: u64 = fld(n, sl, harness, agent_bytecode_schema.BS_PROVIDER_HARNESS__INPUT_CONTRACT);
        if n[input].kind == V_STRING && !list_has(n, sl, st, types, agent_bytecode_schema.BS_TYPE__NAME, input) {
            o = invalid(o, n, st, "provider harness".as_slice(), name, "unknown input_contract `".as_slice(), input);
        }
        let output: u64 = fld(n, sl, harness, agent_bytecode_schema.BS_PROVIDER_HARNESS__OUTPUT_CONTRACT);
        if n[output].kind == V_STRING && !list_has(n, sl, st, types, agent_bytecode_schema.BS_TYPE__NAME, output) {
            o = invalid(o, n, st, "provider harness".as_slice(), name, "unknown output_contract `".as_slice(), output);
        }
        if any_blank(n, st, fld(n, sl, harness, agent_bytecode_schema.BS_PROVIDER_HARNESS__ATTESTATIONS)) {
            o = invalid(o, n, st, "provider harness".as_slice(), name, "attestation entries must not be empty".as_slice(), NONE);
        }
    }
    o
}

fn any_blank(n: Slice<Value>, st: Slice<u8>, list: u64) -> bool {
    let mut link: u64 = n[list].a;
    while link != 0u64 {
        let item: u64 = link - 1u64;
        link = n[item].next;
        if blank(n, st, item) {
            return true;
        }
    }
    false
}

// The kind of the last provider contract named `name`, or NONE.
fn provider_kind(n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, providers: u64, name: u64) -> u64 {
    let mut found: u64 = NONE;
    let mut link: u64 = n[providers].a;
    while link != 0u64 {
        let item: u64 = link - 1u64;
        link = n[item].next;
        if same_text(n, st, fld(n, sl, item, agent_bytecode_schema.BS_PROVIDER_CONTRACT__NAME), name) {
            found = fld(n, sl, item, agent_bytecode_schema.BS_PROVIDER_CONTRACT__KIND);
        }
    }
    found
}

fn validate_features(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64, rank: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = gate(out, n, sl, p, rank, agent_bytecode_schema.BS_PROGRAM__FEATURES, 21u64, "feature flag metadata requires bytecode version 0.21".as_slice());
    let features: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__FEATURES);
    let providers: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__PROVIDERS);
    let mut link: u64 = n[features].a;
    while link != 0u64 {
        let feature: u64 = link - 1u64;
        link = n[feature].next;
        let name: u64 = fld(n, sl, feature, agent_bytecode_schema.BS_FEATURE__NAME);
        if seen_before(n, sl, st, features, agent_bytecode_schema.BS_FEATURE__NAME, feature, name) {
            o = named(o, n, st, "duplicate feature ".as_slice(), name, "".as_slice());
        }
        if blank(n, st, name) {
            o = invalid(o, n, st, "feature".as_slice(), name, "name must not be empty".as_slice(), NONE);
        }
        let status: u64 = fld(n, sl, feature, agent_bytecode_schema.BS_FEATURE__STATUS);
        if !one_of(n, st, status, "experimental preview stable deprecated".as_slice()) {
            o = invalid(o, n, st, "feature".as_slice(), name, "invalid status `".as_slice(), status);
        }
        let default: u64 = fld(n, sl, feature, agent_bytecode_schema.BS_FEATURE__DEFAULT);
        if !one_of(n, st, default, "disabled enabled".as_slice()) {
            o = invalid(o, n, st, "feature".as_slice(), name, "invalid default `".as_slice(), default);
        }
        let approval: bool = n[fld(n, sl, feature, agent_bytecode_schema.BS_FEATURE__REQUIRES_APPROVAL)].a == 1u64;
        if one_of(n, st, status, "experimental preview".as_slice()) && !approval {
            let mut reason: Buffer<u8> = bytes.append(Buffer::new(), "status `".as_slice());
            reason = put_text(reason, n, st, status);
            reason = put(reason, "` requires approval".as_slice());
            o = invalid(o, n, st, "feature".as_slice(), name, reason.as_slice(), NONE);
        }
        let provider: u64 = fld(n, sl, feature, agent_bytecode_schema.BS_FEATURE__PROVIDER);
        if n[provider].kind == V_STRING {
            let provider_type: u64 = provider_kind(n, sl, st, providers, provider);
            if provider_type != NONE && text_is(n, st, provider_type, "external".as_slice()) && !text_is(n, st, default, "disabled".as_slice()) {
                let mut reason: Buffer<u8> = bytes.append(Buffer::new(), "feature linked to external provider `".as_slice());
                reason = put_text(reason, n, st, provider);
                reason = put(reason, "` must default to disabled".as_slice());
                o = invalid(o, n, st, "feature".as_slice(), name, reason.as_slice(), NONE);
            }
        }
    }
    o
}

fn validate_secrets(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64, rank: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = gate(out, n, sl, p, rank, agent_bytecode_schema.BS_PROGRAM__SECRETS, 21u64, "secret boundary metadata requires bytecode version 0.21".as_slice());
    let secrets: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__SECRETS);
    let features: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__FEATURES);
    let mut link: u64 = n[secrets].a;
    while link != 0u64 {
        let secret: u64 = link - 1u64;
        link = n[secret].next;
        let name: u64 = fld(n, sl, secret, agent_bytecode_schema.BS_SECRET__NAME);
        if seen_before(n, sl, st, secrets, agent_bytecode_schema.BS_SECRET__NAME, secret, name) {
            o = named(o, n, st, "duplicate secret ".as_slice(), name, "".as_slice());
        }
        if blank(n, st, name) {
            o = invalid(o, n, st, "secret".as_slice(), name, "name must not be empty".as_slice(), NONE);
        }
        if blank(n, st, fld(n, sl, secret, agent_bytecode_schema.BS_SECRET__HANDLE)) {
            o = invalid(o, n, st, "secret".as_slice(), name, "handle must not be empty".as_slice(), NONE);
        }
        let scope: u64 = fld(n, sl, secret, agent_bytecode_schema.BS_SECRET__SCOPE);
        if !one_of(n, st, scope, "provider adapter model tool runtime".as_slice()) {
            o = invalid(o, n, st, "secret".as_slice(), name, "invalid scope `".as_slice(), scope);
        }
        if !text_is(n, st, fld(n, sl, secret, agent_bytecode_schema.BS_SECRET__ACCESS), "denied".as_slice()) {
            o = invalid(o, n, st, "secret".as_slice(), name, "access must be denied".as_slice(), NONE);
        }
        if !text_is(n, st, fld(n, sl, secret, agent_bytecode_schema.BS_SECRET__SOURCE), "none".as_slice()) {
            o = invalid(o, n, st, "secret".as_slice(), name, "source must be none".as_slice(), NONE);
        }
        let required_by: u64 = fld(n, sl, secret, agent_bytecode_schema.BS_SECRET__REQUIRED_BY);
        if n[required_by].kind == V_STRING && !is_empty(n, features) && !list_has(n, sl, st, features, agent_bytecode_schema.BS_FEATURE__NAME, required_by) {
            o = invalid(o, n, st, "secret".as_slice(), name, "unknown required_by feature `".as_slice(), required_by);
        }
    }
    o
}

fn validate_adapters(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let adapters: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__ADAPTERS);
    let providers: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__PROVIDERS);
    let features: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__FEATURES);
    let secrets: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__SECRETS);
    let harnesses: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__PROVIDER_HARNESSES);
    let mut link: u64 = n[adapters].a;
    while link != 0u64 {
        let adapter: u64 = link - 1u64;
        link = n[adapter].next;
        let name: u64 = fld(n, sl, adapter, agent_bytecode_schema.BS_ADAPTER__NAME);
        // A duplicate is reported and skipped; the set holds each name once.
        if seen_before(n, sl, st, adapters, agent_bytecode_schema.BS_ADAPTER__NAME, adapter, name) {
            o = named(o, n, st, "duplicate adapter ".as_slice(), name, "".as_slice());
        } else {
            let provider: u64 = fld(n, sl, adapter, agent_bytecode_schema.BS_ADAPTER__PROVIDER);
            if blank(n, st, provider) {
                o = invalid(o, n, st, "adapter".as_slice(), name, "missing provider".as_slice(), NONE);
            } else if !list_has(n, sl, st, providers, agent_bytecode_schema.BS_PROVIDER_CONTRACT__NAME, provider) {
                o = invalid(o, n, st, "adapter".as_slice(), name, "unknown provider `".as_slice(), provider);
            }
            let feature: u64 = fld(n, sl, adapter, agent_bytecode_schema.BS_ADAPTER__FEATURE);
            if n[feature].kind == V_STRING && !list_has(n, sl, st, features, agent_bytecode_schema.BS_FEATURE__NAME, feature) {
                o = invalid(o, n, st, "adapter".as_slice(), name, "unknown feature `".as_slice(), feature);
            }
            let secret: u64 = fld(n, sl, adapter, agent_bytecode_schema.BS_ADAPTER__SECRET);
            if n[secret].kind == V_STRING && !list_has(n, sl, st, secrets, agent_bytecode_schema.BS_SECRET__NAME, secret) {
                o = invalid(o, n, st, "adapter".as_slice(), name, "unknown secret `".as_slice(), secret);
            }
            let harness: u64 = fld(n, sl, adapter, agent_bytecode_schema.BS_ADAPTER__HARNESS);
            if n[harness].kind == V_STRING && !list_has(n, sl, st, harnesses, agent_bytecode_schema.BS_PROVIDER_HARNESS__NAME, harness) {
                o = invalid(o, n, st, "adapter".as_slice(), name, "unknown harness `".as_slice(), harness);
            }
            let mode: u64 = fld(n, sl, adapter, agent_bytecode_schema.BS_ADAPTER__MODE);
            if blank(n, st, mode) || text_is(n, st, mode, "unknown".as_slice()) {
                o = invalid(o, n, st, "adapter".as_slice(), name, "missing or invalid mode".as_slice(), NONE);
            }
            if !text_is(n, st, fld(n, sl, adapter, agent_bytecode_schema.BS_ADAPTER__EXECUTION), "disabled".as_slice()) {
                o = invalid(o, n, st, "adapter".as_slice(), name, "execution must be disabled".as_slice(), NONE);
            }
            if !text_is(n, st, fld(n, sl, adapter, agent_bytecode_schema.BS_ADAPTER__NETWORK), "denied".as_slice()) {
                o = invalid(o, n, st, "adapter".as_slice(), name, "network must be denied".as_slice(), NONE);
            }
            if !text_is(n, st, fld(n, sl, adapter, agent_bytecode_schema.BS_ADAPTER__SECRETS), "denied".as_slice()) {
                o = invalid(o, n, st, "adapter".as_slice(), name, "secrets must be denied".as_slice(), NONE);
            }
            if !one_of(n, st, fld(n, sl, adapter, agent_bytecode_schema.BS_ADAPTER__FILESYSTEM), "none read_only".as_slice()) {
                o = invalid(o, n, st, "adapter".as_slice(), name, "filesystem must be none or read_only".as_slice(), NONE);
            }
            let mut item_link: u64 = n[fld(n, sl, adapter, agent_bytecode_schema.BS_ADAPTER__CONFORMANCE)].a;
            while item_link != 0u64 {
                let item: u64 = item_link - 1u64;
                item_link = n[item].next;
                if blank(n, st, item) {
                    o = invalid(o, n, st, "adapter".as_slice(), name, "empty conformance item".as_slice(), NONE);
                }
            }
            if n[harness].kind == V_STRING {
                let found: u64 = find_named(n, sl, st, harnesses, agent_bytecode_schema.BS_PROVIDER_HARNESS__NAME, harness);
                if found != NONE && !same_text(n, st, fld(n, sl, found, agent_bytecode_schema.BS_PROVIDER_HARNESS__PROVIDER), provider) {
                    o = invalid(o, n, st, "adapter".as_slice(), name, "provider mismatch with harness".as_slice(), NONE);
                }
            }
        }
    }
    o
}

// "invalid <kind> `<name>`: <reason>" unless field `field` of `item` is one
// of `words`.
fn must(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, item: u64, field: u64, words: Slice<u8>, kind: Slice<u8>, name: u64, reason: Slice<u8>) -> Buffer<u8> {
    if one_of(n, st, fld(n, sl, item, field), words) {
        return out;
    }
    invalid(out, n, st, kind, name, reason, NONE)
}

// ... unless field `field` of `item` is not blank.
fn filled(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, item: u64, field: u64, kind: Slice<u8>, name: u64, reason: Slice<u8>) -> Buffer<u8> {
    if !blank(n, st, fld(n, sl, item, field)) {
        return out;
    }
    invalid(out, n, st, kind, name, reason, NONE)
}

// ... once for each blank entry of list field `field` of `item`.
fn each_blank(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, item: u64, field: u64, kind: Slice<u8>, name: u64, reason: Slice<u8>) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let mut link: u64 = n[fld(n, sl, item, field)].a;
    while link != 0u64 {
        let entry: u64 = link - 1u64;
        link = n[entry].next;
        if blank(n, st, entry) {
            o = invalid(o, n, st, kind, name, reason, NONE);
        }
    }
    o
}

// ... once if any entry of list field `field` of `item` is blank.
fn any_blank_field(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, item: u64, field: u64, kind: Slice<u8>, name: u64, reason: Slice<u8>) -> Buffer<u8> {
    if !any_blank(n, st, fld(n, sl, item, field)) {
        return out;
    }
    invalid(out, n, st, kind, name, reason, NONE)
}

// ... if u64 option field `field` of `item` is `Some(0)`.
fn positive(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, item: u64, field: u64, kind: Slice<u8>, name: u64, reason: Slice<u8>) -> Buffer<u8> {
    if !some_zero(n, fld(n, sl, item, field)) {
        return out;
    }
    invalid(out, n, st, kind, name, reason, NONE)
}

// "invalid <kind> `<name>`: <reason><value>`" unless field `field` is one of
// `words`.
fn must_named(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, item: u64, field: u64, words: Slice<u8>, kind: Slice<u8>, name: u64, reason: Slice<u8>) -> Buffer<u8> {
    let value: u64 = fld(n, sl, item, field);
    if one_of(n, st, value, words) {
        return out;
    }
    invalid(out, n, st, kind, name, reason, value)
}

// A reference field: "missing <what>" when blank, "unknown <what> `<v>`"
// when not declared in `list` (by field `list_field`).
fn reference(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, item: u64, field: u64, list: u64, list_field: u64, kind: Slice<u8>, name: u64, missing: Slice<u8>, unknown: Slice<u8>) -> Buffer<u8> {
    let value: u64 = fld(n, sl, item, field);
    if blank(n, st, value) {
        return invalid(out, n, st, kind, name, missing, NONE);
    }
    if list_has(n, sl, st, list, list_field, value) {
        return out;
    }
    invalid(out, n, st, kind, name, unknown, value)
}

fn validate_adapter_profiles(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let profiles: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__ADAPTER_PROFILES);
    let adapters: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__ADAPTERS);
    let providers: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__PROVIDERS);
    let mut link: u64 = n[profiles].a;
    while link != 0u64 {
        let profile: u64 = link - 1u64;
        link = n[profile].next;
        let name: u64 = fld(n, sl, profile, agent_bytecode_schema.BS_ADAPTER_PROFILE__NAME);
        if seen_before(n, sl, st, profiles, agent_bytecode_schema.BS_ADAPTER_PROFILE__NAME, profile, name) {
            o = named(o, n, st, "duplicate adapter profile ".as_slice(), name, "".as_slice());
        } else {
            o = reference(o, n, sl, st, profile, agent_bytecode_schema.BS_ADAPTER_PROFILE__ADAPTER, adapters, agent_bytecode_schema.BS_ADAPTER__NAME, "adapter profile".as_slice(), name, "missing adapter".as_slice(), "unknown adapter `".as_slice());
            o = reference(o, n, sl, st, profile, agent_bytecode_schema.BS_ADAPTER_PROFILE__PROVIDER, providers, agent_bytecode_schema.BS_PROVIDER_CONTRACT__NAME, "adapter profile".as_slice(), name, "missing provider".as_slice(), "unknown provider `".as_slice());
            o = filled(o, n, sl, st, profile, agent_bytecode_schema.BS_ADAPTER_PROFILE__VENDOR, "adapter profile".as_slice(), name, "missing vendor".as_slice());
            o = must(o, n, sl, st, profile, agent_bytecode_schema.BS_ADAPTER_PROFILE__EXECUTION, "disabled".as_slice(), "adapter profile".as_slice(), name, "execution must be disabled".as_slice());
            o = must(o, n, sl, st, profile, agent_bytecode_schema.BS_ADAPTER_PROFILE__NETWORK, "denied".as_slice(), "adapter profile".as_slice(), name, "network must be denied".as_slice());
            o = must(o, n, sl, st, profile, agent_bytecode_schema.BS_ADAPTER_PROFILE__SECRETS, "denied".as_slice(), "adapter profile".as_slice(), name, "secrets must be denied".as_slice());
            o = each_blank(o, n, sl, st, profile, agent_bytecode_schema.BS_ADAPTER_PROFILE__CAPABILITIES, "adapter profile".as_slice(), name, "empty capability".as_slice());
            o = each_blank(o, n, sl, st, profile, agent_bytecode_schema.BS_ADAPTER_PROFILE__REQUIRED_CONFORMANCE, "adapter profile".as_slice(), name, "empty required_conformance item".as_slice());
        }
    }
    o
}

fn validate_cryptos(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let cryptos: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__CRYPTOS);
    let mut link: u64 = n[cryptos].a;
    while link != 0u64 {
        let crypto: u64 = link - 1u64;
        link = n[crypto].next;
        let name: u64 = fld(n, sl, crypto, agent_bytecode_schema.BS_CRYPTO__NAME);
        if seen_before(n, sl, st, cryptos, agent_bytecode_schema.BS_CRYPTO__NAME, crypto, name) {
            o = named(o, n, st, "duplicate crypto ".as_slice(), name, "".as_slice());
        } else {
            o = filled(o, n, sl, st, crypto, agent_bytecode_schema.BS_CRYPTO__KIND, "crypto".as_slice(), name, "missing kind".as_slice());
            o = filled(o, n, sl, st, crypto, agent_bytecode_schema.BS_CRYPTO__STATUS, "crypto".as_slice(), name, "missing status".as_slice());
            o = filled(o, n, sl, st, crypto, agent_bytecode_schema.BS_CRYPTO__STRENGTH, "crypto".as_slice(), name, "missing strength".as_slice());
            if is_empty(n, fld(n, sl, crypto, agent_bytecode_schema.BS_CRYPTO__PURPOSE)) {
                o = invalid(o, n, st, "crypto".as_slice(), name, "missing or empty purpose".as_slice(), NONE);
            } else {
                o = each_blank(o, n, sl, st, crypto, agent_bytecode_schema.BS_CRYPTO__PURPOSE, "crypto".as_slice(), name, "empty purpose item".as_slice());
            }
            o = positive(o, n, sl, st, crypto, agent_bytecode_schema.BS_CRYPTO__OUTPUT_BITS, "crypto".as_slice(), name, "output_bits must be > 0".as_slice());
            o = positive(o, n, sl, st, crypto, agent_bytecode_schema.BS_CRYPTO__MIN_KEY_BITS, "crypto".as_slice(), name, "min_key_bits must be > 0".as_slice());
        }
    }
    o
}

fn validate_crypto_boundaries(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let boundaries: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__CRYPTO_BOUNDARIES);
    let mut link: u64 = n[boundaries].a;
    while link != 0u64 {
        let boundary: u64 = link - 1u64;
        link = n[boundary].next;
        let name: u64 = fld(n, sl, boundary, agent_bytecode_schema.BS_CRYPTO_BOUNDARY__NAME);
        if seen_before(n, sl, st, boundaries, agent_bytecode_schema.BS_CRYPTO_BOUNDARY__NAME, boundary, name) {
            o = named(o, n, st, "duplicate crypto boundary ".as_slice(), name, "".as_slice());
        } else {
            if blank(n, st, name) {
                o = invalid(o, n, st, "crypto boundary".as_slice(), name, "name must not be empty".as_slice(), NONE);
            }
            o = must_named(o, n, sl, st, boundary, agent_bytecode_schema.BS_CRYPTO_BOUNDARY__KEY_MATERIAL, "denied allowed required".as_slice(), "crypto boundary".as_slice(), name, "invalid key_material `".as_slice());
            o = must_named(o, n, sl, st, boundary, agent_bytecode_schema.BS_CRYPTO_BOUNDARY__SECRET_MATERIAL, "denied allowed required".as_slice(), "crypto boundary".as_slice(), name, "invalid secret_material `".as_slice());
            o = must(o, n, sl, st, boundary, agent_bytecode_schema.BS_CRYPTO_BOUNDARY__EXECUTION, "disabled".as_slice(), "crypto boundary".as_slice(), name, "execution must be disabled".as_slice());
            o = positive(o, n, sl, st, boundary, agent_bytecode_schema.BS_CRYPTO_BOUNDARY__MIN_HASH_BITS, "crypto boundary".as_slice(), name, "min_hash_bits must be > 0".as_slice());
            o = each_blank(o, n, sl, st, boundary, agent_bytecode_schema.BS_CRYPTO_BOUNDARY__ALLOWED_HASHES, "crypto boundary".as_slice(), name, "empty list item".as_slice());
            o = each_blank(o, n, sl, st, boundary, agent_bytecode_schema.BS_CRYPTO_BOUNDARY__ALLOWED_SIGNATURES, "crypto boundary".as_slice(), name, "empty list item".as_slice());
            o = each_blank(o, n, sl, st, boundary, agent_bytecode_schema.BS_CRYPTO_BOUNDARY__ALLOWED_KEMS, "crypto boundary".as_slice(), name, "empty list item".as_slice());
            o = each_blank(o, n, sl, st, boundary, agent_bytecode_schema.BS_CRYPTO_BOUNDARY__ALLOWED_AEADS, "crypto boundary".as_slice(), name, "empty list item".as_slice());
            o = each_blank(o, n, sl, st, boundary, agent_bytecode_schema.BS_CRYPTO_BOUNDARY__LEGACY_ALLOWED, "crypto boundary".as_slice(), name, "empty list item".as_slice());
            o = each_blank(o, n, sl, st, boundary, agent_bytecode_schema.BS_CRYPTO_BOUNDARY__DENIED, "crypto boundary".as_slice(), name, "empty list item".as_slice());
            o = each_blank(o, n, sl, st, boundary, agent_bytecode_schema.BS_CRYPTO_BOUNDARY__PURPOSE, "crypto boundary".as_slice(), name, "empty list item".as_slice());
        }
    }
    o
}

fn validate_atrust_handshakes(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let handshakes: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__ATRUST_HANDSHAKES);
    let mut link: u64 = n[handshakes].a;
    while link != 0u64 {
        let h: u64 = link - 1u64;
        link = n[h].next;
        let name: u64 = fld(n, sl, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__NAME);
        if seen_before(n, sl, st, handshakes, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__NAME, h, name) {
            o = named(o, n, st, "duplicate atrust handshake ".as_slice(), name, "".as_slice());
        } else {
            o = filled(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__NAME, "atrust handshake".as_slice(), name, "name must not be empty".as_slice());
            o = filled(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__INITIATOR, "atrust handshake".as_slice(), name, "initiator must not be empty".as_slice());
            o = filled(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__RESPONDER, "atrust handshake".as_slice(), name, "responder must not be empty".as_slice());
            o = filled(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__INITIATOR_IDENTITY, "atrust handshake".as_slice(), name, "initiator_identity must not be empty".as_slice());
            o = filled(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__RESPONDER_IDENTITY, "atrust handshake".as_slice(), name, "responder_identity must not be empty".as_slice());
            o = filled(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__BOUNDARY, "atrust handshake".as_slice(), name, "boundary must not be empty".as_slice());
            o = filled(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__METHOD, "atrust handshake".as_slice(), name, "method must not be empty".as_slice());
            o = any_blank_field(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__CREDENTIAL_CONTRACTS, "atrust handshake".as_slice(), name, "credential_contracts must not contain empty items".as_slice());
            o = any_blank_field(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__PURPOSE, "atrust handshake".as_slice(), name, "purpose must not contain empty items".as_slice());
            o = must(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__MODE, "dry_run".as_slice(), "atrust handshake".as_slice(), name, "mode must be dry_run".as_slice());
            o = must(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__DIRECTION, "one_way mutual".as_slice(), "atrust handshake".as_slice(), name, "direction must be one_way or mutual".as_slice());
            o = must(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__CHALLENGE, "disabled declared_only".as_slice(), "atrust handshake".as_slice(), name, "challenge must be disabled or declared_only".as_slice());
            o = must(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__RESPONSE, "disabled declared_only".as_slice(), "atrust handshake".as_slice(), name, "response must be disabled or declared_only".as_slice());
            o = must(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__TRANSCRIPT, "metadata_only evidence_only".as_slice(), "atrust handshake".as_slice(), name, "transcript must be metadata_only or evidence_only".as_slice());
            o = must(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__VERIFICATION, "disabled declared_only".as_slice(), "atrust handshake".as_slice(), name, "verification must be disabled or declared_only".as_slice());
            o = must(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__RESOLUTION, "disabled embedded local".as_slice(), "atrust handshake".as_slice(), name, "resolution must be disabled, embedded, or local".as_slice());
            o = must(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__NETWORK, "denied".as_slice(), "atrust handshake".as_slice(), name, "network must be denied".as_slice());
            o = must(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__KEY_MATERIAL, "denied".as_slice(), "atrust handshake".as_slice(), name, "key_material must be denied".as_slice());
            o = must(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__SECRET_MATERIAL, "denied".as_slice(), "atrust handshake".as_slice(), name, "secret_material must be denied".as_slice());
            o = must(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__EXECUTION, "disabled".as_slice(), "atrust handshake".as_slice(), name, "execution must be disabled".as_slice());
            o = must(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__EVIDENCE, "required".as_slice(), "atrust handshake".as_slice(), name, "evidence must be required".as_slice());
            o = must(o, n, sl, st, h, agent_bytecode_schema.BS_A_TRUST_HANDSHAKE__SECURITY_CLAIMS, "none".as_slice(), "atrust handshake".as_slice(), name, "security_claims must be none".as_slice());
        }
    }
    o
}

// ... if list field `field` of `item` is empty.
fn nonempty(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, item: u64, field: u64, kind: Slice<u8>, name: u64, reason: Slice<u8>) -> Buffer<u8> {
    if !is_empty(n, fld(n, sl, item, field)) {
        return out;
    }
    invalid(out, n, st, kind, name, reason, NONE)
}

// Whether a crypto named `name` is of kind `hash` and not denied.
fn hash_crypto(n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64, name: u64) -> bool {
    let mut link: u64 = n[list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__CRYPTOS)].a;
    while link != 0u64 {
        let crypto: u64 = link - 1u64;
        link = n[crypto].next;
        if same_text(n, st, fld(n, sl, crypto, agent_bytecode_schema.BS_CRYPTO__NAME), name) && text_is(n, st, fld(n, sl, crypto, agent_bytecode_schema.BS_CRYPTO__KIND), "hash".as_slice()) && !text_is(n, st, fld(n, sl, crypto, agent_bytecode_schema.BS_CRYPTO__STATUS), "denied".as_slice()) {
            return true;
        }
    }
    false
}

fn validate_trust_ledgers(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let ledgers: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__TRUST_LEDGERS);
    let mut link: u64 = n[ledgers].a;
    while link != 0u64 {
        let l: u64 = link - 1u64;
        link = n[l].next;
        let name: u64 = fld(n, sl, l, agent_bytecode_schema.BS_TRUST_LEDGER__NAME);
        if seen_before(n, sl, st, ledgers, agent_bytecode_schema.BS_TRUST_LEDGER__NAME, l, name) {
            o = named(o, n, st, "duplicate trust ledger ".as_slice(), name, "".as_slice());
        } else {
            o = filled(o, n, sl, st, l, agent_bytecode_schema.BS_TRUST_LEDGER__NAME, "trust ledger".as_slice(), name, "name must not be empty".as_slice());
            o = must(o, n, sl, st, l, agent_bytecode_schema.BS_TRUST_LEDGER__SCOPE, "local package bundle".as_slice(), "trust ledger".as_slice(), name, "scope must be local, package, or bundle".as_slice());
            o = must(o, n, sl, st, l, agent_bytecode_schema.BS_TRUST_LEDGER__MODE, "dry_run declared_only".as_slice(), "trust ledger".as_slice(), name, "mode must be dry_run or declared_only".as_slice());
            let algorithm: u64 = fld(n, sl, l, agent_bytecode_schema.BS_TRUST_LEDGER__HASH_ALGORITHM);
            if blank(n, st, algorithm) {
                o = invalid(o, n, st, "trust ledger".as_slice(), name, "hash_algorithm must not be empty".as_slice(), NONE);
            } else if !hash_crypto(n, sl, st, p, algorithm) {
                o = invalid(o, n, st, "trust ledger".as_slice(), name, "hash_algorithm must reference a declared, non-denied crypto of kind hash".as_slice(), NONE);
            }
            o = must(o, n, sl, st, l, agent_bytecode_schema.BS_TRUST_LEDGER__CHAIN_POLICY, "append_only declared_only".as_slice(), "trust ledger".as_slice(), name, "chain_policy must be append_only or declared_only".as_slice());
            o = nonempty(o, n, sl, st, l, agent_bytecode_schema.BS_TRUST_LEDGER__ENTRIES, "trust ledger".as_slice(), name, "entries must not be empty".as_slice());
            o = any_blank_field(o, n, sl, st, l, agent_bytecode_schema.BS_TRUST_LEDGER__PURPOSE, "trust ledger".as_slice(), name, "purpose must not contain empty items".as_slice());
            o = must(o, n, sl, st, l, agent_bytecode_schema.BS_TRUST_LEDGER__NETWORK, "denied".as_slice(), "trust ledger".as_slice(), name, "network must be denied".as_slice());
            o = must(o, n, sl, st, l, agent_bytecode_schema.BS_TRUST_LEDGER__KEY_MATERIAL, "denied".as_slice(), "trust ledger".as_slice(), name, "key_material must be denied".as_slice());
            o = must(o, n, sl, st, l, agent_bytecode_schema.BS_TRUST_LEDGER__SECRET_MATERIAL, "denied".as_slice(), "trust ledger".as_slice(), name, "secret_material must be denied".as_slice());
            o = must(o, n, sl, st, l, agent_bytecode_schema.BS_TRUST_LEDGER__EXECUTION, "disabled".as_slice(), "trust ledger".as_slice(), name, "execution must be disabled".as_slice());
            o = must(o, n, sl, st, l, agent_bytecode_schema.BS_TRUST_LEDGER__EVIDENCE, "required".as_slice(), "trust ledger".as_slice(), name, "evidence must be required".as_slice());
            o = must(o, n, sl, st, l, agent_bytecode_schema.BS_TRUST_LEDGER__SECURITY_CLAIMS, "none".as_slice(), "trust ledger".as_slice(), name, "security_claims must be none".as_slice());
            o = ledger_entries(o, n, sl, st, l, name, algorithm);
        }
    }
    o
}

fn ledger_entries(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, l: u64, name: u64, algorithm: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let entries: u64 = fld(n, sl, l, agent_bytecode_schema.BS_TRUST_LEDGER__ENTRIES);
    let mut previous: u64 = NONE;
    let mut link: u64 = n[entries].a;
    while link != 0u64 {
        let e: u64 = link - 1u64;
        link = n[e].next;
        let id: u64 = fld(n, sl, e, agent_bytecode_schema.BS_TRUST_LEDGER_ENTRY__ID);
        if seen_before(n, sl, st, entries, agent_bytecode_schema.BS_TRUST_LEDGER_ENTRY__ID, e, id) {
            o = invalid(o, n, st, "trust ledger".as_slice(), name, "entry ids must be unique".as_slice(), NONE);
        }
        o = filled(o, n, sl, st, e, agent_bytecode_schema.BS_TRUST_LEDGER_ENTRY__ID, "trust ledger".as_slice(), name, "entry id must not be empty".as_slice());
        o = must(o, n, sl, st, e, agent_bytecode_schema.BS_TRUST_LEDGER_ENTRY__KIND, "identity credential handshake evidence policy custom".as_slice(), "trust ledger".as_slice(), name, "entry kind is invalid".as_slice());
        o = filled(o, n, sl, st, e, agent_bytecode_schema.BS_TRUST_LEDGER_ENTRY__SUBJECT, "trust ledger".as_slice(), name, "entry subject must not be empty".as_slice());
        o = filled(o, n, sl, st, e, agent_bytecode_schema.BS_TRUST_LEDGER_ENTRY__EVIDENCE_REF, "trust ledger".as_slice(), name, "entry evidence_ref must not be empty".as_slice());
        let entry_hash: u64 = fld(n, sl, e, agent_bytecode_schema.BS_TRUST_LEDGER_ENTRY__ENTRY_HASH);
        if blank(n, st, entry_hash) {
            o = invalid(o, n, st, "trust ledger".as_slice(), name, "entry entry_hash must not be empty".as_slice(), NONE);
        } else if !blank(n, st, algorithm) && !prefixed(n, st, entry_hash, algorithm) {
            o = invalid(o, n, st, "trust ledger".as_slice(), name, "entry_hash must use the declared hash_algorithm prefix".as_slice(), NONE);
        }
        let previous_hash: u64 = fld(n, sl, e, agent_bytecode_schema.BS_TRUST_LEDGER_ENTRY__PREVIOUS_HASH);
        if blank(n, st, previous_hash) {
            o = invalid(o, n, st, "trust ledger".as_slice(), name, "entry previous_hash must not be empty".as_slice(), NONE);
        } else if previous == NONE {
            if !text_is(n, st, previous_hash, "GENESIS".as_slice()) {
                o = invalid(o, n, st, "trust ledger".as_slice(), name, "first entry previous_hash must be GENESIS".as_slice(), NONE);
            }
        } else if !same_text(n, st, previous_hash, previous) {
            o = invalid(o, n, st, "trust ledger".as_slice(), name, "entry previous_hash must match the prior entry_hash".as_slice(), NONE);
        }
        previous = entry_hash;
    }
    let chain_root: u64 = fld(n, sl, l, agent_bytecode_schema.BS_TRUST_LEDGER__CHAIN_ROOT);
    if previous != NONE {
        if !same_text(n, st, chain_root, previous) {
            o = invalid(o, n, st, "trust ledger".as_slice(), name, "chain_root must match the final entry_hash".as_slice(), NONE);
        }
    } else if blank(n, st, chain_root) {
        o = invalid(o, n, st, "trust ledger".as_slice(), name, "chain_root must not be empty".as_slice(), NONE);
    }
    o
}

// Whether `hash` starts with `<algorithm>:`.
fn prefixed(n: Slice<Value>, st: Slice<u8>, hash: u64, algorithm: u64) -> bool {
    let length: u64 = n[algorithm].b - n[algorithm].a;
    if n[hash].b - n[hash].a < length + 1u64 {
        return false;
    }
    bytes.equal(st.slice(n[hash].a, n[hash].a + length), st.slice(n[algorithm].a, n[algorithm].b)) && st[n[hash].a + length] == 58u8
}

fn validate_mcp_bridges(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let bridges: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__MCP_BRIDGE_CONTRACTS);
    let mut link: u64 = n[bridges].a;
    while link != 0u64 {
        let c: u64 = link - 1u64;
        link = n[c].next;
        let name: u64 = fld(n, sl, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__NAME);
        if seen_before(n, sl, st, bridges, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__NAME, c, name) {
            o = named(o, n, st, "duplicate mcp bridge contract ".as_slice(), name, "".as_slice());
        } else {
            o = filled(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__NAME, "mcp bridge contract".as_slice(), name, "name must not be empty".as_slice());
            o = filled(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__AGENT, "mcp bridge contract".as_slice(), name, "agent must not be empty".as_slice());
            o = filled(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__PASSPORT, "mcp bridge contract".as_slice(), name, "passport must not be empty".as_slice());
            o = filled(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__IDENTITY, "mcp bridge contract".as_slice(), name, "identity must not be empty".as_slice());
            o = filled(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__BOUNDARY, "mcp bridge contract".as_slice(), name, "boundary must not be empty".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__TRANSPORT, "declared_only disabled".as_slice(), "mcp bridge contract".as_slice(), name, "transport must be declared_only or disabled".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__PROTOCOL, "mcp".as_slice(), "mcp bridge contract".as_slice(), name, "protocol must be mcp".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__DIRECTION, "inbound outbound bidirectional".as_slice(), "mcp bridge contract".as_slice(), name, "direction must be inbound, outbound, or bidirectional".as_slice());
            o = any_blank_field(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__TOOLS, "mcp bridge contract".as_slice(), name, "tools must not contain empty items".as_slice());
            o = any_blank_field(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__RESOURCES, "mcp bridge contract".as_slice(), name, "resources must not contain empty items".as_slice());
            o = any_blank_field(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__PROMPTS, "mcp bridge contract".as_slice(), name, "prompts must not contain empty items".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__NETWORK, "denied".as_slice(), "mcp bridge contract".as_slice(), name, "network must be denied".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__EXTERNAL_EXECUTION, "disabled".as_slice(), "mcp bridge contract".as_slice(), name, "external_execution must be disabled".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__TOOL_EXECUTION, "disabled".as_slice(), "mcp bridge contract".as_slice(), name, "tool_execution must be disabled".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__SECRET_MATERIAL, "denied".as_slice(), "mcp bridge contract".as_slice(), name, "secret_material must be denied".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__KEY_MATERIAL, "denied".as_slice(), "mcp bridge contract".as_slice(), name, "key_material must be denied".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__AUTHENTICATION, "none declared_only".as_slice(), "mcp bridge contract".as_slice(), name, "authentication must be none or declared_only".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__AUTHORIZATION, "policy_bound declared_only".as_slice(), "mcp bridge contract".as_slice(), name, "authorization must be policy_bound or declared_only".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__EVIDENCE, "required".as_slice(), "mcp bridge contract".as_slice(), name, "evidence must be required".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__SECURITY_CLAIMS, "none".as_slice(), "mcp bridge contract".as_slice(), name, "security_claims must be none".as_slice());
            o = nonempty(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__PURPOSE, "mcp bridge contract".as_slice(), name, "purpose must not be empty".as_slice());
            o = any_blank_field(o, n, sl, st, c, agent_bytecode_schema.BS_MCP_BRIDGE_CONTRACT__PURPOSE, "mcp bridge contract".as_slice(), name, "purpose must not contain empty items".as_slice());
        }
    }
    o
}

fn validate_a2a_bridges(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let bridges: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__A2A_BRIDGE_CONTRACTS);
    let mut link: u64 = n[bridges].a;
    while link != 0u64 {
        let c: u64 = link - 1u64;
        link = n[c].next;
        let name: u64 = fld(n, sl, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__NAME);
        if seen_before(n, sl, st, bridges, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__NAME, c, name) {
            o = named(o, n, st, "duplicate a2a bridge contract ".as_slice(), name, "".as_slice());
        } else {
            o = filled(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__NAME, "a2a bridge contract".as_slice(), name, "name must not be empty".as_slice());
            o = filled(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__INITIATOR, "a2a bridge contract".as_slice(), name, "initiator must not be empty".as_slice());
            o = filled(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__RESPONDER, "a2a bridge contract".as_slice(), name, "responder must not be empty".as_slice());
            o = filled(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__INITIATOR_PASSPORT, "a2a bridge contract".as_slice(), name, "initiator_passport must not be empty".as_slice());
            o = filled(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__RESPONDER_PASSPORT, "a2a bridge contract".as_slice(), name, "responder_passport must not be empty".as_slice());
            o = filled(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__INITIATOR_IDENTITY, "a2a bridge contract".as_slice(), name, "initiator_identity must not be empty".as_slice());
            o = filled(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__RESPONDER_IDENTITY, "a2a bridge contract".as_slice(), name, "responder_identity must not be empty".as_slice());
            o = filled(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__HANDSHAKE, "a2a bridge contract".as_slice(), name, "handshake must not be empty".as_slice());
            o = filled(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__TRUST_LEDGER, "a2a bridge contract".as_slice(), name, "trust_ledger must not be empty".as_slice());
            o = filled(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__BOUNDARY, "a2a bridge contract".as_slice(), name, "boundary must not be empty".as_slice());
            let initiator: u64 = fld(n, sl, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__INITIATOR);
            if !blank(n, st, initiator) && same_text(n, st, initiator, fld(n, sl, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__RESPONDER)) {
                o = invalid(o, n, st, "a2a bridge contract".as_slice(), name, "initiator and responder must be distinct".as_slice(), NONE);
            }
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__PROTOCOL, "a2a".as_slice(), "a2a bridge contract".as_slice(), name, "protocol must be a2a".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__TRANSPORT, "declared_only disabled".as_slice(), "a2a bridge contract".as_slice(), name, "transport must be declared_only or disabled".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__DIRECTION, "inbound outbound bidirectional".as_slice(), "a2a bridge contract".as_slice(), name, "direction must be inbound, outbound, or bidirectional".as_slice());
            o = nonempty(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__MESSAGE_CONTRACTS, "a2a bridge contract".as_slice(), name, "message_contracts must not be empty".as_slice());
            o = any_blank_field(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__MESSAGE_CONTRACTS, "a2a bridge contract".as_slice(), name, "message_contracts must not contain empty items".as_slice());
            o = any_blank_field(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__CAPABILITIES, "a2a bridge contract".as_slice(), name, "capabilities must not contain empty items".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__NETWORK, "denied".as_slice(), "a2a bridge contract".as_slice(), name, "network must be denied".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__EXTERNAL_EXECUTION, "disabled".as_slice(), "a2a bridge contract".as_slice(), name, "external_execution must be disabled".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__AGENT_EXECUTION, "disabled".as_slice(), "a2a bridge contract".as_slice(), name, "agent_execution must be disabled".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__SECRET_MATERIAL, "denied".as_slice(), "a2a bridge contract".as_slice(), name, "secret_material must be denied".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__KEY_MATERIAL, "denied".as_slice(), "a2a bridge contract".as_slice(), name, "key_material must be denied".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__AUTHENTICATION, "none declared_only".as_slice(), "a2a bridge contract".as_slice(), name, "authentication must be none or declared_only".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__AUTHORIZATION, "policy_bound declared_only".as_slice(), "a2a bridge contract".as_slice(), name, "authorization must be policy_bound or declared_only".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__EVIDENCE, "required".as_slice(), "a2a bridge contract".as_slice(), name, "evidence must be required".as_slice());
            o = must(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__SECURITY_CLAIMS, "none".as_slice(), "a2a bridge contract".as_slice(), name, "security_claims must be none".as_slice());
            o = nonempty(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__PURPOSE, "a2a bridge contract".as_slice(), name, "purpose must not be empty".as_slice());
            o = any_blank_field(o, n, sl, st, c, agent_bytecode_schema.BS_A2_A_BRIDGE_CONTRACT__PURPOSE, "a2a bridge contract".as_slice(), name, "purpose must not contain empty items".as_slice());
        }
    }
    o
}

// Whether a string node is empty, untrimmed.
fn bare_empty(n: Slice<Value>, node: u64) -> bool {
    n[node].a == n[node].b
}

fn any_empty(n: Slice<Value>, list: u64) -> bool {
    let mut link: u64 = n[list].a;
    while link != 0u64 {
        let entry: u64 = link - 1u64;
        link = n[entry].next;
        if bare_empty(n, entry) {
            return true;
        }
    }
    false
}

// ... if list field `field` is empty or has an empty (untrimmed) entry.
fn nonempty_strict(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, item: u64, field: u64, kind: Slice<u8>, name: u64, reason: Slice<u8>) -> Buffer<u8> {
    let list: u64 = fld(n, sl, item, field);
    let mut bad: bool = is_empty(n, list);
    let mut link: u64 = n[list].a;
    while link != 0u64 {
        let entry: u64 = link - 1u64;
        link = n[entry].next;
        if bare_empty(n, entry) {
            bad = true;
        }
    }
    if !bad {
        return out;
    }
    invalid(out, n, st, kind, name, reason, NONE)
}

// ... if option field `field` is `Some("")`.
fn notes_empty(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, item: u64, field: u64, kind: Slice<u8>, name: u64) -> Buffer<u8> {
    let notes: u64 = fld(n, sl, item, field);
    if n[notes].kind != V_STRING || !bare_empty(n, notes) {
        return out;
    }
    invalid(out, n, st, kind, name, "notes must not be empty".as_slice(), NONE)
}

// The last element of `list` whose field `field` is `name`, or NONE.
fn find_last(n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, list: u64, field: u64, name: u64) -> u64 {
    let mut found: u64 = NONE;
    let mut link: u64 = n[list].a;
    while link != 0u64 {
        let item: u64 = link - 1u64;
        link = n[item].next;
        if same_text(n, st, fld(n, sl, item, field), name) {
            found = item;
        }
    }
    found
}

// Whether fields `first` to `first + count - 1` hold the words of the
// runtime boundary: network denied, external_execution disabled, secret and
// key material denied, execution disabled, security_claims none.
fn boundaries_closed(n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, item: u64, network: u64, external: u64, secret: u64, key: u64, execution: u64, claims: u64) -> bool {
    text_is(n, st, fld(n, sl, item, network), "denied".as_slice()) && text_is(n, st, fld(n, sl, item, external), "disabled".as_slice()) && text_is(n, st, fld(n, sl, item, secret), "denied".as_slice()) && text_is(n, st, fld(n, sl, item, key), "denied".as_slice()) && text_is(n, st, fld(n, sl, item, execution), "disabled".as_slice()) && text_is(n, st, fld(n, sl, item, claims), "none".as_slice())
}

fn validate_evidence_maps(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let maps: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__ATRUST_EVIDENCE_MAPS);
    let mut link: u64 = n[maps].a;
    while link != 0u64 {
        let map: u64 = link - 1u64;
        link = n[map].next;
        let name: u64 = fld(n, sl, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__NAME);
        if seen_before(n, sl, st, maps, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__NAME, map, name) {
            o = named(o, n, st, "duplicate atrust_evidence_map ".as_slice(), name, "".as_slice());
        }
        o = filled(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__AGENT, "atrust_evidence_map".as_slice(), name, "missing required field `agent`".as_slice());
        o = filled(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__PASSPORT, "atrust_evidence_map".as_slice(), name, "missing required field `passport`".as_slice());
        o = filled(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__IDENTITY, "atrust_evidence_map".as_slice(), name, "missing required field `identity`".as_slice());
        o = filled(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__CREDENTIAL_CONTRACT, "atrust_evidence_map".as_slice(), name, "missing required field `credential_contract`".as_slice());
        o = filled(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__HANDSHAKE, "atrust_evidence_map".as_slice(), name, "missing required field `handshake`".as_slice());
        o = filled(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__TRUST_LEDGER, "atrust_evidence_map".as_slice(), name, "missing required field `trust_ledger`".as_slice());
        o = nonempty(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__MCP_BRIDGES, "atrust_evidence_map".as_slice(), name, "missing required field `mcp_bridges`".as_slice());
        o = any_blank_field(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__MCP_BRIDGES, "atrust_evidence_map".as_slice(), name, "`mcp_bridges` must not contain empty strings".as_slice());
        o = nonempty(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__A2A_BRIDGES, "atrust_evidence_map".as_slice(), name, "missing required field `a2a_bridges`".as_slice());
        o = any_blank_field(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__A2A_BRIDGES, "atrust_evidence_map".as_slice(), name, "`a2a_bridges` must not contain empty strings".as_slice());
        o = nonempty(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__POLICIES, "atrust_evidence_map".as_slice(), name, "missing required field `policies`".as_slice());
        o = any_blank_field(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__POLICIES, "atrust_evidence_map".as_slice(), name, "`policies` must not contain empty strings".as_slice());
        o = nonempty(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__PURPOSE, "atrust_evidence_map".as_slice(), name, "missing required field `purpose`".as_slice());
        o = any_blank_field(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__PURPOSE, "atrust_evidence_map".as_slice(), name, "`purpose` must not contain empty strings".as_slice());
        o = must(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__COVERAGE, "required complete".as_slice(), "atrust_evidence_map".as_slice(), name, "coverage must be required or complete".as_slice());
        o = must(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__MAPPING_MODE, "declared_only evidence_only".as_slice(), "atrust_evidence_map".as_slice(), name, "mapping_mode must be declared_only or evidence_only".as_slice());
        o = must(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__VERIFICATION, "declared_only disabled".as_slice(), "atrust_evidence_map".as_slice(), name, "verification must be declared_only or disabled".as_slice());
        o = must(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__RESOLUTION, "disabled".as_slice(), "atrust_evidence_map".as_slice(), name, "resolution must be disabled".as_slice());
        o = must(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__EVIDENCE_BUNDLE, "required".as_slice(), "atrust_evidence_map".as_slice(), name, "evidence_bundle must be required".as_slice());
        o = must(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__SECURITY_REPORT, "required".as_slice(), "atrust_evidence_map".as_slice(), name, "security_report must be required".as_slice());
        o = must(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__TRACE, "required".as_slice(), "atrust_evidence_map".as_slice(), name, "trace must be required".as_slice());
        o = must(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__NETWORK, "denied".as_slice(), "atrust_evidence_map".as_slice(), name, "network must be denied".as_slice());
        o = must(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__EXTERNAL_EXECUTION, "disabled".as_slice(), "atrust_evidence_map".as_slice(), name, "external_execution must be disabled".as_slice());
        o = must(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__SECRET_MATERIAL, "denied".as_slice(), "atrust_evidence_map".as_slice(), name, "secret_material must be denied".as_slice());
        o = must(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__KEY_MATERIAL, "denied".as_slice(), "atrust_evidence_map".as_slice(), name, "key_material must be denied".as_slice());
        o = must(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__EXECUTION, "disabled".as_slice(), "atrust_evidence_map".as_slice(), name, "execution must be disabled".as_slice());
        o = must(o, n, sl, st, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__SECURITY_CLAIMS, "none".as_slice(), "atrust_evidence_map".as_slice(), name, "security_claims must be none".as_slice());
        let notes: u64 = fld(n, sl, map, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__NOTES);
        if n[notes].kind == V_STRING && blank(n, st, notes) {
            o = invalid(o, n, st, "atrust_evidence_map".as_slice(), name, "notes must not be empty".as_slice(), NONE);
        }
    }
    o
}

fn validate_governance(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let profiles: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__GOVERNANCE_PROFILES);
    let maps: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__ATRUST_EVIDENCE_MAPS);
    let ledgers: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__TRUST_LEDGERS);
    let policies: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__POLICIES);
    let mut link: u64 = n[profiles].a;
    while link != 0u64 {
        let profile: u64 = link - 1u64;
        link = n[profile].next;
        let name: u64 = fld(n, sl, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__NAME);
        if seen_before(n, sl, st, profiles, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__NAME, profile, name) {
            o = named(o, n, st, "duplicate governance_profile ".as_slice(), name, "".as_slice());
        }
        o = filled(o, n, sl, st, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__NAME, "governance_profile".as_slice(), name, "name must not be empty".as_slice());
        o = filled(o, n, sl, st, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__OWNER, "governance_profile".as_slice(), name, "owner must not be empty".as_slice());
        o = filled(o, n, sl, st, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__JURISDICTION, "governance_profile".as_slice(), name, "jurisdiction must not be empty".as_slice());
        o = filled(o, n, sl, st, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__FRAMEWORK, "governance_profile".as_slice(), name, "framework must not be empty".as_slice());
        o = filled(o, n, sl, st, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__EVIDENCE_MAP, "governance_profile".as_slice(), name, "evidence_map must not be empty".as_slice());
        o = filled(o, n, sl, st, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__TRUST_LEDGER, "governance_profile".as_slice(), name, "trust_ledger must not be empty".as_slice());
        o = must(o, n, sl, st, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__SCOPE, "agent system package organization".as_slice(), "governance_profile".as_slice(), name, "invalid scope".as_slice());
        o = must(o, n, sl, st, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__LEVEL, "baseline audit regulated experimental".as_slice(), "governance_profile".as_slice(), name, "invalid level".as_slice());
        o = must(o, n, sl, st, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__DOMAIN, "ai_agent security compliance privacy safety custom".as_slice(), "governance_profile".as_slice(), name, "invalid domain".as_slice());
        if !list_has(n, sl, st, maps, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__NAME, fld(n, sl, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__EVIDENCE_MAP)) {
            o = invalid(o, n, st, "governance_profile".as_slice(), name, "unknown evidence_map".as_slice(), NONE);
        }
        if !list_has(n, sl, st, ledgers, agent_bytecode_schema.BS_TRUST_LEDGER__NAME, fld(n, sl, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__TRUST_LEDGER)) {
            o = invalid(o, n, st, "governance_profile".as_slice(), name, "unknown trust_ledger".as_slice(), NONE);
        }
        let profile_policies: u64 = fld(n, sl, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__POLICIES);
        let mut bad: bool = is_empty(n, profile_policies);
        let mut policy_link: u64 = n[profile_policies].a;
        while policy_link != 0u64 {
            let policy: u64 = policy_link - 1u64;
            policy_link = n[policy].next;
            if bare_empty(n, policy) || !list_has(n, sl, st, policies, agent_bytecode_schema.BS_POLICY__NAME, policy) {
                bad = true;
            }
        }
        if bad {
            o = invalid(o, n, st, "governance_profile".as_slice(), name, "policies must be non-empty and reference declared policies".as_slice(), NONE);
        }
        let controls: u64 = fld(n, sl, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__CONTROLS);
        o = nonempty(o, n, sl, st, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__CONTROLS, "governance_profile".as_slice(), name, "controls must not be empty".as_slice());
        let mut control_link: u64 = n[controls].a;
        while control_link != 0u64 {
            let control: u64 = control_link - 1u64;
            control_link = n[control].next;
            if seen_before(n, sl, st, controls, agent_bytecode_schema.BS_GOVERNANCE_CONTROL__ID, control, fld(n, sl, control, agent_bytecode_schema.BS_GOVERNANCE_CONTROL__ID)) {
                o = invalid(o, n, st, "governance_profile".as_slice(), name, "duplicate control id".as_slice(), NONE);
            }
            if blank(n, st, fld(n, sl, control, agent_bytecode_schema.BS_GOVERNANCE_CONTROL__ID)) || blank(n, st, fld(n, sl, control, agent_bytecode_schema.BS_GOVERNANCE_CONTROL__REQUIREMENT)) || blank(n, st, fld(n, sl, control, agent_bytecode_schema.BS_GOVERNANCE_CONTROL__EVIDENCE_REF)) {
                o = invalid(o, n, st, "governance_profile".as_slice(), name, "control fields must not be empty".as_slice(), NONE);
            }
            o = must(o, n, sl, st, control, agent_bytecode_schema.BS_GOVERNANCE_CONTROL__CATEGORY, "identity credential handshake ledger bridge evidence runtime_boundary policy security privacy safety compliance custom".as_slice(), "governance_profile".as_slice(), name, "invalid control category".as_slice());
            o = must(o, n, sl, st, control, agent_bytecode_schema.BS_GOVERNANCE_CONTROL__STATUS, "mapped declared pending_review not_applicable".as_slice(), "governance_profile".as_slice(), name, "invalid control status".as_slice());
        }
        o = must(o, n, sl, st, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__RISK_LEVEL, "low moderate high critical unknown".as_slice(), "governance_profile".as_slice(), name, "invalid risk_level".as_slice());
        o = must(o, n, sl, st, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__REVIEW_STATUS, "draft reviewed approved_internal deprecated".as_slice(), "governance_profile".as_slice(), name, "invalid review_status".as_slice());
        o = must(o, n, sl, st, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__ASSURANCE, "declared_only evidence_mapped manually_reviewed".as_slice(), "governance_profile".as_slice(), name, "invalid assurance".as_slice());
        if !boundaries_closed(n, sl, st, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__NETWORK, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__EXTERNAL_EXECUTION, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__SECRET_MATERIAL, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__KEY_MATERIAL, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__EXECUTION, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__SECURITY_CLAIMS) {
            o = invalid(o, n, st, "governance_profile".as_slice(), name, "runtime boundaries must remain denied/disabled and security_claims none".as_slice(), NONE);
        }
        o = nonempty_strict(o, n, sl, st, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__PURPOSE, "governance_profile".as_slice(), name, "purpose must not be empty".as_slice());
        o = notes_empty(o, n, sl, st, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__NOTES, "governance_profile".as_slice(), name);
    }
    o
}

fn validate_regulatory(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let mappings: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__REGULATORY_MAPPINGS);
    let profiles: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__GOVERNANCE_PROFILES);
    let maps: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__ATRUST_EVIDENCE_MAPS);
    let mut link: u64 = n[mappings].a;
    while link != 0u64 {
        let mapping: u64 = link - 1u64;
        link = n[mapping].next;
        let name: u64 = fld(n, sl, mapping, agent_bytecode_schema.BS_REGULATORY_MAPPING__NAME);
        if seen_before(n, sl, st, mappings, agent_bytecode_schema.BS_REGULATORY_MAPPING__NAME, mapping, name) {
            o = named(o, n, st, "duplicate regulatory_mapping ".as_slice(), name, "".as_slice());
        }
        let profile: u64 = find_last(n, sl, st, profiles, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__NAME, fld(n, sl, mapping, agent_bytecode_schema.BS_REGULATORY_MAPPING__GOVERNANCE_PROFILE));
        if profile == NONE {
            o = invalid(o, n, st, "regulatory_mapping".as_slice(), name, "unknown governance_profile".as_slice(), NONE);
        }
        let evidence_map: u64 = fld(n, sl, mapping, agent_bytecode_schema.BS_REGULATORY_MAPPING__EVIDENCE_MAP);
        if !list_has(n, sl, st, maps, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__NAME, evidence_map) {
            o = invalid(o, n, st, "regulatory_mapping".as_slice(), name, "unknown evidence_map".as_slice(), NONE);
        }
        if profile != NONE && !same_text(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__EVIDENCE_MAP), evidence_map) {
            o = invalid(o, n, st, "regulatory_mapping".as_slice(), name, "evidence_map does not match governance_profile".as_slice(), NONE);
        }
        if blank(n, st, fld(n, sl, mapping, agent_bytecode_schema.BS_REGULATORY_MAPPING__JURISDICTION)) || blank(n, st, fld(n, sl, mapping, agent_bytecode_schema.BS_REGULATORY_MAPPING__FRAMEWORK)) {
            o = invalid(o, n, st, "regulatory_mapping".as_slice(), name, "jurisdiction and framework must not be empty".as_slice(), NONE);
        }
        let obligations: u64 = fld(n, sl, mapping, agent_bytecode_schema.BS_REGULATORY_MAPPING__OBLIGATIONS);
        o = nonempty(o, n, sl, st, mapping, agent_bytecode_schema.BS_REGULATORY_MAPPING__OBLIGATIONS, "regulatory_mapping".as_slice(), name, "obligations must not be empty".as_slice());
        let mut obligation_link: u64 = n[obligations].a;
        while obligation_link != 0u64 {
            let obligation: u64 = obligation_link - 1u64;
            obligation_link = n[obligation].next;
            let id: u64 = fld(n, sl, obligation, agent_bytecode_schema.BS_REGULATORY_OBLIGATION__ID);
            if seen_before(n, sl, st, obligations, agent_bytecode_schema.BS_REGULATORY_OBLIGATION__ID, obligation, id) {
                o = invalid(o, n, st, "regulatory_mapping".as_slice(), name, "duplicate obligation id".as_slice(), NONE);
            }
            let control: u64 = fld(n, sl, obligation, agent_bytecode_schema.BS_REGULATORY_OBLIGATION__CONTROL);
            if blank(n, st, id) || blank(n, st, fld(n, sl, obligation, agent_bytecode_schema.BS_REGULATORY_OBLIGATION__SOURCE)) || blank(n, st, fld(n, sl, obligation, agent_bytecode_schema.BS_REGULATORY_OBLIGATION__REQUIREMENT)) || blank(n, st, control) || blank(n, st, fld(n, sl, obligation, agent_bytecode_schema.BS_REGULATORY_OBLIGATION__EVIDENCE_REF)) {
                o = invalid(o, n, st, "regulatory_mapping".as_slice(), name, "obligation fields must not be empty".as_slice(), NONE);
            }
            let known: bool = profile != NONE && list_has(n, sl, st, fld(n, sl, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__CONTROLS), agent_bytecode_schema.BS_GOVERNANCE_CONTROL__ID, control);
            if !known {
                o = invalid(o, n, st, "regulatory_mapping".as_slice(), name, "obligation references unknown control".as_slice(), NONE);
            }
            o = must(o, n, sl, st, obligation, agent_bytecode_schema.BS_REGULATORY_OBLIGATION__STATUS, "mapped pending_review gap not_applicable".as_slice(), "regulatory_mapping".as_slice(), name, "invalid obligation status".as_slice());
        }
        o = must(o, n, sl, st, mapping, agent_bytecode_schema.BS_REGULATORY_MAPPING__COVERAGE, "mapped partial pending_review".as_slice(), "regulatory_mapping".as_slice(), name, "invalid coverage".as_slice());
        o = must(o, n, sl, st, mapping, agent_bytecode_schema.BS_REGULATORY_MAPPING__ASSESSMENT, "declared_only evidence_mapped manual_review_required".as_slice(), "regulatory_mapping".as_slice(), name, "invalid assessment".as_slice());
        if !text_is(n, st, fld(n, sl, mapping, agent_bytecode_schema.BS_REGULATORY_MAPPING__LEGAL_CLAIMS), "none".as_slice()) || !text_is(n, st, fld(n, sl, mapping, agent_bytecode_schema.BS_REGULATORY_MAPPING__CERTIFICATION), "none".as_slice()) {
            o = invalid(o, n, st, "regulatory_mapping".as_slice(), name, "legal_claims and certification must be none".as_slice(), NONE);
        }
        if !boundaries_closed(n, sl, st, mapping, agent_bytecode_schema.BS_REGULATORY_MAPPING__NETWORK, agent_bytecode_schema.BS_REGULATORY_MAPPING__EXTERNAL_EXECUTION, agent_bytecode_schema.BS_REGULATORY_MAPPING__SECRET_MATERIAL, agent_bytecode_schema.BS_REGULATORY_MAPPING__KEY_MATERIAL, agent_bytecode_schema.BS_REGULATORY_MAPPING__EXECUTION, agent_bytecode_schema.BS_REGULATORY_MAPPING__SECURITY_CLAIMS) {
            o = invalid(o, n, st, "regulatory_mapping".as_slice(), name, "runtime boundaries must remain denied/disabled and security_claims none".as_slice(), NONE);
        }
        o = nonempty_strict(o, n, sl, st, mapping, agent_bytecode_schema.BS_REGULATORY_MAPPING__PURPOSE, "regulatory_mapping".as_slice(), name, "purpose must not be empty".as_slice());
        o = notes_empty(o, n, sl, st, mapping, agent_bytecode_schema.BS_REGULATORY_MAPPING__NOTES, "regulatory_mapping".as_slice(), name);
    }
    o
}

fn validate_third_party_verifiers(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let items: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__THIRD_PARTY_VERIFIERS);
    let mut link: u64 = n[items].a;
    while link != 0u64 {
        let v: u64 = link - 1u64;
        link = n[v].next;
        let name: u64 = fld(n, sl, v, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__NAME);
        if seen_before(n, sl, st, items, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__NAME, v, name) {
            o = named(o, n, st, "duplicate third_party_verifier ".as_slice(), name, "".as_slice());
        }
        o = must(o, n, sl, st, v, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__VERIFIER_TYPE, "internal community academic vendor independent_lab custom".as_slice(), "third_party_verifier".as_slice(), name, "invalid verifier_type".as_slice());
        o = must(o, n, sl, st, v, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__INDEPENDENCE, "declared self_attested independent_declared".as_slice(), "third_party_verifier".as_slice(), name, "invalid independence".as_slice());
        o = must(o, n, sl, st, v, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__IDENTITY_MODE, "declared_only document_only".as_slice(), "third_party_verifier".as_slice(), name, "invalid identity_mode".as_slice());
        o = must(o, n, sl, st, v, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__VERIFICATION_MODE, "reproducible_artifacts document_review conformance_replay".as_slice(), "third_party_verifier".as_slice(), name, "invalid verification_mode".as_slice());
        if blank(n, st, fld(n, sl, v, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__DISPLAY_NAME)) || blank(n, st, fld(n, sl, v, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__ORGANIZATION)) || blank(n, st, fld(n, sl, v, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__JURISDICTION)) {
            o = invalid(o, n, st, "third_party_verifier".as_slice(), name, "identity metadata must not be empty".as_slice(), NONE);
        }
        if is_empty(n, fld(n, sl, v, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__ALLOWED_SCOPES)) || any_empty(n, fld(n, sl, v, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__ALLOWED_SCOPES)) || is_empty(n, fld(n, sl, v, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__DISALLOWED_CLAIMS)) || any_empty(n, fld(n, sl, v, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__DISALLOWED_CLAIMS)) || is_empty(n, fld(n, sl, v, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__PURPOSE)) || any_empty(n, fld(n, sl, v, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__PURPOSE)) {
            o = invalid(o, n, st, "third_party_verifier".as_slice(), name, "scope, disallowed claims, and purpose must not be empty".as_slice(), NONE);
        }
        if !boundaries_closed(n, sl, st, v, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__NETWORK, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__EXTERNAL_EXECUTION, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__SECRET_MATERIAL, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__KEY_MATERIAL, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__EXECUTION, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__SECURITY_CLAIMS) || !text_is(n, st, fld(n, sl, v, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__LEGAL_CLAIMS), "none".as_slice()) || !text_is(n, st, fld(n, sl, v, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__CERTIFICATION), "none".as_slice()) {
            o = invalid(o, n, st, "third_party_verifier".as_slice(), name, "runtime, legal, certification, and security claims must remain denied".as_slice(), NONE);
        }
        o = notes_empty(o, n, sl, st, v, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__NOTES, "third_party_verifier".as_slice(), name);
    }
    o
}

fn validate_public_conformance_reports(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let items: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__PUBLIC_CONFORMANCE_REPORTS);
    let verifiers: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__THIRD_PARTY_VERIFIERS);
    let profiles: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__GOVERNANCE_PROFILES);
    let mappings: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__REGULATORY_MAPPINGS);
    let maps: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__ATRUST_EVIDENCE_MAPS);
    let ledgers: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__TRUST_LEDGERS);
    let mut link: u64 = n[items].a;
    while link != 0u64 {
        let report: u64 = link - 1u64;
        link = n[report].next;
        let name: u64 = fld(n, sl, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__NAME);
        if seen_before(n, sl, st, items, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__NAME, report, name) {
            o = named(o, n, st, "duplicate public_conformance_report ".as_slice(), name, "".as_slice());
        }
        let evidence_map: u64 = fld(n, sl, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__EVIDENCE_MAP);
        let profile_name: u64 = fld(n, sl, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__GOVERNANCE_PROFILE);
        let mapping_name: u64 = fld(n, sl, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__REGULATORY_MAPPING);
        let profile: u64 = find_last(n, sl, st, profiles, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__NAME, profile_name);
        let mapping: u64 = find_last(n, sl, st, mappings, agent_bytecode_schema.BS_REGULATORY_MAPPING__NAME, mapping_name);
        if !list_has(n, sl, st, verifiers, agent_bytecode_schema.BS_THIRD_PARTY_VERIFIER__NAME, fld(n, sl, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__VERIFIER)) {
            o = invalid(o, n, st, "public_conformance_report".as_slice(), name, "unknown third_party_verifier".as_slice(), NONE);
        }
        if !list_has(n, sl, st, maps, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__NAME, evidence_map) {
            o = invalid(o, n, st, "public_conformance_report".as_slice(), name, "unknown evidence_map".as_slice(), NONE);
        }
        if profile == NONE { o = invalid(o, n, st, "public_conformance_report".as_slice(), name, "unknown governance_profile".as_slice(), NONE); }
        if mapping == NONE { o = invalid(o, n, st, "public_conformance_report".as_slice(), name, "unknown regulatory_mapping".as_slice(), NONE); }
        if !list_has(n, sl, st, ledgers, agent_bytecode_schema.BS_TRUST_LEDGER__NAME, fld(n, sl, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__TRUST_LEDGER)) {
            o = invalid(o, n, st, "public_conformance_report".as_slice(), name, "unknown trust_ledger".as_slice(), NONE);
        }
        if profile != NONE && !same_text(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__EVIDENCE_MAP), evidence_map) {
            o = invalid(o, n, st, "public_conformance_report".as_slice(), name, "governance/evidence_map mismatch".as_slice(), NONE);
        }
        if mapping != NONE && !same_text(n, st, fld(n, sl, mapping, agent_bytecode_schema.BS_REGULATORY_MAPPING__GOVERNANCE_PROFILE), profile_name) {
            o = invalid(o, n, st, "public_conformance_report".as_slice(), name, "regulatory/governance mismatch".as_slice(), NONE);
        }
        if mapping != NONE && !same_text(n, st, fld(n, sl, mapping, agent_bytecode_schema.BS_REGULATORY_MAPPING__EVIDENCE_MAP), evidence_map) {
            o = invalid(o, n, st, "public_conformance_report".as_slice(), name, "regulatory/evidence_map mismatch".as_slice(), NONE);
        }
        if blank(n, st, fld(n, sl, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__SUITE)) || !text_is(n, st, fld(n, sl, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__SUITE_VERSION), "0.34".as_slice()) || blank(n, st, fld(n, sl, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__SOURCE_ARTIFACT)) || blank(n, st, fld(n, sl, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__BYTECODE_ARTIFACT)) {
            o = invalid(o, n, st, "public_conformance_report".as_slice(), name, "suite and artifacts must be non-empty and suite_version 0.34".as_slice(), NONE);
        }
        if !one_of(n, st, fld(n, sl, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__RESULT), "passed failed pending_review".as_slice()) || !one_of(n, st, fld(n, sl, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__REPRODUCIBILITY), "declared replayable_locally document_only".as_slice()) || !one_of(n, st, fld(n, sl, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__REVIEW_STATUS), "draft reviewed published deprecated".as_slice()) {
            o = invalid(o, n, st, "public_conformance_report".as_slice(), name, "invalid result, reproducibility, or review_status".as_slice(), NONE);
        }
        if !text_is(n, st, fld(n, sl, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__SECURITY_REPORT), "required".as_slice()) || !text_is(n, st, fld(n, sl, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__EVIDENCE_BUNDLE), "required".as_slice()) || !text_is(n, st, fld(n, sl, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__TRACE), "required".as_slice()) {
            o = invalid(o, n, st, "public_conformance_report".as_slice(), name, "security_report, evidence_bundle, and trace must be required".as_slice(), NONE);
        }
        let claims: u64 = fld(n, sl, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__CLAIMS);
        if is_empty(n, claims) { o = invalid(o, n, st, "public_conformance_report".as_slice(), name, "claims must not be empty".as_slice(), NONE); }
        let mut claim_link: u64 = n[claims].a;
        while claim_link != 0u64 {
            let claim: u64 = claim_link - 1u64;
            claim_link = n[claim].next;
            let id: u64 = fld(n, sl, claim, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_CLAIM__ID);
            if seen_before(n, sl, st, claims, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_CLAIM__ID, claim, id) {
                o = invalid(o, n, st, "public_conformance_report".as_slice(), name, "duplicate claim id".as_slice(), NONE);
            }
            if bare_empty(n, id) || bare_empty(n, fld(n, sl, claim, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_CLAIM__STATEMENT)) || bare_empty(n, fld(n, sl, claim, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_CLAIM__EVIDENCE_REF)) {
                o = invalid(o, n, st, "public_conformance_report".as_slice(), name, "claim fields must not be empty".as_slice(), NONE);
            }
            if !one_of(n, st, fld(n, sl, claim, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_CLAIM__CATEGORY), "conformance evidence security_report governance regulatory_mapping bytecode source policy runtime_boundary custom".as_slice()) || !one_of(n, st, fld(n, sl, claim, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_CLAIM__STATUS), "mapped declared pending_review not_applicable".as_slice()) {
                o = invalid(o, n, st, "public_conformance_report".as_slice(), name, "invalid claim category or status".as_slice(), NONE);
            }
        }
        if !boundaries_closed(n, sl, st, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__NETWORK, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__EXTERNAL_EXECUTION, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__SECRET_MATERIAL, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__KEY_MATERIAL, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__EXECUTION, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__SECURITY_CLAIMS) || !text_is(n, st, fld(n, sl, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__LEGAL_CLAIMS), "none".as_slice()) || !text_is(n, st, fld(n, sl, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__CERTIFICATION), "none".as_slice()) {
            o = invalid(o, n, st, "public_conformance_report".as_slice(), name, "runtime, legal, certification, and security claims must remain denied".as_slice(), NONE);
        }
        if is_empty(n, fld(n, sl, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__PURPOSE)) || any_empty(n, fld(n, sl, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__PURPOSE)) {
            o = invalid(o, n, st, "public_conformance_report".as_slice(), name, "purpose must not be empty".as_slice(), NONE);
        }
        o = notes_empty(o, n, sl, st, report, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__NOTES, "public_conformance_report".as_slice(), name);
    }
    o
}

fn validate_runtime_hardening_profiles(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let items: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__RUNTIME_HARDENING_PROFILES);
    let maps: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__ATRUST_EVIDENCE_MAPS);
    let governance: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__GOVERNANCE_PROFILES);
    let reports: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__PUBLIC_CONFORMANCE_REPORTS);
    let mut link: u64 = n[items].a;
    while link != 0u64 {
        let profile: u64 = link - 1u64;
        link = n[profile].next;
        let name: u64 = fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__NAME);
        if seen_before(n, sl, st, items, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__NAME, profile, name) {
            o = named(o, n, st, "duplicate runtime_hardening_profile ".as_slice(), name, "".as_slice());
        }
        o = must(o, n, sl, st, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__SCOPE, "agent system package organization".as_slice(), "runtime_hardening_profile".as_slice(), name, "invalid scope".as_slice());
        o = must(o, n, sl, st, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__MODE, "declared_only evidence_only".as_slice(), "runtime_hardening_profile".as_slice(), name, "invalid mode".as_slice());
        o = must(o, n, sl, st, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__ENFORCEMENT, "declared_only evidence_only".as_slice(), "runtime_hardening_profile".as_slice(), name, "invalid enforcement".as_slice());
        o = must(o, n, sl, st, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__SANDBOX, "required declared".as_slice(), "runtime_hardening_profile".as_slice(), name, "invalid sandbox".as_slice());
        o = must(o, n, sl, st, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__ALLOWLIST, "required declared".as_slice(), "runtime_hardening_profile".as_slice(), name, "invalid allowlist".as_slice());
        o = must(o, n, sl, st, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__APPROVAL, "required declared".as_slice(), "runtime_hardening_profile".as_slice(), name, "invalid approval".as_slice());
        o = must(o, n, sl, st, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__INCIDENT_RESPONSE, "declared required".as_slice(), "runtime_hardening_profile".as_slice(), name, "invalid incident_response".as_slice());
        o = must(o, n, sl, st, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__RESIDUAL_RISK, "low moderate high critical unknown".as_slice(), "runtime_hardening_profile".as_slice(), name, "invalid residual_risk".as_slice());
        o = must(o, n, sl, st, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__REVIEW_STATUS, "draft reviewed approved_internal deprecated".as_slice(), "runtime_hardening_profile".as_slice(), name, "invalid review_status".as_slice());
        o = must(o, n, sl, st, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__ASSURANCE, "declared_only evidence_mapped manually_reviewed".as_slice(), "runtime_hardening_profile".as_slice(), name, "invalid assurance".as_slice());
        if !text_is(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__PROVIDER_EXECUTION), "disabled".as_slice()) || !text_is(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__EXTERNAL_PROVIDERS), "disabled".as_slice()) || !text_is(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__NETWORK), "denied".as_slice()) || !text_is(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__TOOL_EXECUTION), "disabled".as_slice()) || !text_is(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__AGENT_EXECUTION), "disabled".as_slice()) || !text_is(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__FILESYSTEM_ACCESS), "denied".as_slice()) || !text_is(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__ENV_ACCESS), "denied".as_slice()) || !text_is(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__SECRET_MATERIAL), "denied".as_slice()) || !text_is(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__KEY_MATERIAL), "denied".as_slice()) || n[fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__DENY_BY_DEFAULT)].a == 0u64 || !text_is(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__AUDIT_LOG), "required".as_slice()) || !text_is(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__EVIDENCE), "required".as_slice()) || !text_is(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__SECURITY_CLAIMS), "none".as_slice()) {
            o = invalid(o, n, st, "runtime_hardening_profile".as_slice(), name, "runtime boundaries must remain denied, disabled, required, and deny-by-default".as_slice(), NONE);
        }
        if !list_has(n, sl, st, maps, agent_bytecode_schema.BS_A_TRUST_EVIDENCE_MAP__NAME, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__EVIDENCE_MAP)) || !list_has(n, sl, st, governance, agent_bytecode_schema.BS_GOVERNANCE_PROFILE__NAME, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__GOVERNANCE_PROFILE)) || !list_has(n, sl, st, reports, agent_bytecode_schema.BS_PUBLIC_CONFORMANCE_REPORT__NAME, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__PUBLIC_CONFORMANCE_REPORT)) {
            o = invalid(o, n, st, "runtime_hardening_profile".as_slice(), name, "unknown evidence, governance, or public conformance binding".as_slice(), NONE);
        }
        if is_empty(n, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__PROTECTED_ASSETS)) || any_empty(n, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__PROTECTED_ASSETS)) || is_empty(n, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__RUNTIME_BOUNDARIES)) || any_empty(n, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__RUNTIME_BOUNDARIES)) || is_empty(n, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__PURPOSE)) || any_empty(n, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__PURPOSE)) {
            o = invalid(o, n, st, "runtime_hardening_profile".as_slice(), name, "protected assets, runtime boundaries, and purpose must not be empty".as_slice(), NONE);
        }
        o = notes_empty(o, n, sl, st, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__NOTES, "runtime_hardening_profile".as_slice(), name);
    }
    o
}

fn validate_threat_models(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, p: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let items: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__THREAT_MODELS);
    let profiles: u64 = list_of(n, sl, p, agent_bytecode_schema.BS_PROGRAM__RUNTIME_HARDENING_PROFILES);
    let mut link: u64 = n[items].a;
    while link != 0u64 {
        let model: u64 = link - 1u64;
        link = n[model].next;
        let name: u64 = fld(n, sl, model, agent_bytecode_schema.BS_THREAT_MODEL__NAME);
        if seen_before(n, sl, st, items, agent_bytecode_schema.BS_THREAT_MODEL__NAME, model, name) {
            o = named(o, n, st, "duplicate threat_model ".as_slice(), name, "".as_slice());
        }
        let profile: u64 = find_last(n, sl, st, profiles, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__NAME, fld(n, sl, model, agent_bytecode_schema.BS_THREAT_MODEL__HARDENING_PROFILE));
        if profile == NONE {
            o = invalid(o, n, st, "threat_model".as_slice(), name, "unknown runtime_hardening_profile".as_slice(), NONE);
        } else if !same_text(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__EVIDENCE_MAP), fld(n, sl, model, agent_bytecode_schema.BS_THREAT_MODEL__EVIDENCE_MAP)) || !same_text(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__GOVERNANCE_PROFILE), fld(n, sl, model, agent_bytecode_schema.BS_THREAT_MODEL__GOVERNANCE_PROFILE)) || !same_text(n, st, fld(n, sl, profile, agent_bytecode_schema.BS_RUNTIME_HARDENING_PROFILE__PUBLIC_CONFORMANCE_REPORT), fld(n, sl, model, agent_bytecode_schema.BS_THREAT_MODEL__PUBLIC_CONFORMANCE_REPORT)) {
            o = invalid(o, n, st, "threat_model".as_slice(), name, "hardening references mismatch".as_slice(), NONE);
        }
        o = must(o, n, sl, st, model, agent_bytecode_schema.BS_THREAT_MODEL__METHODOLOGY, "declared structured internal_review".as_slice(), "threat_model".as_slice(), name, "invalid methodology".as_slice());
        o = must(o, n, sl, st, model, agent_bytecode_schema.BS_THREAT_MODEL__SCOPE, "agent system package organization".as_slice(), "threat_model".as_slice(), name, "invalid scope".as_slice());
        o = must(o, n, sl, st, model, agent_bytecode_schema.BS_THREAT_MODEL__REVIEW_STATUS, "draft reviewed approved_internal deprecated".as_slice(), "threat_model".as_slice(), name, "invalid review_status".as_slice());
        o = must(o, n, sl, st, model, agent_bytecode_schema.BS_THREAT_MODEL__RESIDUAL_RISK, "low moderate high critical unknown".as_slice(), "threat_model".as_slice(), name, "invalid residual_risk".as_slice());
        o = must(o, n, sl, st, model, agent_bytecode_schema.BS_THREAT_MODEL__RISK_ACCEPTANCE, "declared_only pending_review manually_reviewed".as_slice(), "threat_model".as_slice(), name, "invalid risk_acceptance".as_slice());
        if !text_is(n, st, fld(n, sl, model, agent_bytecode_schema.BS_THREAT_MODEL__NETWORK), "denied".as_slice()) || !text_is(n, st, fld(n, sl, model, agent_bytecode_schema.BS_THREAT_MODEL__EXTERNAL_EXECUTION), "disabled".as_slice()) || !text_is(n, st, fld(n, sl, model, agent_bytecode_schema.BS_THREAT_MODEL__TOOL_EXECUTION), "disabled".as_slice()) || !text_is(n, st, fld(n, sl, model, agent_bytecode_schema.BS_THREAT_MODEL__AGENT_EXECUTION), "disabled".as_slice()) || !text_is(n, st, fld(n, sl, model, agent_bytecode_schema.BS_THREAT_MODEL__SECRET_MATERIAL), "denied".as_slice()) || !text_is(n, st, fld(n, sl, model, agent_bytecode_schema.BS_THREAT_MODEL__KEY_MATERIAL), "denied".as_slice()) || !text_is(n, st, fld(n, sl, model, agent_bytecode_schema.BS_THREAT_MODEL__EXECUTION), "disabled".as_slice()) || !text_is(n, st, fld(n, sl, model, agent_bytecode_schema.BS_THREAT_MODEL__SECURITY_CLAIMS), "none".as_slice()) {
            o = invalid(o, n, st, "threat_model".as_slice(), name, "threat model runtime and security boundaries must remain denied".as_slice(), NONE);
        }
        o = validate_threat_collections(o, n, sl, st, model, name);
        if is_empty(n, fld(n, sl, model, agent_bytecode_schema.BS_THREAT_MODEL__PURPOSE)) || any_empty(n, fld(n, sl, model, agent_bytecode_schema.BS_THREAT_MODEL__PURPOSE)) {
            o = invalid(o, n, st, "threat_model".as_slice(), name, "purpose must not be empty".as_slice(), NONE);
        }
        o = notes_empty(o, n, sl, st, model, agent_bytecode_schema.BS_THREAT_MODEL__NOTES, "threat_model".as_slice(), name);
    }
    o
}

fn validate_threat_collections(out: Buffer<u8>, n: Slice<Value>, sl: Slice<u64>, st: Slice<u8>, model: u64, name: u64) -> Buffer<u8> {
    let mut o: Buffer<u8> = out;
    let assets: u64 = fld(n, sl, model, agent_bytecode_schema.BS_THREAT_MODEL__ASSETS);
    let threats: u64 = fld(n, sl, model, agent_bytecode_schema.BS_THREAT_MODEL__THREATS);
    let mitigations: u64 = fld(n, sl, model, agent_bytecode_schema.BS_THREAT_MODEL__MITIGATIONS);
    if is_empty(n, assets) || is_empty(n, threats) || is_empty(n, mitigations) {
        o = invalid(o, n, st, "threat_model".as_slice(), name, "assets, threats, and mitigations must not be empty".as_slice(), NONE);
    }
    let mut link: u64 = n[assets].a;
    while link != 0u64 {
        let item: u64 = link - 1u64;
        link = n[item].next;
        let id: u64 = fld(n, sl, item, agent_bytecode_schema.BS_THREAT_ASSET__ID);
        if seen_before(n, sl, st, assets, agent_bytecode_schema.BS_THREAT_ASSET__ID, item, id) { o = invalid(o, n, st, "threat_model".as_slice(), name, "duplicate asset id".as_slice(), NONE); }
        if bare_empty(n, id) || bare_empty(n, fld(n, sl, item, agent_bytecode_schema.BS_THREAT_ASSET__DESCRIPTION)) || bare_empty(n, fld(n, sl, item, agent_bytecode_schema.BS_THREAT_ASSET__EVIDENCE_REF)) || !one_of(n, st, fld(n, sl, item, agent_bytecode_schema.BS_THREAT_ASSET__CATEGORY), "secret key identity credential handshake ledger bridge evidence policy runtime provider user_data custom".as_slice()) || !one_of(n, st, fld(n, sl, item, agent_bytecode_schema.BS_THREAT_ASSET__SENSITIVITY), "low moderate high critical unknown".as_slice()) { o = invalid(o, n, st, "threat_model".as_slice(), name, "invalid asset".as_slice(), NONE); }
    }
    link = n[threats].a;
    while link != 0u64 {
