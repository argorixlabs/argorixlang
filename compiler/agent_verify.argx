        let suites: u64 = fld(n, sl, freeze, agent_bytecode_schema.BS_SPEC_FREEZE__REQUIRED_SUITES);
        let notes: u64 = fld(n, sl, freeze, agent_bytecode_schema.BS_SPEC_FREEZE__NOTES);
