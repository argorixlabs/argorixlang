core 0.1;
module compiler.agent_check;

// The agent-language checker, in Argorix (ESP-018.C). It ports
// crates/argorix_semantics/src/checker.rs over the syntax tree of
// `compiler.agent_parser`, check by check and in stage0's order, and prints
// the canonical dump of spec/language/check.md: `ok`, or one line per
// diagnostic.
//
// The checks are ported one group of declarations at a time. A program that
// declares something whose checks are not ported yet dumps `unsupported`, so
// the differential can tell a gap from a mismatch.

import stdlib.bytes;
import compiler.agent_ast;
import compiler.agent_schema;
import compiler.agent_parser;

// The symbols stage0 collects: the names of each kind, as `Spanned<String>`
// nodes, and each capability's level (the last one declared wins).
struct Symbols {
    types: Buffer<u64>,
    enums: Buffer<u64>,
    agents: Buffer<u64>,
    tools: Buffer<u64>,
    models: Buffer<u64>,
    providers: Buffer<u64>,
    features: Buffer<u64>,
    secrets: Buffer<u64>,
    adapters: Buffer<u64>,
    adapter_profiles: Buffer<u64>,
    cryptos: Buffer<u64>,
    did_methods: Buffer<u64>,
    atrust_boundaries: Buffer<u64>,
    atrust_identities: Buffer<u64>,
    capabilities: Buffer<u64>,
    levels: Buffer<u64>,
    out: Buffer<u8>,
}

pub fn dump(source: Slice<u8>) -> Buffer<u8> {
    let parsed: Tree = agent_parser.parse(source);
    if parsed.failed || parsed.unsupported {
        return agent_parser.dump(source);
    }
    let program: u64 = parsed.result;
    if !ported(parsed.slots.as_slice(), parsed.nodes.as_slice(), program) {
        return bytes.copy("unsupported\n".as_slice());
    }
    let y: Symbols = check(parsed.slots.as_slice(), parsed.nodes.as_slice(), parsed.strings.as_slice(), program);
    if y.out.length() == 0u64 {
        return bytes.copy("ok\n".as_slice());
    }
    bytes.copy(y.out.as_slice())
}

// Whether every declaration of the program has its checks ported.
fn ported(sl: Slice<u64>, n: Slice<AgentNode>, program: u64) -> bool {
    let mut field: u64 = agent_schema.PROGRAM_PROVIDERS;
    while field < agent_schema.field_count(agent_schema.PROGRAM) {
        let core: bool = field == agent_schema.PROGRAM_IMPORTS || field == agent_schema.PROGRAM_PROVIDERS || field == agent_schema.PROGRAM_HARNESSES || field == agent_schema.PROGRAM_ADAPTERS || field == agent_schema.PROGRAM_ADAPTER_PROFILES || field == agent_schema.PROGRAM_FEATURES || field == agent_schema.PROGRAM_SECRETS || field == agent_schema.PROGRAM_CRYPTOS || field == agent_schema.PROGRAM_CRYPTO_BOUNDARIES || field == agent_schema.PROGRAM_DID_METHODS || field == agent_schema.PROGRAM_ASSERTIONS || field == agent_schema.PROGRAM_POLICIES || field == agent_schema.PROGRAM_FAILURES || field == agent_schema.PROGRAM_CAPABILITIES || field == agent_schema.PROGRAM_ENUMS || field == agent_schema.PROGRAM_TYPES || field == agent_schema.PROGRAM_TOOLS || field == agent_schema.PROGRAM_MODELS || field == agent_schema.PROGRAM_AGENTS || field == agent_schema.PROGRAM_PROTOCOLS;
        if !core && n[get(sl, n, program, field)].a != 0u64 {
            return false;
        }
        field += 1u64;
    }
    true
}

// ------------------------------------------------------------------ the checks

fn check(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64) -> Symbols {
    let mut y: Symbols = Symbols {
        types: Buffer::new(),
        enums: Buffer::new(),
        agents: Buffer::new(),
        tools: Buffer::new(),
        models: Buffer::new(),
        providers: Buffer::new(),
        features: Buffer::new(),
        secrets: Buffer::new(),
        adapters: Buffer::new(),
        adapter_profiles: Buffer::new(),
        cryptos: Buffer::new(),
        did_methods: Buffer::new(),
        atrust_boundaries: Buffer::new(),
        atrust_identities: Buffer::new(),
        capabilities: Buffer::new(),
        levels: Buffer::new(),
        out: Buffer::new(),
    };
    y = collect_symbols(sl, n, st, program, y);
    y = check_provider_contracts(sl, n, st, program, y);
    y = check_harnesses(sl, n, st, program, y);
    y = check_features(sl, n, st, program, y);
    y = check_secrets(sl, n, st, program, y);
    y = check_adapters(sl, n, st, program, y);
    y = check_adapter_profiles(sl, n, st, program, y);
    y = check_cryptos(sl, n, st, program, y);
    y = check_did_methods(sl, n, st, program, y);
    y = check_policies(sl, n, st, program, y);
    y = check_tools(sl, n, st, program, y);
    y = check_models(sl, n, st, program, y);
    y = check_types(sl, n, st, program, y);
    y = check_agents(sl, n, st, program, y);
    check_protocols(sl, n, st, program, y)
}

fn collect_symbols(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64, symbols: Symbols) -> Symbols {
    let mut y: Symbols = symbols;
    let mut link: u64 = first(sl, n, program, agent_schema.PROGRAM_PROVIDERS);
    while link != 0u64 {
        y.providers.push(get(sl, n, link - 1u64, 0u64));
        link = n[link - 1u64].next;
    }
    link = first(sl, n, program, agent_schema.PROGRAM_TYPES);
    while link != 0u64 {
        let name: u64 = get(sl, n, link - 1u64, agent_schema.TYPE_DECL_NAME);
        if contains(sl, n, st, y.types.as_slice(), name) {
            y = duplicate(y, sl, n, st, name, "type".as_slice());
        } else {
            y.types.push(name);
        }
        link = n[link - 1u64].next;
    }
    link = first(sl, n, program, agent_schema.PROGRAM_ENUMS);
    while link != 0u64 {
        let name: u64 = get(sl, n, link - 1u64, agent_schema.ENUM_DECL_NAME);
        if contains(sl, n, st, y.enums.as_slice(), name) {
            y = duplicate(y, sl, n, st, name, "enum".as_slice());
        } else {
            y.enums.push(name);
        }
        link = n[link - 1u64].next;
    }
    link = first(sl, n, program, agent_schema.PROGRAM_AGENTS);
    while link != 0u64 {
        let name: u64 = get(sl, n, link - 1u64, agent_schema.AGENT_DECL_NAME);
        if contains(sl, n, st, y.agents.as_slice(), name) {
            y = duplicate(y, sl, n, st, name, "agent".as_slice());
        } else {
            y.agents.push(name);
        }
        link = n[link - 1u64].next;
    }
    link = first(sl, n, program, agent_schema.PROGRAM_TOOLS);
    while link != 0u64 {
        let name: u64 = get(sl, n, link - 1u64, agent_schema.TOOL_DECL_NAME);
        if contains(sl, n, st, y.tools.as_slice(), name) {
            y = duplicate(y, sl, n, st, name, "tool".as_slice());
        } else {
            y.tools.push(name);
        }
        link = n[link - 1u64].next;
    }
    link = first(sl, n, program, agent_schema.PROGRAM_MODELS);
    while link != 0u64 {
        let name: u64 = get(sl, n, link - 1u64, agent_schema.MODEL_DECL_NAME);
        if contains(sl, n, st, y.models.as_slice(), name) {
            y = duplicate(y, sl, n, st, name, "model".as_slice());
        } else {
            y.models.push(name);
        }
        link = n[link - 1u64].next;
    }
    y = collect_more(sl, n, st, program, y);
    link = first(sl, n, program, agent_schema.PROGRAM_CAPABILITIES);
    while link != 0u64 {
        let capability: u64 = link - 1u64;
        let name: u64 = get(sl, n, capability, agent_schema.CAPABILITY_DECL_NAME);
        let level: u64 = n[value(sl, n, get(sl, n, capability, agent_schema.CAPABILITY_DECL_LEVEL))].a;
        let known: u64 = index_of(sl, n, st, y.capabilities.as_slice(), name);
        if known == NONE {
            y.capabilities.push(name);
            y.levels.push(level);
        } else {
            y.levels[known] = level;
            y = at(y, sl, n, name);
            y = put(y, "duplicate capability `".as_slice());
            y = text(y, sl, n, st, name);
            y = close(y);
        }
        link = n[capability].next;
    }
    y
}

fn check_policies(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64, symbols: Symbols) -> Symbols {
    let mut y: Symbols = symbols;
    let mut link: u64 = first(sl, n, program, agent_schema.PROGRAM_ASSERTIONS);
    while link != 0u64 {
        let assertion: u64 = link - 1u64;
        let name: u64 = get(sl, n, assertion, agent_schema.ASSERTION_DECL_NAME);
        if !(is(sl, n, st, name, "no_unhandled_messages".as_slice()) || is(sl, n, st, name, "all_tool_calls_traced".as_slice()) || is(sl, n, st, name, "all_model_calls_traced".as_slice()) || is(sl, n, st, name, "all_intrinsics_traced".as_slice()) || is(sl, n, st, name, "halt_requires_trace".as_slice()) || is(sl, n, st, name, "runtime_status".as_slice())) {
            y = at(y, sl, n, name);
            y = put(y, "unknown policy assertion `".as_slice());
            y = text(y, sl, n, st, name);
            y = close(y);
        }
        let argument: u64 = get(sl, n, assertion, agent_schema.ASSERTION_DECL_ARGUMENT);
        if is(sl, n, st, name, "runtime_status".as_slice()) && (argument == 0u64 || !is(sl, n, st, argument, "completed".as_slice())) {
            y = at(y, sl, n, name);
            y = put(y, "`runtime_status` assertion requires argument `completed`\n".as_slice());
        }
        link = n[assertion].next;
    }
    let mut policy_names: Buffer<u64> = Buffer::new();
    link = first(sl, n, program, agent_schema.PROGRAM_POLICIES);
    while link != 0u64 {
        let policy: u64 = link - 1u64;
        let name: u64 = get(sl, n, policy, agent_schema.POLICY_DECL_NAME);
        if contains(sl, n, st, policy_names.as_slice(), name) {
            y = duplicate(y, sl, n, st, name, "policy".as_slice());
        } else {
            policy_names.push(name);
        }
        let mut required: Buffer<u64> = Buffer::new();
        let mut denied: Buffer<u64> = Buffer::new();
        let mut rule_link: u64 = first(sl, n, policy, agent_schema.POLICY_DECL_RULES);
        while rule_link != 0u64 {
            let declaration: u64 = rule_link - 1u64;
            rule_link = n[declaration].next;
            let require: bool = n[declaration].a == agent_schema.POLICY_RULE_DECL_REQUIRE;
            // Require { rule } and Deny { rule } hold the rule in field 0.
            let rule: u64 = get(sl, n, n[declaration].b, 0u64);
            let variant: u64 = value(sl, n, rule);
            let which: u64 = n[variant].a;
            if which == agent_schema.POLICY_RULE_UNKNOWN {
                y = at(y, sl, n, rule);
                y = put(y, "unknown policy rule `".as_slice());
                y = raw(y, n, st, n[variant].b);
                y = close(y);
                continue;
            }
            let mut repeated: bool = false;
            let mut contradicted: bool = false;
            if require {
                repeated = has(required.as_slice(), which);
                contradicted = has(denied.as_slice(), which);
                if !repeated {
                    required.push(which);
                }
            } else {
                repeated = has(denied.as_slice(), which);
                contradicted = has(required.as_slice(), which);
                if !repeated {
                    denied.push(which);
                }
            }
            if repeated {
                y = at(y, sl, n, rule);
                y = put(y, "duplicate ".as_slice());
                if require {
                    y = put(y, "require".as_slice());
                } else {
                    y = put(y, "deny".as_slice());
                }
                y = put(y, " rule `".as_slice());
                y = source_name(y, agent_schema.POLICY_RULE, which);
                y = put(y, "` in policy `".as_slice());
                y = text(y, sl, n, st, name);
                y = close(y);
            }
            if contradicted {
                y = at(y, sl, n, rule);
                y = put(y, "contradictory policy rule `".as_slice());
                y = source_name(y, agent_schema.POLICY_RULE, which);
                y = put(y, "` in policy `".as_slice());
                y = text(y, sl, n, st, name);
                y = close(y);
            }
        }
        let violation: u64 = get(sl, n, policy, agent_schema.POLICY_DECL_VIOLATION);
        if violation != 0u64 {
            let action: u64 = get(sl, n, violation, agent_schema.POLICY_VIOLATION_DECL_ACTION);
            let variant: u64 = value(sl, n, action);
            if n[variant].a == agent_schema.POLICY_VIOLATION_ACTION_UNKNOWN {
                y = at(y, sl, n, action);
                y = put(y, "invalid policy violation action `".as_slice());
                y = raw(y, n, st, n[variant].b);
                y = close(y);
            }
        }
        link = n[policy].next;
    }
    let mut failures: Buffer<u64> = Buffer::new();
    link = first(sl, n, program, agent_schema.PROGRAM_FAILURES);
    while link != 0u64 {
        let failure: u64 = link - 1u64;
        let name: u64 = get(sl, n, failure, agent_schema.FAILURE_DECL_NAME);
        if contains(sl, n, st, failures.as_slice(), name) {
            y = duplicate(y, sl, n, st, name, "failure".as_slice());
        } else {
            failures.push(name);
        }
        let action: u64 = get(sl, n, failure, agent_schema.FAILURE_DECL_ACTION);
        if !(is(sl, n, st, action, "block".as_slice()) || is(sl, n, st, action, "review".as_slice()) || is(sl, n, st, action, "halt".as_slice())) {
            y = at(y, sl, n, action);
            y = put(y, "invalid failure action `".as_slice());
            y = text(y, sl, n, st, action);
            y = close(y);
        }
        if n[get(sl, n, failure, agent_schema.FAILURE_DECL_TRACE_REQUIRED)].a == 0u64 {
            y = at(y, sl, n, name);
            y = put(y, "failure `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` requires `trace required`\n".as_slice());
        }
        link = n[failure].next;
    }
    y
}

fn check_tools(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64, symbols: Symbols) -> Symbols {
    let mut y: Symbols = symbols;
    let mut link: u64 = first(sl, n, program, agent_schema.PROGRAM_TOOLS);
    while link != 0u64 {
        let tool: u64 = link - 1u64;
        let name: u64 = get(sl, n, tool, agent_schema.TOOL_DECL_NAME);
        let provider: u64 = get(sl, n, tool, agent_schema.TOOL_DECL_PROVIDER);
        if provider != 0u64 && !is(sl, n, st, provider, "simulated".as_slice()) {
            y = unsupported_provider(y, sl, n, st, "tool `".as_slice(), name, provider);
        }
        let capability: u64 = get(sl, n, tool, agent_schema.TOOL_DECL_CAPABILITY);
        if !contains(sl, n, st, y.capabilities.as_slice(), capability) {
            y = unknown_capability(y, sl, n, st, "tool `".as_slice(), name, capability);
        }
        y = require_message_type(y, sl, n, st, get(sl, n, tool, agent_schema.TOOL_DECL_INPUT));
        y = require_message_type(y, sl, n, st, get(sl, n, tool, agent_schema.TOOL_DECL_OUTPUT));
        link = n[tool].next;
    }
    y
}

fn check_models(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64, symbols: Symbols) -> Symbols {
    let mut y: Symbols = symbols;
    let mut link: u64 = first(sl, n, program, agent_schema.PROGRAM_MODELS);
    while link != 0u64 {
        let model: u64 = link - 1u64;
        let name: u64 = get(sl, n, model, agent_schema.MODEL_DECL_NAME);
        let provider: u64 = get(sl, n, model, agent_schema.MODEL_DECL_PROVIDER);
        if !is(sl, n, st, provider, "simulated".as_slice()) {
            y = unsupported_provider(y, sl, n, st, "model `".as_slice(), name, provider);
        }
        let capability: u64 = get(sl, n, model, agent_schema.MODEL_DECL_CAPABILITY);
        if !contains(sl, n, st, y.capabilities.as_slice(), capability) {
            y = unknown_capability(y, sl, n, st, "model `".as_slice(), name, capability);
        }
        y = require_message_type(y, sl, n, st, get(sl, n, model, agent_schema.MODEL_DECL_INPUT));
        y = require_message_type(y, sl, n, st, get(sl, n, model, agent_schema.MODEL_DECL_OUTPUT));
        link = n[model].next;
    }
    y
}

fn unsupported_provider(symbols: Symbols, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, kind: Slice<u8>, name: u64, provider: u64) -> Symbols {
    let mut y: Symbols = at(symbols, sl, n, provider);
    y = put(y, kind);
    y = text(y, sl, n, st, name);
    y = put(y, "` uses unsupported provider `".as_slice());
    y = text(y, sl, n, st, provider);
    put(y, "`; only `simulated` is allowed\n".as_slice())
}

fn unknown_capability(symbols: Symbols, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, kind: Slice<u8>, name: u64, capability: u64) -> Symbols {
    let mut y: Symbols = at(symbols, sl, n, capability);
    y = put(y, kind);
    y = text(y, sl, n, st, name);
    y = put(y, "` references unknown capability `".as_slice());
    y = text(y, sl, n, st, capability);
    close(y)
}

fn check_types(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64, symbols: Symbols) -> Symbols {
    let mut y: Symbols = symbols;
    let mut link: u64 = first(sl, n, program, agent_schema.PROGRAM_TYPES);
    while link != 0u64 {
        let type_decl: u64 = link - 1u64;
        let mut field_names: Buffer<u64> = Buffer::new();
        let mut field_link: u64 = first(sl, n, type_decl, agent_schema.TYPE_DECL_FIELDS);
        while field_link != 0u64 {
            let field: u64 = field_link - 1u64;
            let name: u64 = get(sl, n, field, agent_schema.FIELD_DECL_NAME);
            if contains(sl, n, st, field_names.as_slice(), name) {
                y = duplicate(y, sl, n, st, name, "field".as_slice());
            } else {
                field_names.push(name);
            }
            let field_type: u64 = get(sl, n, field, agent_schema.FIELD_DECL_FIELD_TYPE);
            let variant: u64 = value(sl, n, field_type);
            if n[variant].a == agent_schema.MESSAGE_FIELD_TYPE_UNKNOWN {
                let word: u64 = n[variant].b;
                if !(contains_raw(sl, n, st, y.types.as_slice(), word) || contains_raw(sl, n, st, y.enums.as_slice(), word) || raw_is(n, st, word, "string".as_slice()) || raw_is(n, st, word, "bool".as_slice()) || raw_is(n, st, word, "int".as_slice()) || raw_is(n, st, word, "float".as_slice())) {
                    y = at(y, sl, n, field_type);
                    y = put(y, "unknown message field type `".as_slice());
                    y = raw(y, n, st, word);
                    y = close(y);
                }
            }
            field_link = n[field].next;
        }
        link = n[type_decl].next;
    }
    y
}

fn check_agents(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64, symbols: Symbols) -> Symbols {
    let mut y: Symbols = symbols;
    let mut link: u64 = first(sl, n, program, agent_schema.PROGRAM_AGENTS);
    while link != 0u64 {
        let agent: u64 = link - 1u64;
        let mut receive_link: u64 = first(sl, n, agent, agent_schema.AGENT_DECL_RECEIVES);
        while receive_link != 0u64 {
            let receive: u64 = receive_link - 1u64;
            y = require_message_type(y, sl, n, st, get(sl, n, receive, agent_schema.RECEIVE_DECL_MESSAGE_TYPE));
            let from: u64 = get(sl, n, receive, agent_schema.RECEIVE_DECL_FROM);
            if from != 0u64 && !participant(sl, n, st, y.agents.as_slice(), from) {
                y = unknown_role(y, sl, n, st, "receive source".as_slice(), from);
            }
            receive_link = n[receive].next;
        }
        let mut send_link: u64 = first(sl, n, agent, agent_schema.AGENT_DECL_SENDS);
        while send_link != 0u64 {
            let send: u64 = send_link - 1u64;
            y = require_message_type(y, sl, n, st, get(sl, n, send, agent_schema.SEND_DECL_MESSAGE_TYPE));
            let to: u64 = get(sl, n, send, agent_schema.SEND_DECL_TO);
            if !participant(sl, n, st, y.agents.as_slice(), to) {
                y = unknown_role(y, sl, n, st, "send destination".as_slice(), to);
            }
            send_link = n[send].next;
        }
        y = check_agent_capabilities(sl, n, st, agent, y);
        y = check_handlers(sl, n, st, program, agent, y);
        link = n[agent].next;
    }
    y
}

// Whether the agent's `security { approval granted }` is there.
fn approved(sl: Slice<u64>, n: Slice<AgentNode>, agent: u64) -> bool {
    let approval: u64 = get(sl, n, agent, agent_schema.AGENT_DECL_APPROVAL);
    approval != 0u64 && n[value(sl, n, approval)].a == agent_schema.APPROVAL_GRANTED
}

fn restricted(level: u64) -> bool {
    level == agent_schema.CAPABILITY_LEVEL_RESTRICTED || level == agent_schema.CAPABILITY_LEVEL_DANGEROUS
}

fn check_agent_capabilities(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, agent: u64, symbols: Symbols) -> Symbols {
    let mut y: Symbols = symbols;
    let name: u64 = get(sl, n, agent, agent_schema.AGENT_DECL_NAME);
    let mut link: u64 = first(sl, n, agent, agent_schema.AGENT_DECL_CAPABILITIES);
    while link != 0u64 {
        let capability: u64 = link - 1u64;
        link = n[capability].next;
        let known: u64 = index_of(sl, n, st, y.capabilities.as_slice(), capability);
        if known == NONE {
            y = at(y, sl, n, capability);
            y = put(y, "Unknown capability ".as_slice());
            y = text(y, sl, n, st, capability);
            y = put(y, " used by agent ".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, ".\n".as_slice());
            continue;
        }
        let level: u64 = y.levels[known];
        if restricted(level) && !approved(sl, n, agent) {
            y = at(y, sl, n, capability);
            y = put(y, "Agent ".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, " uses ".as_slice());
            y = source_name(y, agent_schema.CAPABILITY_LEVEL, level);
            y = put(y, " capability ".as_slice());
            y = text(y, sl, n, st, capability);
            y = put(y, " without approval.\n".as_slice());
        }
    }
    y
}

fn check_handlers(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64, agent: u64, symbols: Symbols) -> Symbols {
    let mut y: Symbols = symbols;
    let name: u64 = get(sl, n, agent, agent_schema.AGENT_DECL_NAME);
    let mut link: u64 = first(sl, n, agent, agent_schema.AGENT_DECL_TOOLS);
    while link != 0u64 {
        let tool: u64 = link - 1u64;
        if !contains(sl, n, st, y.tools.as_slice(), tool) {
            y = agent_references(y, sl, n, st, name, "tool".as_slice(), tool);
        }
        link = n[tool].next;
    }
    link = first(sl, n, agent, agent_schema.AGENT_DECL_MODELS);
    while link != 0u64 {
        let model: u64 = link - 1u64;
        if !contains(sl, n, st, y.models.as_slice(), model) {
            y = agent_references(y, sl, n, st, name, "model".as_slice(), model);
        }
        link = n[model].next;
    }
    let mut handled: Buffer<u64> = Buffer::new();
    link = first(sl, n, agent, agent_schema.AGENT_DECL_HANDLERS);
    while link != 0u64 {
        let handler: u64 = link - 1u64;
        link = n[handler].next;
        let message_type: u64 = get(sl, n, handler, agent_schema.HANDLER_DECL_MESSAGE_TYPE);
        let binding: u64 = get(sl, n, handler, agent_schema.HANDLER_DECL_BINDING);
        y = require_message_type(y, sl, n, st, message_type);
        if contains(sl, n, st, handled.as_slice(), message_type) {
            y = at(y, sl, n, message_type);
            y = put(y, "agent `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` has duplicate handlers for `".as_slice());
            y = text(y, sl, n, st, message_type);
            y = close(y);
        } else {
            handled.push(message_type);
        }
        if !receives(sl, n, st, agent, message_type) {
            y = at(y, sl, n, message_type);
            y = put(y, "handler `on ".as_slice());
            y = text(y, sl, n, st, message_type);
            y = put(y, "` in agent `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` requires `receives ".as_slice());
            y = text(y, sl, n, st, message_type);
            y = close(y);
        }
        let mut instruction_link: u64 = first(sl, n, handler, agent_schema.HANDLER_DECL_INSTRUCTIONS);
        while instruction_link != 0u64 {
            let instruction: u64 = instruction_link - 1u64;
            instruction_link = n[instruction].next;
            y = check_instruction(sl, n, st, program, agent, handler, n[instruction].a, n[instruction].b, y);
        }
    }
    y
}

fn check_instruction(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64, agent: u64, handler: u64, which: u64, holder: u64, symbols: Symbols) -> Symbols {
    let mut y: Symbols = symbols;
    let name: u64 = get(sl, n, agent, agent_schema.AGENT_DECL_NAME);
    let handler_type: u64 = get(sl, n, handler, agent_schema.HANDLER_DECL_MESSAGE_TYPE);
    let handler_binding: u64 = get(sl, n, handler, agent_schema.HANDLER_DECL_BINDING);
    if which == agent_schema.HANDLER_INSTRUCTION_EMIT {
        let message_type: u64 = get(sl, n, holder, agent_schema.HANDLER_INSTRUCTION__EMIT_MESSAGE_TYPE);
        let to: u64 = get(sl, n, holder, agent_schema.HANDLER_INSTRUCTION__EMIT_TO);
        y = require_message_type(y, sl, n, st, message_type);
        if !participant(sl, n, st, y.agents.as_slice(), to) {
            y = unknown_role(y, sl, n, st, "emit destination".as_slice(), to);
        }
        if !sends(sl, n, st, agent, message_type, to) {
            y = at(y, sl, n, message_type);
            y = put(y, "handler emit in agent `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` requires `sends ".as_slice());
            y = text(y, sl, n, st, message_type);
            y = put(y, " to ".as_slice());
            y = text(y, sl, n, st, to);
            y = close(y);
        }
        return y;
    }
    if which == agent_schema.HANDLER_INSTRUCTION_TRACE {
        let binding: u64 = get(sl, n, holder, agent_schema.HANDLER_INSTRUCTION__TRACE_BINDING);
        if !same(sl, n, st, binding, handler_binding) {
            y = mismatched_binding(y, sl, n, st, "trace binding `".as_slice(), binding, handler_binding);
        }
        return y;
    }
    if which == agent_schema.HANDLER_INSTRUCTION_HALT {
        if !has_capability(sl, n, st, agent, "runtime.halt".as_slice()) {
            y = at_span(y, sl, n, get(sl, n, holder, agent_schema.HANDLER_INSTRUCTION__HALT_SPAN));
            y = put(y, "agent `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` uses `halt` without capability `runtime.halt`\n".as_slice());
        }
        return y;
    }
    if which == agent_schema.HANDLER_INSTRUCTION_INTRINSIC_CALL {
        let intrinsic: u64 = get(sl, n, holder, agent_schema.HANDLER_INSTRUCTION__INTRINSIC_CALL_NAME);
        let argument: u64 = get(sl, n, holder, agent_schema.HANDLER_INSTRUCTION__INTRINSIC_CALL_ARGUMENT);
        let facu: bool = is(sl, n, st, intrinsic, "facu".as_slice());
        if !(facu || is(sl, n, st, intrinsic, "marron".as_slice())) {
            y = at(y, sl, n, intrinsic);
            y = put(y, "unknown runtime intrinsic `".as_slice());
            y = text(y, sl, n, st, intrinsic);
            y = close(y);
            return y;
        }
        if !same(sl, n, st, argument, handler_binding) {
            y = at(y, sl, n, argument);
            y = put(y, "intrinsic `".as_slice());
            y = text(y, sl, n, st, intrinsic);
            y = put(y, "` argument `".as_slice());
            y = text(y, sl, n, st, argument);
            y = put(y, "` does not match handler binding `".as_slice());
            y = text(y, sl, n, st, handler_binding);
            y = close(y);
        }
        let mut missing: bool = false;
        if facu {
            missing = !has_capability(sl, n, st, agent, "state.write".as_slice());
        } else {
            missing = !has_capability(sl, n, st, agent, "runtime.guard".as_slice());
        }
        if missing {
            y = at(y, sl, n, intrinsic);
            y = put(y, "agent `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` uses `".as_slice());
            y = text(y, sl, n, st, intrinsic);
            y = put(y, "` without capability `".as_slice());
            if facu {
                y = put(y, "state.write".as_slice());
            } else {
                y = put(y, "runtime.guard".as_slice());
            }
            y = close(y);
        }
        return y;
    }
    // A tool call or a model call: the same checks with other words.
    let tool_call: bool = which == agent_schema.HANDLER_INSTRUCTION_CALL_TOOL;
    let mut target: u64 = 0u64;
    let mut binding: u64 = 0u64;
    let mut list: u64 = agent_schema.PROGRAM_MODELS;
    if tool_call {
        target = get(sl, n, holder, agent_schema.HANDLER_INSTRUCTION__CALL_TOOL_TOOL);
        binding = get(sl, n, holder, agent_schema.HANDLER_INSTRUCTION__CALL_TOOL_BINDING);
        list = agent_schema.PROGRAM_TOOLS;
    } else {
        target = get(sl, n, holder, agent_schema.HANDLER_INSTRUCTION__ASK_MODEL_MODEL);
        binding = get(sl, n, holder, agent_schema.HANDLER_INSTRUCTION__ASK_MODEL_BINDING);
    }
    // Tools and models both hold their name, capability and input in the
    // same fields.
    let declaration: u64 = find_named(sl, n, st, program, list, target);
    if declaration == NONE {
        y = at(y, sl, n, target);
        if tool_call {
            y = put(y, "unknown tool `".as_slice());
        } else {
            y = put(y, "unknown model `".as_slice());
        }
        y = text(y, sl, n, st, target);
        y = close(y);
        return y;
    }
    let mut declared: bool = false;
    if tool_call {
        declared = in_list(sl, n, st, agent, agent_schema.AGENT_DECL_TOOLS, target);
    } else {
        declared = in_list(sl, n, st, agent, agent_schema.AGENT_DECL_MODELS, target);
    }
    if !declared {
        y = at(y, sl, n, target);
        y = put(y, "agent `".as_slice());
        y = text(y, sl, n, st, name);
        if tool_call {
            y = put(y, "` calls tool `".as_slice());
        } else {
            y = put(y, "` asks model `".as_slice());
        }
        y = text(y, sl, n, st, target);
        if tool_call {
            y = put(y, "` without declaring it in `tools`\n".as_slice());
        } else {
            y = put(y, "` without declaring it in `models`\n".as_slice());
        }
    }
    if !same(sl, n, st, binding, handler_binding) {
        if tool_call {
            y = mismatched_binding(y, sl, n, st, "tool call binding `".as_slice(), binding, handler_binding);
        } else {
            y = mismatched_binding(y, sl, n, st, "model call binding `".as_slice(), binding, handler_binding);
        }
    }
    let input: u64 = get(sl, n, declaration, agent_schema.TOOL_DECL_INPUT);
    if !same(sl, n, st, input, handler_type) {
        y = at(y, sl, n, target);
        if tool_call {
            y = put(y, "tool `".as_slice());
        } else {
            y = put(y, "model `".as_slice());
        }
        y = text(y, sl, n, st, target);
        y = put(y, "` expects `".as_slice());
        y = text(y, sl, n, st, input);
        y = put(y, "` but handler receives `".as_slice());
        y = text(y, sl, n, st, handler_type);
        y = close(y);
    }
    let capability: u64 = get(sl, n, declaration, agent_schema.TOOL_DECL_CAPABILITY);
    if !in_list(sl, n, st, agent, agent_schema.AGENT_DECL_CAPABILITIES, capability) {
        y = at(y, sl, n, target);
        y = put(y, "agent `".as_slice());
        y = text(y, sl, n, st, name);
        if tool_call {
            y = put(y, "` calls tool `".as_slice());
        } else {
            y = put(y, "` asks model `".as_slice());
        }
        y = text(y, sl, n, st, target);
        y = put(y, "` without capability `".as_slice());
        y = text(y, sl, n, st, capability);
        y = close(y);
    } else {
        let known: u64 = index_of(sl, n, st, y.capabilities.as_slice(), capability);
        if known != NONE && restricted(y.levels[known]) && !approved(sl, n, agent) {
            y = at(y, sl, n, target);
            y = put(y, "agent `".as_slice());
            y = text(y, sl, n, st, name);
            if tool_call {
                y = put(y, "` calls restricted tool `".as_slice());
            } else {
                y = put(y, "` asks restricted model `".as_slice());
            }
            y = text(y, sl, n, st, target);
            y = put(y, "` without approval\n".as_slice());
        }
    }
    y
}

fn check_protocols(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64, symbols: Symbols) -> Symbols {
    let mut y: Symbols = symbols;
    let mut link: u64 = first(sl, n, program, agent_schema.PROGRAM_PROTOCOLS);
    while link != 0u64 {
        let protocol: u64 = link - 1u64;
        link = n[protocol].next;
        let mut step_link: u64 = first(sl, n, protocol, agent_schema.PROTOCOL_DECL_STEPS);
        while step_link != 0u64 {
            let step: u64 = step_link - 1u64;
            step_link = n[step].next;
            let from: u64 = get(sl, n, step, agent_schema.PROTOCOL_STEP_FROM);
            let to: u64 = get(sl, n, step, agent_schema.PROTOCOL_STEP_TO);
            let act: u64 = get(sl, n, step, agent_schema.PROTOCOL_STEP_ACT);
            let message_type: u64 = get(sl, n, step, agent_schema.PROTOCOL_STEP_MESSAGE_TYPE);
            if !participant(sl, n, st, y.agents.as_slice(), from) {
                y = unknown_role(y, sl, n, st, "protocol participant".as_slice(), from);
            }
            if !participant(sl, n, st, y.agents.as_slice(), to) {
                y = unknown_role(y, sl, n, st, "protocol participant".as_slice(), to);
            }
            y = require_message_type(y, sl, n, st, message_type);
            if !(is(sl, n, st, act, "tell".as_slice()) || is(sl, n, st, act, "ask".as_slice()) || is(sl, n, st, act, "propose".as_slice()) || is(sl, n, st, act, "commit".as_slice()) || is(sl, n, st, act, "reject".as_slice()) || is(sl, n, st, act, "verify".as_slice()) || is(sl, n, st, act, "delegate".as_slice()) || is(sl, n, st, act, "observe".as_slice()) || is(sl, n, st, act, "handoff".as_slice())) {
                y = at(y, sl, n, act);
                y = put(y, "unsupported communicative act `".as_slice());
                y = text(y, sl, n, st, act);
                y = put(y, "`; allowed acts: tell, ask, propose, commit, reject, verify, delegate, observe, handoff\n".as_slice());
            }
            if contains(sl, n, st, y.agents.as_slice(), from) {
                let sender: u64 = find_named(sl, n, st, program, agent_schema.PROGRAM_AGENTS, from);
                if !sends(sl, n, st, sender, message_type, to) {
                    y = at(y, sl, n, from);
                    y = put(y, "Protocol step requires agent ".as_slice());
                    y = text(y, sl, n, st, from);
                    y = put(y, " to declare `sends ".as_slice());
                    y = text(y, sl, n, st, message_type);
                    y = put(y, " to ".as_slice());
                    y = text(y, sl, n, st, to);
                    y = put(y, "`.\n".as_slice());
                }
            }
            if contains(sl, n, st, y.agents.as_slice(), to) {
                let receiver: u64 = find_named(sl, n, st, program, agent_schema.PROGRAM_AGENTS, to);
                if !receives_from(sl, n, st, receiver, message_type, from) {
                    y = at(y, sl, n, to);
                    y = put(y, "Protocol step requires agent ".as_slice());
                    y = text(y, sl, n, st, to);
                    y = put(y, " to declare `receives ".as_slice());
                    y = text(y, sl, n, st, message_type);
                    y = put(y, " from ".as_slice());
                    y = text(y, sl, n, st, from);
                    y = put(y, "`.\n".as_slice());
                }
            }
        }
    }
    y
}

// ------------------------------------------------------------------ lookups

const NONE: u64 = 1000000000u64;

fn get(sl: Slice<u64>, n: Slice<AgentNode>, node: u64, field: u64) -> u64 {
    agent_ast.get(sl, n, node, field)
}

// The first link of the array in field `field` of `node`.
fn first(sl: Slice<u64>, n: Slice<AgentNode>, node: u64, field: u64) -> u64 {
    n[get(sl, n, node, field)].a
}

// The value of a `Spanned`.
fn value(sl: Slice<u64>, n: Slice<AgentNode>, spanned: u64) -> u64 {
    get(sl, n, spanned, agent_schema.SPANNED_VALUE)
}

// Whether two `Spanned<String>` hold the same text.
fn same(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, left: u64, right: u64) -> bool {
    let a: u64 = value(sl, n, left);
    let b: u64 = value(sl, n, right);
    bytes.equal(st.slice(n[a].a, n[a].b), st.slice(n[b].a, n[b].b))
}

// Whether a `Spanned<String>` holds `word`.
fn is(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, spanned: u64, word: Slice<u8>) -> bool {
    let a: u64 = value(sl, n, spanned);
    bytes.equal(st.slice(n[a].a, n[a].b), word)
}

// Whether a string node holds `word`.
fn raw_is(n: Slice<AgentNode>, st: Slice<u8>, string: u64, word: Slice<u8>) -> bool {
    bytes.equal(st.slice(n[string].a, n[string].b), word)
}

// The position in `names` of a `Spanned<String>` with the same text, or NONE.
fn index_of(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, names: Slice<u64>, spanned: u64) -> u64 {
    let mut index: u64 = 0u64;
    while index < names.length() {
        if same(sl, n, st, names[index], spanned) {
            return index;
        }
        index += 1u64;
    }
    NONE
}

fn contains(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, names: Slice<u64>, spanned: u64) -> bool {
    index_of(sl, n, st, names, spanned) != NONE
}

// Whether `names` holds the text of string node `string`.
fn contains_raw(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, names: Slice<u64>, string: u64) -> bool {
    let mut index: u64 = 0u64;
    while index < names.length() {
        let a: u64 = value(sl, n, names[index]);
        if bytes.equal(st.slice(n[a].a, n[a].b), st.slice(n[string].a, n[string].b)) {
            return true;
        }
        index += 1u64;
    }
    false
}

fn has(values: Slice<u64>, wanted: u64) -> bool {
    let mut index: u64 = 0u64;
    while index < values.length() {
        if values[index] == wanted {
            return true;
        }
        index += 1u64;
    }
    false
}

// An agent, or one of stage0's external entities.
fn participant(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, agents: Slice<u64>, name: u64) -> bool {
    contains(sl, n, st, agents, name) || is(sl, n, st, name, "User".as_slice()) || is(sl, n, st, name, "System".as_slice()) || is(sl, n, st, name, "Runtime".as_slice()) || is(sl, n, st, name, "Memory".as_slice()) || is(sl, n, st, name, "Tool".as_slice())
}

// The first declaration in array `list` of the program whose name (field 0)
// is `name`, or NONE.
fn find_named(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64, list: u64, name: u64) -> u64 {
    let mut link: u64 = first(sl, n, program, list);
    while link != 0u64 {
        if same(sl, n, st, get(sl, n, link - 1u64, 0u64), name) {
            return link - 1u64;
        }
        link = n[link - 1u64].next;
    }
    NONE
}

// Whether array `field` of `node`, of `Spanned<String>`, holds `name`.
fn in_list(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, node: u64, field: u64, name: u64) -> bool {
    let mut link: u64 = first(sl, n, node, field);
    while link != 0u64 {
        if same(sl, n, st, link - 1u64, name) {
            return true;
        }
        link = n[link - 1u64].next;
    }
    false
}

fn has_capability(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, agent: u64, word: Slice<u8>) -> bool {
    let mut link: u64 = first(sl, n, agent, agent_schema.AGENT_DECL_CAPABILITIES);
    while link != 0u64 {
        if is(sl, n, st, link - 1u64, word) {
            return true;
        }
        link = n[link - 1u64].next;
    }
    false
}

// Whether the agent declares `receives <message_type>`.
fn receives(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, agent: u64, message_type: u64) -> bool {
    let mut link: u64 = first(sl, n, agent, agent_schema.AGENT_DECL_RECEIVES);
    while link != 0u64 {
        if same(sl, n, st, get(sl, n, link - 1u64, agent_schema.RECEIVE_DECL_MESSAGE_TYPE), message_type) {
            return true;
        }
        link = n[link - 1u64].next;
    }
    false
}

// Whether the agent declares `receives <message_type>`, from `from` or from
// anyone.
fn receives_from(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, agent: u64, message_type: u64, from: u64) -> bool {
    let mut link: u64 = first(sl, n, agent, agent_schema.AGENT_DECL_RECEIVES);
    while link != 0u64 {
        let receive: u64 = link - 1u64;
        let declared_from: u64 = get(sl, n, receive, agent_schema.RECEIVE_DECL_FROM);
        if same(sl, n, st, get(sl, n, receive, agent_schema.RECEIVE_DECL_MESSAGE_TYPE), message_type) && (declared_from == 0u64 || same(sl, n, st, declared_from, from)) {
            return true;
        }
        link = n[receive].next;
    }
    false
}

// Whether the agent declares `sends <message_type> to <to>`.
fn sends(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, agent: u64, message_type: u64, to: u64) -> bool {
    let mut link: u64 = first(sl, n, agent, agent_schema.AGENT_DECL_SENDS);
    while link != 0u64 {
        let send: u64 = link - 1u64;
        if same(sl, n, st, get(sl, n, send, agent_schema.SEND_DECL_MESSAGE_TYPE), message_type) && same(sl, n, st, get(sl, n, send, agent_schema.SEND_DECL_TO), to) {
            return true;
        }
        link = n[send].next;
    }
    false
}

// ------------------------------------------------------------------ messages

// The diagnostics are written into `out` of the symbols, which Core moves as
// one value: each helper takes it and gives it back.

fn put(symbols: Symbols, text_bytes: Slice<u8>) -> Symbols {
    let mut y: Symbols = symbols;
    let mut index: u64 = 0u64;
    while index < text_bytes.length() {
        y.out.push(text_bytes[index]);
        index += 1u64;
    }
    y
}

fn decimal(symbols: Symbols, number: u64) -> Symbols {
    let digits: Buffer<u8> = bytes.append_decimal(Buffer::new(), number);
    put(symbols, digits.as_slice())
}

// The word stage0 writes for a variant.
fn source_name(symbols: Symbols, e: u64, v: u64) -> Symbols {
    let word: Buffer<u8> = agent_schema.append_source_name(Buffer::new(), e, v);
    put(symbols, word.as_slice())
}

// `line:column: ` of a `Spanned`.
fn at(symbols: Symbols, sl: Slice<u64>, n: Slice<AgentNode>, spanned: u64) -> Symbols {
    at_span(symbols, sl, n, get(sl, n, spanned, agent_schema.SPANNED_SPAN))
}

// `line:column: ` of a `Span`.
fn at_span(symbols: Symbols, sl: Slice<u64>, n: Slice<AgentNode>, span: u64) -> Symbols {
    let mut y: Symbols = decimal(symbols, n[get(sl, n, span, agent_schema.SPAN_LINE)].a);
    y.out.push(58u8);
    y = decimal(y, n[get(sl, n, span, agent_schema.SPAN_COLUMN)].a);
    put(y, ": ".as_slice())
}

// The text of a `Spanned<String>`.
fn text(symbols: Symbols, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, spanned: u64) -> Symbols {
    let a: u64 = value(sl, n, spanned);
    put(symbols, st.slice(n[a].a, n[a].b))
}

// The text of a string node.
fn raw(symbols: Symbols, n: Slice<AgentNode>, st: Slice<u8>, string: u64) -> Symbols {
    put(symbols, st.slice(n[string].a, n[string].b))
}

// "`" and the end of the line.
fn close(symbols: Symbols) -> Symbols {
    let mut y: Symbols = symbols;
    y.out.push(96u8);
    y.out.push(10u8);
    y
}

// "duplicate <kind> `<name>`".
fn duplicate(symbols: Symbols, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, name: u64, kind: Slice<u8>) -> Symbols {
    let mut y: Symbols = at(symbols, sl, n, name);
    y = put(y, "duplicate ".as_slice());
    y = put(y, kind);
    y = put(y, " `".as_slice());
    y = text(y, sl, n, st, name);
    close(y)
}

// "unknown message type `<name>`; messages must reference a declared `type`"
// when the type is not declared.
fn require_message_type(symbols: Symbols, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, message_type: u64) -> Symbols {
    if contains(sl, n, st, symbols.types.as_slice(), message_type) {
        return symbols;
    }
    let mut y: Symbols = at(symbols, sl, n, message_type);
    y = put(y, "unknown message type `".as_slice());
    y = text(y, sl, n, st, message_type);
    put(y, "`; messages must reference a declared `type`\n".as_slice())
}

// "unknown <role> `<name>`".
fn unknown_role(symbols: Symbols, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, role: Slice<u8>, name: u64) -> Symbols {
    let mut y: Symbols = at(symbols, sl, n, name);
    y = put(y, "unknown ".as_slice());
    y = put(y, role);
    y = put(y, " `".as_slice());
    y = text(y, sl, n, st, name);
    close(y)
}

// "agent `<agent>` references unknown <kind> `<name>`".
fn agent_references(symbols: Symbols, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, agent: u64, kind: Slice<u8>, name: u64) -> Symbols {
    let mut y: Symbols = at(symbols, sl, n, name);
    y = put(y, "agent `".as_slice());
    y = text(y, sl, n, st, agent);
    y = put(y, "` references unknown ".as_slice());
    y = put(y, kind);
    y = put(y, " `".as_slice());
    y = text(y, sl, n, st, name);
    close(y)
}

// "<what>`<binding>` does not match handler binding `<handler>`".
fn mismatched_binding(symbols: Symbols, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, what: Slice<u8>, binding: u64, handler: u64) -> Symbols {
    let mut y: Symbols = at(symbols, sl, n, binding);
    y = put(y, what);
    y = text(y, sl, n, st, binding);
    y = put(y, "` does not match handler binding `".as_slice());
    y = text(y, sl, n, st, handler);
    close(y)
}

// ------------------------------------------------------------------ providers, features, secrets, crypto, DIDs

// The duplicates stage0 reports after tools and models, before capabilities:
// features, secrets, adapters, adapter profiles, cryptos, DID methods, trust
// boundaries and identities.
fn collect_more(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64, symbols: Symbols) -> Symbols {
    let mut y: Symbols = symbols;
    let mut link: u64 = first(sl, n, program, agent_schema.PROGRAM_FEATURES);
    while link != 0u64 {
        let name: u64 = get(sl, n, link - 1u64, 0u64);
        if contains(sl, n, st, y.features.as_slice(), name) { y = duplicate(y, sl, n, st, name, "feature".as_slice()); } else { y.features.push(name); }
        link = n[link - 1u64].next;
    }
    link = first(sl, n, program, agent_schema.PROGRAM_SECRETS);
    while link != 0u64 {
        let name: u64 = get(sl, n, link - 1u64, 0u64);
        if contains(sl, n, st, y.secrets.as_slice(), name) { y = duplicate(y, sl, n, st, name, "secret".as_slice()); } else { y.secrets.push(name); }
        link = n[link - 1u64].next;
    }
    link = first(sl, n, program, agent_schema.PROGRAM_ADAPTERS);
    while link != 0u64 {
        let name: u64 = get(sl, n, link - 1u64, 0u64);
        if contains(sl, n, st, y.adapters.as_slice(), name) { y = duplicate(y, sl, n, st, name, "adapter".as_slice()); } else { y.adapters.push(name); }
        link = n[link - 1u64].next;
    }
    link = first(sl, n, program, agent_schema.PROGRAM_ADAPTER_PROFILES);
    while link != 0u64 {
        let name: u64 = get(sl, n, link - 1u64, 0u64);
        if contains(sl, n, st, y.adapter_profiles.as_slice(), name) { y = duplicate(y, sl, n, st, name, "adapter_profile".as_slice()); } else { y.adapter_profiles.push(name); }
        link = n[link - 1u64].next;
    }
    link = first(sl, n, program, agent_schema.PROGRAM_CRYPTOS);
    while link != 0u64 {
        let name: u64 = get(sl, n, link - 1u64, 0u64);
        if contains(sl, n, st, y.cryptos.as_slice(), name) { y = duplicate(y, sl, n, st, name, "crypto".as_slice()); } else { y.cryptos.push(name); }
        link = n[link - 1u64].next;
    }
    link = first(sl, n, program, agent_schema.PROGRAM_DID_METHODS);
    while link != 0u64 {
        let name: u64 = get(sl, n, link - 1u64, 0u64);
        if contains(sl, n, st, y.did_methods.as_slice(), name) { y = duplicate(y, sl, n, st, name, "did_method".as_slice()); } else { y.did_methods.push(name); }
        link = n[link - 1u64].next;
    }
    link = first(sl, n, program, agent_schema.PROGRAM_ATRUST_BOUNDARIES);
    while link != 0u64 {
        let name: u64 = get(sl, n, link - 1u64, 0u64);
        if contains(sl, n, st, y.atrust_boundaries.as_slice(), name) { y = duplicate(y, sl, n, st, name, "atrust_boundary".as_slice()); } else { y.atrust_boundaries.push(name); }
        link = n[link - 1u64].next;
    }
    link = first(sl, n, program, agent_schema.PROGRAM_ATRUST_IDENTITIES);
    while link != 0u64 {
        let name: u64 = get(sl, n, link - 1u64, 0u64);
        if contains(sl, n, st, y.atrust_identities.as_slice(), name) { y = duplicate(y, sl, n, st, name, "atrust_identity".as_slice()); } else { y.atrust_identities.push(name); }
        link = n[link - 1u64].next;
    }
    y
}

fn check_provider_contracts(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64, symbols: Symbols) -> Symbols {
    let mut y: Symbols = symbols;
    let mut names: Buffer<u64> = Buffer::new();
    let mut link: u64 = first(sl, n, program, agent_schema.PROGRAM_PROVIDERS);
    while link != 0u64 {
        let provider: u64 = link - 1u64;
        link = n[provider].next;
        let name: u64 = get(sl, n, provider, agent_schema.PROVIDER_DECL_NAME);
        if contains(sl, n, st, names.as_slice(), name) {
            y = duplicate(y, sl, n, st, name, "provider".as_slice());
        } else {
            names.push(name);
        }
        if is(sl, n, st, name, "simulated".as_slice()) {
            y = at(y, sl, n, name);
            y = put(y, "`simulated` is the reserved executable provider and must not be declared as a provider contract\n".as_slice());
        }
        let kind: u64 = get(sl, n, provider, agent_schema.PROVIDER_DECL_KIND);
        if n[value(sl, n, kind)].a != agent_schema.PROVIDER_KIND_DECL_EXTERNAL {
            y = at(y, sl, n, kind);
            y = put(y, "provider contract `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` must use kind `external` in v0.15\n".as_slice());
        }
        let enabled: u64 = get(sl, n, provider, agent_schema.PROVIDER_DECL_ENABLED);
        if n[value(sl, n, enabled)].a == 1u64 {
            y = at(y, sl, n, enabled);
            y = put(y, "external provider contract `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` must be disabled\n".as_slice());
        }
        let dry_run_only: u64 = get(sl, n, provider, agent_schema.PROVIDER_DECL_DRY_RUN_ONLY);
        if n[value(sl, n, dry_run_only)].a == 0u64 {
            y = at(y, sl, n, dry_run_only);
            y = put(y, "external provider contract `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` requires `dry_run_only true`\n".as_slice());
        }
        if n[get(sl, n, provider, agent_schema.PROVIDER_DECL_REQUIRES_FEATURE_FLAG)].a == 0u64 {
            y = at(y, sl, n, name);
            y = put(y, "external provider contract `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` requires `requires feature_flag`\n".as_slice());
        }
        if n[get(sl, n, provider, agent_schema.PROVIDER_DECL_REQUIRES_EXPLICIT_APPROVAL)].a == 0u64 {
            y = at(y, sl, n, name);
            y = put(y, "external provider contract `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` requires `requires approval`\n".as_slice());
        }
        let allowed_capabilities: u64 = get(sl, n, provider, agent_schema.PROVIDER_DECL_ALLOWED_CAPABILITIES);
        let mut targets: Buffer<u64> = Buffer::new();
        let mut target_link: u64 = first(sl, n, provider, agent_schema.PROVIDER_DECL_ALLOWED_TARGETS);
        while target_link != 0u64 {
            let target: u64 = target_link - 1u64;
            target_link = n[target].next;
            if contains(sl, n, st, targets.as_slice(), target) {
                y = at(y, sl, n, target);
                y = put(y, "duplicate allowed target `".as_slice());
                y = text(y, sl, n, st, target);
                y = close(y);
                continue;
            }
            targets.push(target);
            let tool: u64 = find_named(sl, n, st, program, agent_schema.PROGRAM_TOOLS, target);
            let model: u64 = find_named(sl, n, st, program, agent_schema.PROGRAM_MODELS, target);
            let mut capability: u64 = NONE;
            if tool == NONE && model == NONE {
                y = at(y, sl, n, target);
                y = put(y, "unknown allowlist target `".as_slice());
                y = text(y, sl, n, st, target);
                y = close(y);
            } else if tool != NONE && model != NONE {
                y = at(y, sl, n, target);
                y = put(y, "ambiguous allowlist target `".as_slice());
                y = text(y, sl, n, st, target);
                y = close(y);
            } else if tool != NONE {
                capability = get(sl, n, tool, agent_schema.TOOL_DECL_CAPABILITY);
            } else {
                capability = get(sl, n, model, agent_schema.MODEL_DECL_CAPABILITY);
            }
            if capability != NONE && n[allowed_capabilities].a != 0u64 && !in_list(sl, n, st, provider, agent_schema.PROVIDER_DECL_ALLOWED_CAPABILITIES, capability) {
                y = at(y, sl, n, target);
                y = put(y, "allowlist target `".as_slice());
                y = text(y, sl, n, st, target);
                y = put(y, "` requires capability `".as_slice());
                y = text(y, sl, n, st, capability);
                y = close(y);
            }
        }
        let mut capabilities: Buffer<u64> = Buffer::new();
        let mut capability_link: u64 = n[allowed_capabilities].a;
        while capability_link != 0u64 {
            let capability: u64 = capability_link - 1u64;
            capability_link = n[capability].next;
            if contains(sl, n, st, capabilities.as_slice(), capability) {
                y = at(y, sl, n, capability);
                y = put(y, "duplicate allowed capability `".as_slice());
                y = text(y, sl, n, st, capability);
                y = close(y);
            } else {
                capabilities.push(capability);
            }
            if !contains(sl, n, st, y.capabilities.as_slice(), capability) {
                y = at(y, sl, n, capability);
                y = put(y, "unknown allowlist capability `".as_slice());
                y = text(y, sl, n, st, capability);
                y = close(y);
            }
        }
    }
    y
}

// An enum field whose `Unknown` variant (`unknown`) holds the word: empty,
// "<kind> `<name>` is missing required field `<field>`"; otherwise
// "<kind> `<name>` has invalid <field> `<word>`<tail>".
fn required_enum(symbols: Symbols, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, kind: Slice<u8>, name: u64, field: Slice<u8>, spanned: u64, unknown: u64, tail: Slice<u8>) -> Symbols {
    let variant: u64 = value(sl, n, spanned);
    if n[variant].a != unknown {
        return symbols;
    }
    let word: u64 = n[variant].b;
    let mut y: Symbols = at(symbols, sl, n, spanned);
    y = put(y, kind);
    y = put(y, " `".as_slice());
    y = text(y, sl, n, st, name);
    if n[word].b == n[word].a {
        y = put(y, "` is missing required field `".as_slice());
        y = put(y, field);
        return close(y);
    }
    y = put(y, "` has invalid ".as_slice());
    y = put(y, field);
    y = put(y, " `".as_slice());
    y = raw(y, n, st, word);
    y = put(y, "`".as_slice());
    y = put(y, tail);
    put(y, "\n".as_slice())
}

fn check_features(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64, symbols: Symbols) -> Symbols {
    let mut y: Symbols = symbols;
    let mut link: u64 = first(sl, n, program, agent_schema.PROGRAM_FEATURES);
    while link != 0u64 {
        let feature: u64 = link - 1u64;
        link = n[feature].next;
        let name: u64 = get(sl, n, feature, agent_schema.FEATURE_DECL_NAME);
        let provider: u64 = get(sl, n, feature, agent_schema.FEATURE_DECL_PROVIDER);
        if provider != 0u64 && !contains(sl, n, st, y.providers.as_slice(), provider) {
            y = at(y, sl, n, provider);
            y = put(y, "feature `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` references unknown provider `".as_slice());
            y = text(y, sl, n, st, provider);
            y = close(y);
        }
        let status: u64 = get(sl, n, feature, agent_schema.FEATURE_DECL_STATUS);
        y = required_enum(y, sl, n, st, "feature".as_slice(), name, "status".as_slice(), status, agent_schema.FEATURE_STATUS_UNKNOWN, "".as_slice());
        let default: u64 = get(sl, n, feature, agent_schema.FEATURE_DECL_DEFAULT);
        y = required_enum(y, sl, n, st, "feature".as_slice(), name, "default".as_slice(), default, agent_schema.FEATURE_DEFAULT_UNKNOWN, "".as_slice());
        let purpose: u64 = get(sl, n, feature, agent_schema.FEATURE_DECL_PURPOSE);
        if purpose != 0u64 && blank(sl, n, st, purpose) {
            y = at(y, sl, n, purpose);
            y = put(y, "feature `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` purpose must not be empty\n".as_slice());
        }
        let status_value: u64 = n[value(sl, n, status)].a;
        let gated: bool = status_value == agent_schema.FEATURE_STATUS_EXPERIMENTAL || status_value == agent_schema.FEATURE_STATUS_PREVIEW;
        if gated && n[get(sl, n, feature, agent_schema.FEATURE_DECL_REQUIRES_APPROVAL)].a == 0u64 {
            y = at(y, sl, n, status);
            y = put(y, "feature `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` is `".as_slice());
            y = source_name(y, agent_schema.FEATURE_STATUS, status_value);
            y = put(y, "` and requires `requires approval`\n".as_slice());
        }
        if provider != 0u64 && external_provider(sl, n, st, program, provider) && n[value(sl, n, default)].a != agent_schema.FEATURE_DEFAULT_DISABLED {
            y = at(y, sl, n, default);
            y = put(y, "feature `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` is linked to external provider `".as_slice());
            y = text(y, sl, n, st, provider);
            y = put(y, "` and must default to disabled\n".as_slice());
        }
    }
    y
}

// Whether some provider named `name` is of kind `external`.
fn external_provider(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64, name: u64) -> bool {
    let mut link: u64 = first(sl, n, program, agent_schema.PROGRAM_PROVIDERS);
    while link != 0u64 {
        let provider: u64 = link - 1u64;
        if same(sl, n, st, get(sl, n, provider, agent_schema.PROVIDER_DECL_NAME), name) && n[value(sl, n, get(sl, n, provider, agent_schema.PROVIDER_DECL_KIND))].a == agent_schema.PROVIDER_KIND_DECL_EXTERNAL {
            return true;
        }
        link = n[provider].next;
    }
    false
}

fn check_secrets(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64, symbols: Symbols) -> Symbols {
    let mut y: Symbols = symbols;
    let mut link: u64 = first(sl, n, program, agent_schema.PROGRAM_SECRETS);
    while link != 0u64 {
        let secret: u64 = link - 1u64;
        link = n[secret].next;
        let name: u64 = get(sl, n, secret, agent_schema.SECRET_DECL_NAME);
        let handle: u64 = get(sl, n, secret, agent_schema.SECRET_DECL_HANDLE);
        if blank(sl, n, st, handle) {
            y = at(y, sl, n, handle);
            y = put(y, "secret `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` is missing required field `handle`\n".as_slice());
        }
        let provider: u64 = get(sl, n, secret, agent_schema.SECRET_DECL_PROVIDER);
        if provider != 0u64 && !contains(sl, n, st, y.providers.as_slice(), provider) {
            y = at(y, sl, n, provider);
            y = put(y, "secret `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` references unknown provider `".as_slice());
            y = text(y, sl, n, st, provider);
            y = close(y);
        }
        let required_by: u64 = get(sl, n, secret, agent_schema.SECRET_DECL_REQUIRED_BY);
        if required_by != 0u64 && !contains(sl, n, st, y.features.as_slice(), required_by) {
            y = at(y, sl, n, required_by);
            y = put(y, "secret `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` required_by references unknown feature `".as_slice());
            y = text(y, sl, n, st, required_by);
            y = close(y);
        }
        y = required_enum(y, sl, n, st, "secret".as_slice(), name, "scope".as_slice(), get(sl, n, secret, agent_schema.SECRET_DECL_SCOPE), agent_schema.SECRET_SCOPE_UNKNOWN, "".as_slice());
        y = required_enum(y, sl, n, st, "secret".as_slice(), name, "access".as_slice(), get(sl, n, secret, agent_schema.SECRET_DECL_ACCESS), agent_schema.SECRET_ACCESS_UNKNOWN, "; only `denied` is allowed in v0.21".as_slice());
        y = required_enum(y, sl, n, st, "secret".as_slice(), name, "source".as_slice(), get(sl, n, secret, agent_schema.SECRET_DECL_SOURCE), agent_schema.SECRET_SOURCE_UNKNOWN, "; only `none` is allowed in v0.21".as_slice());
        if provider != 0u64 && required_by != 0u64 {
            let feature: u64 = find_named(sl, n, st, program, agent_schema.PROGRAM_FEATURES, required_by);
            if feature != NONE {
                let feature_provider: u64 = get(sl, n, feature, agent_schema.FEATURE_DECL_PROVIDER);
                if feature_provider != 0u64 && !same(sl, n, st, feature_provider, provider) {
                    y = at(y, sl, n, provider);
                    y = put(y, "secret `".as_slice());
                    y = text(y, sl, n, st, name);
                    y = put(y, "` provider `".as_slice());
                    y = text(y, sl, n, st, provider);
                    y = put(y, "` does not match feature `".as_slice());
                    y = text(y, sl, n, st, get(sl, n, feature, agent_schema.FEATURE_DECL_NAME));
                    y = put(y, "` provider `".as_slice());
                    y = text(y, sl, n, st, feature_provider);
                    y = close(y);
                }
            }
        }
    }
    y
}

fn check_cryptos(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64, symbols: Symbols) -> Symbols {
    let mut y: Symbols = symbols;
    let mut names: Buffer<u64> = Buffer::new();
    let mut link: u64 = first(sl, n, program, agent_schema.PROGRAM_CRYPTOS);
    while link != 0u64 {
        let crypto: u64 = link - 1u64;
        link = n[crypto].next;
        let name: u64 = get(sl, n, crypto, agent_schema.CRYPTO_DECL_NAME);
        if contains(sl, n, st, names.as_slice(), name) {
            y = duplicate(y, sl, n, st, name, "crypto".as_slice());
        } else {
            names.push(name);
        }
        y = required_enum(y, sl, n, st, "crypto".as_slice(), name, "kind".as_slice(), get(sl, n, crypto, agent_schema.CRYPTO_DECL_KIND), agent_schema.CRYPTO_KIND_UNKNOWN, "".as_slice());
        y = required_enum(y, sl, n, st, "crypto".as_slice(), name, "status".as_slice(), get(sl, n, crypto, agent_schema.CRYPTO_DECL_STATUS), agent_schema.CRYPTO_STATUS_UNKNOWN, "".as_slice());
        y = required_enum(y, sl, n, st, "crypto".as_slice(), name, "strength".as_slice(), get(sl, n, crypto, agent_schema.CRYPTO_DECL_STRENGTH), agent_schema.CRYPTO_STRENGTH_UNKNOWN_VALUE, "".as_slice());
        let purpose: u64 = first(sl, n, crypto, agent_schema.CRYPTO_DECL_PURPOSE);
        if purpose == 0u64 {
            y = at(y, sl, n, name);
            y = put(y, "crypto `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` is missing required field `purpose`\n".as_slice());
        } else {
            let mut item_link: u64 = purpose;
            while item_link != 0u64 {
                let item: u64 = item_link - 1u64;
                item_link = n[item].next;
                if blank(sl, n, st, item) {
                    y = at(y, sl, n, item);
                    y = put(y, "crypto `".as_slice());
                    y = text(y, sl, n, st, name);
                    y = put(y, "` has empty purpose item\n".as_slice());
                }
            }
        }
        let output_bits: u64 = get(sl, n, crypto, agent_schema.CRYPTO_DECL_OUTPUT_BITS);
        if output_bits != 0u64 && n[value(sl, n, output_bits)].a == 0u64 {
            y = at(y, sl, n, output_bits);
            y = put(y, "crypto `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` has invalid output_bits 0\n".as_slice());
        }
        let min_key_bits: u64 = get(sl, n, crypto, agent_schema.CRYPTO_DECL_MIN_KEY_BITS);
        if min_key_bits != 0u64 && n[value(sl, n, min_key_bits)].a == 0u64 {
            y = at(y, sl, n, min_key_bits);
            y = put(y, "crypto `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` has invalid min_key_bits 0\n".as_slice());
        }
        let notes: u64 = get(sl, n, crypto, agent_schema.CRYPTO_DECL_NOTES);
        if notes != 0u64 && blank(sl, n, st, notes) {
            y = at(y, sl, n, notes);
            y = put(y, "crypto `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` has empty notes\n".as_slice());
        }
    }
    y
}

fn check_did_methods(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64, symbols: Symbols) -> Symbols {
    let mut y: Symbols = symbols;
    let mut names: Buffer<u64> = Buffer::new();
    let mut link: u64 = first(sl, n, program, agent_schema.PROGRAM_DID_METHODS);
    while link != 0u64 {
        let method: u64 = link - 1u64;
        link = n[method].next;
        let name: u64 = get(sl, n, method, agent_schema.DID_METHOD_DECL_NAME);
        if contains(sl, n, st, names.as_slice(), name) {
            y = duplicate(y, sl, n, st, name, "did_method".as_slice());
        } else {
            names.push(name);
        }
        y = missing_unknown(y, sl, n, st, name, "status".as_slice(), get(sl, n, method, agent_schema.DID_METHOD_DECL_STATUS), agent_schema.DID_METHOD_STATUS_UNKNOWN);
        let resolution: u64 = get(sl, n, method, agent_schema.DID_METHOD_DECL_RESOLUTION);
        y = missing_unknown(y, sl, n, st, name, "resolution".as_slice(), resolution, agent_schema.DID_RESOLUTION_MODE_UNKNOWN);
        y = missing_unknown(y, sl, n, st, name, "ledger".as_slice(), get(sl, n, method, agent_schema.DID_METHOD_DECL_LEDGER), agent_schema.DID_LEDGER_MODE_UNKNOWN);
        let boundary: u64 = get(sl, n, method, agent_schema.DID_METHOD_DECL_CRYPTO_BOUNDARY);
        if is(sl, n, st, boundary, "".as_slice()) {
            y = at(y, sl, n, boundary);
            y = put(y, "did_method `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` is missing required field `crypto_boundary`\n".as_slice());
        }
        let purpose: u64 = first(sl, n, method, agent_schema.DID_METHOD_DECL_PURPOSE);
        if purpose == 0u64 {
            y = at(y, sl, n, name);
            y = put(y, "did_method `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` is missing required field `purpose`\n".as_slice());
        }
        let mut item_link: u64 = purpose;
        while item_link != 0u64 {
            let item: u64 = item_link - 1u64;
            item_link = n[item].next;
            if blank(sl, n, st, item) {
                y = at(y, sl, n, item);
                y = put(y, "purpose entries must be non-empty\n".as_slice());
            }
        }
        let mode: u64 = value(sl, n, resolution);
        if n[mode].a == agent_schema.DID_RESOLUTION_MODE_UNKNOWN && (raw_is(n, st, n[mode].b, "remote".as_slice()) || raw_is(n, st, n[mode].b, "network".as_slice()) || raw_is(n, st, n[mode].b, "live".as_slice()) || raw_is(n, st, n[mode].b, "distributed".as_slice())) {
            y = at(y, sl, n, resolution);
            y = put(y, "resolution `remote`/`network`/`live`/`distributed` not permitted in v0.26\n".as_slice());
        }
    }
    y
}

// "did_method `<name>` is missing required field `<field>`" when the field is
// an empty `Unknown`.
fn missing_unknown(symbols: Symbols, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, name: u64, field: Slice<u8>, spanned: u64, unknown: u64) -> Symbols {
    let variant: u64 = value(sl, n, spanned);
    if n[variant].a != unknown || n[n[variant].b].b != n[n[variant].b].a {
        return symbols;
    }
    let mut y: Symbols = at(symbols, sl, n, spanned);
    y = put(y, "did_method `".as_slice());
    y = text(y, sl, n, st, name);
    y = put(y, "` is missing required field `".as_slice());
    y = put(y, field);
    close(y)
}

// Whether a `Spanned<String>` is empty once Unicode white space is trimmed,
// as Rust's `str::trim` trims it.
fn blank(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, spanned: u64) -> bool {
    let string: u64 = value(sl, n, spanned);
    let mut at_byte: u64 = n[string].a;
    let end: u64 = n[string].b;
    while at_byte < end {
        let lead: u8 = st[at_byte];
        if lead < 128u8 {
            if !(lead == 32u8 || (lead >= 9u8 && lead <= 13u8)) {
                return false;
            }
            at_byte += 1u64;
        } else if lead < 224u8 {
            // U+0085 and U+00A0.
            let next: u8 = st[at_byte + 1u64];
            if !(lead == 194u8 && (next == 133u8 || next == 160u8)) {
                return false;
            }
            at_byte += 2u64;
        } else if lead < 240u8 {
            let second: u8 = st[at_byte + 1u64];
            let third: u8 = st[at_byte + 2u64];
            // U+1680; U+2000 to U+200A, U+2028, U+2029, U+202F, U+205F; U+3000.
            let ogham: bool = lead == 225u8 && second == 154u8 && third == 128u8;
            let general: bool = lead == 226u8 && ((second == 128u8 && (third <= 138u8 || third == 168u8 || third == 169u8 || third == 175u8)) || (second == 129u8 && third == 159u8));
            let ideographic: bool = lead == 227u8 && second == 128u8 && third == 128u8;
            if !(ogham || general || ideographic) {
                return false;
            }
            at_byte += 3u64;
        } else {
            return false;
        }
    }
    true
}

// ------------------------------------------------------------------ harnesses

fn check_harnesses(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64, symbols: Symbols) -> Symbols {
    let mut y: Symbols = symbols;
    let mut names: Buffer<u64> = Buffer::new();
    let mut link: u64 = first(sl, n, program, agent_schema.PROGRAM_HARNESSES);
    while link != 0u64 {
        let harness: u64 = link - 1u64;
        link = n[harness].next;
        let name: u64 = get(sl, n, harness, agent_schema.PROVIDER_HARNESS_DECL_NAME);
        if contains(sl, n, st, names.as_slice(), name) {
            y = duplicate(y, sl, n, st, name, "harness".as_slice());
        } else {
            names.push(name);
        }
        let provider: u64 = get(sl, n, harness, agent_schema.PROVIDER_HARNESS_DECL_PROVIDER);
        let has_provider: bool = !blank(sl, n, st, provider);
        if !has_provider {
            y = at(y, sl, n, provider);
            y = put(y, "harness `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` is missing required field `provider`\n".as_slice());
        } else if !contains(sl, n, st, y.providers.as_slice(), provider) {
            y = harness_references(y, sl, n, st, name, "provider".as_slice(), provider);
        }
        y = required_enum(y, sl, n, st, "harness".as_slice(), name, "mode".as_slice(), get(sl, n, harness, agent_schema.PROVIDER_HARNESS_DECL_MODE), agent_schema.HARNESS_MODE_UNKNOWN, "".as_slice());
        y = required_enum(y, sl, n, st, "harness".as_slice(), name, "network".as_slice(), get(sl, n, harness, agent_schema.PROVIDER_HARNESS_DECL_NETWORK), agent_schema.HARNESS_NETWORK_UNKNOWN, "".as_slice());
        y = required_enum(y, sl, n, st, "harness".as_slice(), name, "secrets".as_slice(), get(sl, n, harness, agent_schema.PROVIDER_HARNESS_DECL_SECRETS), agent_schema.HARNESS_SECRETS_UNKNOWN, "".as_slice());
        y = required_enum(y, sl, n, st, "harness".as_slice(), name, "filesystem".as_slice(), get(sl, n, harness, agent_schema.PROVIDER_HARNESS_DECL_FILESYSTEM), agent_schema.HARNESS_FILESYSTEM_UNKNOWN, "".as_slice());
        let max_steps: u64 = get(sl, n, harness, agent_schema.PROVIDER_HARNESS_DECL_MAX_STEPS);
        if max_steps != 0u64 && n[value(sl, n, max_steps)].a == 0u64 {
            y = at(y, sl, n, max_steps);
            y = put(y, "harness `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` max_steps must be positive\n".as_slice());
        }
        let timeout_ms: u64 = get(sl, n, harness, agent_schema.PROVIDER_HARNESS_DECL_TIMEOUT_MS);
        if timeout_ms != 0u64 && n[value(sl, n, timeout_ms)].a == 0u64 {
            y = at(y, sl, n, timeout_ms);
            y = put(y, "harness `".as_slice());
            y = text(y, sl, n, st, name);
            y = put(y, "` timeout_ms must be positive\n".as_slice());
        }
        let input: u64 = get(sl, n, harness, agent_schema.PROVIDER_HARNESS_DECL_INPUT_CONTRACT);
        if input != 0u64 && !contains(sl, n, st, y.types.as_slice(), input) {
            y = harness_references(y, sl, n, st, name, "input_contract".as_slice(), input);
        }
        let output: u64 = get(sl, n, harness, agent_schema.PROVIDER_HARNESS_DECL_OUTPUT_CONTRACT);
        if output != 0u64 && !contains(sl, n, st, y.types.as_slice(), output) {
            y = harness_references(y, sl, n, st, name, "output_contract".as_slice(), output);
        }
        let mut item_link: u64 = first(sl, n, harness, agent_schema.PROVIDER_HARNESS_DECL_ATTESTATIONS);
        while item_link != 0u64 {
            let item: u64 = item_link - 1u64;
            item_link = n[item].next;
            if blank(sl, n, st, item) {
                y = at(y, sl, n, item);
                y = put(y, "harness `".as_slice());
                y = text(y, sl, n, st, name);
                y = put(y, "` attestation entries must not be empty\n".as_slice());
            }
        }
        let feature_ref: u64 = get(sl, n, harness, agent_schema.PROVIDER_HARNESS_DECL_FEATURE);
        let mut feature: u64 = NONE;
        if feature_ref != 0u64 {
            if !contains(sl, n, st, y.features.as_slice(), feature_ref) {
                y = harness_references(y, sl, n, st, name, "feature".as_slice(), feature_ref);
            } else {
                feature = find_named(sl, n, st, program, agent_schema.PROGRAM_FEATURES, feature_ref);
            }
        }
        let secret_ref: u64 = get(sl, n, harness, agent_schema.PROVIDER_HARNESS_DECL_SECRET);
        let mut secret: u64 = NONE;
        if secret_ref != 0u64 {
            if !contains(sl, n, st, y.secrets.as_slice(), secret_ref) {
                y = harness_references(y, sl, n, st, name, "secret".as_slice(), secret_ref);
            } else {
                secret = find_named(sl, n, st, program, agent_schema.PROGRAM_SECRETS, secret_ref);
            }
        }
        if has_provider && feature != NONE {
            let feature_provider: u64 = get(sl, n, feature, agent_schema.FEATURE_DECL_PROVIDER);
            if feature_provider != 0u64 && !same(sl, n, st, feature_provider, provider) {
                y = harness_mismatch(y, sl, n, st, name, provider, "feature `".as_slice(), get(sl, n, feature, 0u64), feature_provider);
            }
        }
        if has_provider && secret != NONE {
            let secret_provider: u64 = get(sl, n, secret, agent_schema.SECRET_DECL_PROVIDER);
            if secret_provider != 0u64 && !same(sl, n, st, secret_provider, provider) {
                y = harness_mismatch(y, sl, n, st, name, provider, "secret `".as_slice(), get(sl, n, secret, 0u64), secret_provider);
            }
        }
        if feature_ref != 0u64 && secret != NONE {
            let required_by: u64 = get(sl, n, secret, agent_schema.SECRET_DECL_REQUIRED_BY);
            if required_by != 0u64 && !same(sl, n, st, required_by, feature_ref) {
                y = at(y, sl, n, feature_ref);
                y = put(y, "harness `".as_slice());
                y = text(y, sl, n, st, name);
                y = put(y, "` feature `".as_slice());
                y = text(y, sl, n, st, feature_ref);
                y = put(y, "` does not match secret `".as_slice());
                y = text(y, sl, n, st, get(sl, n, secret, 0u64));
                y = put(y, "` required_by `".as_slice());
                y = text(y, sl, n, st, required_by);
                y = close(y);
            }
        }
    }
    y
}

// "harness `<name>` references unknown <what> `<reference>`".
fn harness_references(symbols: Symbols, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, name: u64, what: Slice<u8>, reference: u64) -> Symbols {
    let mut y: Symbols = at(symbols, sl, n, reference);
    y = put(y, "harness `".as_slice());
    y = text(y, sl, n, st, name);
    y = put(y, "` references unknown ".as_slice());
    y = put(y, what);
    y = put(y, " `".as_slice());
    y = text(y, sl, n, st, reference);
    close(y)
}

// "harness `<name>` provider `<provider>` does not match <what><other>`
// provider `<theirs>`", at the harness's provider.
fn harness_mismatch(symbols: Symbols, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, name: u64, provider: u64, what: Slice<u8>, other: u64, theirs: u64) -> Symbols {
    let mut y: Symbols = at(symbols, sl, n, provider);
    y = put(y, "harness `".as_slice());
    y = text(y, sl, n, st, name);
    y = put(y, "` provider `".as_slice());
    y = text(y, sl, n, st, provider);
    y = put(y, "` does not match ".as_slice());
    y = put(y, what);
    y = text(y, sl, n, st, other);
    y = put(y, "` provider `".as_slice());
    y = text(y, sl, n, st, theirs);
    close(y)
}

// ------------------------------------------------------------------ adapters

// "<kind> `<name>` <message>" at `spanned`, the most common shape.
fn say(symbols: Symbols, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, spanned: u64, kind: Slice<u8>, name: u64, message: Slice<u8>) -> Symbols {
    let mut y: Symbols = at(symbols, sl, n, spanned);
    y = put(y, kind);
    y = put(y, " `".as_slice());
    y = text(y, sl, n, st, name);
    y = put(y, "` ".as_slice());
    put(y, message)
}

// Whether a `Spanned` holds variant `v` of its enum.
fn variant_is(sl: Slice<u64>, n: Slice<AgentNode>, spanned: u64, v: u64) -> bool {
    n[value(sl, n, spanned)].a == v
}

// Whether a `Spanned` holds the `Unknown` variant `unknown` with an empty
// word.
fn empty_unknown(sl: Slice<u64>, n: Slice<AgentNode>, spanned: u64, unknown: u64) -> bool {
    let variant: u64 = value(sl, n, spanned);
    n[variant].a == unknown && n[n[variant].b].a == n[n[variant].b].b
}

// Whether `name` is a declared type, enum or primitive type.
fn field_type(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, types: Slice<u64>, enums: Slice<u64>, name: u64) -> bool {
    contains(sl, n, st, types, name) || contains(sl, n, st, enums, name) || is(sl, n, st, name, "string".as_slice()) || is(sl, n, st, name, "bool".as_slice()) || is(sl, n, st, name, "int".as_slice()) || is(sl, n, st, name, "float".as_slice())
}

fn check_adapters(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64, symbols: Symbols) -> Symbols {
    let mut y: Symbols = symbols;
    let mut names: Buffer<u64> = Buffer::new();
    let mut link: u64 = first(sl, n, program, agent_schema.PROGRAM_ADAPTERS);
    while link != 0u64 {
        let adapter: u64 = link - 1u64;
        link = n[adapter].next;
        let name: u64 = get(sl, n, adapter, agent_schema.ADAPTER_DECL_NAME);
        if contains(sl, n, st, names.as_slice(), name) {
            y = duplicate(y, sl, n, st, name, "adapter".as_slice());
        } else {
            names.push(name);
        }
        let provider: u64 = get(sl, n, adapter, agent_schema.ADAPTER_DECL_PROVIDER);
        if blank(sl, n, st, provider) {
            y = say(y, sl, n, st, provider, "adapter".as_slice(), name, "is missing required field `provider`\n".as_slice());
        } else if !contains(sl, n, st, y.providers.as_slice(), provider) {
            y = say(y, sl, n, st, provider, "adapter".as_slice(), name, "references unknown provider `".as_slice());
            y = text(y, sl, n, st, provider);
            y = close(y);
        }
        let feature: u64 = get(sl, n, adapter, agent_schema.ADAPTER_DECL_FEATURE);
        if feature != 0u64 && !contains(sl, n, st, y.features.as_slice(), feature) {
            y = say(y, sl, n, st, feature, "adapter".as_slice(), name, "references unknown feature `".as_slice());
            y = text(y, sl, n, st, feature);
            y = close(y);
        }
        let secret: u64 = get(sl, n, adapter, agent_schema.ADAPTER_DECL_SECRET);
        if secret != 0u64 && !contains(sl, n, st, y.secrets.as_slice(), secret) {
            y = say(y, sl, n, st, secret, "adapter".as_slice(), name, "references unknown secret `".as_slice());
            y = text(y, sl, n, st, secret);
            y = close(y);
        }
        let harness: u64 = get(sl, n, adapter, agent_schema.ADAPTER_DECL_HARNESS);
        if harness != 0u64 && find_named(sl, n, st, program, agent_schema.PROGRAM_HARNESSES, harness) == NONE {
            y = say(y, sl, n, st, harness, "adapter".as_slice(), name, "references unknown harness `".as_slice());
            y = text(y, sl, n, st, harness);
            y = close(y);
        }
        let vendor: u64 = get(sl, n, adapter, agent_schema.ADAPTER_DECL_VENDOR);
        if vendor != 0u64 && blank(sl, n, st, vendor) {
            y = say(y, sl, n, st, vendor, "adapter".as_slice(), name, "has empty `vendor`\n".as_slice());
        }
        y = required_enum(y, sl, n, st, "adapter".as_slice(), name, "mode".as_slice(), get(sl, n, adapter, agent_schema.ADAPTER_DECL_MODE), agent_schema.ADAPTER_MODE_UNKNOWN, "".as_slice());
        y = required_enum(y, sl, n, st, "adapter".as_slice(), name, "execution".as_slice(), get(sl, n, adapter, agent_schema.ADAPTER_DECL_EXECUTION), agent_schema.ADAPTER_EXECUTION_UNKNOWN, "".as_slice());
        y = required_enum(y, sl, n, st, "adapter".as_slice(), name, "network".as_slice(), get(sl, n, adapter, agent_schema.ADAPTER_DECL_NETWORK), agent_schema.ADAPTER_NETWORK_UNKNOWN, "".as_slice());
        y = required_enum(y, sl, n, st, "adapter".as_slice(), name, "secrets".as_slice(), get(sl, n, adapter, agent_schema.ADAPTER_DECL_SECRETS), agent_schema.ADAPTER_SECRETS_UNKNOWN, "".as_slice());
        y = required_enum(y, sl, n, st, "adapter".as_slice(), name, "filesystem".as_slice(), get(sl, n, adapter, agent_schema.ADAPTER_DECL_FILESYSTEM), agent_schema.ADAPTER_FILESYSTEM_UNKNOWN, "".as_slice());
        let mut item_link: u64 = first(sl, n, adapter, agent_schema.ADAPTER_DECL_CONFORMANCE);
        while item_link != 0u64 {
            let item: u64 = item_link - 1u64;
            item_link = n[item].next;
            if blank(sl, n, st, item) {
                y = say(y, sl, n, st, item, "adapter".as_slice(), name, "has empty conformance item\n".as_slice());
            }
        }
    }
    // The references against each other.
    link = first(sl, n, program, agent_schema.PROGRAM_ADAPTERS);
    while link != 0u64 {
        let adapter: u64 = link - 1u64;
        link = n[adapter].next;
        let name: u64 = get(sl, n, adapter, agent_schema.ADAPTER_DECL_NAME);
        let provider: u64 = get(sl, n, adapter, agent_schema.ADAPTER_DECL_PROVIDER);
        let feature: u64 = get(sl, n, adapter, agent_schema.ADAPTER_DECL_FEATURE);
        let secret: u64 = get(sl, n, adapter, agent_schema.ADAPTER_DECL_SECRET);
        let harness: u64 = get(sl, n, adapter, agent_schema.ADAPTER_DECL_HARNESS);
        if feature != 0u64 {
            let declared: u64 = find_named(sl, n, st, program, agent_schema.PROGRAM_FEATURES, feature);
            if declared != NONE {
                let theirs: u64 = get(sl, n, declared, agent_schema.FEATURE_DECL_PROVIDER);
                if theirs != 0u64 && !same(sl, n, st, theirs, provider) {
                    y = adapter_mismatch(y, sl, n, st, feature, name, "provider `".as_slice(), provider, "feature `".as_slice(), feature, "provider `".as_slice(), theirs);
                }
            }
        }
        if secret != 0u64 {
            let declared: u64 = find_named(sl, n, st, program, agent_schema.PROGRAM_SECRETS, secret);
            if declared != NONE {
                let theirs: u64 = get(sl, n, declared, agent_schema.SECRET_DECL_PROVIDER);
                if theirs != 0u64 && !same(sl, n, st, theirs, provider) {
                    y = adapter_mismatch(y, sl, n, st, secret, name, "provider `".as_slice(), provider, "secret `".as_slice(), secret, "provider `".as_slice(), theirs);
                }
                let required_by: u64 = get(sl, n, declared, agent_schema.SECRET_DECL_REQUIRED_BY);
                if required_by != 0u64 && feature != 0u64 && !same(sl, n, st, required_by, feature) {
                    y = adapter_mismatch(y, sl, n, st, secret, name, "feature `".as_slice(), feature, "secret `".as_slice(), secret, "required_by `".as_slice(), required_by);
                }
            }
        }
        if harness != 0u64 {
            let declared: u64 = find_named(sl, n, st, program, agent_schema.PROGRAM_HARNESSES, harness);
            if declared != NONE {
                let theirs: u64 = get(sl, n, declared, agent_schema.PROVIDER_HARNESS_DECL_PROVIDER);
                if !same(sl, n, st, theirs, provider) {
                    y = adapter_mismatch(y, sl, n, st, harness, name, "provider `".as_slice(), provider, "harness `".as_slice(), harness, "provider `".as_slice(), theirs);
                }
                let harness_feature: u64 = get(sl, n, declared, agent_schema.PROVIDER_HARNESS_DECL_FEATURE);
                if harness_feature != 0u64 && feature != 0u64 && !same(sl, n, st, harness_feature, feature) {
                    y = adapter_mismatch(y, sl, n, st, harness, name, "feature `".as_slice(), feature, "harness `".as_slice(), harness, "feature `".as_slice(), harness_feature);
                }
                let harness_secret: u64 = get(sl, n, declared, agent_schema.PROVIDER_HARNESS_DECL_SECRET);
                if harness_secret != 0u64 && secret != 0u64 && !same(sl, n, st, harness_secret, secret) {
                    y = adapter_mismatch(y, sl, n, st, harness, name, "secret `".as_slice(), secret, "harness `".as_slice(), harness, "secret `".as_slice(), harness_secret);
                }
            }
        }
    }
    // The contracts' types.
    link = first(sl, n, program, agent_schema.PROGRAM_ADAPTERS);
    while link != 0u64 {
        let adapter: u64 = link - 1u64;
        link = n[adapter].next;
        let name: u64 = get(sl, n, adapter, agent_schema.ADAPTER_DECL_NAME);
        let input: u64 = get(sl, n, adapter, agent_schema.ADAPTER_DECL_INPUT_CONTRACT);
        if input != 0u64 && !field_type(sl, n, st, y.types.as_slice(), y.enums.as_slice(), input) {
            y = say(y, sl, n, st, input, "adapter".as_slice(), name, "input_contract references unknown type `".as_slice());
            y = text(y, sl, n, st, input);
            y = close(y);
        }
        let output: u64 = get(sl, n, adapter, agent_schema.ADAPTER_DECL_OUTPUT_CONTRACT);
        if output != 0u64 && !field_type(sl, n, st, y.types.as_slice(), y.enums.as_slice(), output) {
            y = say(y, sl, n, st, output, "adapter".as_slice(), name, "output_contract references unknown type `".as_slice());
            y = text(y, sl, n, st, output);
            y = close(y);
        }
    }
    // External providers' boundaries.
    link = first(sl, n, program, agent_schema.PROGRAM_ADAPTERS);
    while link != 0u64 {
        let adapter: u64 = link - 1u64;
        link = n[adapter].next;
        let provider: u64 = get(sl, n, adapter, agent_schema.ADAPTER_DECL_PROVIDER);
        let declared_provider: u64 = find_named(sl, n, st, program, agent_schema.PROGRAM_PROVIDERS, provider);
        if declared_provider == NONE || !variant_is(sl, n, get(sl, n, declared_provider, agent_schema.PROVIDER_DECL_KIND), agent_schema.PROVIDER_KIND_DECL_EXTERNAL) {
            continue;
        }
        let name: u64 = get(sl, n, adapter, agent_schema.ADAPTER_DECL_NAME);
        let feature: u64 = get(sl, n, adapter, agent_schema.ADAPTER_DECL_FEATURE);
        let secret: u64 = get(sl, n, adapter, agent_schema.ADAPTER_DECL_SECRET);
        let harness: u64 = get(sl, n, adapter, agent_schema.ADAPTER_DECL_HARNESS);
        if feature == 0u64 {
            y = say(y, sl, n, st, provider, "adapter".as_slice(), name, "references external provider but is missing `feature`\n".as_slice());
        }
        if secret == 0u64 {
            y = say(y, sl, n, st, provider, "adapter".as_slice(), name, "references external provider but is missing `secret`\n".as_slice());
        }
        if harness == 0u64 {
            y = say(y, sl, n, st, provider, "adapter".as_slice(), name, "references external provider but is missing `harness`\n".as_slice());
        }
        if feature != 0u64 {
            let declared: u64 = find_named(sl, n, st, program, agent_schema.PROGRAM_FEATURES, feature);
            if declared != NONE {
                let default: u64 = get(sl, n, declared, agent_schema.FEATURE_DECL_DEFAULT);
                if variant_is(sl, n, default, agent_schema.FEATURE_DEFAULT_ENABLED) {
                    y = say(y, sl, n, st, default, "adapter".as_slice(), name, "for external provider requires feature `".as_slice());
                    y = text(y, sl, n, st, feature);
                    y = put(y, "` to default to disabled\n".as_slice());
                }
                if n[get(sl, n, declared, agent_schema.FEATURE_DECL_REQUIRES_APPROVAL)].a == 0u64 {
                    y = say(y, sl, n, st, get(sl, n, declared, 0u64), "adapter".as_slice(), name, "for external provider requires feature `".as_slice());
                    y = text(y, sl, n, st, feature);
                    y = put(y, "` to require approval\n".as_slice());
                }
            }
        }
        if secret != 0u64 {
            let declared: u64 = find_named(sl, n, st, program, agent_schema.PROGRAM_SECRETS, secret);
            if declared != NONE {
                let access: u64 = get(sl, n, declared, agent_schema.SECRET_DECL_ACCESS);
                if !variant_is(sl, n, access, agent_schema.SECRET_ACCESS_DENIED) && !empty_unknown(sl, n, access, agent_schema.SECRET_ACCESS_UNKNOWN) {
                    y = say(y, sl, n, st, access, "adapter".as_slice(), name, "secret boundary for external provider must have access denied\n".as_slice());
                }
                let source: u64 = get(sl, n, declared, agent_schema.SECRET_DECL_SOURCE);
                if !variant_is(sl, n, source, agent_schema.SECRET_SOURCE_NONE) && !empty_unknown(sl, n, source, agent_schema.SECRET_SOURCE_UNKNOWN) {
                    y = say(y, sl, n, st, source, "adapter".as_slice(), name, "secret boundary for external provider must have source none\n".as_slice());
                }
            }
        }
        if harness != 0u64 {
            let declared: u64 = find_named(sl, n, st, program, agent_schema.PROGRAM_HARNESSES, harness);
            if declared != NONE {
                let network: u64 = get(sl, n, declared, agent_schema.PROVIDER_HARNESS_DECL_NETWORK);
                if !variant_is(sl, n, network, agent_schema.HARNESS_NETWORK_DENIED) {
                    y = say(y, sl, n, st, network, "adapter".as_slice(), name, "harness for external provider must have network denied\n".as_slice());
                }
                let secrets: u64 = get(sl, n, declared, agent_schema.PROVIDER_HARNESS_DECL_SECRETS);
                if !variant_is(sl, n, secrets, agent_schema.HARNESS_SECRETS_DENIED) {
                    y = say(y, sl, n, st, secrets, "adapter".as_slice(), name, "harness for external provider must have secrets denied\n".as_slice());
                }
            }
        }
    }
    y
}

// "adapter `<name>` <what><ours>` does not match <kind><other>` <field><theirs>`".
fn adapter_mismatch(symbols: Symbols, sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, spanned: u64, name: u64, what: Slice<u8>, ours: u64, kind: Slice<u8>, other: u64, field: Slice<u8>, theirs: u64) -> Symbols {
    let mut y: Symbols = say(symbols, sl, n, st, spanned, "adapter".as_slice(), name, what);
    y = text(y, sl, n, st, ours);
    y = put(y, "` does not match ".as_slice());
    y = put(y, kind);
    y = text(y, sl, n, st, other);
    y = put(y, "` ".as_slice());
    y = put(y, field);
    y = text(y, sl, n, st, theirs);
    close(y)
}

// ------------------------------------------------------------------ adapter profiles

fn check_adapter_profiles(sl: Slice<u64>, n: Slice<AgentNode>, st: Slice<u8>, program: u64, symbols: Symbols) -> Symbols {
    let mut y: Symbols = symbols;
    let mut names: Buffer<u64> = Buffer::new();
    let mut link: u64 = first(sl, n, program, agent_schema.PROGRAM_ADAPTER_PROFILES);
    while link != 0u64 {
        let profile: u64 = link - 1u64;
        link = n[profile].next;
        let name: u64 = get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_NAME);
        if contains(sl, n, st, names.as_slice(), name) {
            y = duplicate(y, sl, n, st, name, "adapter_profile".as_slice());
        } else {
            names.push(name);
        }
        let adapter: u64 = get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_ADAPTER);
        if blank(sl, n, st, adapter) {
            y = say(y, sl, n, st, adapter, "adapter_profile".as_slice(), name, "is missing required field `adapter`\n".as_slice());
        } else if !contains(sl, n, st, y.adapters.as_slice(), adapter) {
            y = say(y, sl, n, st, adapter, "adapter_profile".as_slice(), name, "references unknown adapter `".as_slice());
            y = text(y, sl, n, st, adapter);
            y = close(y);
        }
        let provider: u64 = get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_PROVIDER);
        if blank(sl, n, st, provider) {
            y = say(y, sl, n, st, provider, "adapter_profile".as_slice(), name, "is missing required field `provider`\n".as_slice());
        } else if !contains(sl, n, st, y.providers.as_slice(), provider) {
            y = say(y, sl, n, st, provider, "adapter_profile".as_slice(), name, "references unknown provider `".as_slice());
            y = text(y, sl, n, st, provider);
            y = close(y);
        }
        let vendor: u64 = get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_VENDOR);
        if blank(sl, n, st, vendor) {
            y = say(y, sl, n, st, vendor, "adapter_profile".as_slice(), name, "is missing required field `vendor`\n".as_slice());
        }
        y = required_enum(y, sl, n, st, "adapter_profile".as_slice(), name, "family".as_slice(), get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_FAMILY), agent_schema.ADAPTER_PROFILE_FAMILY_UNKNOWN, "".as_slice());
        y = required_enum(y, sl, n, st, "adapter_profile".as_slice(), name, "api_style".as_slice(), get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_API_STYLE), agent_schema.ADAPTER_PROFILE_API_STYLE_UNKNOWN, "".as_slice());
        y = required_enum(y, sl, n, st, "adapter_profile".as_slice(), name, "auth".as_slice(), get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_AUTH), agent_schema.ADAPTER_PROFILE_AUTH_UNKNOWN, "".as_slice());
        y = required_enum(y, sl, n, st, "adapter_profile".as_slice(), name, "execution".as_slice(), get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_EXECUTION), agent_schema.ADAPTER_PROFILE_EXECUTION_UNKNOWN, "".as_slice());
        y = required_enum(y, sl, n, st, "adapter_profile".as_slice(), name, "network".as_slice(), get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_NETWORK), agent_schema.ADAPTER_PROFILE_NETWORK_UNKNOWN, "".as_slice());
        y = required_enum(y, sl, n, st, "adapter_profile".as_slice(), name, "secrets".as_slice(), get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_SECRETS), agent_schema.ADAPTER_PROFILE_SECRETS_UNKNOWN, "".as_slice());
        let request: u64 = get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_REQUEST_CONTRACT);
        if request != 0u64 && !field_type(sl, n, st, y.types.as_slice(), y.enums.as_slice(), request) {
            y = say(y, sl, n, st, request, "adapter_profile".as_slice(), name, "request_contract references unknown type `".as_slice());
            y = text(y, sl, n, st, request);
            y = close(y);
        }
        let response: u64 = get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_RESPONSE_CONTRACT);
        if response != 0u64 && !field_type(sl, n, st, y.types.as_slice(), y.enums.as_slice(), response) {
            y = say(y, sl, n, st, response, "adapter_profile".as_slice(), name, "response_contract references unknown type `".as_slice());
            y = text(y, sl, n, st, response);
            y = close(y);
        }
        let mut item_link: u64 = first(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_CAPABILITIES);
        while item_link != 0u64 {
            let item: u64 = item_link - 1u64;
            item_link = n[item].next;
            if blank(sl, n, st, item) {
                y = say(y, sl, n, st, item, "adapter_profile".as_slice(), name, "has empty capability\n".as_slice());
            }
        }
        item_link = first(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_REQUIRED_CONFORMANCE);
        while item_link != 0u64 {
            let item: u64 = item_link - 1u64;
            item_link = n[item].next;
            if blank(sl, n, st, item) {
                y = say(y, sl, n, st, item, "adapter_profile".as_slice(), name, "has empty required_conformance item\n".as_slice());
            }
        }
    }
    // Links and coherence.
    link = first(sl, n, program, agent_schema.PROGRAM_ADAPTER_PROFILES);
    while link != 0u64 {
        let profile: u64 = link - 1u64;
        link = n[profile].next;
        let name: u64 = get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_NAME);
        let adapter: u64 = get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_ADAPTER);
        let provider: u64 = get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_PROVIDER);
        let declared: u64 = find_named(sl, n, st, program, agent_schema.PROGRAM_ADAPTERS, adapter);
        if declared != NONE {
            let theirs: u64 = get(sl, n, declared, agent_schema.ADAPTER_DECL_PROVIDER);
            if !same(sl, n, st, theirs, provider) {
                y = say(y, sl, n, st, adapter, "adapter_profile".as_slice(), name, "provider `".as_slice());
                y = text(y, sl, n, st, provider);
                y = put(y, "` does not match adapter `".as_slice());
                y = text(y, sl, n, st, adapter);
                y = put(y, "` provider `".as_slice());
                y = text(y, sl, n, st, theirs);
                y = close(y);
            }
        }
        let auth: u64 = get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_AUTH);
        if variant_is(sl, n, auth, agent_schema.ADAPTER_PROFILE_AUTH_SECRET_BOUNDARY) && declared != NONE && get(sl, n, declared, agent_schema.ADAPTER_DECL_SECRET) == 0u64 {
            y = say(y, sl, n, st, auth, "adapter_profile".as_slice(), name, "uses auth secret_boundary but linked adapter has no secret boundary\n".as_slice());
        }
    }
    // External providers' boundaries.
    link = first(sl, n, program, agent_schema.PROGRAM_ADAPTER_PROFILES);
    while link != 0u64 {
        let profile: u64 = link - 1u64;
        link = n[profile].next;
        let provider: u64 = get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_PROVIDER);
        let declared_provider: u64 = find_named(sl, n, st, program, agent_schema.PROGRAM_PROVIDERS, provider);
        if declared_provider == NONE || !variant_is(sl, n, get(sl, n, declared_provider, agent_schema.PROVIDER_DECL_KIND), agent_schema.PROVIDER_KIND_DECL_EXTERNAL) {
            continue;
        }
        let name: u64 = get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_NAME);
        let adapter: u64 = get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_ADAPTER);
        let declared: u64 = find_named(sl, n, st, program, agent_schema.PROGRAM_ADAPTERS, adapter);
        if declared == NONE {
            continue;
        }
        let feature: u64 = get(sl, n, declared, agent_schema.ADAPTER_DECL_FEATURE);
        let secret: u64 = get(sl, n, declared, agent_schema.ADAPTER_DECL_SECRET);
        let harness: u64 = get(sl, n, declared, agent_schema.ADAPTER_DECL_HARNESS);
        if feature == 0u64 {
            y = say(y, sl, n, st, adapter, "adapter_profile".as_slice(), name, "for external provider requires linked adapter to declare feature\n".as_slice());
        }
        if secret == 0u64 {
            y = say(y, sl, n, st, adapter, "adapter_profile".as_slice(), name, "for external provider requires linked adapter to declare secret\n".as_slice());
        }
        if harness == 0u64 {
            y = say(y, sl, n, st, adapter, "adapter_profile".as_slice(), name, "for external provider requires linked adapter to declare harness\n".as_slice());
        }
        if feature != 0u64 {
            let feature_decl: u64 = find_named(sl, n, st, program, agent_schema.PROGRAM_FEATURES, feature);
            if feature_decl != NONE {
                let default: u64 = get(sl, n, feature_decl, agent_schema.FEATURE_DECL_DEFAULT);
                if variant_is(sl, n, default, agent_schema.FEATURE_DEFAULT_ENABLED) {
                    y = say(y, sl, n, st, default, "adapter_profile".as_slice(), name, "requires feature `".as_slice());
                    y = text(y, sl, n, st, feature);
                    y = put(y, "` default disabled for external provider\n".as_slice());
                }
                if n[get(sl, n, feature_decl, agent_schema.FEATURE_DECL_REQUIRES_APPROVAL)].a == 0u64 {
                    y = say(y, sl, n, st, get(sl, n, feature_decl, 0u64), "adapter_profile".as_slice(), name, "requires feature `".as_slice());
                    y = text(y, sl, n, st, feature);
                    y = put(y, "` to require approval\n".as_slice());
                }
            }
        }
        if secret != 0u64 {
            let secret_decl: u64 = find_named(sl, n, st, program, agent_schema.PROGRAM_SECRETS, secret);
            if secret_decl != NONE {
                let access: u64 = get(sl, n, secret_decl, agent_schema.SECRET_DECL_ACCESS);
                if !variant_is(sl, n, access, agent_schema.SECRET_ACCESS_DENIED) {
                    y = say(y, sl, n, st, access, "adapter_profile".as_slice(), name, "requires secret access denied\n".as_slice());
                }
                let source: u64 = get(sl, n, secret_decl, agent_schema.SECRET_DECL_SOURCE);
                if !variant_is(sl, n, source, agent_schema.SECRET_SOURCE_NONE) {
                    y = say(y, sl, n, st, source, "adapter_profile".as_slice(), name, "requires secret source none\n".as_slice());
                }
            }
        }
        if harness != 0u64 {
            let harness_decl: u64 = find_named(sl, n, st, program, agent_schema.PROGRAM_HARNESSES, harness);
            if harness_decl != NONE {
                let network: u64 = get(sl, n, harness_decl, agent_schema.PROVIDER_HARNESS_DECL_NETWORK);
                if !variant_is(sl, n, network, agent_schema.HARNESS_NETWORK_DENIED) {
                    y = say(y, sl, n, st, network, "adapter_profile".as_slice(), name, "requires harness network denied\n".as_slice());
                }
                let secrets: u64 = get(sl, n, harness_decl, agent_schema.PROVIDER_HARNESS_DECL_SECRETS);
                if !variant_is(sl, n, secrets, agent_schema.HARNESS_SECRETS_DENIED) {
                    y = say(y, sl, n, st, secrets, "adapter_profile".as_slice(), name, "requires harness secrets denied\n".as_slice());
                }
            }
        }
    }
    // Vendors' families.
    link = first(sl, n, program, agent_schema.PROGRAM_ADAPTER_PROFILES);
    while link != 0u64 {
        let profile: u64 = link - 1u64;
        link = n[profile].next;
        let name: u64 = get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_NAME);
        let vendor: u64 = get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_VENDOR);
        let family: u64 = get(sl, n, profile, agent_schema.ADAPTER_PROFILE_DECL_FAMILY);
        let llm_or_custom: bool = variant_is(sl, n, family, agent_schema.ADAPTER_PROFILE_FAMILY_LLM) || variant_is(sl, n, family, agent_schema.ADAPTER_PROFILE_FAMILY_CUSTOM);
        if is(sl, n, st, vendor, "openai".as_slice()) && !llm_or_custom {
            y = say(y, sl, n, st, family, "adapter_profile".as_slice(), name, "for vendor openai should use family llm (or custom)\n".as_slice());
        }
        if is(sl, n, st, vendor, "anthropic".as_slice()) && !llm_or_custom {
            y = say(y, sl, n, st, family, "adapter_profile".as_slice(), name, "for vendor anthropic should use family llm (or custom)\n".as_slice());
        }
    }
    y
}
