{
  "schema_version": 1,
  "abi_version": "C1",
  "language_standard": "c11",
  "allowed_compiler_names": ["cc", "clang", "gcc"],
  "required_flags": ["-std=c11", "-Wall", "-Wextra", "-Werror"],
  "runtime_sources": [
    "bootstrap/c/argorix_core_runtime.c",
    "bootstrap/c/argorix_core_runtime.h",
    "bootstrap/c/argorix_core_host.h"
  ],
  "selftest_source": "bootstrap/c/runtime_selftest.c",
  "forbidden_link_inputs": ["*.rlib", "*.rustlib", "cargo", "rustc"],
  "trap_exit_code": 70,
  "notes": "The driver invokes the compiler directly with an argument array; source text cannot supply executable names or flags."
}
