{
  "schema_version": 1,
  "core_version": "0.1",
  "task": "ESP-009.B",
  "purpose": "Programs that the transitional C backend once got wrong, kept as regression cases. Each one is valid Core 0.1 that argorixc core-check accepts, and every expectation comes from spec/core/evaluation.md. They were the known-gap corpus of issue #27 until the defects were fixed.",
  "cases": [
    {
      "id": "g01_nested_array",
      "file": "g01_nested_array.argx",
      "was": "Array typedefs were emitted sorted by name, so the outer array preceded the inner one.",
      "expected_exit": 0,
      "expected_stdout": "ARGORIX_RESULT:37",
      "expected_stderr": ""
    },
    {
      "id": "g02_struct_in_struct",
      "file": "g02_struct_in_struct.argx",
      "was": "Struct definitions were emitted alphabetically instead of in dependency order.",
      "expected_exit": 0,
      "expected_stdout": "ARGORIX_RESULT:42",
      "expected_stderr": ""
    },
    {
      "id": "g03_array_of_struct",
      "file": "g03_array_of_struct.argx",
      "was": "The array typedef came before the struct it holds.",
      "expected_exit": 0,
      "expected_stdout": "ARGORIX_RESULT:42",
      "expected_stderr": ""
    },
    {
      "id": "g04_block_scope",
      "file": "g04_block_scope.argx",
      "was": "A block expression's locals landed in the enclosing C scope.",
      "expected_exit": 0,
      "expected_stdout": "ARGORIX_RESULT:42",
      "expected_stderr": ""
    },
    {
      "id": "g05_unit_tail_call",
      "file": "g05_unit_tail_call.argx",
      "was": "A unit function whose tail is a call emitted `return <value>;` inside void.",
      "expected_exit": 0,
      "expected_stdout": "ARGORIX_RESULT:42",
      "expected_stderr": ""
    },
    {
      "id": "g06_array_in_if",
