core 0.1;
module regression.f01_guard_falls_through;

enum E { A { p0: u32, }, B, }

fn read(v: E) -> u32 {
    match v {
        E::A { p0 } if p0 > 100u32 => 1u32,
        E::A { p0 } if p0 > 10u32 => p0,
        E::A { p0 } => p0 + 1000u32,
        E::B => 7u32,
    }
}

pub fn argorix_main() -> u32 {
    read(E::A { p0: 35u32 }) + read(E::A { p0: 2u32 }) + read(E::B)
}
