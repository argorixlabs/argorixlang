core 0.1;
module regression.g27_field_of_slice_element;

// Reading a field of an element of a view, `points[i].x` with
// `points: Slice<Point>`, was refused: the backend treated the element as a
// place and only knew places in buffers and arrays ("only a Buffer or an
// Array element is a writable place"). The Argorix parser reads its tokens
// this way (ESP-011).

struct Point { x: u64, y: u64, }

fn total(points: Slice<Point>) -> u64 {
    let mut sum: u64 = 0u64;
    let mut index: u64 = 0u64;
    while index < points.length() {
        sum += points[index].x * 10u64 + points[index].y;
        index += 1u64;
    }
    sum
}

pub fn argorix_main() -> u64 {
    let points: Array<Point, 3> = [Point { x: 1u64, y: 2u64 }, Point { x: 3u64, y: 4u64 }, Point { x: 5u64, y: 6u64 }];
    total(points.as_slice())
}
