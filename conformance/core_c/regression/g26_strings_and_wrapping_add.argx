core 0.1;
module regression.g26_strings_and_wrapping_add;

// String literals and `wrapping_add` are valid Core, but the C backend refused
// both ("outside the scalar C profile", "does not accept arguments"). The Argorix
// lexer (ESP-010) needs them. The literal below holds every byte class the C
// literal must escape: a quote, a backslash, `?` (trigraphs), a tab and
// non-ASCII text.

fn sum(values: Slice<u8>) -> u64 {
    let mut total: u64 = 0u64;
    let mut index: u64 = 0u64;
    while index < values.length() {
        if values[index] == 34u8 || values[index] == 92u8 || values[index] == 63u8 || values[index] == 9u8 {
            total += 1u64;
        }
        index += 1u64;
    }
    total * 100u64 + values.length()
}

pub fn argorix_main() -> u64 {
    // "a\"b\\c??=d\té": 12 bytes (é is two), four escaped classes, two `?`.
    let marked: u64 = sum("a\"b\\c??=d\té".as_slice());
    let text: string = "0123456789";
    // Wraps around: u64::MAX + 2 is 1.
    let wrapped: u64 = 18446744073709551615u64.wrapping_add(2u64);
    marked + text.length() * 1000u64 + wrapped * 100000u64
}
