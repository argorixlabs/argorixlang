{
  "schema_version": 1,
  "task": "ESP-008.R",
  "description": "What a transitional Core C executable may depend on. Applied to Linux ELF binaries by the core-c-harness crate. A pattern is a plain substring, or anchored with ^ (prefix), $ (suffix), or both (exact).",
  "allowed_needed_libraries": ["libc.so.6"],
  "forbidden_library_patterns": ["rust", "libstd-", "libcore-", ".rlib$"],
  "forbidden_symbol_patterns": [
    "^rust_",
    "^_rust_",
    "^__rust",
    "^_ZN",
    "^_R"
  ],
  "forbidden_imports": [
    "system", "popen",
    "execl", "execle", "execlp", "execv", "execve", "execvp", "execvpe", "fexecve",
    "posix_spawn", "posix_spawnp", "fork", "vfork", "clone", "clone3",
    "dlopen", "dlmopen"
  ],
  "host_only_imports": [
    "open", "open64", "openat", "openat64", "creat", "fopen", "fopen64",
    "realpath", "opendir", "stat", "stat64", "lstat", "fstatat", "mkdir", "unlink", "rename"
  ],
  "forbidden_byte_markers": ["/.cargo/", "/.rustup/", "/rustc/", "RUST_BACKTRACE"],
  "execution_timeout_seconds": 10
}
